  "setup": {
    "workspace_baseline": "stark-workspace-a",
    "workspace_backends": [
      "stark-enterprise-x",
      "support-daloopa-skills",
      "getting-started",
      "widget-examples"
    ],
    "workspace_skills": [
      "daloopa-capital-allocation",
      "daloopa-earnings-review",
      "daloopa-guidance-tracker",
      "daloopa-industry",
      "daloopa-inflection",
      "daloopa-tearsheet",
      "finance-comps",
      "finance-earnings-prep",
      "finance-guidance-tracker",
      "finance-tearsheet"
    ],
    "default_selected_dashboard": "Home",
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_widgets": [
      {
        "origin": "Pilot Close Policy",
        "widget_id": "close_policy_exceptions",
        "data_args": {
          "fund": "Flagship Long/Short",
          "status": "Open",
          "period": "YTD"
        },
        "tab_id": "exceptions"
      }
    ],
    "required_tools": [
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Pilot Close Policy",
          "url": "http://127.0.0.1:9403",
          "widgets_json": {
            "close_policy_exceptions": {
              "name": "Close Policy Exceptions",
              "description": "Exception view whose controls encode the close-desk policy.",
              "endpoint": "/close-policy-exceptions",
              "type": "table",
              "gridData": {
                "w": 20,
                "h": 10
              },
              "params": [
                {
                  "paramName": "fund",
                  "type": "text",
                  "label": "Fund",
                  "value": "Flagship Long/Short",
                  "options": [
                    {
                      "label": "Flagship Long/Short",
                      "value": "Flagship Long/Short"
                    },
                    {
                      "label": "Global Opportunities",
                      "value": "Global Opportunities"
                    }
                  ]
                },
                {
                  "paramName": "status",
                  "type": "text",
                  "label": "Status",
                  "value": "Open",
                  "options": [
                    {
                      "label": "Open",
                      "value": "Open"
                    },
                    {
                      "label": "In Review",
                      "value": "In Review"
                    }
                  ]
                },
                {
                  "paramName": "period",
                  "type": "text",
                  "label": "Period",
                  "value": "YTD",
                  "options": [
                    {
                      "label": "Year to Date",
                      "value": "YTD"
                    },
                    {
                      "label": "Quarter to Date",
                      "value": "QTD"
                    }
                  ]
                }
              ]
            }
          },
          "apps_json": [
            {
              "name": "Close Policy App",
              "description": "Pilot app for Close Policy App.",
              "tabs": {
                "exceptions": {
                  "id": "exceptions",
                  "name": "Exceptions",
                  "layout": [
                    {
                      "i": "close_policy_exceptions",
                      "x": 0,
                      "y": 0,
                      "w": 20,
                      "h": 10,
                      "state": {
                        "params": {
                          "fund": "Flagship Long/Short",
                          "status": "Open",
                          "period": "YTD"
                        }
                      }
                    }
                  ]
                }
              },
              "groups": []
            }
          ]
        },
        "graded_args": [
          "operation",
          "name"
        ]
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_005",
          "app_name": "Close Policy App",
          "dashboard_name": "Close Policy Live",
          "activate": true
        },
        "graded_args": [
          "operation",
          "app_name"
        ]
      }
    ],
    "required_widget_defs": [
      {
        "backend_name": "Pilot Close Policy",
        "widget_id": "close_policy_exceptions",
        "expect": {
          "type": "table"
        },
        "params_include": [
          {
            "paramName": "fund",
            "value": "Flagship Long/Short"
          },
          {
            "paramName": "status",
            "value": "Open"
          },
          {
            "paramName": "period",
            "value": "YTD"
          }
        ]
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Pilot Close Policy",
        "name_contains": "Close Policy App",
        "tabs_include": [
          "exceptions"
        ],
        "layout_refs_valid": true
      }
    ],
    "max_turns": 5
  }
}
