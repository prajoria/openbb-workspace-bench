      {
        "widget_type": "note",
        "name_contains": "Intake Tooling Governance Note",
        "data_contains": [
          "form"
        ],
        "tab_id": "intake"
      }
    ],
    "required_layouts": [
      {
        "widget_uuid": "w_bf5",
        "tab_id": "intake",
        "x": 0,
        "y": 0,
        "w": 20,
        "h": 9
      },
      {
        "widget_uuid": "w_87d",
        "tab_id": "intake",
        "x": 20,
