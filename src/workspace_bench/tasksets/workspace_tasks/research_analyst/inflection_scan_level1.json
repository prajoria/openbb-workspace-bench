{
  "id": "inflection_scan_level1",
  "difficulty": "level1",
  "prompt": "Pull the KPI trends from Bench Daloopa for TSLA, period 2026Q1, and leave an Inflection Scan Note on the open Inflection Scan dashboard recording each KPI and its exact value and unit for the quarter.",
  "setup": {
    "workspace_baseline": "stark-workspace-a",
    "workspace_backends": [
      "stark-enterprise-x",
      "support-daloopa-skills",
      "getting-started",
      "widget-examples"
    ],
    "workspace_skills": [
      "daloopa-capital-allocation",
      "daloopa-earnings-review",
      "daloopa-guidance-tracker",
      "daloopa-industry",
      "daloopa-inflection",
      "daloopa-tearsheet",
      "finance-comps",
      "finance-earnings-prep",
      "finance-guidance-tracker",
      "finance-tearsheet"
    ],
    "default_selected_dashboard": "Inflection Scan",
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ],
    "initial_state": {
      "dashboard": {
        "name": "Inflection Scan",
        "activate": false,
        "tabs": [
          {
            "id": "scan",
            "name": "Scan"
          }
        ],
        "widgets": []
      }
    }
  },
  "eval": {
    "required_tools": [
      {
        "tool": "get_workspace_snapshot",
        "args": {},
        "optional": true
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Bench Daloopa"
        },
        "optional": true
      },
      {
        "tool": "get_widget_data",
        "args": {
          "origin": "Bench Daloopa",
          "widget_id": "daloopa_kpi_metrics",
          "data_args": {
            "ticker": "TSLA",
            "period": "2026Q1"
          }
        },
        "graded_args": [
          "origin",
          "widget_id",
          "data_args"
        ]
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Inflection Scan Note",
          "data": "TSLA Operating KPIs for 2026Q1: Vehicle Deliveries 509.3 units k; Energy Storage Deployed 12.8 GWh."
        },
        "graded_args": [
          "widget_type"
        ]
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "name_contains": "Inflection Scan Note",
        "data_contains": [
          "Vehicle Deliveries",
          "509.3",
          "units k",
          "Energy Storage Deployed",
          "12.8",
          "GWh"
        ]
      }
    ],
    "max_turns": 7
  }
}
