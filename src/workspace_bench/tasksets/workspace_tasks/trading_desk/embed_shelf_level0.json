        "activate": false,
        "tabs": [
          {
            "id": "shelf",
            "name": "Shelf"
          }
        ],
        "widgets": []
      }
    }
  },
  "eval": {
    "required_tools": [
      {
        "tool": "get_workspace_snapshot",
        "args": {},
        "optional": true
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Getting Started"
        },
        "optional": true
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Getting Started",
          "widget_id": "html_widget"
        },
        "graded_args": [
          "origin",
          "widget_id"
        ]
      },
      {
        "tool": "get_widget_schema",
        "args": {
          "origin": "Getting Started",
          "widget_id": "get_video"
        },
        "optional": true
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Getting Started",
          "widget_id": "get_video",
          "data_args": {
            "video_name": "OpenBB Workspace Demo"
          }
        },
        "graded_args": [
          "origin",
          "widget_id",
          "data_args"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Getting Started",
        "widget_id": "html_widget"
      },
      {
        "origin": "Getting Started",
        "widget_id": "get_video",
        "data_args": {
          "video_name": "OpenBB Workspace Demo"
        }
      }
    ],
    "required_dashboard_name_contains": "Desk Shelf",
    "max_turns": 8
