            "color_scale": "Viridis"
          }
        },
        "graded_args": [
          "origin",
          "widget_id",
          "data_args"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Getting Started",
        "widget_id": "udf"
      },
      {
        "origin": "Getting Started",
        "widget_id": "plotly_heatmap",
        "data_args": {
          "color_scale": "Viridis"
        }
