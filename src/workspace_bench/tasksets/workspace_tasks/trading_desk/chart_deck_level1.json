        "optional": true
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Getting Started",
          "widget_id": "udf"
        },
        "graded_args": [
          "origin",
          "widget_id"
        ]
      },
      {
        "tool": "get_params_options",
        "args": {
          "origin": "Getting Started",
          "widget_id": "plotly_heatmap",
          "param_name": "color_scale"
        },
        "optional": true
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Getting Started",
          "widget_id": "plotly_heatmap",
