{
  "id": "repair_ticker_nvda_msft",
  "category": "repair",
  "family": "update",
  "difficulty": "medium",
  "split": "test",
  "prompt": "This MSFT review dashboard mistakenly shows NVDA in the price widget. Repair the widget to MSFT; then add a note saying what was repaired and mentioning both values.",
  "fixtures": {
    "backends": [
      {
        "name": "equities"
      }
    ]
  },
  "initial_state": {
    "dashboard": {
      "name": "Repair Task",
      "activate": true,
      "tabs": [
        {
          "id": "",
          "name": ""
        }
      ],
      "widgets": [
        {
          "origin": "Bench Equities",
          "widget_id": "price_performance",
          "data_args": {
            "symbol": "NVDA"
          },
          "layout": {
            "x": 0,
            "y": 0,
            "w": 20,
            "h": 12
          }
        }
      ]
    }
  },
  "allowed_tools": [
    "get_workspace_snapshot",
    "read_widget",
    "update_widget",
    "add_generative_widget"
  ],
  "success": {
    "required_widgets": [
      {
        "origin": "Bench Equities",
        "widget_id": "price_performance",
        "data_args": {
          "symbol": "MSFT"
        },
        "min_count": 1
      },
      {
        "origin": "Bench Equities",
        "widget_id": "price_performance",
        "data_args": {
          "symbol": "NVDA"
        },
        "min_count": 0,
        "max_count": 0
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
