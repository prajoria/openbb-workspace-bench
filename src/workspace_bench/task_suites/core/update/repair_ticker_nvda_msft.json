  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_snapshot",
      "args": {}
    },
    {
      "tool": "read_widget",
      "args": {
        "widget_id": "price_performance"
      }
    },
    {
      "tool": "update_widget",
      "args": {
        "widget_uuid": "widget_001",
        "data_args": {
          "symbol": "MSFT"
        }
      }
    },
    {
      "tool": "add_generative_widget",
      "args": {
        "widget_type": "note",
        "name": "Repair Note",
        "data": "Repaired price_performance from NVDA to MSFT."
      }
    }
  ],
  "limits": {
    "max_turns": 7
  }
