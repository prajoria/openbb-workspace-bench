{
  "id": "cross_book_inflation",
  "category": "dashboard",
  "family": "create",
  "difficulty": "hard",
  "split": "train",
  "prompt": "Build the active dashboard with these two widgets: the Holdings Table widget from Bench Portfolio and the Macro Timeseries widget from Bench Macro for CPIAUCSL. Add a note mentioning holdings and CPIAUCSL.",
  "fixtures": {
    "backends": [
      {
        "name": "macro"
      },
      {
        "name": "portfolio"
      }
    ]
  },
  "initial_state": {
    "dashboard": {
      "name": "Cross-Backend Task",
      "activate": true,
      "tabs": [
        {
          "id": "",
          "name": ""
        }
      ]
    }
  },
  "allowed_tools": [
    "get_workspace_snapshot",
    "list_available_widgets",
    "get_widget_schema",
    "get_params_options",
    "create_widget",
    "update_widget_layout",
    "add_generative_widget"
  ],
  "success": {
    "required_widgets": [
      {
        "origin": "Bench Portfolio",
        "widget_id": "holdings_table",
        "data_args": {},
        "min_count": 1
      },
      {
        "origin": "Bench Macro",
        "widget_id": "macro_timeseries",
        "data_args": {
          "series": "CPIAUCSL"
        },
        "min_count": 1
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "holdings",
          "CPIAUCSL"
        ]
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_snapshot",
      "args": {}
    },
    {
      "tool": "list_available_widgets",
      "args": {
        "origin": "Bench Portfolio"
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Bench Portfolio",
        "widget_id": "holdings_table"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Bench Portfolio",
        "widget_id": "holdings_table",
        "data_args": {}
      }
    },
    {
      "tool": "list_available_widgets",
      "args": {
        "origin": "Bench Macro"
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Bench Macro",
        "widget_id": "macro_timeseries"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Bench Macro",
        "widget_id": "macro_timeseries",
        "data_args": {
          "series": "CPIAUCSL"
        }
      }
    },
    {
      "tool": "add_generative_widget",
      "args": {
        "widget_type": "note",
        "name": "Build Note",
        "data": "Holdings reviewed against the CPIAUCSL inflation series."
      }
    }
  ],
  "limits": {
    "max_turns": 10
  }
}
