{
  "id": "skill_build_finance_earnings_prep",
  "category": "dashboard",
  "family": "resources",
  "difficulty": "medium",
  "split": "train",
  "prompt": "Read resource openbb://workspace/specs/widgets-json, add Bench Equities/estimate_history with data_args {\"symbol\": \"AAPL\"}, and add a note that mentions surprise drivers.",
  "fixtures": {
    "backends": [
      {
        "name": "equities"
      }
    ]
  },
  "initial_state": {
    "dashboard": {
      "name": "Resource Build",
      "activate": true,
      "tabs": [
        {
          "id": "",
          "name": ""
        }
      ]
    }
  },
  "allowed_tools": [
    "get_workspace_snapshot",
    "read_workspace_resource",
    "list_available_widgets",
    "get_widget_schema",
    "create_widget",
    "add_generative_widget"
  ],
  "success": {
    "required_resource_reads": [
      {
        "uri": "openbb://workspace/specs/widgets-json",
        "data_contains": [
          "widgets.json"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Bench Equities",
        "widget_id": "estimate_history",
        "data_args": {
          "symbol": "AAPL"
        }
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "surprise drivers"
        ]
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_snapshot",
      "args": {}
    },
    {
      "tool": "read_workspace_resource",
      "args": {
        "uri": "openbb://workspace/specs/widgets-json"
      }
    },
    {
      "tool": "list_available_widgets",
      "args": {
        "origin": "Bench Equities"
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Bench Equities",
        "widget_id": "estimate_history"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Bench Equities",
        "widget_id": "estimate_history",
        "data_args": {
          "symbol": "AAPL"
        }
      }
    },
    {
      "tool": "add_generative_widget",
      "args": {
        "widget_type": "note",
        "name": "Resource Build Note",
        "data": "Built from resource guidance: surprise drivers."
      }
    }
  ],
  "limits": {
    "max_turns": 9
  }
}
