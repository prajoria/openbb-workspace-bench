{
  "id": "index_equity_earnings_review",
  "category": "dashboard",
  "family": "resources",
  "difficulty": "easy",
  "split": "train",
  "prompt": "After calling read_workspace_resource with uri openbb://workspace/app-builder/index, add a note naming the Equity Earnings Review template id equity-earnings-review.",
  "fixtures": {
    "backends": [
      {
        "name": "equities"
      }
    ]
  },
  "initial_state": {
    "dashboard": {
      "name": "App Index Review",
      "activate": true,
      "tabs": [
        {
          "id": "",
          "name": ""
        }
      ]
    }
  },
  "allowed_tools": [
    "get_workspace_snapshot",
    "read_workspace_resource",
    "add_generative_widget"
  ],
  "success": {
    "required_resource_reads": [
      {
        "uri": "openbb://workspace/app-builder/index",
        "data_contains": [
          "Equity Earnings Review",
          "equity-earnings-review"
        ]
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "Equity Earnings Review",
          "equity-earnings-review"
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 0
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_snapshot",
      "args": {}
    },
    {
      "tool": "read_workspace_resource",
      "args": {
        "uri": "openbb://workspace/app-builder/index"
      }
    },
    {
      "tool": "add_generative_widget",
      "args": {
        "widget_type": "note",
        "name": "App Index Note",
        "data": "Equity Earnings Review uses template equity-earnings-review."
      }
    }
  ],
  "limits": {
    "max_turns": 6
  }
}
