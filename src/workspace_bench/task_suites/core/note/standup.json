{
  "id": "standup",
  "category": "single-widget",
  "family": "note",
  "difficulty": "easy",
  "split": "test",
  "prompt": "On the dashboard, add a note named Morning Standup stating that the desk meeting moved to 9am and the risk review is at noon.",
  "fixtures": {
    "backends": [
      {
        "name": "equities"
      }
    ]
  },
  "initial_state": {
    "dashboard": {
      "name": "Notes Board",
      "activate": true,
      "tabs": [
        {
          "id": "",
          "name": ""
        }
      ]
    }
  },
  "allowed_tools": [
    "get_workspace_snapshot",
