{
  "id": "risk_note",
  "category": "platform",
  "family": "delegate",
  "difficulty": "medium",
  "split": "test",
  "prompt": "Use assign_tasks_to_agents with two task_requests using ids stress-analyst and limits-analyst for risk review work. Then add a coordinator note naming both workstreams on the active dashboard; omit dashboard_id when adding the note.",
  "fixtures": {
    "backends": [
      {
        "name": "stark-enterprise"
      }
    ]
  },
  "initial_state": {
    "dashboard": {
      "name": "Delegation Board",
      "activate": true,
      "tabs": [
        {
          "id": "overview",
          "name": "Overview"
        }
      ],
      "widgets": [
        {
          "origin": "Bench Stark Enterprise",
          "widget_id": "workspace_data_control_center_data_health_feed_status",
          "data_args": {},
          "tab_id": "overview",
          "layout": {
            "x": 0,
            "y": 500,
            "w": 8,
            "h": 4
          }
        }
      ]
    }
  },
  "allowed_tools": [
    "get_workspace_snapshot",
    "assign_tasks_to_agents",
    "add_generative_widget"
  ],
  "success": {
    "required_tool_calls": [
      {
        "tool": "assign_tasks_to_agents"
      }
    ],
    "required_tool_results": [
      {
        "tool": "assign_tasks_to_agents",
        "data_contains": [
          "stress-analyst",
          "limits-analyst"
        ]
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "stress analyst",
          "limits analyst",
          "risk review"
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 0
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "required_widgets": [
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "workspace_data_control_center_data_health_feed_status",
        "data_args": {},
        "tab_id": "overview",
        "min_count": 1,
        "max_count": 1
      }
    ]
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_snapshot",
      "args": {}
    },
    {
      "tool": "assign_tasks_to_agents",
      "args": {
        "task_requests": [
          {
            "id": "stress-analyst",
            "description": "Run historical stress scenarios and summarize losses.",
            "assigned_holder_url": "workspace://agents/stress",
            "assigned_agent_id": "stress-agent"
          },
          {
            "id": "limits-analyst",
            "description": "Review limit utilization and current breaches.",
            "assigned_holder_url": "workspace://agents/limits",
            "assigned_agent_id": "limits-agent"
          }
        ]
      }
    },
    {
      "tool": "add_generative_widget",
      "args": {
        "widget_type": "note",
        "name": "Delegation Note",
        "data": "stress analyst; limits analyst; risk review."
      }
    }
  ],
  "limits": {
    "max_turns": 6
  }
}
