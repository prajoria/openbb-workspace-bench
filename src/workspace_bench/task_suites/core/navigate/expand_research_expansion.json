{
  "id": "expand_research_expansion",
  "category": "single-widget",
  "family": "navigate",
  "difficulty": "medium",
  "split": "train",
  "prompt": "Rename the active dashboard to Research Command Center, add a new tab named Draft Reviews, and add a HTML card on the new tab that mentions draft reviews and says items are pending.",
  "fixtures": {
    "backends": [
      {
        "name": "stark-enterprise"
      }
    ]
  },
  "initial_state": {
    "dashboard": {
      "name": "Research Board",
      "activate": true,
      "tabs": [
        {
          "id": "overview",
          "name": "Overview"
        }
      ],
      "widgets": [
        {
          "origin": "Bench Stark Enterprise",
          "widget_id": "stress_liquidity_lab_stress_tests_historical_shocks",
          "data_args": {},
          "tab_id": "overview",
          "layout": {
            "x": 0,
            "y": 500,
            "w": 8,
            "h": 4
          }
        }
      ]
    }
  },
  "allowed_tools": [
    "get_workspace_snapshot",
    "manage_dashboard",
    "manage_navigation_bar",
    "navigate_workspace",
    "add_generative_widget"
  ],
  "success": {
    "required_dashboard_name_contains": "Research Command Center",
    "required_tabs": [
      "overview",
      "draft-reviews"
    ],
    "required_generated_widgets": [
      {
        "widget_type": "html",
        "data_contains": [
          "draft reviews",
          "pending"
        ],
        "tab_id": "draft-reviews"
      }
    ],
    "required_tool_calls": [
      {
        "tool": "manage_navigation_bar",
        "args_contains": {
          "operation": "add_tabs"
        }
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 0
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "required_widgets": [
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "stress_liquidity_lab_stress_tests_historical_shocks",
        "data_args": {},
        "tab_id": "overview",
        "min_count": 1,
        "max_count": 1
      }
    ]
  },
  "oracle_tool_calls": [
    {
      "tool": "manage_dashboard",
      "args": {
        "operation": "update",
        "dashboard_id": "dash_001",
        "name": "Research Command Center"
      }
    },
    {
      "tool": "manage_navigation_bar",
      "args": {
        "operation": "add_tabs",
        "tabs": [
          {
            "name": "Draft Reviews"
          }
        ]
      }
    },
    {
      "tool": "navigate_workspace",
      "args": {
        "operation": "tab",
        "tab_id": "draft-reviews"
      }
    },
    {
      "tool": "add_generative_widget",
      "args": {
        "widget_type": "html",
        "name": "Tab Note",
        "data": "<section>Tracking draft reviews: items are pending review.</section>"
      }
    }
  ],
  "limits": {
    "max_turns": 7
  }
}
