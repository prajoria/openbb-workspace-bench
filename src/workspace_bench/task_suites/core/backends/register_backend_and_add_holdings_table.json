  "oracle_tool_calls": [
    {
      "tool": "manage_backends",
      "args": {
        "operation": "add",
        "name": "portfolio"
      }
    },
    {
      "tool": "manage_backends",
      "args": {
        "operation": "list"
      }
    },
    {
      "tool": "list_available_widgets",
