{
  "id": "register_backend_and_add_holdings_table",
  "category": "dashboard",
  "family": "backends",
  "difficulty": "medium",
  "split": "train",
  "prompt": "Call manage_backends with operation add and name portfolio to register Bench Portfolio; then discover holdings_table, fetch its schema, and add Bench Portfolio/holdings_table to the active dashboard.",
  "fixtures": {
    "backends": []
  },
  "initial_state": {
    "dashboard": {
      "name": "Backend Build",
      "activate": true,
      "tabs": [
        {
          "id": "",
          "name": ""
        }
      ]
    }
  },
  "allowed_tools": [
    "manage_backends",
    "get_workspace_snapshot",
    "list_available_widgets",
    "get_widget_schema",
    "create_widget"
  ],
  "success": {
    "required_widgets": [
      {
        "origin": "Bench Portfolio",
        "widget_id": "holdings_table",
        "data_args": {}
      }
    ],
    "required_tool_calls": [
      {
        "tool": "manage_backends",
        "args_contains": {
          "operation": "add"
        }
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "portfolio__holdings_table",
