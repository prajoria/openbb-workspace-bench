{
  "id": "cross_portfolio_sector",
  "category": "dashboard",
  "family": "params",
  "difficulty": "hard",
  "split": "validation",
  "prompt": "Build a two-widget dashboard using parameter options for both widgets: Bench Portfolio/sector_exposure sector=Technology; Bench Macro/macro_timeseries series=CPIAUCSL. Add a note mentioning Technology and CPIAUCSL.",
  "fixtures": {
    "backends": [
      {
        "name": "macro"
      },
      {
        "name": "portfolio"
      }
    ]
  },
  "initial_state": {
    "dashboard": {
      "name": "Cross Options",
      "activate": true,
      "tabs": [
        {
          "id": "",
          "name": ""
        }
      ]
    }
  },
  "allowed_tools": [
    "get_workspace_snapshot",
    "list_available_widgets",
    "get_widget_schema",
    "get_params_options",
    "create_widget",
    "add_generative_widget"
  ],
  "success": {
    "required_widgets": [
      {
        "origin": "Bench Portfolio",
        "widget_id": "sector_exposure",
        "data_args": {
          "sector": "Technology"
        }
      },
      {
        "origin": "Bench Macro",
        "widget_id": "macro_timeseries",
        "data_args": {
          "series": "CPIAUCSL"
        }
      }
    ],
    "required_tool_calls": [
      {
        "tool": "get_params_options",
        "args_contains": {
          "widget_id": "sector_exposure",
          "param_name": "sector"
        }
      },
      {
        "tool": "get_params_options",
        "args_contains": {
          "widget_id": "macro_timeseries",
          "param_name": "series"
        }
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "Technology",
          "CPIAUCSL"
        ]
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_snapshot",
      "args": {}
    },
    {
      "tool": "list_available_widgets",
      "args": {
        "origin": "Bench Portfolio"
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Bench Portfolio",
        "widget_id": "sector_exposure"
      }
    },
    {
      "tool": "get_params_options",
      "args": {
        "origin": "Bench Portfolio",
        "widget_id": "sector_exposure",
        "param_name": "sector"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Bench Portfolio",
        "widget_id": "sector_exposure",
        "data_args": {
          "sector": "Technology"
        }
      }
    },
    {
      "tool": "list_available_widgets",
      "args": {
        "origin": "Bench Macro"
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Bench Macro",
        "widget_id": "macro_timeseries"
      }
    },
    {
      "tool": "get_params_options",
      "args": {
        "origin": "Bench Macro",
        "widget_id": "macro_timeseries",
        "param_name": "series"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Bench Macro",
        "widget_id": "macro_timeseries",
        "data_args": {
          "series": "CPIAUCSL"
        }
      }
    },
    {
      "tool": "add_generative_widget",
      "args": {
        "widget_type": "note",
        "name": "Options Note",
        "data": "Options used: Technology, CPIAUCSL."
      }
    }
  ],
  "limits": {
    "max_turns": 12
  }
}
