{
  "id": "extend_portfolio_command_center",
  "category": "platform",
  "family": "apps",
  "difficulty": "medium",
  "split": "train",
  "prompt": "From the Bench Stark Enterprise backend, instantiate the Portfolio Command Center app as a new dashboard named PM Command Post. Then add the Sector Exposure widget (id portfolio_command_center_holdings_sector_exposure) to the Holdings tab of the new dashboard.",
  "fixtures": {
    "backends": [
      {
        "name": "stark-enterprise"
      }
    ]
  },
  "initial_state": {},
  "allowed_tools": [
    "get_workspace_snapshot",
    "manage_backends",
    "manage_apps",
    "navigate_workspace",
    "list_available_widgets",
    "get_widget_schema",
    "create_widget"
  ],
  "success": {
    "required_dashboard_name_contains": "PM Command Post",
    "required_tabs": [
      "overview",
      "actions",
      "attribution",
      "holdings"
    ],
    "required_widgets": [
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "portfolio_command_center_actions_trade_ideas",
        "tab_id": "actions",
        "min_count": 1
      },
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "portfolio_command_center_attribution_brinson_attribution",
        "tab_id": "attribution",
        "min_count": 1
      },
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "portfolio_command_center_holdings_sector_exposure",
        "tab_id": "holdings",
        "min_count": 1
      }
    ],
    "layout": {
      "within_grid": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "manage_backends",
      "args": {
        "operation": "list"
      }
    },
    {
      "tool": "manage_apps",
      "args": {
        "operation": "instantiate",
        "backend_id": "backend_001",
        "app_name": "Portfolio Command Center",
        "dashboard_name": "PM Command Post",
        "activate": true
      }
    },
    {
      "tool": "navigate_workspace",
      "args": {
        "operation": "tab",
        "tab_id": "holdings"
      }
    },
    {
      "tool": "list_available_widgets",
      "args": {
        "origin": "Bench Stark Enterprise"
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Bench Stark Enterprise",
        "widget_id": "portfolio_command_center_holdings_sector_exposure"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Bench Stark Enterprise",
        "widget_id": "portfolio_command_center_holdings_sector_exposure",
        "data_args": {}
      }
    }
  ],
  "limits": {
    "max_turns": 9
  }
}
