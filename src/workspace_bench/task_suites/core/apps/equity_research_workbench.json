{
  "id": "equity_research_workbench",
  "category": "platform",
  "family": "apps",
  "difficulty": "easy",
  "split": "validation",
  "prompt": "From the Bench Stark Enterprise backend, instantiate the Equity Research Workbench app as a new dashboard named Coverage Workbench.",
  "fixtures": {
    "backends": [
      {
        "name": "stark-enterprise"
      }
    ]
  },
  "initial_state": {},
  "allowed_tools": [
    "get_workspace_snapshot",
    "manage_backends",
    "manage_apps",
    "navigate_workspace"
  ],
  "success": {
    "required_dashboard_name_contains": "Coverage Workbench",
    "required_tabs": [
      "overview",
      "company",
      "coverage"
    ],
    "required_widgets": [
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "equity_research_workbench_company_company_tear_sheet",
        "tab_id": "company",
        "min_count": 1
      },
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "equity_research_workbench_coverage_coverage_universe",
        "tab_id": "coverage",
        "min_count": 1
      }
    ],
    "layout": {
      "within_grid": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "manage_backends",
      "args": {
        "operation": "list"
      }
    },
    {
      "tool": "manage_apps",
      "args": {
        "operation": "instantiate",
        "backend_id": "backend_001",
        "app_name": "Equity Research Workbench",
        "dashboard_name": "Coverage Workbench",
        "activate": true
      }
    }
  ],
  "limits": {
    "max_turns": 5
  }
}
