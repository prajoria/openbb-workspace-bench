{
  "id": "session_tab_estimates_estimate_history",
  "category": "dashboard",
  "family": "prompts",
  "difficulty": "medium",
  "split": "train",
  "prompt": "Get workspace_session_context, add a Estimates tab, navigate to it, fetch the widget schema, create Bench Equities/estimate_history with data_args {\"symbol\": \"MSFT\"} there, and add a note mentioning Estimates on that tab.",
  "fixtures": {
    "backends": [
      {
        "name": "equities"
      }
    ]
  },
  "initial_state": {
    "dashboard": {
      "name": "Prompt Session",
      "activate": true,
      "tabs": [
        {
          "id": "overview",
          "name": "Overview"
        }
      ]
    }
  },
  "allowed_tools": [
    "get_workspace_prompt",
    "manage_navigation_bar",
    "navigate_workspace",
    "list_available_widgets",
    "get_widget_schema",
    "create_widget",
    "add_generative_widget"
  ],
  "success": {
    "required_tabs": [
      "overview",
      "estimates"
    ],
    "required_tool_results": [
      {
        "tool": "get_workspace_prompt",
        "data_contains": [
          "current-dashboard current-tab session grounding"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Bench Equities",
        "widget_id": "estimate_history",
        "data_args": {
          "symbol": "MSFT"
        },
        "tab_id": "estimates"
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "Estimates"
        ],
        "tab_id": "estimates"
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_prompt",
      "args": {
        "name": "workspace_session_context"
      }
    },
    {
      "tool": "manage_navigation_bar",
      "args": {
        "operation": "add_tabs",
        "tabs": [
          {
            "name": "Estimates"
          }
        ]
      }
    },
    {
      "tool": "navigate_workspace",
      "args": {
        "operation": "tab",
        "tab_id": "estimates"
      }
    },
    {
      "tool": "list_available_widgets",
      "args": {
        "origin": "Bench Equities"
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Bench Equities",
        "widget_id": "estimate_history"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Bench Equities",
        "widget_id": "estimate_history",
        "data_args": {
          "symbol": "MSFT"
        }
      }
    },
    {
      "tool": "add_generative_widget",
      "args": {
        "widget_type": "note",
        "name": "Session Prompt Note",
        "data": "Estimates built using current tab guidance."
      }
    }
  ],
  "limits": {
    "max_turns": 10
  }
}
