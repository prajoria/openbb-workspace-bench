{
  "id": "dashboard_macro_prompt_dashboard",
  "category": "dashboard",
  "family": "prompts",
  "difficulty": "medium",
  "split": "train",
  "prompt": "After fetching workspace_tool_usage, create dashboard Macro Prompt Dashboard, add Bench Macro/macro_timeseries with data_args {\"series\": \"DGS2\"} and Bench Macro/yield_curve with schema-first discipline, and add a note mentioning DGS2 and schema.",
  "fixtures": {
    "backends": [
      {
        "name": "macro"
      }
    ]
  },
  "initial_state": {},
  "allowed_tools": [
    "get_workspace_prompt",
    "manage_dashboard",
    "list_available_widgets",
    "get_widget_schema",
    "create_widget",
    "add_generative_widget"
  ],
  "success": {
    "required_dashboard_name_contains": "Macro Prompt Dashboard",
    "required_tool_results": [
      {
        "tool": "get_workspace_prompt",
        "data_contains": [
          "schema-before-create workspace tool discipline"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Bench Macro",
        "widget_id": "macro_timeseries",
        "data_args": {
          "series": "DGS2"
        }
      },
      {
        "origin": "Bench Macro",
        "widget_id": "yield_curve",
        "data_args": {}
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "DGS2",
          "schema"
        ]
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_prompt",
      "args": {
        "name": "workspace_tool_usage"
      }
    },
    {
      "tool": "manage_dashboard",
      "args": {
        "operation": "create",
        "name": "Macro Prompt Dashboard"
      }
    },
    {
      "tool": "list_available_widgets",
      "args": {
        "origin": "Bench Macro"
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Bench Macro",
        "widget_id": "macro_timeseries"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Bench Macro",
        "widget_id": "macro_timeseries",
        "data_args": {
          "series": "DGS2"
        }
      }
    },
    {
      "tool": "list_available_widgets",
      "args": {
        "origin": "Bench Macro"
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Bench Macro",
        "widget_id": "yield_curve"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Bench Macro",
        "widget_id": "yield_curve",
        "data_args": {}
      }
    },
    {
      "tool": "add_generative_widget",
      "args": {
        "widget_type": "note",
        "name": "Prompt Build Note",
        "data": "Prompt build used DGS2 and schema."
      }
    }
  ],
  "limits": {
    "max_turns": 12
  }
}
