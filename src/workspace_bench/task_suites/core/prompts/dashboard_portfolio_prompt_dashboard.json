{
  "id": "dashboard_portfolio_prompt_dashboard",
  "category": "dashboard",
  "family": "prompts",
  "difficulty": "hard",
  "split": "validation",
  "prompt": "After fetching workspace_tool_usage, create dashboard Portfolio Prompt Dashboard, add Bench Portfolio/holdings_table and Bench Portfolio/risk_metrics with schema-first discipline, and add a note mentioning holdings and schema.",
  "fixtures": {
    "backends": [
      {
        "name": "portfolio"
      }
    ]
  },
  "initial_state": {},
  "allowed_tools": [
    "get_workspace_prompt",
    "manage_dashboard",
    "list_available_widgets",
    "get_widget_schema",
    "create_widget",
    "add_generative_widget"
  ],
  "success": {
    "required_dashboard_name_contains": "Portfolio Prompt Dashboard",
    "required_tool_results": [
      {
        "tool": "get_workspace_prompt",
        "data_contains": [
          "schema-before-create workspace tool discipline"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Bench Portfolio",
        "widget_id": "holdings_table",
        "data_args": {}
      },
      {
        "origin": "Bench Portfolio",
        "widget_id": "risk_metrics",
        "data_args": {}
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "holdings",
          "schema"
        ]
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_prompt",
      "args": {
        "name": "workspace_tool_usage"
      }
    },
    {
      "tool": "manage_dashboard",
      "args": {
        "operation": "create",
        "name": "Portfolio Prompt Dashboard"
      }
    },
    {
      "tool": "list_available_widgets",
      "args": {
        "origin": "Bench Portfolio"
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Bench Portfolio",
        "widget_id": "holdings_table"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Bench Portfolio",
        "widget_id": "holdings_table",
        "data_args": {}
      }
    },
    {
      "tool": "list_available_widgets",
      "args": {
        "origin": "Bench Portfolio"
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Bench Portfolio",
        "widget_id": "risk_metrics"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Bench Portfolio",
        "widget_id": "risk_metrics",
        "data_args": {}
      }
    },
    {
      "tool": "add_generative_widget",
      "args": {
        "widget_type": "note",
        "name": "Prompt Build Note",
        "data": "Prompt build used holdings and schema."
      }
    }
  ],
  "limits": {
    "max_turns": 12
  }
}
