{
  "id": "follow_tool_usage_prompt_for_price_performance",
  "category": "dashboard",
  "family": "prompts",
  "difficulty": "easy",
  "split": "validation",
  "prompt": "Call get_workspace_prompt with name workspace_tool_usage, then follow it by discovering schema before creating Bench Equities/price_performance with data_args {\"symbol\": \"AAPL\"}.",
  "fixtures": {
    "backends": [
      {
        "name": "equities"
      }
    ]
  },
  "initial_state": {
    "dashboard": {
      "name": "Prompt Build",
      "activate": true,
      "tabs": [
        {
          "id": "",
          "name": ""
        }
      ]
    }
  },
  "allowed_tools": [
    "get_workspace_snapshot",
    "get_workspace_prompt",
    "list_available_widgets",
    "get_widget_schema",
    "create_widget"
  ],
  "success": {
    "required_tool_results": [
      {
        "tool": "get_workspace_prompt",
        "data_contains": [
          "schema-before-create workspace tool discipline"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Bench Equities",
        "widget_id": "price_performance",
        "data_args": {
          "symbol": "AAPL"
        }
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_snapshot",
      "args": {}
    },
    {
      "tool": "get_workspace_prompt",
      "args": {
        "name": "workspace_tool_usage"
      }
    },
    {
      "tool": "list_available_widgets",
      "args": {
        "origin": "Bench Equities"
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Bench Equities",
        "widget_id": "price_performance"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Bench Equities",
        "widget_id": "price_performance",
        "data_args": {
          "symbol": "AAPL"
        }
      }
    }
  ],
  "limits": {
    "max_turns": 8
  }
}
