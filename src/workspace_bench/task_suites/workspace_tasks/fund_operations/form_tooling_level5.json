{
  "id": "form_tooling_level5",
  "difficulty": "level5",
  "prompt": "Build the intake service before cutoff: add an Intake Form Service backend serving an Intake Register table, publish Intake Controls App with Intake Register on its Register tab, and instantiate the app. On the open Intake Tools dashboard, add the built Intake Register plus Financial Entry Form and Example Backend Params from Widget Examples, with daysPicker1 set to 5 and the tester's other parameters left at their defaults; keep everything already on the dashboard exactly as it is. Under the widgets.json spec's Widget Parameters resource, leave an Intake Tooling Governance Note recording the parameter kind its list names between endpoint and button.",
  "setup": {
    "workspace_baseline": "stark-workspace-a",
    "workspace_backends": [
      "stark-enterprise-x",
      "support-daloopa-skills",
      "getting-started",
      "widget-examples"
    ],
    "workspace_skills": [
      "daloopa-capital-allocation",
      "daloopa-earnings-review",
      "daloopa-guidance-tracker",
      "daloopa-industry",
      "daloopa-inflection",
      "daloopa-tearsheet",
      "finance-comps",
      "finance-earnings-prep",
      "finance-guidance-tracker",
      "finance-tearsheet"
    ],
    "default_selected_dashboard": "Intake Tools",
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ],
    "initial_state": {
      "dashboard": {
        "name": "Intake Tools",
        "activate": false,
        "tabs": [
          {
            "id": "intake",
            "name": "Intake"
          }
        ],
        "widgets": [
          {
            "origin": "Widget Examples",
            "widget_id": "show_example_params",
            "widget_uuid": "seeded_month_end_params",
            "tab_id": "intake",
            "data_args": {
              "datePicker1": "$currentDate-1d",
              "textBox1": "Hello!",
              "textBox2": "var1,var2,var3",
              "TrueFalse": true,
              "daysPicker1": "10"
            },
            "layout": {
              "x": 0,
              "y": 0,
              "w": 20,
              "h": 9
            }
          }
        ],
        "generated_widgets": [
          {
            "widget_type": "note",
            "widget_uuid": "seeded_prior_intake_note",
            "name": "Prior Intake Check",
            "data": "Prior intake check: the month-end exception batch stays on its existing review window.",
            "tab_id": "intake",
            "layout": {
              "x": 20,
              "y": 0,
              "w": 20,
              "h": 8
            }
          }
        ]
      }
    }
  },
  "eval": {
    "required_tools": [
      {
        "tool": "get_workspace_snapshot",
        "args": {},
        "optional": true
      },
      {
        "tool": "read_workspace_resource",
        "args": {
          "uri": "openbb://workspace/specs/widget-parameters"
        },
        "graded_args": [
          "uri"
        ]
      },
      {
        "tool": "read_workspace_resource",
        "args": {
          "uri": "openbb://workspace/specs/widgets-json"
        },
        "optional": true
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Intake Form Service",
          "url": "http://127.0.0.1:9718",
          "widgets_json": {
            "intake_register": {
              "name": "Intake Register",
              "description": "Authored register for operational intake submissions.",
              "endpoint": "/intake-register",
              "type": "table",
              "gridData": {
                "w": 40,
                "h": 10
              }
            }
          },
          "apps_json": [
            {
              "name": "Intake Controls App",
              "description": "Authored app for the operations intake register.",
              "tabs": {
                "register": {
                  "id": "register",
                  "name": "Register",
                  "layout": [
                    {
                      "i": "intake_register",
                      "x": 0,
                      "y": 0,
                      "w": 40,
                      "h": 10
                    }
                  ]
                }
              }
            }
          ]
        },
        "graded_args": [
          "operation",
          "name"
        ]
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "list",
          "backend_id": "backend_005"
        },
        "optional": true
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Intake Form Service"
        },
        "optional": true
      },
      {
        "tool": "get_widget_schema",
        "args": {
          "origin": "Intake Form Service",
          "widget_id": "intake_register"
        },
        "optional": true
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Intake Form Service",
          "widget_id": "intake_register"
        },
        "graded_args": [
          "origin",
          "widget_id"
        ]
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Widget Examples"
        },
        "optional": true
      },
      {
        "tool": "get_widget_schema",
        "args": {
          "origin": "Widget Examples",
          "widget_id": "form_submit_widget"
        },
        "optional": true
      },
      {
        "tool": "get_widget_schema",
        "args": {
          "origin": "Widget Examples",
          "widget_id": "show_example_params"
        },
        "optional": true
      },
      {
        "tool": "get_params_options",
        "args": {
          "origin": "Widget Examples",
          "widget_id": "show_example_params",
          "param_name": "daysPicker1"
        },
        "optional": true
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Widget Examples",
          "widget_id": "form_submit_widget"
        },
        "graded_args": [
          "origin",
          "widget_id"
        ]
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Widget Examples",
          "widget_id": "show_example_params",
          "data_args": {
            "daysPicker1": "5"
          }
        },
        "graded_args": [
          "origin",
          "widget_id",
          "data_args"
        ]
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Intake Tooling Governance Note",
          "data": "The widgets.json parameter kind named between endpoint and button is form."
        },
        "graded_args": [
          "widget_type"
        ]
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_005",
          "app_name": "Intake Controls App",
          "dashboard_name": "Intake Controls App",
          "activate": false
        },
        "graded_args": [
          "operation"
        ]
      }
    ],
    "required_tabs": [
      "intake"
    ],
    "required_tab_names": [
      "Intake"
    ],
    "required_widgets": [
      {
        "origin": "Intake Form Service",
        "widget_id": "intake_register",
        "tab_id": "intake"
      },
      {
        "origin": "Widget Examples",
        "widget_id": "form_submit_widget",
        "tab_id": "intake"
      },
      {
        "origin": "Widget Examples",
        "widget_id": "show_example_params",
        "data_args": {
          "daysPicker1": "5"
        },
        "tab_id": "intake"
      },
      {
        "origin": "Widget Examples",
        "widget_id": "show_example_params",
        "data_args": {
          "datePicker1": "$currentDate-1d",
          "textBox1": "Hello!",
          "textBox2": "var1,var2,var3",
          "TrueFalse": true,
          "daysPicker1": "10"
        },
        "tab_id": "intake",
        "max_count": 1
      }
    ],
    "required_widget_defs": [
      {
        "backend_name": "Intake Form Service",
        "widget_id": "intake_register",
        "expect": {
          "name": "Intake Register",
          "type": "table"
        }
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Intake Form Service",
        "name_contains": "Intake Controls App",
        "tabs_include": [
          "register"
        ],
        "layout_refs_valid": true,
        "no_overlaps": true,
        "widgets_on_tab": [
          {
            "tab_id": "register",
            "widget_id": "intake_register"
          }
        ]
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "name_contains": "Prior Intake Check",
        "data_contains": [
          "Prior intake check: the month-end exception batch stays on its existing review window."
        ],
        "tab_id": "intake"
      },
      {
        "widget_type": "note",
        "name_contains": "Intake Tooling Governance Note",
        "data_contains": [
          "form"
        ],
        "tab_id": "intake"
      }
    ],
    "required_layouts": [
      {
        "widget_uuid": "seeded_month_end_params",
        "tab_id": "intake",
        "x": 0,
        "y": 0,
        "w": 20,
        "h": 9
      },
      {
        "widget_uuid": "seeded_prior_intake_note",
        "tab_id": "intake",
