                    {
                      "i": "handoff_register",
                      "x": 0,
                      "y": 0,
                      "w": 40,
                      "h": 10
                    }
                  ]
                }
              }
            }
          ]
        },
        "graded_args": [
          "operation",
          "name"
        ]
