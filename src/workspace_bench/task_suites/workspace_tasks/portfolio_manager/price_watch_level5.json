{
  "id": "price_watch_level5",
  "difficulty": "level5",
  "prompt": "Build the desk's watch feed before the open: add a Watch Feed Service backend serving a Watch Register table, publish Watch Feed App with Watch Register on its Watch tab, and instantiate the app. On the open Price Watch dashboard, add the built Watch Register and a fresh Live Grid from Getting Started with symbol set to TSLA, keeping everything already there as is. Read the Finance Tearsheet skill and leave a Price Watch Governance note recording what its final step says to close with.",
  "setup": {
    "workspace_baseline": "stark-workspace-a",
    "workspace_backends": [
      "stark-enterprise-x",
      "support-daloopa-skills",
      "getting-started",
      "widget-examples"
    ],
    "workspace_skills": [
      "daloopa-capital-allocation",
      "daloopa-earnings-review",
      "daloopa-guidance-tracker",
      "daloopa-industry",
      "daloopa-inflection",
      "daloopa-tearsheet",
      "finance-comps",
      "finance-earnings-prep",
      "finance-guidance-tracker",
      "finance-tearsheet"
    ],
    "default_selected_dashboard": "Price Watch",
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ],
    "initial_state": {
      "dashboard": {
        "name": "Price Watch",
        "activate": false,
        "tabs": [
          {
            "id": "watch",
            "name": "Watch"
          }
        ],
        "widgets": [
          {
            "origin": "Getting Started",
            "widget_id": "live_grid_data",
            "widget_uuid": "seeded_live_grid_decoy",
            "tab_id": "watch",
            "data_args": {
              "symbol": "MSFT"
            },
            "layout": {
              "x": 0,
              "y": 0,
              "w": 20,
              "h": 9
            }
          },
          {
            "origin": "Getting Started",
            "widget_id": "sparkline_line",
            "widget_uuid": "seeded_sparkline_trends",
            "tab_id": "watch",
            "layout": {
              "x": 20,
              "y": 0,
              "w": 20,
              "h": 10
            }
          }
        ],
        "generated_widgets": [
          {
            "widget_type": "note",
            "widget_uuid": "seeded_watch_handoff_note",
            "name": "Watch Handoff Note",
            "data": "Prior session: the desk was watching MSFT into the print.",
            "tab_id": "watch",
            "layout": {
              "x": 0,
              "y": 10,
              "w": 20,
              "h": 8
            }
          }
        ]
      }
    }
  },
  "eval": {
    "required_tools": [
      {
        "tool": "get_workspace_snapshot",
        "args": {},
        "optional": true
      },
      {
        "tool": "get_skill_content",
        "args": {
          "slug": "finance-tearsheet"
        },
        "graded_args": [
          "slug"
        ]
      },
      {
        "tool": "read_workspace_resource",
        "args": {
          "uri": "openbb://workspace/specs/widgets-json"
        },
        "optional": true
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Watch Feed Service",
          "url": "http://127.0.0.1:9714",
          "widgets_json": {
            "watch_register": {
              "name": "Watch Register",
              "description": "Authored register of the names the desk is watching.",
              "endpoint": "/watch-register",
              "type": "table",
              "gridData": {
                "w": 40,
                "h": 10
              }
            }
          },
          "apps_json": [
            {
              "name": "Watch Feed App",
              "description": "Authored app for the desk's watch feed.",
              "tabs": {
                "watch": {
                  "id": "watch",
                  "name": "Watch",
                  "layout": [
                    {
                      "i": "watch_register",
                      "x": 0,
                      "y": 0,
                      "w": 40,
                      "h": 10
                    }
                  ]
                }
              }
            }
          ]
        },
        "graded_args": [
          "operation",
          "name"
        ]
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "list",
          "backend_id": "backend_005"
        },
        "optional": true
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_005",
          "app_name": "Watch Feed App",
          "dashboard_name": "Watch Feed App",
          "activate": false
        },
        "graded_args": [
          "operation",
          "app_name"
        ]
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Watch Feed Service"
        },
        "optional": true
      },
      {
        "tool": "get_params_options",
        "args": {
          "origin": "Getting Started",
          "widget_id": "live_grid_data",
          "param_name": "symbol"
        },
        "optional": true
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Watch Feed Service",
          "widget_id": "watch_register"
        },
        "graded_args": [
          "origin",
          "widget_id"
        ]
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Getting Started"
        },
        "optional": true
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Getting Started",
          "widget_id": "live_grid_data",
          "data_args": {
            "symbol": "TSLA"
          }
        },
        "graded_args": [
          "origin",
          "data_args"
        ]
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Price Watch Governance",
          "data": "Per the Finance Tearsheet skill, close with a short investment conclusion a reader could act on."
        },
        "graded_args": [
          "widget_type",
          "name"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Watch Feed Service",
        "widget_id": "watch_register",
        "tab_id": "watch"
      },
      {
        "origin": "Getting Started",
        "widget_id": "live_grid_data",
        "data_args": {
          "symbol": "TSLA"
        },
        "tab_id": "watch"
      },
      {
        "origin": "Getting Started",
        "widget_id": "live_grid_data",
        "data_args": {
          "symbol": "MSFT"
        },
        "tab_id": "watch",
        "max_count": 1
      },
      {
        "origin": "Getting Started",
        "widget_id": "sparkline_line",
        "tab_id": "watch",
        "max_count": 1
      }
    ],
    "required_tabs": [
      "watch"
    ],
    "required_tab_names": [
      "Watch"
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "name_contains": "Watch Handoff Note",
        "data_contains": [
          "Prior session: the desk was watching MSFT into the print."
        ],
        "tab_id": "watch"
      },
      {
        "widget_type": "note",
        "name_contains": "Price Watch Governance",
        "data_contains": [
          "investment conclusion"
        ],
        "tab_id": "watch"
      }
    ],
    "required_layouts": [
      {
        "widget_uuid": "seeded_live_grid_decoy",
        "tab_id": "watch",
        "x": 0,
        "y": 0,
        "w": 20,
        "h": 9
      },
      {
        "widget_uuid": "seeded_sparkline_trends",
        "tab_id": "watch",
        "x": 20,
        "y": 0,
        "w": 20,
        "h": 10
      },
      {
        "widget_uuid": "seeded_watch_handoff_note",
        "tab_id": "watch",
        "x": 0,
        "y": 10,
        "w": 20,
        "h": 8
      }
    ],
    "required_widget_defs": [
      {
        "backend_name": "Watch Feed Service",
        "widget_id": "watch_register",
        "expect": {
          "name": "Watch Register",
          "type": "table"
        }
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Watch Feed Service",
        "name_contains": "Watch Feed App",
        "tabs_include": [
          "watch"
        ],
        "layout_refs_valid": true,
        "no_overlaps": true
      }
    ],
    "required_dashboard_name_contains": "Price Watch",
    "max_turns": 15
  }
}
