{
  "id": "morning_briefing_level5",
  "difficulty": "level5",
  "prompt": "Stand up the desk's own briefing feed before the 9am call: add a backend named Briefing Feed Service serving an Idea Register table, and put Idea Register on the open PM Morning Briefing dashboard alongside Trade Ideas from Bench Stark Enterprise's Portfolio Command Center for Flagship Long/Short, QTD. Briefings run under the Daloopa Capital Allocation skill - leave a Morning Briefing Governance note recording what its final step says every figure is cited via. Everything already on the dashboard stays.",
  "setup": {
    "workspace_baseline": "stark-workspace-a",
    "workspace_backends": [
      "stark-enterprise-x",
      "support-daloopa-skills",
      "getting-started",
      "widget-examples"
    ],
    "workspace_skills": [
      "daloopa-capital-allocation",
      "daloopa-earnings-review",
      "daloopa-guidance-tracker",
      "daloopa-industry",
      "daloopa-inflection",
      "daloopa-tearsheet",
      "finance-comps",
      "finance-earnings-prep",
      "finance-guidance-tracker",
      "finance-tearsheet"
    ],
    "default_selected_dashboard": "PM Morning Briefing",
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ],
    "initial_state": {
      "dashboard": {
        "name": "PM Morning Briefing",
        "activate": false,
        "tabs": [
          {
            "id": "briefing",
            "name": "Briefing"
          }
        ],
        "widgets": [
          {
            "origin": "Bench Stark Enterprise",
            "widget_id": "portfolio_command_center_overview_top_alerts",
            "widget_uuid": "seeded_top_alerts",
            "tab_id": "briefing",
            "data_args": {
              "fund": "Flagship Long/Short",
              "period": "1D"
            },
            "layout": {
              "x": 0,
              "y": 0,
              "w": 20,
              "h": 14
            }
          }
        ],
        "generated_widgets": [
          {
            "widget_type": "note",
            "widget_uuid": "seeded_last_week_note",
            "name": "Last Week Briefing Note",
            "data": "Last week's briefing: watch Income Fund redemptions into month-end.",
            "tab_id": "briefing",
            "layout": {
              "x": 20,
              "y": 0,
              "w": 20,
              "h": 8
            }
          }
        ]
      }
    }
  },
  "eval": {
    "required_tools": [
      {
        "tool": "get_skill_content",
        "args": {
          "slug": "daloopa-capital-allocation"
        },
        "graded_args": [
          "slug"
        ]
      },
      {
        "tool": "get_workspace_snapshot",
        "args": {},
        "optional": true
      },
      {
        "tool": "read_workspace_resource",
        "args": {
          "uri": "openbb://workspace/specs/widgets-json"
        },
        "optional": true
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Briefing Feed Service",
          "url": "http://127.0.0.1:9713",
          "widgets_json": {
            "idea_register": {
              "name": "Idea Register",
              "description": "Authored register of the desk's briefing ideas.",
              "endpoint": "/idea-register",
              "type": "table",
              "gridData": {
                "w": 40,
                "h": 10
              }
            }
          }
        },
        "graded_args": [
          "operation",
          "name"
        ]
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Briefing Feed Service"
        },
        "optional": true
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Briefing Feed Service",
          "widget_id": "idea_register"
        },
        "graded_args": [
          "origin",
          "widget_id"
        ]
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Bench Stark Enterprise"
        },
        "optional": true
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Bench Stark Enterprise",
          "widget_id": "portfolio_command_center_actions_trade_ideas",
          "data_args": {
            "fund": "Flagship Long/Short",
            "period": "QTD"
          }
        },
        "graded_args": [
          "origin",
          "data_args"
        ]
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Morning Briefing Governance",
          "data": "Per the Daloopa Capital Allocation skill, every figure is cited via source_url."
        },
        "graded_args": [
          "widget_type",
          "name"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Briefing Feed Service",
        "widget_id": "idea_register"
      },
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "portfolio_command_center_actions_trade_ideas",
        "data_args": {
          "fund": "Flagship Long/Short",
          "period": "QTD"
        }
      },
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "portfolio_command_center_overview_top_alerts",
        "data_args": {
          "fund": "Flagship Long/Short",
          "period": "1D"
        }
      }
    ],
    "required_widget_defs": [
      {
        "backend_name": "Briefing Feed Service",
        "widget_id": "idea_register",
        "expect": {
          "type": "table"
        }
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "name_contains": "Last Week Briefing Note",
        "data_contains": [
          "Income Fund"
        ]
      },
      {
        "widget_type": "note",
        "name_contains": "Morning Briefing Governance",
        "data_contains": [
          "source_url"
        ]
      }
    ],
    "max_turns": 12
  }
}
