        },
        "optional": true
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Inflection Scan Service",
          "url": "http://127.0.0.1:9717",
          "widgets_json": {
            "reversal_register": {
              "name": "Reversal Register",
