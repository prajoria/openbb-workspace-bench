{
  "id": "case_handoff_level2",
  "difficulty": "level2",
  "prompt": "On the open Case Review dashboard, read Expert Calls from Bench Stark Enterprise's MNPI & Research Review with status In Review, period MTD, and severity set by the escalation policy. Leave a Case Handoff Note recording the returned In Review fund and both exact scores as evidence for the reviewing team.",
  "setup": {
    "workspace_baseline": "stark-workspace-a",
    "workspace_backends": [
      "stark-enterprise-x",
      "support-daloopa-skills",
      "getting-started",
      "widget-examples"
    ],
    "workspace_skills": [
      "daloopa-capital-allocation",
      "daloopa-earnings-review",
      "daloopa-guidance-tracker",
      "daloopa-industry",
      "daloopa-inflection",
      "daloopa-tearsheet",
      "finance-comps",
      "finance-earnings-prep",
      "finance-guidance-tracker",
      "finance-tearsheet"
    ],
    "default_selected_dashboard": "Case Review",
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ],
    "initial_state": {
      "dashboard": {
        "name": "Case Review",
        "activate": false,
        "tabs": [
          {
            "id": "review",
            "name": "Review"
          }
        ],
        "widgets": []
      }
    }
  },
  "eval": {
    "required_tools": [
      {
        "tool": "get_workspace_snapshot",
        "args": {},
        "optional": true
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Bench Stark Enterprise"
        },
        "optional": true
      },
      {
        "tool": "get_params_options",
        "args": {
          "origin": "Bench Stark Enterprise",
          "widget_id": "mnpi_research_review_mnpi_log_expert_calls",
          "param_name": "severity"
        },
        "optional": true
      },
      {
        "tool": "get_widget_data",
        "args": {
          "origin": "Bench Stark Enterprise",
          "widget_id": "mnpi_research_review_mnpi_log_expert_calls",
          "data_args": {
            "status": "In Review",
            "severity": "High",
            "period": "MTD"
          }
        },
        "graded_args": [
          "origin",
          "widget_id",
          "data_args"
        ]
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Case Handoff Note",
          "data": "Expert Calls evidence: the returned In Review fund is Global Opportunities, with exact scores 89.96 and 21.55."
        },
        "graded_args": [
          "widget_type"
        ]
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "name_contains": "Case Handoff Note",
        "data_contains": [
          "Global Opportunities",
          "89.96",
          "21.55"
        ]
      }
    ],
    "required_dashboard_name_contains": "Case Review",
    "max_turns": 8
  }
}
