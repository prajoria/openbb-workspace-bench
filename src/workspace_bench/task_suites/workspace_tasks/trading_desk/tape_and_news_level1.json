{
  "id": "tape_and_news_level1",
  "difficulty": "level1",
  "prompt": "On the open Desk Tape dashboard, read the newswire from Getting Started for business, limited to 3, then leave a Tape Lead Note recording the exact lead title and author.",
  "setup": {
    "workspace_baseline": "stark-workspace-a",
    "workspace_backends": [
      "stark-enterprise-x",
      "support-daloopa-skills",
      "getting-started",
      "widget-examples"
    ],
    "workspace_skills": [
      "daloopa-capital-allocation",
      "daloopa-earnings-review",
      "daloopa-guidance-tracker",
      "daloopa-industry",
      "daloopa-inflection",
      "daloopa-tearsheet",
      "finance-comps",
      "finance-earnings-prep",
      "finance-guidance-tracker",
      "finance-tearsheet"
    ],
    "default_selected_dashboard": "Desk Tape",
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ],
    "initial_state": {
      "dashboard": {
        "name": "Desk Tape",
        "activate": false,
        "tabs": [
          {
            "id": "tape",
            "name": "Tape"
          }
        ],
        "widgets": []
      }
    }
  },
  "eval": {
    "required_tools": [
      {
        "tool": "get_workspace_snapshot",
        "args": {},
        "optional": true
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Getting Started"
        },
        "optional": true
      },
      {
        "tool": "get_widget_schema",
        "args": {
          "origin": "Getting Started",
          "widget_id": "sample_newsfeed"
        },
        "optional": true
      },
      {
        "tool": "get_widget_data",
        "args": {
          "origin": "Getting Started",
          "widget_id": "sample_newsfeed",
          "data_args": {
            "category": "business",
            "limit": 3
          }
        },
        "graded_args": [
          "origin",
          "widget_id",
          "data_args"
        ]
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Tape Lead Note",
          "data": "Lead: Global Markets Rally on Positive Economic Data; author: Robert Williams."
        },
        "graded_args": [
          "widget_type",
          "name"
        ]
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "name_contains": "Tape Lead Note",
        "data_contains": [
          "Global Markets Rally on Positive Economic Data",
          "Robert Williams"
        ]
      }
    ],
    "max_turns": 8
  }
}
