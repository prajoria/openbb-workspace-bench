{
  "id": "due_diligence_media_room_level3",
  "category": "dashboard",
  "difficulty": "level3",
  "prompt": "Media-room level-3 layout: create and open Due Diligence Media Room, add Overview and Review tabs, then add Getting Started's Video Library with Transcript, Getting Started's PDF Widget with URL.",
  "setup": {
    "workspace_baseline": "stark-workspace-a",
    "workspace_backends": [
      "stark-enterprise-x",
      "support-daloopa-skills",
      "getting-started",
      "widget-examples"
    ],
    "workspace_skills": [
      "daloopa-capital-allocation",
      "daloopa-earnings-review",
      "daloopa-guidance-tracker",
      "daloopa-industry",
      "daloopa-inflection",
      "daloopa-tearsheet",
      "finance-comps",
      "finance-earnings-prep",
      "finance-guidance-tracker",
      "finance-tearsheet"
    ],
    "default_selected_dashboard": "Home",
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_tools": [
      {
        "tool": "manage_dashboard",
        "args": {
          "operation": "create",
          "name": "Due Diligence Media Room",
          "activate": true
        },
        "graded_args": [
          "operation",
          "name"
        ]
      },
      {
        "tool": "manage_navigation_bar",
        "args": {
          "operation": "add_tabs",
          "tabs": [
            {
              "name": "Overview"
            },
            {
              "name": "Review"
            }
          ]
        },
        "graded_args": [
          "tabs"
        ]
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Getting Started"
        },
        "optional": true
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Getting Started",
          "widget_id": "get_video_with_transcript"
        },
        "graded_args": [
          "origin",
          "widget_id"
        ]
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Getting Started",
          "widget_id": "pdf_widget_url"
        },
        "graded_args": [
          "origin",
          "widget_id"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Getting Started",
        "widget_id": "get_video_with_transcript"
      },
      {
        "origin": "Getting Started",
        "widget_id": "pdf_widget_url"
      }
    ],
    "required_tabs": [
      "overview",
      "review"
    ],
    "required_dashboard_name_contains": "Due Diligence Media Room",
    "max_turns": 8
  }
}
