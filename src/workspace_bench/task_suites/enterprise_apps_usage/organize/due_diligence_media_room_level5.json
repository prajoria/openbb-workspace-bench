{
  "id": "due_diligence_media_room_level5",
  "category": "platform",
  "difficulty": "level5",
  "prompt": "Buildout Media Room goes live today: add it with a Media Review Register table per the widgets.json spec, publish and instantiate Media Room App on Media, then add Getting Started's PDF Widget with URL and Widget Examples's URL PDF files. Wrap with a Media-room Build Note recording what the Finance Tearsheet skill gathers between valuation and risks.",
  "setup": {
    "workspace_baseline": "stark-workspace-a",
    "workspace_backends": [
      "stark-enterprise-x",
      "support-daloopa-skills",
      "getting-started",
      "widget-examples"
    ],
    "workspace_skills": [
      "daloopa-capital-allocation",
      "daloopa-earnings-review",
      "daloopa-guidance-tracker",
      "daloopa-industry",
      "daloopa-inflection",
      "daloopa-tearsheet",
      "finance-comps",
      "finance-earnings-prep",
      "finance-guidance-tracker",
      "finance-tearsheet"
    ],
    "default_selected_dashboard": "Home",
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_tools": [
      {
        "tool": "get_workspace_snapshot",
        "args": {},
        "optional": true
      },
      {
        "tool": "get_skill_content",
        "args": {
          "slug": "finance-tearsheet"
        },
        "graded_args": [
          "slug"
        ]
      },
      {
        "tool": "read_workspace_resource",
        "args": {
          "uri": "openbb://workspace/specs/widgets-json"
        },
        "optional": true
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Buildout Media Room",
          "url": "http://127.0.0.1:9705",
          "widgets_json": {
            "media_review_register": {
              "name": "Media Review Register",
              "description": "Authored view for Media Review Register.",
              "endpoint": "/media_review_register",
              "type": "table",
              "gridData": {
                "w": 40,
                "h": 10
              }
            }
          },
          "apps_json": [
            {
              "name": "Media Room App",
              "description": "Authored app for Media Room App.",
              "tabs": {
                "media": {
                  "id": "media",
                  "name": "Media",
                  "layout": [
                    {
                      "i": "media_review_register",
                      "x": 0,
                      "y": 0,
                      "w": 40,
                      "h": 10
                    }
                  ]
                }
              }
            }
          ]
        },
        "graded_args": [
          "operation",
          "name"
        ]
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "list"
        },
        "optional": true
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_005",
          "app_name": "Media Room App",
          "dashboard_name": "Media-room Live",
          "activate": true
        },
        "graded_args": [
          "operation"
        ]
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Getting Started"
        },
        "optional": true
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Widget Examples"
        },
        "optional": true
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Getting Started",
          "widget_id": "pdf_widget_url"
        },
        "graded_args": [
          "origin",
          "widget_id"
        ]
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Widget Examples",
          "widget_id": "url_pdf"
        },
        "graded_args": [
          "origin",
          "widget_id"
        ]
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Media-room Build Note",
          "data": "catalysts"
        },
        "graded_args": [
          "widget_type",
          "name"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Buildout Media Room",
        "widget_id": "media_review_register",
        "tab_id": "media"
      },
      {
        "origin": "Getting Started",
        "widget_id": "pdf_widget_url"
      },
      {
        "origin": "Widget Examples",
        "widget_id": "url_pdf"
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "name_contains": "Media-room Build Note",
        "data_contains": [
          "catalysts"
        ]
      }
    ],
    "required_widget_defs": [
      {
        "backend_name": "Buildout Media Room",
        "widget_id": "media_review_register",
        "expect": {
          "type": "table"
        }
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Buildout Media Room",
        "name_contains": "Media Room App",
        "tabs_include": [
          "media"
        ],
        "layout_refs_valid": true,
        "widgets_on_tab": [
          {
            "tab_id": "media",
            "widget_id": "media_review_register"
          }
        ]
      }
    ],
    "max_turns": 14
  }
}
