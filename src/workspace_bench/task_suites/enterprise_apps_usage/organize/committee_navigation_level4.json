{
  "id": "committee_navigation_level4",
  "category": "dashboard",
  "difficulty": "level4",
  "prompt": "Following Workspace session guidance, create and activate Pilot Committee Review with Decision Agenda, Evidence, and Sign-Off tabs in that order, and pin a Committee Session Note naming the two anchors in the guidance's stable session-grounding phrase.",
  "setup": {
    "workspace_baseline": "stark-workspace-a",
    "workspace_backends": [
      "stark-enterprise-x",
      "support-daloopa-skills",
      "getting-started",
      "widget-examples"
    ],
    "workspace_skills": [
      "daloopa-capital-allocation",
      "daloopa-earnings-review",
      "daloopa-guidance-tracker",
      "daloopa-industry",
      "daloopa-inflection",
      "daloopa-tearsheet",
      "finance-comps",
      "finance-earnings-prep",
      "finance-guidance-tracker",
      "finance-tearsheet"
    ],
    "default_selected_dashboard": "Home",
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_tools": [
      {
        "tool": "get_workspace_snapshot",
        "args": {},
        "optional": true
      },
      {
        "tool": "get_workspace_prompt",
        "args": {
          "name": "workspace_session_context"
        },
        "graded_args": [
          "name"
        ]
      },
      {
        "tool": "manage_dashboard",
        "args": {
          "operation": "create",
          "name": "Pilot Committee Review",
          "activate": true
        },
        "graded_args": [
          "operation",
          "name"
        ]
      },
      {
        "tool": "manage_navigation_bar",
        "args": {
          "operation": "create",
          "tabs": [
            {
              "name": "Decision Agenda"
            },
            {
              "name": "Evidence"
            },
            {
              "name": "Sign-Off"
            }
          ]
        },
        "graded_args": [
          "tabs"
        ]
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Committee Session Note",
          "data": "current-dashboard current-tab"
        },
        "graded_args": [
          "widget_type",
          "name"
        ]
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "name_contains": "Committee Session Note",
        "data_contains": [
          "current-dashboard",
          "current-tab"
        ]
      }
    ],
    "max_turns": 8
  }
}
