{
  "id": "client_onboarding_flow_level5",
  "category": "platform",
  "difficulty": "level5",
  "prompt": "Author and add a Client Onboarding Backend with Client Intake Queue and Approval Log table views, then publish and instantiate a Client Onboarding App with Intake and Approvals tabs. Follow the apps manifest specification. Widget ids are the snake_case of widget names; tab ids are the snake_case of tab names.",
  "setup": {
    "workspace_baseline": "stark-workspace-a",
    "workspace_backends": [
      "stark-enterprise-x",
      "support-daloopa-skills",
      "getting-started",
      "widget-examples"
    ],
    "workspace_skills": [
      "daloopa-capital-allocation",
      "daloopa-earnings-review",
      "daloopa-guidance-tracker",
      "daloopa-industry",
      "daloopa-inflection",
      "daloopa-tearsheet",
      "finance-comps",
      "finance-earnings-prep",
      "finance-guidance-tracker",
      "finance-tearsheet"
    ],
    "default_selected_dashboard": "Home",
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_tools": [
      {
        "tool": "get_workspace_snapshot",
        "args": {},
        "optional": true
      },
      {
        "tool": "read_workspace_resource",
        "args": {
          "uri": "openbb://workspace/specs/apps-json"
        },
        "optional": true
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Client Onboarding Backend",
          "url": "http://127.0.0.1:9603",
          "widgets_json": {
            "client_intake_queue": {
              "name": "Client Intake Queue",
              "description": "Wave-1 view for Client Intake Queue.",
              "endpoint": "/client-intake",
              "type": "table",
              "gridData": {
                "w": 20,
                "h": 10
              }
            },
            "approval_log": {
              "name": "Approval Log",
              "description": "Wave-1 view for Approval Log.",
              "endpoint": "/approval-log",
              "type": "table",
              "gridData": {
                "w": 20,
                "h": 10
              }
            }
          },
          "apps_json": [
            {
              "name": "Client Onboarding App",
              "description": "Wave-1 authored app for Client Onboarding App.",
              "tabs": {
                "intake": {
                  "id": "intake",
                  "name": "Intake",
                  "layout": [
                    {
                      "i": "client_intake_queue",
                      "x": 0,
                      "y": 0,
                      "w": 40,
                      "h": 12
                    }
                  ]
                },
                "approvals": {
                  "id": "approvals",
                  "name": "Approvals",
                  "layout": [
                    {
                      "i": "approval_log",
                      "x": 0,
                      "y": 0,
                      "w": 40,
                      "h": 12
                    }
                  ]
                }
              }
            }
          ]
        },
        "graded_args": [
          "operation",
          "name"
        ]
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "list"
        },
        "optional": true
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_005",
          "app_name": "Client Onboarding App",
          "dashboard_name": "Client Onboarding Live",
          "activate": true
        },
        "graded_args": [
          "operation"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Client Onboarding Backend",
        "widget_id": "client_intake_queue",
        "tab_id": "intake"
      },
      {
        "origin": "Client Onboarding Backend",
        "widget_id": "approval_log",
        "tab_id": "approvals"
      }
    ],
    "required_widget_defs": [
      {
        "backend_name": "Client Onboarding Backend",
        "widget_id": "client_intake_queue",
        "expect": {
          "type": "table"
        }
      },
      {
        "backend_name": "Client Onboarding Backend",
        "widget_id": "approval_log",
        "expect": {
          "type": "table"
        }
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Client Onboarding Backend",
        "name_contains": "Client Onboarding App",
        "tabs_include": [
          "intake",
          "approvals"
        ],
        "layout_refs_valid": true,
        "widgets_on_tab": [
          {
            "tab_id": "intake",
            "widget_id": "client_intake_queue"
          },
          {
            "tab_id": "approvals",
            "widget_id": "approval_log"
          }
        ]
      }
    ],
    "max_turns": 8
  }
}
