{
  "id": "register_backend_and_add_holdings_table",
  "category": "dashboard",
  "family": "backends",
  "difficulty": "medium",
  "prompt": "Call manage_backends with operation add and name widget-examples to register Usage Widget Examples register_backend_and_add_holdings_table; then discover test_metric, fetch its schema, and add Usage Widget Examples register_backend_and_add_holdings_table/test_metric to the active dashboard.",
  "setup": {
    "fixtures": {
      "backends": []
    },
    "initial_state": {
      "dashboard": {
        "name": "Backend Build",
        "activate": true,
        "tabs": [
          {
            "id": "",
            "name": ""
          }
        ],
        "dashboard_id": "usage_register_backend_and_add_holdings_table_dashboard_001"
      }
    },
    "allowed_tools": [
      "manage_backends",
      "get_workspace_snapshot",
      "list_available_widgets",
      "get_widget_schema",
      "create_widget"
    ]
  },
  "eval": {
    "required_widgets": [
      {
        "origin": "Usage Widget Examples register_backend_and_add_holdings_table",
        "widget_id": "test_metric",
        "data_args": {}
      }
