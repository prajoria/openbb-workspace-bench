{
  "id": "register_backend_and_add_macro_timeseries",
  "category": "dashboard",
  "family": "backends",
  "difficulty": "easy",
  "prompt": "After calling manage_backends with operation add and name macro for Bench Macro, discover macro_timeseries, fetch its schema, and add Bench Macro/macro_timeseries with data_args {\"series\": \"DGS10\"} to the active dashboard.",
  "fixtures": {
    "backends": []
  },
  "initial_state": {
    "dashboard": {
      "name": "Backend Build",
      "activate": true,
      "tabs": [
        {
          "id": "",
          "name": ""
        }
      ]
    }
  },
  "allowed_tools": [
    "manage_backends",
    "get_workspace_snapshot",
    "list_available_widgets",
    "get_widget_schema",
    "create_widget"
  ],
  "success": {
    "required_widgets": [
      {
        "origin": "Bench Macro",
        "widget_id": "macro_timeseries",
        "data_args": {
          "series": "DGS10"
        }
      }
    ],
    "required_tool_calls": [
      {
        "tool": "manage_backends",
        "args_contains": {
          "operation": "add"
        }
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "macro__macro_timeseries",
          "widget_id": "macro_timeseries",
          "fields": [
            "date",
            "value"
          ],
          "path": "/macro-timeseries",
          "payload": [
            {
              "date": "2025-10-31",
              "value": 4.38
            },
            {
              "date": "2025-11-30",
              "value": 4.25
            },
            {
              "date": "2025-12-31",
              "value": 4.12
            }
          ]
        },
        {
          "name": "macro__yield_curve",
          "widget_id": "yield_curve",
          "fields": [
            "tenor",
            "yield"
          ],
          "path": "/yield-curve",
          "payload": [
            {
              "tenor": "3M",
              "yield": 4.02
            },
            {
              "tenor": "2Y",
              "yield": 3.75
            },
            {
              "tenor": "5Y",
              "yield": 3.92
            },
            {
              "tenor": "10Y",
              "yield": 4.16
            },
            {
              "tenor": "30Y",
              "yield": 4.48
            }
          ]
        }
      ],
      "pinned_paths": false
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "manage_backends",
      "args": {
        "operation": "add",
        "name": "macro"
      }
    },
    {
      "tool": "manage_backends",
      "args": {
        "operation": "list"
      }
    },
    {
      "tool": "list_available_widgets",
      "args": {
        "origin": "Bench Macro"
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Bench Macro",
        "widget_id": "macro_timeseries"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Bench Macro",
        "widget_id": "macro_timeseries",
        "data_args": {
          "series": "DGS10"
        }
      }
    }
  ],
  "limits": {
    "max_turns": 8
  }
}
