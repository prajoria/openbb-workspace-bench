{
  "id": "register_two_backends_latest_news_and_yield_curve",
  "category": "dashboard",
  "family": "backends",
  "difficulty": "medium",
  "prompt": "Register both backends by name (equities, macro); then fetch each widget's schema and add Bench Equities/latest_news with data_args {\"limit\": 5, \"symbol\": \"MSFT\"} and Bench Macro/yield_curve to the active dashboard.",
  "fixtures": {
    "backends": []
  },
  "initial_state": {
    "dashboard": {
      "name": "Cross Backend Build",
      "activate": true,
      "tabs": [
        {
          "id": "",
          "name": ""
        }
      ]
    }
  },
  "allowed_tools": [
    "manage_backends",
    "get_workspace_snapshot",
    "list_available_widgets",
    "get_widget_schema",
    "create_widget"
  ],
  "success": {
    "required_widgets": [
      {
        "origin": "Bench Equities",
        "widget_id": "latest_news",
        "data_args": {
          "symbol": "MSFT",
          "limit": 5
        }
      },
      {
        "origin": "Bench Macro",
        "widget_id": "yield_curve",
        "data_args": {}
      }
    ],
    "required_tool_calls": [
      {
        "tool": "manage_backends",
        "args_contains": {
          "operation": "add"
        },
        "min_count": 2
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "equities__estimate_history",
          "widget_id": "estimate_history",
