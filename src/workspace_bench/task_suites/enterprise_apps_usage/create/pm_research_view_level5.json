{
  "id": "pm_research_view_level5",
  "category": "platform",
  "difficulty": "level5",
  "prompt": "Author a Pilot PM Research backend with an Idea Queue table and a Risk Snapshot metric, both governed by flagship-book and year-to-date controls. Compose them side by side in a PM Research Board Decision tab, publish and instantiate the app, and leave it open without embedding sample rows.",
  "setup": {
    "workspace_baseline": "stark-workspace-a",
    "workspace_backends": [
      "stark-enterprise-x",
      "support-daloopa-skills",
      "getting-started",
      "widget-examples"
    ],
    "workspace_skills": [
      "daloopa-capital-allocation",
      "daloopa-earnings-review",
      "daloopa-guidance-tracker",
      "daloopa-industry",
      "daloopa-inflection",
      "daloopa-tearsheet",
      "finance-comps",
      "finance-earnings-prep",
      "finance-guidance-tracker",
      "finance-tearsheet"
    ],
    "default_selected_dashboard": "Home",
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_widgets": [
      {
        "origin": "Pilot PM Research",
        "widget_id": "idea_queue",
        "data_args": {
          "fund": "Flagship Long/Short",
          "period": "YTD"
        },
        "tab_id": "decision"
      },
      {
        "origin": "Pilot PM Research",
        "widget_id": "risk_snapshot",
        "data_args": {
          "fund": "Flagship Long/Short",
          "period": "YTD"
        },
        "tab_id": "decision"
      }
    ],
    "required_tools": [
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Pilot PM Research",
          "url": "http://127.0.0.1:9405",
          "widgets_json": {
            "idea_queue": {
              "name": "Idea Queue",
              "description": "Actionable ideas for the portfolio manager.",
              "endpoint": "/idea-queue",
              "type": "table",
              "gridData": {
                "w": 24,
                "h": 10
              },
              "params": [
                {
                  "paramName": "fund",
                  "type": "text",
                  "label": "Fund",
                  "value": "Flagship Long/Short",
                  "options": [
                    {
                      "label": "Flagship Long/Short",
                      "value": "Flagship Long/Short"
                    }
                  ]
                },
                {
                  "paramName": "period",
                  "type": "text",
                  "label": "Period",
                  "value": "YTD",
                  "options": [
                    {
                      "label": "Year to Date",
                      "value": "YTD"
                    }
                  ]
                }
              ]
            },
            "risk_snapshot": {
              "name": "Risk Snapshot",
              "description": "Compact risk posture for the selected fund and period.",
              "endpoint": "/risk-snapshot",
              "type": "metric",
              "gridData": {
                "w": 16,
                "h": 10
              },
              "params": [
                {
                  "paramName": "fund",
                  "type": "text",
                  "label": "Fund",
                  "value": "Flagship Long/Short",
                  "options": [
                    {
                      "label": "Flagship Long/Short",
                      "value": "Flagship Long/Short"
                    }
                  ]
                },
                {
                  "paramName": "period",
                  "type": "text",
                  "label": "Period",
                  "value": "YTD",
                  "options": [
                    {
                      "label": "Year to Date",
                      "value": "YTD"
                    }
                  ]
                }
              ]
            }
          },
          "apps_json": [
            {
              "name": "PM Research Board",
              "description": "Pilot app for PM Research Board.",
              "tabs": {
                "decision": {
                  "id": "decision",
                  "name": "Decision",
                  "layout": [
                    {
                      "i": "idea_queue",
                      "x": 0,
                      "y": 0,
                      "w": 24,
                      "h": 10,
                      "state": {
                        "params": {
                          "fund": "Flagship Long/Short",
                          "period": "YTD"
                        }
                      }
                    },
                    {
                      "i": "risk_snapshot",
                      "x": 24,
                      "y": 0,
                      "w": 16,
                      "h": 10,
                      "state": {
                        "params": {
                          "fund": "Flagship Long/Short",
                          "period": "YTD"
                        }
                      }
                    }
                  ]
                }
              },
              "groups": []
            }
          ]
        },
        "graded_args": [
          "operation",
          "name"
        ]
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_005",
          "app_name": "PM Research Board",
          "dashboard_name": "PM Research Live",
          "activate": true
        },
        "graded_args": [
          "operation",
          "app_name"
        ]
      }
    ],
    "required_widget_defs": [
      {
        "backend_name": "Pilot PM Research",
        "widget_id": "idea_queue",
        "expect": {
          "type": "table"
        },
        "params_include": [
          {
            "paramName": "fund"
          },
          {
            "paramName": "period"
          }
        ]
      },
      {
        "backend_name": "Pilot PM Research",
        "widget_id": "risk_snapshot",
        "expect": {
          "type": "metric"
        },
        "params_include": [
          {
            "paramName": "fund"
          },
          {
            "paramName": "period"
          }
        ]
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Pilot PM Research",
        "name_contains": "PM Research Board",
        "tabs_include": [
          "decision"
        ],
        "layout_refs_valid": true,
        "no_overlaps": true
      }
    ],
    "max_turns": 5
  }
}
