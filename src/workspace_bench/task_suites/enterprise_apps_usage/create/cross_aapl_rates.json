{
  "id": "cross_aapl_rates",
  "category": "dashboard",
  "family": "create",
  "difficulty": "hard",
  "prompt": "On the active dashboard, add these two widgets: the Table widget with grouping by cell click widget from Getting Started for AAPL and the Car Manufacturer Performance widget from Getting Started for GM. Then add a HTML card mentioning AAPL and GM.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "getting-started"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Cross-Backend Task",
        "activate": true,
        "tabs": [
          {
            "id": "",
            "name": ""
          }
        ],
        "dashboard_id": "usage_cross_aapl_rates_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "create_widget",
      "update_widget_layout",
      "add_generative_widget"
    ]
  },
  "eval": {
    "required_widgets": [
      {
        "origin": "Getting Started",
        "widget_id": "table_widget_with_grouping_by_cell_click",
        "data_args": {
          "symbol": "AAPL"
        },
        "min_count": 1
      },
      {
        "origin": "Getting Started",
        "widget_id": "company_performance",
        "data_args": {
          "company": "GM",
          "year": "2024"
        },
        "min_count": 1
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "html",
        "data_contains": [
          "AAPL",
          "GM"
        ]
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference_trace": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Getting Started"
        }
      },
      {
        "tool": "get_widget_schema",
        "args": {
          "origin": "Getting Started",
          "widget_id": "table_widget_with_grouping_by_cell_click"
        }
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Getting Started",
          "widget_id": "table_widget_with_grouping_by_cell_click",
          "data_args": {
            "symbol": "AAPL"
          }
        }
      },
      {
        "tool": "get_widget_schema",
        "args": {
          "origin": "Getting Started",
          "widget_id": "company_performance"
        }
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Getting Started",
          "widget_id": "company_performance",
          "data_args": {
            "company": "GM",
            "year": "2024"
          }
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "html",
          "name": "Build Note",
          "data": "<section>AAPL price against the GM rates backdrop.</section>"
        }
      }
    ],
    "max_turns": 9
  }
}
