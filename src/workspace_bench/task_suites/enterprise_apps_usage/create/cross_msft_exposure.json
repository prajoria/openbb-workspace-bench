{
  "id": "cross_msft_exposure",
  "category": "dashboard",
  "family": "create",
  "difficulty": "hard",
  "prompt": "Add these two widgets to the active dashboard: the Sample News Feed widget from Getting Started for business and the Live Grid widget from Widget Examples. Then add a note mentioning business and sector exposure.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "getting-started"
        },
        {
          "name": "widget-examples"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Cross-Backend Task",
        "activate": true,
        "tabs": [
          {
            "id": "",
            "name": ""
          }
        ],
        "dashboard_id": "usage_cross_msft_exposure_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "create_widget",
      "update_widget_layout",
      "add_generative_widget"
    ]
  },
  "eval": {
    "required_widgets": [
      {
        "origin": "Getting Started",
        "widget_id": "sample_newsfeed",
        "data_args": {
          "category": "business",
          "limit": 5
        },
        "min_count": 1
      },
      {
        "origin": "Widget Examples",
        "widget_id": "live_grid_example",
        "data_args": {},
        "min_count": 1
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "business",
          "sector exposure"
        ]
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference_trace": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Getting Started"
        }
      },
      {
        "tool": "get_widget_schema",
        "args": {
          "origin": "Getting Started",
          "widget_id": "sample_newsfeed"
        }
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Getting Started",
          "widget_id": "sample_newsfeed",
          "data_args": {
            "category": "business",
            "limit": 5
          }
        }
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Widget Examples"
        }
      },
      {
        "tool": "get_widget_schema",
        "args": {
          "origin": "Widget Examples",
          "widget_id": "live_grid_example"
        }
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Widget Examples",
          "widget_id": "live_grid_example",
          "data_args": {}
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Build Note",
          "data": "business news next to the book's sector exposure."
        }
      }
    ],
    "max_turns": 10
  }
}
