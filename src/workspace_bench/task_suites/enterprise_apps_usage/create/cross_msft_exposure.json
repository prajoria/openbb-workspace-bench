{
  "id": "cross_msft_exposure",
  "category": "dashboard",
  "family": "create",
  "difficulty": "hard",
  "prompt": "Add these two widgets to the active dashboard: the Latest News widget from Bench Equities for MSFT and the Sector Exposure widget from Bench Portfolio. Then add a note mentioning MSFT and sector exposure.",
  "fixtures": {
    "backends": [
      {
        "name": "equities"
      },
      {
        "name": "portfolio"
      }
    ]
  },
  "initial_state": {
    "dashboard": {
      "name": "Cross-Backend Task",
      "activate": true,
      "tabs": [
        {
          "id": "",
          "name": ""
        }
      ]
    }
  },
  "allowed_tools": [
    "get_workspace_snapshot",
    "list_available_widgets",
    "get_widget_schema",
    "get_params_options",
    "create_widget",
    "update_widget_layout",
    "add_generative_widget"
  ],
  "success": {
    "required_widgets": [
      {
        "origin": "Bench Equities",
        "widget_id": "latest_news",
        "data_args": {
          "symbol": "MSFT",
          "limit": 5
        },
        "min_count": 1
      },
      {
        "origin": "Bench Portfolio",
        "widget_id": "sector_exposure",
        "data_args": {},
        "min_count": 1
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "MSFT",
          "sector exposure"
        ]
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_snapshot",
      "args": {}
    },
    {
      "tool": "list_available_widgets",
      "args": {
        "origin": "Bench Equities"
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Bench Equities",
        "widget_id": "latest_news"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Bench Equities",
        "widget_id": "latest_news",
        "data_args": {
          "symbol": "MSFT",
          "limit": 5
        }
      }
    },
    {
      "tool": "list_available_widgets",
      "args": {
        "origin": "Bench Portfolio"
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Bench Portfolio",
        "widget_id": "sector_exposure"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Bench Portfolio",
        "widget_id": "sector_exposure",
        "data_args": {}
      }
    },
    {
      "tool": "add_generative_widget",
      "args": {
        "widget_type": "note",
        "name": "Build Note",
        "data": "MSFT news next to the book's sector exposure."
      }
    }
  ],
  "limits": {
    "max_turns": 10
  }
}
