{
  "id": "place_latest_news_msft",
  "category": "single-widget",
  "family": "create",
  "difficulty": "medium",
  "prompt": "Add the Sample News Feed widget for business and place it at exactly x=20, y=0, width 20, height 10. Fetch the widget schema and confirm the symbol value through the parameter options before creating.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "getting-started"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Placement Task",
        "activate": true,
        "tabs": [
          {
            "id": "",
            "name": ""
          }
        ],
        "dashboard_id": "usage_place_latest_news_msft_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "create_widget",
      "update_widget_layout",
      "read_widget"
    ]
  },
  "eval": {
    "required_widgets": [
      {
        "origin": "Getting Started",
        "widget_id": "sample_newsfeed",
        "data_args": {
          "category": "business",
          "limit": 5
        },
        "min_count": 1
      }
    ],
    "required_layouts": [
      {
        "widget_id": "sample_newsfeed",
        "x": 20,
        "y": 0,
        "w": 20,
        "h": 10
      }
    ],
    "required_tool_calls": [
      {
        "tool": "get_params_options",
        "args_contains": {
          "widget_id": "sample_newsfeed",
          "param_name": "category"
        }
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference_trace": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Getting Started"
        }
      },
      {
        "tool": "get_widget_schema",
        "args": {
          "origin": "Getting Started",
          "widget_id": "sample_newsfeed"
        }
      },
      {
        "tool": "get_params_options",
        "args": {
          "origin": "Getting Started",
          "widget_id": "sample_newsfeed",
          "param_name": "category"
        }
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Getting Started",
          "widget_id": "sample_newsfeed",
          "data_args": {
            "category": "business",
            "limit": 5
          }
        }
      },
      {
        "tool": "update_widget_layout",
        "args": {
          "widget_id": "sample_newsfeed",
          "x": 20,
          "y": 0,
          "w": 20,
          "h": 10
        }
      }
    ],
    "max_turns": 9
  }
}
