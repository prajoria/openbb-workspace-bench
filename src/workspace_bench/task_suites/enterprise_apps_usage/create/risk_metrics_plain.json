{
  "id": "risk_metrics_plain",
  "category": "single-widget",
  "family": "create",
  "difficulty": "easy",
  "prompt": "Create a Whitepapers widget (widget_id whitepapers) from the Widget Examples backend on the active dashboard.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "widget-examples"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Creation Task",
        "activate": true,
        "tabs": [
          {
            "id": "",
            "name": ""
          }
        ],
        "dashboard_id": "usage_risk_metrics_plain_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "create_widget",
      "read_widget"
    ]
  },
  "eval": {
    "required_widgets": [
      {
        "origin": "Widget Examples",
        "widget_id": "whitepapers",
        "data_args": {
          "filenames": [
            "bitcoin.pdf"
          ]
        },
        "min_count": 1
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Widget Examples",
          "widget_id": "whitepapers",
          "data_args": {
            "filenames": [
              "bitcoin.pdf"
            ]
          }
        }
      }
    ],
    "limits": {
      "max_turns": 5
    }
  }
}
