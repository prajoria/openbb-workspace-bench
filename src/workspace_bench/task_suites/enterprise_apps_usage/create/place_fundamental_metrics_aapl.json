{
  "id": "place_fundamental_metrics_aapl",
  "category": "single-widget",
  "family": "create",
  "difficulty": "medium",
  "prompt": "Place a Company List with ID Mapping widget for TM at exactly x=0, y=0, width 10, height 8. Fetch the widget schema and confirm the symbol value through the parameter options before creating.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "getting-started"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Placement Task",
        "activate": true,
        "tabs": [
          {
            "id": "",
            "name": ""
          }
        ],
        "dashboard_id": "usage_place_fundamental_metrics_aapl_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "create_widget",
      "update_widget_layout",
      "read_widget"
    ]
  },
  "eval": {
    "required_widgets": [
      {
        "origin": "Getting Started",
        "widget_id": "company_list",
        "data_args": {
          "companyId": "TM"
        },
        "min_count": 1
      }
    ],
    "required_layouts": [
      {
        "widget_id": "company_list",
        "x": 0,
        "y": 0,
        "w": 10,
        "h": 8
      }
    ],
    "required_tool_calls": [
      {
        "tool": "get_params_options",
        "args_contains": {
          "widget_id": "company_list",
          "param_name": "companyId"
        }
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Getting Started"
        }
      },
      {
        "tool": "get_widget_schema",
        "args": {
          "origin": "Getting Started",
          "widget_id": "company_list"
        }
      },
      {
        "tool": "get_params_options",
        "args": {
          "origin": "Getting Started",
          "widget_id": "company_list",
          "param_name": "companyId"
        }
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Getting Started",
          "widget_id": "company_list",
          "data_args": {
            "companyId": "TM"
          }
        }
      },
      {
        "tool": "update_widget_layout",
        "args": {
          "widget_id": "company_list",
          "x": 0,
          "y": 0,
          "w": 10,
          "h": 8
        }
      }
    ],
    "limits": {
      "max_turns": 9
    }
  }
}
