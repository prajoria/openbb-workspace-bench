{
  "id": "preserve_fundamental_metrics_msft",
  "category": "single-widget",
  "family": "create",
  "difficulty": "hard",
  "prompt": "Keep the existing Live Grid widget undisturbed and non-overlapped while adding the Company List with ID Mapping widget for MSFT next to it.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "getting-started"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Existing Review",
        "activate": true,
        "tabs": [
          {
            "id": "",
            "name": ""
          }
        ],
        "widgets": [
          {
            "origin": "Getting Started",
            "widget_id": "live_grid_data",
            "data_args": {
              "symbol": "MSFT"
            },
            "layout": {
              "x": 0,
              "y": 0,
              "w": 20,
              "h": 12
            },
            "widget_uuid": "usage_preserve_fundamental_metrics_msft_widget_001"
          }
        ],
        "dashboard_id": "usage_preserve_fundamental_metrics_msft_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "create_widget",
      "update_widget_layout",
      "read_widget"
    ]
  },
  "eval": {
    "required_widgets": [
      {
        "origin": "Getting Started",
        "widget_id": "live_grid_data",
        "data_args": {
          "symbol": "MSFT"
        },
        "min_count": 1,
        "max_count": 1
      },
      {
        "origin": "Getting Started",
        "widget_id": "company_list",
        "data_args": {
          "companyId": "VWAGY"
        },
        "min_count": 1
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference_trace": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Getting Started"
        }
      },
      {
        "tool": "get_widget_schema",
        "args": {
          "origin": "Getting Started",
          "widget_id": "company_list"
        }
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Getting Started",
          "widget_id": "company_list",
          "data_args": {
            "companyId": "VWAGY"
          }
        }
      },
      {
        "tool": "update_widget_layout",
        "args": {
          "widget_id": "company_list",
          "x": 20,
          "y": 0,
          "w": 20,
          "h": 10
        }
      }
    ],
    "max_turns": 8
  }
}
