{
  "id": "cross_nvda_curve",
  "category": "dashboard",
  "family": "create",
  "difficulty": "hard",
  "prompt": "On the active dashboard, add these two widgets: the Table widget with grouping by cell click widget from Getting Started for TSLA and the Metric Widget from Widget Examples. Then add a note mentioning TSLA and yield curve.",
  "fixtures": {
    "backends": [
      {
        "name": "getting-started"
      },
      {
        "name": "widget-examples"
      }
    ]
  },
  "initial_state": {
    "dashboard": {
      "name": "Cross-Backend Task",
      "activate": true,
      "tabs": [
        {
          "id": "",
          "name": ""
        }
      ],
      "dashboard_id": "usage_cross_nvda_curve_dashboard_001"
    }
  },
  "allowed_tools": [
    "get_workspace_snapshot",
    "list_available_widgets",
    "get_widget_schema",
    "get_params_options",
    "create_widget",
    "update_widget_layout",
    "add_generative_widget"
  ],
  "success": {
    "required_widgets": [
      {
        "origin": "Getting Started",
        "widget_id": "table_widget_with_grouping_by_cell_click",
        "data_args": {
          "symbol": "TSLA"
        },
        "min_count": 1
      },
      {
        "origin": "Widget Examples",
        "widget_id": "test_metric",
        "data_args": {},
        "min_count": 1
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "TSLA",
          "yield curve"
        ]
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_snapshot",
      "args": {}
    },
    {
      "tool": "list_available_widgets",
      "args": {
        "origin": "Getting Started"
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Getting Started",
        "widget_id": "table_widget_with_grouping_by_cell_click"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Getting Started",
        "widget_id": "table_widget_with_grouping_by_cell_click",
        "data_args": {
          "symbol": "TSLA"
        }
      }
    },
    {
      "tool": "list_available_widgets",
      "args": {
        "origin": "Widget Examples"
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Widget Examples",
        "widget_id": "test_metric"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Widget Examples",
        "widget_id": "test_metric",
        "data_args": {}
      }
    },
    {
      "tool": "add_generative_widget",
      "args": {
        "widget_type": "note",
        "name": "Build Note",
        "data": "TSLA price with the yield curve for rate context."
      }
    }
  ],
  "limits": {
    "max_turns": 10
  }
}
