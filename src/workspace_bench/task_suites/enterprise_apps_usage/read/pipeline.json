{
  "id": "pipeline",
  "category": "single-widget",
  "family": "read",
  "difficulty": "easy",
  "prompt": "On the Bench Stark Enterprise Pipeline by Stage widget, use get_widget_data, then add a short HTML card that cites client_360_flows_pipeline_by_stage and says you reviewed the data.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "stark-enterprise"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Data Review",
        "activate": true,
        "tabs": [
          {
            "id": "main",
            "name": "Main"
          }
        ],
        "widgets": [
          {
            "origin": "Bench Stark Enterprise",
            "widget_id": "client_360_flows_pipeline_by_stage",
            "data_args": {
              "fund": "Flagship Long/Short",
              "period": "YTD"
            },
            "tab_id": "main",
            "layout": {
              "x": 0,
              "y": 2,
              "w": 20,
              "h": 10
            },
            "widget_uuid": "usage_pipeline_widget_001"
          }
        ],
        "dashboard_id": "usage_pipeline_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "get_widget_data",
      "read_widget",
      "add_generative_widget"
    ]
  },
  "eval": {
    "required_tool_calls": [
      {
        "tool": "get_widget_data",
        "args_contains": {
          "origin": "Bench Stark Enterprise",
          "widget_id": "client_360_flows_pipeline_by_stage"
        }
      }
    ],
    "required_tool_results": [
      {
        "tool": "get_widget_data",
        "data_contains": [
          "score"
        ]
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "html",
        "data_contains": [
          "client_360_flows_pipeline_by_stage",
          "data"
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 0
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "get_widget_data",
        "args": {
          "origin": "Bench Stark Enterprise",
          "widget_id": "client_360_flows_pipeline_by_stage",
          "widget_uuid": "usage_pipeline_widget_001",
          "data_args": {
            "fund": "Flagship Long/Short",
            "period": "YTD"
          }
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "html",
          "name": "Data Note",
          "data": "<section>Reviewed the data returned by client_360_flows_pipeline_by_stage.</section>"
        }
      }
    ],
    "limits": {
      "max_turns": 6
    }
  }
}
