{
  "id": "consensus_exception_handoff_level5",
  "category": "platform",
  "difficulty": "level5",
  "prompt": "Consensus-exception build handoff: add Wave Three Consensus Handoff with a Consensus Handoff Register table, publish and instantiate Consensus Handoff App with one Handoff tab, add a Consensus-exception Build Handoff note grounded in Bench Daloopa's Consensus Estimates with the exact Total Revenue actual and consensus for 2026Q1 and the Daloopa Earnings Review skill (daloopa-earnings-review)'s governing concept, then delegate. Widget ids are the snake_case of widget names; tab ids are the snake_case of tab names.",
  "setup": {
    "workspace_baseline": "stark-workspace-a",
    "workspace_backends": [
      "stark-enterprise-x",
      "support-daloopa-skills",
      "getting-started",
      "widget-examples"
    ],
    "workspace_skills": [
      "daloopa-capital-allocation",
      "daloopa-earnings-review",
      "daloopa-guidance-tracker",
      "daloopa-industry",
      "daloopa-inflection",
      "daloopa-tearsheet",
      "finance-comps",
      "finance-earnings-prep",
      "finance-guidance-tracker",
      "finance-tearsheet"
    ],
    "default_selected_dashboard": "Home",
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_tools": [
      {
        "tool": "get_workspace_snapshot",
        "args": {},
        "optional": true
      },
      {
        "tool": "get_skill_content",
        "args": {
          "slug": "daloopa-earnings-review"
        },
        "graded_args": [
          "slug"
        ]
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Bench Daloopa"
        },
        "optional": true
      },
      {
        "tool": "get_widget_data",
        "args": {
          "origin": "Bench Daloopa",
          "widget_id": "daloopa_consensus_estimates",
          "data_args": {
            "ticker": "AAPL"
          }
        },
        "optional": true
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Wave Three Consensus Handoff",
          "url": "http://127.0.0.1:9714",
          "widgets_json": {
            "consensus_handoff_register": {
              "name": "Consensus Handoff Register",
              "description": "Wave-1 view for Consensus Handoff Register.",
              "endpoint": "/consensus_handoff_register",
              "type": "table",
              "gridData": {
                "w": 40,
                "h": 10
              }
            }
          },
          "apps_json": [
            {
              "name": "Consensus Handoff App",
              "description": "Wave-1 authored app for Consensus Handoff App.",
              "tabs": {
                "handoff": {
                  "id": "handoff",
                  "name": "Handoff",
                  "layout": [
                    {
                      "i": "consensus_handoff_register",
                      "x": 0,
                      "y": 0,
                      "w": 40,
                      "h": 10
                    }
                  ]
                }
              }
            }
          ]
        },
        "graded_args": [
          "operation",
          "name"
        ]
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "list"
        },
        "optional": true
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_005",
          "app_name": "Consensus Handoff App",
          "dashboard_name": "Consensus-exception Live",
          "activate": true
        },
        "graded_args": [
          "operation"
        ]
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Consensus-exception Build Handoff",
          "data": "consensus: catalog facts 102070.1 and 99404.2."
        },
        "graded_args": [
          "widget_type",
          "name"
        ]
      },
      {
        "tool": "assign_tasks_to_agents",
        "args": {
          "task_requests": [
            {
              "id": "consensus_exception_handoff_follow_up",
              "description": "Review the Consensus-exception follow-up.",
              "assigned_holder_url": "workspace://agents/consensus_exception_handoff",
              "assigned_agent_id": "consensus_exception_handoff-agent"
            }
          ]
        },
        "graded_args": []
      }
    ],
    "required_widgets": [
      {
        "origin": "Wave Three Consensus Handoff",
        "widget_id": "consensus_handoff_register",
        "tab_id": "handoff"
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "name_contains": "Consensus-exception Build Handoff",
        "data_contains": [
          "consensus",
          "102070.1",
          "99404.2"
        ]
      }
    ],
    "required_widget_defs": [
      {
        "backend_name": "Wave Three Consensus Handoff",
        "widget_id": "consensus_handoff_register",
        "expect": {
          "type": "table"
        }
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Wave Three Consensus Handoff",
        "name_contains": "Consensus Handoff App",
        "tabs_include": [
          "handoff"
        ],
        "layout_refs_valid": true,
        "widgets_on_tab": [
          {
            "tab_id": "handoff",
            "widget_id": "consensus_handoff_register"
          }
        ]
      }
    ],
    "max_turns": 12
  }
}
