        },
        "graded_args": [
          "widget_type",
          "name"
        ]
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "name_contains": "Consensus-exception Discovered Note",
        "data_contains": [
          "102070.1",
          "99404.2"
        ]
      }
    ],
    "max_turns": 7
  }
