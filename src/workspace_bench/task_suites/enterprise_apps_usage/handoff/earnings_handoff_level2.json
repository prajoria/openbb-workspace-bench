        "graded_args": [
          "widget_type",
          "name"
        ]
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "name_contains": "Microsoft Earnings Handoff",
        "data_contains": [
          "89.94",
          "Escalated"
        ]
      }
