{
  "id": "earnings_handoff_level5",
  "category": "platform",
  "difficulty": "level5",
  "prompt": "From the open Earnings Handoff dashboard, author and add a minimal custom Earnings Handoff Backend with one Earnings Handoff Register. Publish and instantiate Earnings Handoff App with one Handoff tab, add an Earnings Build Handoff note naming Earnings Handoff App and Earnings Handoff Register, then delegate the build-review follow-up. Widget ids are the snake_case of widget names; tab ids are the snake_case of tab names. Follow the Finance Earnings Prep skill (finance-earnings-prep) and record in the note what internal estimates are compared to.",
  "setup": {
    "workspace_baseline": "stark-workspace-a",
    "workspace_backends": [
      "stark-enterprise-x",
      "support-daloopa-skills",
      "getting-started",
      "widget-examples"
    ],
    "workspace_skills": [
      "daloopa-capital-allocation",
      "daloopa-earnings-review",
      "daloopa-guidance-tracker",
      "daloopa-industry",
      "daloopa-inflection",
      "daloopa-tearsheet",
      "finance-comps",
      "finance-earnings-prep",
      "finance-guidance-tracker",
      "finance-tearsheet"
    ],
    "default_selected_dashboard": "Earnings Handoff",
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ],
    "initial_state": {
      "dashboard": {
        "name": "Earnings Handoff",
        "activate": false,
        "tabs": [
          {
            "id": "review",
            "name": "Review"
          }
        ],
        "widgets": []
      }
    }
  },
  "eval": {
    "required_tools": [
      {
        "tool": "get_skill_content",
        "args": {
          "slug": "finance-earnings-prep"
        },
        "graded_args": [
          "slug"
        ]
      },
      {
        "tool": "get_workspace_snapshot",
        "args": {},
        "optional": true
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Earnings Handoff Backend",
          "url": "http://127.0.0.1:9508",
          "widgets_json": {
            "earnings_handoff_register": {
              "name": "Earnings Handoff Register",
              "description": "Wave-1 view for Earnings Handoff Register.",
              "endpoint": "/earnings-handoff",
              "type": "table",
              "gridData": {
                "w": 20,
                "h": 10
              }
            }
          },
          "apps_json": [
            {
              "name": "Earnings Handoff App",
              "description": "Wave-1 authored app for Earnings Handoff App.",
              "tabs": {
                "handoff": {
                  "id": "handoff",
                  "name": "Handoff",
                  "layout": [
                    {
                      "i": "earnings_handoff_register",
                      "x": 0,
                      "y": 0,
                      "w": 40,
                      "h": 10
                    }
                  ]
                }
              }
            }
          ]
        },
        "graded_args": [
          "operation",
          "name"
        ]
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "list"
        },
        "optional": true
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_005",
          "app_name": "Earnings Handoff App",
          "dashboard_name": "Earnings Handoff Live",
          "activate": true
        },
        "graded_args": [
          "operation"
        ]
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Earnings Build Handoff",
          "data": "street numbers: Built Earnings Handoff App with Earnings Handoff Register; review ownership."
        },
        "graded_args": [
          "widget_type",
          "name"
        ]
      },
      {
        "tool": "assign_tasks_to_agents",
        "args": {
          "task_requests": [
            {
              "id": "earnings_build_review",
              "description": "Review the Earnings Handoff App build and ownership.",
              "assigned_holder_url": "workspace://agents/coverage",
              "assigned_agent_id": "coverage-agent"
            }
          ]
        },
        "graded_args": []
      }
    ],
    "required_widgets": [
      {
        "origin": "Earnings Handoff Backend",
        "widget_id": "earnings_handoff_register",
        "tab_id": "handoff"
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "name_contains": "Earnings Build Handoff",
        "data_contains": [
          "Earnings Handoff App",
          "Earnings Handoff Register",
          "street numbers"
        ]
      }
    ],
    "required_widget_defs": [
      {
        "backend_name": "Earnings Handoff Backend",
        "widget_id": "earnings_handoff_register",
        "expect": {}
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Earnings Handoff Backend",
        "name_contains": "Earnings Handoff App",
        "tabs_include": [
          "handoff"
        ],
        "layout_refs_valid": true,
        "widgets_on_tab": [
          {
            "tab_id": "handoff",
            "widget_id": "earnings_handoff_register"
          }
        ]
      }
    ],
    "max_turns": 10
  }
}
