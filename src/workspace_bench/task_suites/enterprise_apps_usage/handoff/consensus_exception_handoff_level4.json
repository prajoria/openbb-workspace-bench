{
  "id": "consensus_exception_handoff_level4",
  "category": "dashboard",
  "difficulty": "level4",
  "prompt": "Close out the open Consensus Exception Handoff dashboard under the Daloopa Earnings Review skill: read Bench Daloopa's Consensus Estimates with ticker AAPL, add a Consensus-exception Governed Handoff note recording the exact Total Revenue actual and consensus for 2026Q1 and consensus, then delegate the follow-up.",
  "setup": {
    "workspace_baseline": "stark-workspace-a",
    "workspace_backends": [
      "stark-enterprise-x",
      "support-daloopa-skills",
      "getting-started",
      "widget-examples"
    ],
    "workspace_skills": [
      "daloopa-capital-allocation",
      "daloopa-earnings-review",
      "daloopa-guidance-tracker",
      "daloopa-industry",
      "daloopa-inflection",
      "daloopa-tearsheet",
      "finance-comps",
      "finance-earnings-prep",
      "finance-guidance-tracker",
      "finance-tearsheet"
    ],
    "default_selected_dashboard": "Consensus Exception Handoff",
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ],
    "initial_state": {
      "dashboard": {
        "name": "Consensus Exception Handoff",
        "activate": false,
        "tabs": [
          {
            "id": "review",
            "name": "Review"
          }
        ],
        "widgets": []
      }
    }
  },
  "eval": {
    "required_tools": [
      {
        "tool": "get_workspace_snapshot",
        "args": {},
        "optional": true
      },
      {
        "tool": "get_skill_content",
        "args": {
          "slug": "daloopa-earnings-review"
        },
        "graded_args": [
          "slug"
        ]
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Bench Daloopa"
        },
        "optional": true
      },
      {
        "tool": "get_widget_data",
        "args": {
          "origin": "Bench Daloopa",
          "widget_id": "daloopa_consensus_estimates",
          "data_args": {
            "ticker": "AAPL"
          }
        },
        "graded_args": [
          "origin",
          "widget_id"
        ]
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Consensus-exception Governed Handoff",
          "data": "consensus: observed 102070.1 and 99404.2."
        },
        "graded_args": [
          "widget_type",
          "name"
        ]
      },
      {
        "tool": "assign_tasks_to_agents",
        "args": {
          "task_requests": [
            {
              "id": "consensus_exception_handoff_follow_up",
              "description": "Review the Consensus-exception follow-up.",
              "assigned_holder_url": "workspace://agents/consensus_exception_handoff",
              "assigned_agent_id": "consensus_exception_handoff-agent"
            }
          ]
        },
        "graded_args": []
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "name_contains": "Consensus-exception Governed Handoff",
        "data_contains": [
          "consensus",
          "102070.1",
          "99404.2"
        ]
      }
    ],
    "max_turns": 9
  }
}
