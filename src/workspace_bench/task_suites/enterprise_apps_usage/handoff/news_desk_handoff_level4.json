{
  "id": "news_desk_handoff_level4",
  "category": "platform",
  "difficulty": "level4",
  "prompt": "Handle the science follow-up route from the open News Desk Handoff dashboard under Workspace session guidance. Read Getting Started's Sample News Feed for science, limited to 2; add a Science Delegation Handoff note with the exact lead title and author, then delegate the editorial follow-up.",
  "setup": {
    "workspace_baseline": "stark-workspace-a",
    "workspace_backends": [
      "stark-enterprise-x",
      "support-daloopa-skills",
      "getting-started",
      "widget-examples"
    ],
    "workspace_skills": [
      "daloopa-capital-allocation",
      "daloopa-earnings-review",
      "daloopa-guidance-tracker",
      "daloopa-industry",
      "daloopa-inflection",
      "daloopa-tearsheet",
      "finance-comps",
      "finance-earnings-prep",
      "finance-guidance-tracker",
      "finance-tearsheet"
    ],
    "default_selected_dashboard": "News Desk Handoff",
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ],
    "initial_state": {
      "dashboard": {
        "name": "News Desk Handoff",
        "activate": false,
        "tabs": [
          {
            "id": "review",
            "name": "Review"
          }
        ],
        "widgets": []
      }
    }
  },
  "eval": {
    "required_tools": [
      {
        "tool": "get_workspace_snapshot",
        "args": {},
        "optional": true
      },
      {
        "tool": "get_workspace_prompt",
        "args": {
          "name": "workspace_session_context"
        },
        "optional": true
      },
      {
        "tool": "get_widget_data",
        "args": {
          "origin": "Getting Started",
          "widget_id": "sample_newsfeed",
          "data_args": {
            "category": "science",
            "limit": 2
          }
        },
        "graded_args": [
          "origin",
          "widget_id"
        ]
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Science Delegation Handoff",
          "data": "Lead: Scientists Discover New Earth-like Exoplanet in Habitable Zone; author: Dr. Emily Rogers."
        },
        "graded_args": [
          "widget_type",
          "name"
        ]
      },
      {
        "tool": "assign_tasks_to_agents",
        "args": {
          "task_requests": [
            {
              "id": "science_editor_follow_up",
              "description": "Review the exoplanet story and next editorial actions.",
              "assigned_holder_url": "workspace://agents/science-editor",
              "assigned_agent_id": "science-editor-agent"
            }
          ]
        },
        "graded_args": []
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "name_contains": "Science Delegation Handoff",
        "data_contains": [
          "Scientists Discover New Earth-like Exoplanet in Habitable Zone",
          "Dr. Emily Rogers"
        ]
      }
    ],
    "max_turns": 8
  }
}
