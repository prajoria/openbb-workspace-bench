{
  "id": "news_desk_handoff_level5",
  "category": "platform",
  "difficulty": "level5",
  "prompt": "Starting from the open News Desk Handoff board, author and add a minimal custom News Handoff Backend with one News Handoff Register. Publish and instantiate News Handoff App with one Handoff tab, add a News Build Handoff note naming News Handoff App and News Handoff Register, then delegate the build-review follow-up. Widget ids are the snake_case of widget names; tab ids are the snake_case of tab names.",
  "setup": {
    "workspace_baseline": "stark-workspace-a",
    "workspace_backends": [
      "stark-enterprise-x",
      "support-daloopa-skills",
      "getting-started",
      "widget-examples"
    ],
    "workspace_skills": [
      "daloopa-capital-allocation",
      "daloopa-earnings-review",
      "daloopa-guidance-tracker",
      "daloopa-industry",
      "daloopa-inflection",
      "daloopa-tearsheet",
      "finance-comps",
      "finance-earnings-prep",
      "finance-guidance-tracker",
      "finance-tearsheet"
    ],
    "default_selected_dashboard": "News Desk Handoff",
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ],
    "initial_state": {
      "dashboard": {
        "name": "News Desk Handoff",
        "activate": false,
        "tabs": [
          {
            "id": "review",
            "name": "Review"
          }
        ],
        "widgets": []
      }
    }
  },
  "eval": {
    "required_tools": [
      {
        "tool": "get_workspace_snapshot",
        "args": {},
        "optional": true
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "News Handoff Backend",
          "url": "http://127.0.0.1:9608",
          "widgets_json": {
            "news_handoff_register": {
              "name": "News Handoff Register",
              "description": "Wave-1 view for News Handoff Register.",
              "endpoint": "/news-handoff",
              "type": "table",
              "gridData": {
                "w": 20,
                "h": 10
              }
            }
          },
          "apps_json": [
            {
              "name": "News Handoff App",
              "description": "Wave-1 authored app for News Handoff App.",
              "tabs": {
                "handoff": {
                  "id": "handoff",
                  "name": "Handoff",
                  "layout": [
                    {
                      "i": "news_handoff_register",
                      "x": 0,
                      "y": 0,
                      "w": 40,
                      "h": 10
                    }
                  ]
                }
              }
            }
          ]
        },
        "graded_args": [
          "operation",
          "name"
        ]
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "list"
        },
        "optional": true
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_005",
          "app_name": "News Handoff App",
          "dashboard_name": "News Handoff Live",
          "activate": true
        },
        "graded_args": [
          "operation"
        ]
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "News Build Handoff",
          "data": "Built News Handoff App with News Handoff Register; review ownership."
        },
        "graded_args": [
          "widget_type",
          "name"
        ]
      },
      {
        "tool": "assign_tasks_to_agents",
        "args": {
          "task_requests": [
            {
              "id": "news_build_review",
              "description": "Review the News Handoff App build and ownership.",
              "assigned_holder_url": "workspace://agents/science-editor",
              "assigned_agent_id": "science-editor-agent"
            }
          ]
        },
        "graded_args": []
      }
    ],
    "required_widgets": [
      {
        "origin": "News Handoff Backend",
        "widget_id": "news_handoff_register",
        "tab_id": "handoff"
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "name_contains": "News Build Handoff",
        "data_contains": [
          "News Handoff App",
          "News Handoff Register"
        ]
      }
    ],
    "required_widget_defs": [
      {
        "backend_name": "News Handoff Backend",
        "widget_id": "news_handoff_register",
        "expect": {}
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "News Handoff Backend",
        "name_contains": "News Handoff App",
        "tabs_include": [
          "handoff"
        ],
        "layout_refs_valid": true,
        "widgets_on_tab": [
          {
            "tab_id": "handoff",
            "widget_id": "news_handoff_register"
          }
        ]
      }
    ],
    "max_turns": 9
  }
}
