    "reference_trace": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "read_widget",
        "args": {
          "widget_id": "company_performance"
        }
      },
      {
        "tool": "update_widget",
        "args": {
          "widget_uuid": "usage_repair_series_fedfunds_cpi_widget_001",
          "data_args": {
            "company": "F",
            "year": "2024"
          }
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "html",
          "name": "Repair Note",
          "data": "<section>Repaired company_performance from TM to F.</section>"
        }
      }
