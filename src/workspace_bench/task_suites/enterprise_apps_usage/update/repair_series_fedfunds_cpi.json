        "widgets": [
          {
            "origin": "Getting Started",
            "widget_id": "company_performance",
            "data_args": {
              "company": "TM",
              "year": "2024"
            },
            "layout": {
              "x": 0,
              "y": 0,
              "w": 20,
              "h": 12
            },
            "widget_uuid": "usage_repair_series_fedfunds_cpi_widget_001"
          }
        ],
        "dashboard_id": "usage_repair_series_fedfunds_cpi_dashboard_001"
      }
