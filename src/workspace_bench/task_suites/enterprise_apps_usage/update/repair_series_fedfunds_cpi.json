        "widget_id": "company_performance",
        "data_args": {
          "company": "F",
          "year": "2024"
        },
        "min_count": 1
      },
      {
        "origin": "Getting Started",
        "widget_id": "company_performance",
        "data_args": {
          "company": "TM",
          "year": "2024"
