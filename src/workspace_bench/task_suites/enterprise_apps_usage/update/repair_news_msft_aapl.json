{
  "id": "repair_news_msft_aapl",
  "category": "repair",
  "family": "update",
  "difficulty": "medium",
  "prompt": "This tech desk dashboard mistakenly shows business news. Repair the widget to tech and add a note saying what was repaired, mentioning both values.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "getting-started"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Repair Task",
        "activate": true,
        "tabs": [
          {
            "id": "",
            "name": ""
          }
        ],
        "widgets": [
          {
            "origin": "Getting Started",
            "widget_id": "sample_newsfeed",
            "data_args": {
              "category": "business"
            },
            "layout": {
              "x": 0,
              "y": 0,
              "w": 20,
              "h": 12
            },
            "widget_uuid": "usage_repair_news_msft_aapl_widget_001"
          }
        ],
        "dashboard_id": "usage_repair_news_msft_aapl_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "read_widget",
      "update_widget",
      "add_generative_widget"
    ]
  },
  "eval": {
    "required_widgets": [
      {
        "origin": "Getting Started",
        "widget_id": "sample_newsfeed",
        "data_args": {
          "category": "tech"
        },
        "min_count": 1
      },
      {
        "origin": "Getting Started",
        "widget_id": "sample_newsfeed",
        "data_args": {
          "category": "business"
        },
        "min_count": 0,
        "max_count": 0
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "business",
          "tech",
          "repaired"
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference_trace": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "read_widget",
        "args": {
          "widget_id": "sample_newsfeed"
        }
      },
      {
        "tool": "update_widget",
        "args": {
          "widget_uuid": "usage_repair_news_msft_aapl_widget_001",
          "data_args": {
            "category": "tech"
          }
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Repair Note",
          "data": "Repaired sample_newsfeed from business to tech."
        }
      }
    ],
    "max_turns": 7
  }
}
