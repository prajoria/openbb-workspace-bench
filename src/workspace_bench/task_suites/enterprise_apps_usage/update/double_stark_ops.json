{
  "id": "double_stark_ops",
  "category": "repair",
  "family": "update",
  "difficulty": "hard",
  "prompt": "The ops dashboard has two wrong settings: Vendor SLA Status is Open but should be In Review, and Portfolio Snapshot is YTD but should be MTD. Repair both existing widgets and add a note mentioning In Review, MTD, and the word repaired.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "stark-enterprise"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Double Repair Task",
        "activate": true,
        "tabs": [
          {
            "id": "",
            "name": ""
          }
        ],
        "widgets": [
          {
            "origin": "Bench Stark Enterprise",
            "widget_id": "vendor_dataset_monitor_slas_vendor_sla_status",
            "data_args": {
              "vendor": "FactSet",
              "status": "Open"
            },
            "layout": {
              "x": 0,
              "y": 0,
              "w": 20,
              "h": 10
            },
            "widget_uuid": "usage_double_stark_ops_widget_001"
          },
          {
            "origin": "Bench Stark Enterprise",
            "widget_id": "portfolio_command_center_overview_portfolio_snapshot",
            "data_args": {
              "fund": "Flagship Long/Short",
              "period": "YTD"
            },
            "layout": {
              "x": 20,
              "y": 0,
              "w": 20,
              "h": 10
            },
            "widget_uuid": "usage_double_stark_ops_widget_002"
          }
        ],
        "dashboard_id": "usage_double_stark_ops_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "read_widget",
      "update_widget",
      "add_generative_widget"
    ]
  },
  "eval": {
    "required_widgets": [
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "vendor_dataset_monitor_slas_vendor_sla_status",
        "data_args": {
          "vendor": "FactSet",
          "status": "In Review"
        },
        "min_count": 1
      },
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "vendor_dataset_monitor_slas_vendor_sla_status",
        "data_args": {
          "status": "Open"
        },
        "min_count": 0,
        "max_count": 0
      },
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "portfolio_command_center_overview_portfolio_snapshot",
        "data_args": {
          "fund": "Flagship Long/Short",
          "period": "MTD"
        },
        "min_count": 1
      },
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "portfolio_command_center_overview_portfolio_snapshot",
        "data_args": {
          "period": "YTD"
        },
        "min_count": 0,
        "max_count": 0
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "In Review",
          "MTD",
          "repaired"
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference_trace": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "update_widget",
        "args": {
          "widget_uuid": "usage_double_stark_ops_widget_001",
          "data_args": {
            "status": "In Review"
          }
        }
      },
      {
        "tool": "update_widget",
        "args": {
          "widget_uuid": "usage_double_stark_ops_widget_002",
          "data_args": {
            "period": "MTD"
          }
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Repair Note",
          "data": "Repaired: In Review, MTD, repaired."
        }
      }
    ],
    "max_turns": 6
  }
}
