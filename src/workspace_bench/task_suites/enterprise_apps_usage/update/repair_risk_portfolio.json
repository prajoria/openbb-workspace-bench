{
  "id": "repair_risk_portfolio",
  "category": "repair",
  "family": "update",
  "difficulty": "hard",
  "prompt": "This Long/Short Equity risk dashboard has its snapshot configured for Macro Multi-Asset. Repair the widget to Long/Short Equity and add a HTML card saying what was repaired, mentioning both values.",
  "fixtures": {
    "backends": [
      {
        "name": "stark-enterprise"
      }
    ]
  },
  "initial_state": {
    "dashboard": {
      "name": "Repair Task",
      "activate": true,
      "tabs": [
        {
          "id": "",
          "name": ""
        }
      ],
      "widgets": [
        {
          "origin": "Bench Stark Enterprise",
          "widget_id": "risk_exposure_monitor_dashboard_risk_snapshot",
          "data_args": {
            "portfolio": "Macro Multi-Asset"
          },
          "layout": {
            "x": 0,
            "y": 0,
            "w": 20,
            "h": 12
          },
          "widget_uuid": "usage_repair_risk_portfolio_widget_001"
        }
      ],
      "dashboard_id": "usage_repair_risk_portfolio_dashboard_001"
    }
  },
  "allowed_tools": [
    "get_workspace_snapshot",
    "read_widget",
    "update_widget",
    "add_generative_widget"
  ],
  "success": {
    "required_widgets": [
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "risk_exposure_monitor_dashboard_risk_snapshot",
        "data_args": {
          "portfolio": "Long/Short Equity"
        },
        "min_count": 1
      },
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "risk_exposure_monitor_dashboard_risk_snapshot",
        "data_args": {
          "portfolio": "Macro Multi-Asset"
        },
        "min_count": 0,
        "max_count": 0
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "html",
        "data_contains": [
          "Macro Multi-Asset",
          "Long/Short Equity",
          "repaired"
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_snapshot",
      "args": {}
    },
    {
      "tool": "read_widget",
      "args": {
        "widget_id": "risk_exposure_monitor_dashboard_risk_snapshot"
      }
    },
    {
      "tool": "update_widget",
      "args": {
        "widget_uuid": "usage_repair_risk_portfolio_widget_001",
        "data_args": {
          "portfolio": "Long/Short Equity"
        }
      }
    },
    {
      "tool": "add_generative_widget",
      "args": {
        "widget_type": "html",
        "name": "Repair Note",
        "data": "<section>Repaired risk_exposure_monitor_dashboard_risk_snapshot from Macro Multi-Asset to Long/Short Equity.</section>"
      }
    }
  ],
  "limits": {
    "max_turns": 7
  }
}
