{
  "id": "rename_both_ops_close",
  "category": "single-widget",
  "family": "navigate",
  "difficulty": "easy",
  "prompt": "Change the active dashboard's name to Fund Close Control; also rename the Overview tab to Close Checklist.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "stark-enterprise"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Ops Board",
        "activate": true,
        "tabs": [
          {
            "id": "overview",
            "name": "Overview"
          }
        ],
        "dashboard_id": "usage_rename_both_ops_close_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace"
    ]
  },
  "eval": {
    "required_dashboard_name_contains": "Fund Close Control",
    "required_tab_names": [
      "Close Checklist"
    ],
    "required_tool_calls": [
      {
        "tool": "manage_dashboard",
        "args_contains": {
          "operation": "update",
          "name": "Fund Close Control"
        }
      },
      {
        "tool": "manage_navigation_bar",
        "args_contains": {
          "operation": "rename_tabs"
        }
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 0
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference_trace": [
      {
        "tool": "manage_dashboard",
        "args": {
          "operation": "update",
          "dashboard_id": "usage_rename_both_ops_close_dashboard_001",
          "name": "Fund Close Control"
        }
      },
      {
        "tool": "manage_navigation_bar",
        "args": {
          "operation": "rename_tabs",
          "rename_map": {
            "overview": "Close Checklist"
          }
        }
      }
    ],
    "max_turns": 5
  }
}
