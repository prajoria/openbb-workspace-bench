{
  "id": "rename_both_pm_morning",
  "category": "single-widget",
  "family": "navigate",
  "difficulty": "medium",
  "prompt": "Set the active dashboard name to PM Morning Review and rename the Overview tab to Holdings View.",
  "fixtures": {
    "backends": [
      {
        "name": "portfolio"
      }
    ]
  },
  "initial_state": {
    "dashboard": {
      "name": "PM Board",
      "activate": true,
      "tabs": [
        {
          "id": "overview",
          "name": "Overview"
        }
      ]
    }
  },
  "allowed_tools": [
    "get_workspace_snapshot",
    "manage_dashboard",
    "manage_navigation_bar",
    "navigate_workspace"
  ],
  "success": {
    "required_dashboard_name_contains": "PM Morning Review",
    "required_tab_names": [
      "Holdings View"
    ],
    "required_tool_calls": [
      {
        "tool": "manage_dashboard",
        "args_contains": {
          "operation": "update",
          "name": "PM Morning Review"
        }
      },
      {
        "tool": "manage_navigation_bar",
        "args_contains": {
          "operation": "rename_tabs"
        }
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 0
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "manage_dashboard",
      "args": {
        "operation": "update",
        "dashboard_id": "dash_001",
        "name": "PM Morning Review"
      }
    },
    {
      "tool": "manage_navigation_bar",
      "args": {
        "operation": "rename_tabs",
        "rename_map": {
          "overview": "Holdings View"
        }
      }
    }
  ],
  "limits": {
    "max_turns": 5
  }
}
