{
  "id": "expand_client_expansion",
  "category": "single-widget",
  "family": "navigate",
  "difficulty": "medium",
  "prompt": "Set the active dashboard name to Client Command Center, add a new tab named Open Requests, and add a HTML card on the new tab that mentions open requests and says items are pending.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "stark-enterprise"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Client Board",
        "activate": true,
        "tabs": [
          {
            "id": "overview",
            "name": "Overview"
          }
        ],
        "dashboard_id": "usage_expand_client_expansion_dashboard_001",
        "widgets": [
          {
            "origin": "Bench Stark Enterprise",
            "widget_id": "stress_liquidity_lab_sign_off_sign_off_tracker",
            "data_args": {},
            "tab_id": "overview",
            "layout": {
              "x": 0,
              "y": 500,
              "w": 8,
              "h": 4
            },
            "widget_uuid": "usage_expand_client_expansion_widget_001"
          }
        ]
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "add_generative_widget"
    ]
  },
  "eval": {
    "required_dashboard_name_contains": "Client Command Center",
    "required_tabs": [
      "overview",
      "open-requests"
    ],
    "required_generated_widgets": [
      {
        "widget_type": "html",
        "data_contains": [
          "open requests",
          "pending"
        ],
        "tab_id": "open-requests"
      }
    ],
    "required_tool_calls": [
      {
        "tool": "manage_navigation_bar",
        "args_contains": {
          "operation": "add_tabs"
        }
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 0
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "required_widgets": [
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "stress_liquidity_lab_sign_off_sign_off_tracker",
        "data_args": {},
        "tab_id": "overview",
        "min_count": 1,
        "max_count": 1
      }
    ],
    "reference": [
      {
        "tool": "manage_dashboard",
        "args": {
          "operation": "update",
          "dashboard_id": "usage_expand_client_expansion_dashboard_001",
          "name": "Client Command Center"
        }
      },
      {
        "tool": "manage_navigation_bar",
        "args": {
          "operation": "add_tabs",
          "tabs": [
            {
              "name": "Open Requests"
            }
          ]
        }
      },
      {
        "tool": "navigate_workspace",
        "args": {
          "operation": "tab",
          "tab_id": "open-requests"
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "html",
          "name": "Tab Note",
          "data": "<section>Tracking open requests: items are pending review.</section>"
        }
      }
    ],
    "limits": {
      "max_turns": 7
    }
  }
}
