{
  "id": "rename_macro_watch",
  "category": "single-widget",
  "family": "navigate",
  "difficulty": "easy",
  "prompt": "Rename the active dashboard to Rates Watch.",
  "fixtures": {
    "backends": [
      {
        "name": "macro"
      }
    ]
  },
  "initial_state": {
    "dashboard": {
      "name": "Macro Board",
      "activate": true,
      "tabs": [
        {
          "id": "overview",
          "name": "Overview"
        }
      ]
    }
  },
  "allowed_tools": [
    "get_workspace_snapshot",
    "manage_dashboard"
  ],
  "success": {
    "required_dashboard_name_contains": "Rates Watch",
    "required_tool_calls": [
      {
        "tool": "manage_dashboard",
        "args_contains": {
          "operation": "update",
          "name": "Rates Watch"
        }
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 0
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "manage_dashboard",
      "args": {
        "operation": "update",
        "dashboard_id": "dash_001",
        "name": "Rates Watch"
      }
    }
  ],
  "limits": {
    "max_turns": 4
  }
}
