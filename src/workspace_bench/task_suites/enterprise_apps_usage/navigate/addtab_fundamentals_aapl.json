{
  "id": "addtab_fundamentals_aapl",
  "category": "repair",
  "family": "navigate",
  "difficulty": "medium",
  "prompt": "This dashboard is missing its Fundamentals tab. Add a tab named Fundamentals and put the Company List with ID Mapping widget for AAPL on it. Keep the existing Overview tab intact.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "getting-started"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Incomplete Review",
        "activate": true,
        "tabs": [
          {
            "id": "overview",
            "name": "Overview"
          }
        ],
        "widgets": [
          {
            "origin": "Getting Started",
            "widget_id": "table_widget_with_grouping_by_cell_click",
            "data_args": {
              "symbol": "AAPL"
            },
            "tab_id": "overview",
            "layout": {
              "x": 0,
              "y": 2,
              "w": 20,
              "h": 12
            },
            "widget_uuid": "usage_addtab_fundamentals_aapl_widget_001"
          }
        ],
        "dashboard_id": "usage_addtab_fundamentals_aapl_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "create_widget"
    ]
  },
  "eval": {
    "required_tabs": [
      "overview",
      "fundamentals"
    ],
    "required_widgets": [
      {
        "origin": "Getting Started",
        "widget_id": "table_widget_with_grouping_by_cell_click",
        "data_args": {
          "symbol": "AAPL"
        },
        "tab_id": "overview",
        "min_count": 1
      },
      {
        "origin": "Getting Started",
        "widget_id": "company_list",
        "data_args": {
          "companyId": "TM"
        },
        "tab_id": "fundamentals",
        "min_count": 1
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "manage_navigation_bar",
        "args": {
          "operation": "add_tabs",
          "tabs": [
            {
              "name": "Fundamentals"
            }
          ]
        }
      },
      {
        "tool": "navigate_workspace",
        "args": {
          "operation": "tab",
          "tab_id": "fundamentals"
        }
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Getting Started"
        }
      },
      {
        "tool": "get_widget_schema",
        "args": {
          "origin": "Getting Started",
          "widget_id": "company_list"
        }
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Getting Started",
          "widget_id": "company_list",
          "data_args": {
            "companyId": "TM"
          }
        }
      }
    ],
    "limits": {
      "max_turns": 9
    }
  }
}
