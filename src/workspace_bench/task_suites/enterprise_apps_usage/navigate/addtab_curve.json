{
  "id": "addtab_curve",
  "category": "repair",
  "family": "navigate",
  "difficulty": "hard",
  "prompt": "Add the missing Curve tab to this dashboard and put the Metric Widget on it. Keep the existing Overview tab intact.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "getting-started"
        },
        {
          "name": "widget-examples"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Incomplete Review",
        "activate": true,
        "tabs": [
          {
            "id": "overview",
            "name": "Overview"
          }
        ],
        "widgets": [
          {
            "origin": "Getting Started",
            "widget_id": "company_performance",
            "data_args": {
              "company": "GM",
              "year": "2024"
            },
            "tab_id": "overview",
            "layout": {
              "x": 0,
              "y": 2,
              "w": 20,
              "h": 12
            },
            "widget_uuid": "usage_addtab_curve_widget_001"
          }
        ],
        "dashboard_id": "usage_addtab_curve_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "create_widget"
    ]
  },
  "eval": {
    "required_tabs": [
      "overview",
      "curve"
    ],
    "required_widgets": [
      {
        "origin": "Getting Started",
        "widget_id": "company_performance",
        "data_args": {
          "company": "GM",
          "year": "2024"
        },
        "tab_id": "overview",
        "min_count": 1
      },
      {
        "origin": "Widget Examples",
        "widget_id": "test_metric",
        "data_args": {},
        "tab_id": "curve",
        "min_count": 1
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "manage_navigation_bar",
        "args": {
          "operation": "add_tabs",
          "tabs": [
            {
              "name": "Curve"
            }
          ]
        }
      },
      {
        "tool": "navigate_workspace",
        "args": {
          "operation": "tab",
          "tab_id": "curve"
        }
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Widget Examples"
        }
      },
      {
        "tool": "get_widget_schema",
        "args": {
          "origin": "Widget Examples",
          "widget_id": "test_metric"
        }
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Widget Examples",
          "widget_id": "test_metric",
          "data_args": {}
        }
      }
    ],
    "limits": {
      "max_turns": 9
    }
  }
}
