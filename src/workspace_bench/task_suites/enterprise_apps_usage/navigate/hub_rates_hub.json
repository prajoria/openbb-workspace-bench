{
  "id": "hub_rates_hub",
  "category": "dashboard",
  "family": "navigate",
  "difficulty": "hard",
  "prompt": "Set the active dashboard name to Rates Hub, add a new tab named Curve, put the Metric Widget on it, and add a note on the same tab mentioning curve and rates hub.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "widget-examples"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Starter Board",
        "activate": true,
        "tabs": [
          {
            "id": "overview",
            "name": "Overview"
          }
        ],
        "dashboard_id": "usage_hub_rates_hub_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "create_widget",
      "add_generative_widget"
    ]
  },
  "eval": {
    "required_dashboard_name_contains": "Rates Hub",
    "required_tabs": [
      "overview",
      "curve"
    ],
    "required_widgets": [
      {
        "origin": "Widget Examples",
        "widget_id": "test_metric",
        "data_args": {},
        "tab_id": "curve",
        "min_count": 1
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "curve",
          "rates hub"
        ],
        "tab_id": "curve"
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference": [
      {
        "tool": "manage_dashboard",
        "args": {
          "operation": "update",
          "dashboard_id": "usage_hub_rates_hub_dashboard_001",
          "name": "Rates Hub"
        }
      },
      {
        "tool": "manage_navigation_bar",
        "args": {
          "operation": "add_tabs",
          "tabs": [
            {
              "name": "Curve"
            }
          ]
        }
      },
      {
        "tool": "navigate_workspace",
        "args": {
          "operation": "tab",
          "tab_id": "curve"
        }
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Widget Examples"
        }
      },
      {
        "tool": "get_widget_schema",
        "args": {
          "origin": "Widget Examples",
          "widget_id": "test_metric"
        }
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Widget Examples",
          "widget_id": "test_metric",
          "data_args": {}
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Hub Note",
          "data": "Rates hub: curve tab holds the term-structure view."
        }
      }
    ],
    "limits": {
      "max_turns": 9
    }
  }
}
