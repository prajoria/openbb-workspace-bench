{
  "id": "crypto_document_controls_level5",
  "category": "platform",
  "difficulty": "level5",
  "prompt": "Document-controls build tuning: add a custom backend Wave Two Document Tuning with a Document Control Panel table carrying filenames and category params, publish and instantiate Document Tuning App on Controls, then set the live Document Control Panel to filenames solana.pdf, category l1. Follow the widgets manifest specification. Widget ids are the snake_case of widget names; tab ids are the snake_case of tab names.",
  "setup": {
    "workspace_baseline": "stark-workspace-a",
    "workspace_backends": [
      "stark-enterprise-x",
      "support-daloopa-skills",
      "getting-started",
      "widget-examples"
    ],
    "workspace_skills": [
      "daloopa-capital-allocation",
      "daloopa-earnings-review",
      "daloopa-guidance-tracker",
      "daloopa-industry",
      "daloopa-inflection",
      "daloopa-tearsheet",
      "finance-comps",
      "finance-earnings-prep",
      "finance-guidance-tracker",
      "finance-tearsheet"
    ],
    "default_selected_dashboard": "Home",
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_tools": [
      {
        "tool": "get_workspace_snapshot",
        "args": {},
        "optional": true
      },
      {
        "tool": "read_workspace_resource",
        "args": {
          "uri": "openbb://workspace/specs/widgets-json"
        },
        "optional": true
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Wave Two Document Tuning",
          "url": "http://127.0.0.1:9722",
          "widgets_json": {
            "document_control_panel": {
              "name": "Document Control Panel",
              "description": "Authored tuning table for Document-controls.",
              "endpoint": "/document_control_panel",
              "type": "table",
              "gridData": {
                "w": 40,
                "h": 10
              },
              "params": [
                {
                  "paramName": "filenames",
                  "type": "text",
                  "label": "Filenames",
                  "value": "solana.pdf",
                  "options": [
                    {
                      "label": "solana.pdf",
                      "value": "solana.pdf"
                    }
                  ]
                },
                {
                  "paramName": "category",
                  "type": "text",
                  "label": "Category",
                  "value": "l1",
                  "options": [
                    {
                      "label": "l1",
                      "value": "l1"
                    }
                  ]
                }
              ]
            }
          },
          "apps_json": [
            {
              "name": "Document Tuning App",
              "description": "Wave-1 authored app for Document Tuning App.",
              "tabs": {
                "controls": {
                  "id": "controls",
                  "name": "Controls",
                  "layout": [
                    {
                      "i": "document_control_panel",
                      "x": 0,
                      "y": 0,
                      "w": 40,
                      "h": 10
                    }
                  ]
                }
              }
            }
          ]
        },
        "graded_args": [
          "operation",
          "name"
        ]
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "list"
        },
        "optional": true
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_005",
          "app_name": "Document Tuning App",
          "dashboard_name": "Document-controls Tuned",
          "activate": true
        },
        "graded_args": [
          "operation"
        ]
      },
      {
        "tool": "update_widget",
        "args": {
          "widget_id": "document_control_panel",
          "data_args": {
            "filenames": "solana.pdf",
            "category": "l1"
          }
        },
        "graded_args": [
          "data_args"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Wave Two Document Tuning",
        "widget_id": "document_control_panel",
        "data_args": {
          "filenames": "solana.pdf",
          "category": "l1"
        },
        "tab_id": "controls"
      }
    ],
    "required_widget_defs": [
      {
        "backend_name": "Wave Two Document Tuning",
        "widget_id": "document_control_panel",
        "expect": {
          "type": "table"
        }
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Wave Two Document Tuning",
        "name_contains": "Document Tuning App",
        "tabs_include": [
          "controls"
        ],
        "layout_refs_valid": true,
        "widgets_on_tab": [
          {
            "tab_id": "controls",
            "widget_id": "document_control_panel"
          }
        ]
      }
    ],
    "max_turns": 9
  }
}
