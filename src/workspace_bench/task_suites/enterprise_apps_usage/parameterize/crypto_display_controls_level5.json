{
  "id": "crypto_display_controls_level5",
  "category": "platform",
  "difficulty": "level5",
  "prompt": "Crypto-display build tuning: add a custom backend Wave Three Display Tuning with a Display Control Panel table carrying symbol and interval params, publish and instantiate Display Tuning App on Controls, then set the live Display Control Panel to symbol ethusdt, interval 1m. Follow the widgets manifest specification. Widget ids are the snake_case of widget names; tab ids are the snake_case of tab names.",
  "setup": {
    "workspace_baseline": "stark-workspace-a",
    "workspace_backends": [
      "stark-enterprise-x",
      "support-daloopa-skills",
      "getting-started",
      "widget-examples"
    ],
    "workspace_skills": [
      "daloopa-capital-allocation",
      "daloopa-earnings-review",
      "daloopa-guidance-tracker",
      "daloopa-industry",
      "daloopa-inflection",
      "daloopa-tearsheet",
      "finance-comps",
      "finance-earnings-prep",
      "finance-guidance-tracker",
      "finance-tearsheet"
    ],
    "default_selected_dashboard": "Home",
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_tools": [
      {
        "tool": "get_workspace_snapshot",
        "args": {},
        "optional": true
      },
      {
        "tool": "read_workspace_resource",
        "args": {
          "uri": "openbb://workspace/specs/widgets-json"
        },
        "optional": true
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Wave Three Display Tuning",
          "url": "http://127.0.0.1:9724",
          "widgets_json": {
            "display_control_panel": {
              "name": "Display Control Panel",
              "description": "Authored tuning table for Crypto-display.",
              "endpoint": "/display_control_panel",
              "type": "table",
              "gridData": {
                "w": 40,
                "h": 10
              },
              "params": [
                {
                  "paramName": "symbol",
                  "type": "text",
                  "label": "Symbol",
                  "value": "ethusdt",
                  "options": [
                    {
                      "label": "ethusdt",
                      "value": "ethusdt"
                    }
                  ]
                },
                {
                  "paramName": "interval",
                  "type": "text",
                  "label": "Interval",
                  "value": "1m",
                  "options": [
                    {
                      "label": "1m",
                      "value": "1m"
                    }
                  ]
                }
              ]
            }
          },
          "apps_json": [
            {
              "name": "Display Tuning App",
              "description": "Wave-1 authored app for Display Tuning App.",
              "tabs": {
                "controls": {
                  "id": "controls",
                  "name": "Controls",
                  "layout": [
                    {
                      "i": "display_control_panel",
                      "x": 0,
                      "y": 0,
                      "w": 40,
                      "h": 10
                    }
                  ]
                }
              }
            }
          ]
        },
        "graded_args": [
          "operation",
          "name"
        ]
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "list"
        },
        "optional": true
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_005",
          "app_name": "Display Tuning App",
          "dashboard_name": "Crypto-display Tuned",
          "activate": true
        },
        "graded_args": [
          "operation"
        ]
      },
      {
        "tool": "update_widget",
        "args": {
          "widget_id": "display_control_panel",
          "data_args": {
            "symbol": "ethusdt",
            "interval": "1m"
          }
        },
        "graded_args": [
          "data_args"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Wave Three Display Tuning",
        "widget_id": "display_control_panel",
        "data_args": {
          "symbol": "ethusdt",
          "interval": "1m"
        },
        "tab_id": "controls"
      }
    ],
    "required_widget_defs": [
      {
        "backend_name": "Wave Three Display Tuning",
        "widget_id": "display_control_panel",
        "expect": {
          "type": "table"
        }
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Wave Three Display Tuning",
        "name_contains": "Display Tuning App",
        "tabs_include": [
          "controls"
        ],
        "layout_refs_valid": true,
        "widgets_on_tab": [
          {
            "tab_id": "controls",
            "widget_id": "display_control_panel"
          }
        ]
      }
    ],
    "max_turns": 9
  }
}
