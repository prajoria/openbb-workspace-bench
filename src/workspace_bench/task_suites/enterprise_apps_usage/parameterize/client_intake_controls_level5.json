{
  "id": "client_intake_controls_level5",
  "category": "platform",
  "difficulty": "level5",
  "prompt": "The desk wants intake tuning self-serve - add Buildout Intake Tuning as a custom backend with an Intake Control Panel table carrying risk_profile and client_last_name params per the widgets.json spec, publish and instantiate its app on Controls, set the live panel to Moderate and Chen, and finish with a Client-intake Tuning Note recording the param kind the Widget Parameters resource names between endpoint and button.",
  "setup": {
    "workspace_baseline": "stark-workspace-a",
    "workspace_backends": [
      "stark-enterprise-x",
      "support-daloopa-skills",
      "getting-started",
      "widget-examples"
    ],
    "workspace_skills": [
      "daloopa-capital-allocation",
      "daloopa-earnings-review",
      "daloopa-guidance-tracker",
      "daloopa-industry",
      "daloopa-inflection",
      "daloopa-tearsheet",
      "finance-comps",
      "finance-earnings-prep",
      "finance-guidance-tracker",
      "finance-tearsheet"
    ],
    "default_selected_dashboard": "Home",
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_tools": [
      {
        "tool": "get_workspace_snapshot",
        "args": {},
        "optional": true
      },
      {
        "tool": "read_workspace_resource",
        "args": {
          "uri": "openbb://workspace/specs/widget-parameters"
        },
        "graded_args": [
          "uri"
        ]
      },
      {
        "tool": "read_workspace_resource",
        "args": {
          "uri": "openbb://workspace/specs/widgets-json"
        },
        "optional": true
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Buildout Intake Tuning",
          "url": "http://127.0.0.1:9723",
          "widgets_json": {
            "intake_control_panel": {
              "name": "Intake Control Panel",
              "description": "Authored tuning table for Client-intake.",
              "endpoint": "/intake_control_panel",
              "type": "table",
              "gridData": {
                "w": 40,
                "h": 10
              },
              "params": [
                {
                  "paramName": "risk_profile",
                  "type": "text",
                  "label": "Risk Profile",
                  "value": "Moderate",
                  "options": [
                    {
                      "label": "Moderate",
                      "value": "Moderate"
                    }
                  ]
                },
                {
                  "paramName": "client_last_name",
                  "type": "text",
                  "label": "Client Last Name",
                  "value": "Chen",
                  "options": [
                    {
                      "label": "Chen",
                      "value": "Chen"
                    }
                  ]
                }
              ]
            }
          },
          "apps_json": [
            {
              "name": "Intake Tuning App",
              "description": "Authored app for Intake Tuning App.",
              "tabs": {
                "controls": {
                  "id": "controls",
                  "name": "Controls",
                  "layout": [
                    {
                      "i": "intake_control_panel",
                      "x": 0,
                      "y": 0,
                      "w": 40,
                      "h": 10
                    }
                  ]
                }
              }
            }
          ]
        },
        "graded_args": [
          "operation",
          "name"
        ]
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "list"
        },
        "optional": true
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_005",
          "app_name": "Intake Tuning App",
          "dashboard_name": "Client-intake Tuned",
          "activate": true
        },
        "graded_args": [
          "operation"
        ]
      },
      {
        "tool": "update_widget",
        "args": {
          "widget_id": "intake_control_panel",
          "data_args": {
            "risk_profile": "Moderate",
            "client_last_name": "Chen"
          }
        },
        "graded_args": [
          "data_args"
        ]
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Client-intake Tuning Note",
          "data": "form"
        },
        "graded_args": [
          "widget_type",
          "name"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Buildout Intake Tuning",
        "widget_id": "intake_control_panel",
        "data_args": {
          "risk_profile": "Moderate",
          "client_last_name": "Chen"
        },
        "tab_id": "controls"
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "name_contains": "Client-intake Tuning Note",
        "data_contains": [
          "form"
        ]
      }
    ],
    "required_widget_defs": [
      {
        "backend_name": "Buildout Intake Tuning",
        "widget_id": "intake_control_panel",
        "expect": {
          "type": "table"
        }
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Buildout Intake Tuning",
        "name_contains": "Intake Tuning App",
        "tabs_include": [
          "controls"
        ],
        "layout_refs_valid": true,
        "widgets_on_tab": [
          {
            "tab_id": "controls",
            "widget_id": "intake_control_panel"
          }
        ]
      }
    ],
    "max_turns": 11
  }
}
