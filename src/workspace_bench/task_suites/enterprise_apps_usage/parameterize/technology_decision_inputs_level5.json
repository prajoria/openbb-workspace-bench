{
  "id": "technology_decision_inputs_level5",
  "category": "platform",
  "difficulty": "level5",
  "prompt": "Tune Pilot Decision Tuning end to end: add it as a custom backend with a Decision Input Panel table carrying company and period params, publish and instantiate Decision Tuning App on Controls, then set the live Decision Input Panel to company TSLA, period QTD. Follow the widgets.json spec.  Follow the Finance Earnings Prep skill and add a Decision-inputs Tuning Note recording what it compares to street numbers first.",
  "setup": {
    "workspace_baseline": "stark-workspace-a",
    "workspace_backends": [
      "stark-enterprise-x",
      "support-daloopa-skills",
      "getting-started",
      "widget-examples"
    ],
    "workspace_skills": [
      "daloopa-capital-allocation",
      "daloopa-earnings-review",
      "daloopa-guidance-tracker",
      "daloopa-industry",
      "daloopa-inflection",
      "daloopa-tearsheet",
      "finance-comps",
      "finance-earnings-prep",
      "finance-guidance-tracker",
      "finance-tearsheet"
    ],
    "default_selected_dashboard": "Home",
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_tools": [
      {
        "tool": "get_workspace_snapshot",
        "args": {},
        "optional": true
      },
      {
        "tool": "get_skill_content",
        "args": {
          "slug": "finance-earnings-prep"
        },
        "graded_args": [
          "slug"
        ]
      },
      {
        "tool": "read_workspace_resource",
        "args": {
          "uri": "openbb://workspace/specs/widgets-json"
        },
        "optional": true
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Pilot Decision Tuning",
          "url": "http://127.0.0.1:9721",
          "widgets_json": {
            "decision_input_panel": {
              "name": "Decision Input Panel",
              "description": "Authored tuning table for Decision-inputs.",
              "endpoint": "/decision_input_panel",
              "type": "table",
              "gridData": {
                "w": 40,
                "h": 10
              },
              "params": [
                {
                  "paramName": "company",
                  "type": "text",
                  "label": "Company",
                  "value": "TSLA",
                  "options": [
                    {
                      "label": "TSLA",
                      "value": "TSLA"
                    }
                  ]
                },
                {
                  "paramName": "period",
                  "type": "text",
                  "label": "Period",
                  "value": "QTD",
                  "options": [
                    {
                      "label": "QTD",
                      "value": "QTD"
                    }
                  ]
                }
              ]
            }
          },
          "apps_json": [
            {
              "name": "Decision Tuning App",
              "description": "Authored app for Decision Tuning App.",
              "tabs": {
                "controls": {
                  "id": "controls",
                  "name": "Controls",
                  "layout": [
                    {
                      "i": "decision_input_panel",
                      "x": 0,
                      "y": 0,
                      "w": 40,
                      "h": 10
                    }
                  ]
                }
              }
            }
          ]
        },
        "graded_args": [
          "operation",
          "name"
        ]
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "list"
        },
        "optional": true
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_005",
          "app_name": "Decision Tuning App",
          "dashboard_name": "Decision-inputs Tuned",
          "activate": true
        },
        "graded_args": [
          "operation"
        ]
      },
      {
        "tool": "update_widget",
        "args": {
          "widget_id": "decision_input_panel",
          "data_args": {
            "company": "TSLA",
            "period": "QTD"
          }
        },
        "graded_args": [
          "data_args"
        ]
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Decision-inputs Tuning Note",
          "data": "internal estimates"
        },
        "graded_args": [
          "widget_type",
          "name"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Pilot Decision Tuning",
        "widget_id": "decision_input_panel",
        "data_args": {
          "company": "TSLA",
          "period": "QTD"
        },
        "tab_id": "controls"
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "name_contains": "Decision-inputs Tuning Note",
        "data_contains": [
          "internal estimates"
        ]
      }
    ],
    "required_widget_defs": [
      {
        "backend_name": "Pilot Decision Tuning",
        "widget_id": "decision_input_panel",
        "expect": {
          "type": "table"
        }
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Pilot Decision Tuning",
        "name_contains": "Decision Tuning App",
        "tabs_include": [
          "controls"
        ],
        "layout_refs_valid": true,
        "widgets_on_tab": [
          {
            "tab_id": "controls",
            "widget_id": "decision_input_panel"
          }
        ]
      }
    ],
    "max_turns": 11
  }
}
