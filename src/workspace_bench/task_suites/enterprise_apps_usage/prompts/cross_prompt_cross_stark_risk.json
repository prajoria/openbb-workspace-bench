{
  "id": "cross_prompt_cross_stark_risk",
  "category": "dashboard",
  "family": "prompts",
  "difficulty": "hard",
  "prompt": "Fetch workspace_tool_usage and workspace_session_context, create Prompt Cross Stark Risk, build the cross-backend dashboard with Bench Stark Enterprise/portfolio_command_center_actions_analyst_conviction and Widget Examples/whitepapers, and add a HTML card mentioning stark and risk and current-dashboard.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "stark-enterprise"
        },
        {
          "name": "widget-examples"
        }
      ]
    },
    "initial_state": {},
    "allowed_tools": [
      "get_workspace_prompt",
      "manage_dashboard",
      "list_available_widgets",
      "get_widget_schema",
      "create_widget",
      "add_generative_widget"
    ]
  },
  "eval": {
    "required_dashboard_name_contains": "Prompt Cross Stark Risk",
    "required_tool_calls": [
      {
        "tool": "get_workspace_prompt",
        "args_contains": {
          "name": "workspace_tool_usage"
        }
      },
      {
        "tool": "get_workspace_prompt",
        "args_contains": {
          "name": "workspace_session_context"
        }
      }
    ],
    "required_widgets": [
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "portfolio_command_center_actions_analyst_conviction",
        "data_args": {}
      },
      {
        "origin": "Widget Examples",
        "widget_id": "whitepapers",
        "data_args": {
          "filenames": [
            "bitcoin.pdf"
          ]
        }
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "html",
        "data_contains": [
          "stark",
          "risk",
          "current-dashboard"
        ]
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference": [
      {
        "tool": "get_workspace_prompt",
        "args": {
          "name": "workspace_tool_usage"
        }
      },
      {
        "tool": "get_workspace_prompt",
        "args": {
          "name": "workspace_session_context"
        }
      },
      {
        "tool": "manage_dashboard",
        "args": {
          "operation": "create",
          "name": "Prompt Cross Stark Risk"
        }
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Bench Stark Enterprise"
        }
      },
      {
        "tool": "get_widget_schema",
        "args": {
          "origin": "Bench Stark Enterprise",
          "widget_id": "portfolio_command_center_actions_analyst_conviction"
        }
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Bench Stark Enterprise",
          "widget_id": "portfolio_command_center_actions_analyst_conviction",
          "data_args": {}
        }
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Widget Examples"
        }
      },
      {
        "tool": "get_widget_schema",
        "args": {
          "origin": "Widget Examples",
          "widget_id": "whitepapers"
        }
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Widget Examples",
          "widget_id": "whitepapers",
          "data_args": {
            "filenames": [
              "bitcoin.pdf"
            ]
          }
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "html",
          "name": "Prompt Cross Note",
          "data": "<section>Prompt cross build: stark, risk, current-dashboard.</section>"
        }
      }
    ],
    "limits": {
      "max_turns": 12
    }
  }
}
