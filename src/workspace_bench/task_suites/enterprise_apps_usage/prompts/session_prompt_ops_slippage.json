      }
    },
    {
      "tool": "add_generative_widget",
      "args": {
        "widget_type": "html",
        "name": "Session Prompt Note",
        "data": "<section>Ops built using current tab guidance.</section>"
      }
    }
  ],
  "limits": {
    "max_turns": 10
  }
