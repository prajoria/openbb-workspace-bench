      "overview",
      "ops"
    ],
    "required_tool_results": [
      {
        "tool": "get_workspace_prompt",
        "data_contains": [
          "current-dashboard current-tab session grounding"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "liquidity_tca_workbench_tca_slippage_by_algo",
        "data_args": {},
        "tab_id": "ops"
      },
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "workspace_data_control_center_entitlements_copilot_visibility_flags",
        "data_args": {},
        "tab_id": "overview",
        "min_count": 1,
        "max_count": 1
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "html",
        "data_contains": [
          "Ops"
        ],
        "tab_id": "ops"
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_prompt",
      "args": {
        "name": "workspace_session_context"
      }
    },
    {
      "tool": "manage_navigation_bar",
      "args": {
        "operation": "add_tabs",
        "tabs": [
          {
            "name": "Ops"
          }
        ]
      }
    },
    {
      "tool": "navigate_workspace",
      "args": {
        "operation": "tab",
        "tab_id": "ops"
      }
    },
    {
      "tool": "list_available_widgets",
      "args": {
        "origin": "Bench Stark Enterprise"
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Bench Stark Enterprise",
        "widget_id": "liquidity_tca_workbench_tca_slippage_by_algo"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Bench Stark Enterprise",
        "widget_id": "liquidity_tca_workbench_tca_slippage_by_algo",
