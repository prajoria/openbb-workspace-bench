{
  "id": "cross_prompt_cross_book_cpi",
  "category": "dashboard",
  "family": "prompts",
  "difficulty": "hard",
  "prompt": "Get workspace_tool_usage and workspace_session_context, create Prompt Cross Book CPI, build the cross-backend dashboard with Bench Portfolio/sector_exposure and Bench Macro/macro_timeseries with data_args {\"series\": \"CPIAUCSL\"}, and add a HTML card mentioning sector and CPIAUCSL and current-dashboard.",
  "fixtures": {
    "backends": [
      {
        "name": "macro"
      },
      {
        "name": "portfolio"
      }
    ]
  },
  "initial_state": {},
  "allowed_tools": [
    "get_workspace_prompt",
    "manage_dashboard",
    "list_available_widgets",
    "get_widget_schema",
    "create_widget",
    "add_generative_widget"
  ],
  "success": {
    "required_dashboard_name_contains": "Prompt Cross Book CPI",
    "required_tool_calls": [
      {
        "tool": "get_workspace_prompt",
        "args_contains": {
          "name": "workspace_tool_usage"
        }
      },
      {
        "tool": "get_workspace_prompt",
        "args_contains": {
          "name": "workspace_session_context"
        }
      }
    ],
    "required_widgets": [
      {
        "origin": "Bench Portfolio",
        "widget_id": "sector_exposure",
        "data_args": {}
      },
      {
        "origin": "Bench Macro",
        "widget_id": "macro_timeseries",
        "data_args": {
          "series": "CPIAUCSL"
        }
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "html",
        "data_contains": [
          "sector",
          "CPIAUCSL",
          "current-dashboard"
        ]
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_prompt",
      "args": {
        "name": "workspace_tool_usage"
      }
    },
    {
      "tool": "get_workspace_prompt",
      "args": {
        "name": "workspace_session_context"
      }
    },
    {
      "tool": "manage_dashboard",
      "args": {
        "operation": "create",
        "name": "Prompt Cross Book CPI"
      }
    },
    {
      "tool": "list_available_widgets",
      "args": {
        "origin": "Bench Portfolio"
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Bench Portfolio",
        "widget_id": "sector_exposure"
      }
    },
    {
