{
  "id": "follow_tool_usage_prompt_for_price_performance",
  "category": "dashboard",
  "family": "prompts",
  "difficulty": "easy",
  "prompt": "Call get_workspace_prompt with name workspace_tool_usage, then follow it by discovering schema before creating Getting Started/table_widget_with_grouping_by_cell_click with data_args {\"symbol\": \"AAPL\"}.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "getting-started"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Prompt Build",
        "activate": true,
        "tabs": [
          {
            "id": "",
            "name": ""
          }
        ],
        "dashboard_id": "usage_follow_tool_usage_prompt_for_price_performance_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "get_workspace_prompt",
      "list_available_widgets",
      "get_widget_schema",
      "create_widget"
    ]
  },
  "eval": {
    "required_tool_results": [
      {
        "tool": "get_workspace_prompt",
        "data_contains": [
          "schema-before-create workspace tool discipline"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Getting Started",
        "widget_id": "table_widget_with_grouping_by_cell_click",
        "data_args": {
          "symbol": "AAPL"
        }
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "get_workspace_prompt",
        "args": {
          "name": "workspace_tool_usage"
        }
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Getting Started"
        }
      },
      {
        "tool": "get_widget_schema",
        "args": {
          "origin": "Getting Started",
          "widget_id": "table_widget_with_grouping_by_cell_click"
        }
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Getting Started",
          "widget_id": "table_widget_with_grouping_by_cell_click",
          "data_args": {
            "symbol": "AAPL"
          }
        }
      }
    ],
    "limits": {
      "max_turns": 8
    }
  }
}
