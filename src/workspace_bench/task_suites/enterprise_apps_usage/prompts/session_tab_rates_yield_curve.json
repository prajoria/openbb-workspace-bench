{
  "id": "session_tab_rates_yield_curve",
  "category": "dashboard",
  "family": "prompts",
  "difficulty": "medium",
  "prompt": "After fetching workspace_session_context, add a Rates tab, navigate to it, fetch the widget schema, create Widget Examples/test_metric there, and add a note mentioning Rates on that tab.",
  "fixtures": {
    "backends": [
      {
        "name": "widget-examples"
      }
    ]
  },
  "initial_state": {
    "dashboard": {
      "name": "Prompt Session",
      "activate": true,
      "tabs": [
        {
          "id": "overview",
          "name": "Overview"
        }
      ],
      "dashboard_id": "usage_session_tab_rates_yield_curve_dashboard_001"
    }
  },
  "allowed_tools": [
    "get_workspace_prompt",
    "manage_navigation_bar",
    "navigate_workspace",
    "list_available_widgets",
    "get_widget_schema",
    "create_widget",
    "add_generative_widget"
  ],
  "success": {
    "required_tabs": [
      "overview",
      "rates"
    ],
    "required_tool_results": [
      {
        "tool": "get_workspace_prompt",
        "data_contains": [
          "current-dashboard current-tab session grounding"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Widget Examples",
        "widget_id": "test_metric",
        "data_args": {},
        "tab_id": "rates"
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "Rates"
        ],
        "tab_id": "rates"
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_prompt",
      "args": {
        "name": "workspace_session_context"
      }
    },
    {
      "tool": "manage_navigation_bar",
      "args": {
        "operation": "add_tabs",
        "tabs": [
          {
            "name": "Rates"
          }
        ]
      }
    },
    {
      "tool": "navigate_workspace",
      "args": {
        "operation": "tab",
        "tab_id": "rates"
      }
    },
    {
      "tool": "list_available_widgets",
      "args": {
        "origin": "Widget Examples"
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Widget Examples",
        "widget_id": "test_metric"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Widget Examples",
        "widget_id": "test_metric",
        "data_args": {}
      }
    },
    {
      "tool": "add_generative_widget",
      "args": {
        "widget_type": "note",
        "name": "Session Prompt Note",
        "data": "Rates built using current tab guidance."
      }
    }
  ],
  "limits": {
    "max_turns": 10
  }
}
