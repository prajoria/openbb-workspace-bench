{
  "id": "cross_prompt_cross_nvda_holdings",
  "category": "dashboard",
  "family": "prompts",
  "difficulty": "hard",
  "prompt": "Get workspace_tool_usage and workspace_session_context, create Prompt Cross TSLA Holdings, build the cross-backend dashboard with Getting Started/live_grid_data with data_args {\"symbol\": \"TSLA\"} and Widget Examples/test_metric, and add a note mentioning TSLA and holdings and current-dashboard.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "getting-started"
        },
        {
          "name": "widget-examples"
        }
      ]
    },
    "initial_state": {},
    "allowed_tools": [
      "get_workspace_prompt",
      "manage_dashboard",
      "list_available_widgets",
      "get_widget_schema",
      "create_widget",
      "add_generative_widget"
    ]
  },
  "eval": {
    "required_dashboard_name_contains": "Prompt Cross TSLA Holdings",
    "required_tool_calls": [
      {
        "tool": "get_workspace_prompt",
        "args_contains": {
          "name": "workspace_tool_usage"
        }
      },
      {
        "tool": "get_workspace_prompt",
        "args_contains": {
          "name": "workspace_session_context"
        }
      }
    ],
    "required_widgets": [
      {
        "origin": "Getting Started",
        "widget_id": "live_grid_data",
        "data_args": {
          "symbol": "TSLA"
        }
      },
      {
        "origin": "Widget Examples",
        "widget_id": "test_metric",
        "data_args": {}
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "TSLA",
          "holdings",
          "current-dashboard"
        ]
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference_trace": [
      {
        "tool": "get_workspace_prompt",
        "args": {
          "name": "workspace_tool_usage"
        }
      },
      {
        "tool": "get_workspace_prompt",
        "args": {
          "name": "workspace_session_context"
        }
      },
      {
        "tool": "manage_dashboard",
        "args": {
          "operation": "create",
          "name": "Prompt Cross TSLA Holdings"
        }
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Getting Started"
        }
      },
      {
        "tool": "get_widget_schema",
        "args": {
          "origin": "Getting Started",
          "widget_id": "live_grid_data"
        }
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Getting Started",
          "widget_id": "live_grid_data",
          "data_args": {
            "symbol": "TSLA"
          }
        }
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Widget Examples"
        }
      },
      {
        "tool": "get_widget_schema",
        "args": {
          "origin": "Widget Examples",
          "widget_id": "test_metric"
        }
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Widget Examples",
          "widget_id": "test_metric",
          "data_args": {}
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Prompt Cross Note",
          "data": "Prompt cross build: TSLA, holdings, current-dashboard."
        }
      }
    ],
    "max_turns": 12
  }
}
