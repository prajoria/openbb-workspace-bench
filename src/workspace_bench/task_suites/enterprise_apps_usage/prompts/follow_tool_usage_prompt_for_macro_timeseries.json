{
  "id": "follow_tool_usage_prompt_for_macro_timeseries",
  "category": "dashboard",
  "family": "prompts",
  "difficulty": "easy",
  "prompt": "Before creating Bench Macro/macro_timeseries with data_args {\"series\": \"DGS10\"}, call get_workspace_prompt with name workspace_tool_usage and follow it by discovering schema.",
  "fixtures": {
    "backends": [
      {
        "name": "macro"
      }
    ]
  },
  "initial_state": {
    "dashboard": {
      "name": "Prompt Build",
      "activate": true,
      "tabs": [
        {
          "id": "",
          "name": ""
        }
      ]
    }
  },
  "allowed_tools": [
    "get_workspace_snapshot",
    "get_workspace_prompt",
    "list_available_widgets",
    "get_widget_schema",
    "create_widget"
  ],
  "success": {
    "required_tool_results": [
      {
        "tool": "get_workspace_prompt",
        "data_contains": [
          "schema-before-create workspace tool discipline"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Bench Macro",
        "widget_id": "macro_timeseries",
        "data_args": {
          "series": "DGS10"
        }
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_snapshot",
      "args": {}
    },
    {
      "tool": "get_workspace_prompt",
      "args": {
        "name": "workspace_tool_usage"
      }
    },
    {
      "tool": "list_available_widgets",
      "args": {
        "origin": "Bench Macro"
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Bench Macro",
        "widget_id": "macro_timeseries"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Bench Macro",
        "widget_id": "macro_timeseries",
        "data_args": {
          "series": "DGS10"
        }
      }
    }
  ],
  "limits": {
    "max_turns": 8
  }
}
