{
  "id": "dashboard_portfolio_prompt_dashboard",
  "category": "dashboard",
  "family": "prompts",
  "difficulty": "hard",
  "prompt": "After fetching workspace_tool_usage, create dashboard Portfolio Prompt Dashboard, add Widget Examples/test_metric and Widget Examples/whitepapers with schema-first discipline, and add a note mentioning holdings and schema.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "widget-examples"
        }
      ]
    },
    "initial_state": {},
    "allowed_tools": [
      "get_workspace_prompt",
      "manage_dashboard",
      "list_available_widgets",
      "get_widget_schema",
      "create_widget",
      "add_generative_widget"
    ]
  },
  "eval": {
    "required_dashboard_name_contains": "Portfolio Prompt Dashboard",
    "required_tool_results": [
      {
        "tool": "get_workspace_prompt",
        "data_contains": [
          "schema-before-create workspace tool discipline"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Widget Examples",
        "widget_id": "test_metric",
        "data_args": {}
      },
      {
        "origin": "Widget Examples",
        "widget_id": "whitepapers",
        "data_args": {
          "filenames": [
            "bitcoin.pdf"
          ]
        }
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "holdings",
          "schema"
        ]
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference_trace": [
      {
        "tool": "get_workspace_prompt",
        "args": {
          "name": "workspace_tool_usage"
        }
      },
      {
        "tool": "manage_dashboard",
        "args": {
          "operation": "create",
          "name": "Portfolio Prompt Dashboard"
        }
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Widget Examples"
        }
      },
      {
        "tool": "get_widget_schema",
        "args": {
          "origin": "Widget Examples",
          "widget_id": "test_metric"
        }
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Widget Examples",
          "widget_id": "test_metric",
          "data_args": {}
        }
      },
      {
        "tool": "get_widget_schema",
        "args": {
          "origin": "Widget Examples",
          "widget_id": "whitepapers"
        }
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Widget Examples",
          "widget_id": "whitepapers",
          "data_args": {
            "filenames": [
              "bitcoin.pdf"
            ]
          }
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Prompt Build Note",
          "data": "Prompt build used holdings and schema."
        }
      }
    ],
    "max_turns": 11
  }
}
