        "data_args": {
          "symbol": "AAPL"
        }
      },
      {
        "origin": "Bench Macro",
        "widget_id": "macro_timeseries",
        "data_args": {
          "series": "DGS10"
        }
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "AAPL",
          "DGS10",
          "current-dashboard"
        ]
      }
    ],
    "layout": {
