{
  "id": "cross_prompt_cross_aapl_rates",
  "category": "dashboard",
  "family": "prompts",
  "difficulty": "hard",
  "prompt": "Get workspace_tool_usage and workspace_session_context, create Prompt Cross AAPL Rates, build the cross-backend dashboard with Bench Equities/price_performance with data_args {\"symbol\": \"AAPL\"} and Bench Macro/macro_timeseries with data_args {\"series\": \"DGS10\"}, and add a note mentioning AAPL and DGS10 and current-dashboard.",
  "fixtures": {
    "backends": [
      {
        "name": "equities"
      },
      {
        "name": "macro"
      }
    ]
  },
  "initial_state": {},
  "allowed_tools": [
    "get_workspace_prompt",
    "manage_dashboard",
    "list_available_widgets",
    "get_widget_schema",
    "create_widget",
    "add_generative_widget"
