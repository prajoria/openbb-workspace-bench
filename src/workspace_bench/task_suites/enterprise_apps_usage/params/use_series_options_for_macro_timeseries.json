{
  "id": "use_series_options_for_macro_timeseries",
  "category": "single-widget",
  "family": "params",
  "difficulty": "easy",
  "prompt": "For Getting Started/company_performance, call get_params_options on parameter series, choose GM, and create that widget with series=GM.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "getting-started"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Parameter Options",
        "activate": true,
        "tabs": [
          {
            "id": "",
            "name": ""
          }
        ],
        "dashboard_id": "usage_use_series_options_for_macro_timeseries_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "get_params_options",
      "create_widget"
    ]
  },
  "eval": {
    "required_widgets": [
      {
        "origin": "Getting Started",
        "widget_id": "company_performance",
        "data_args": {
          "company": "GM",
          "year": "2024"
        }
      }
    ],
    "required_tool_calls": [
      {
        "tool": "get_params_options",
        "args_contains": {
          "widget_id": "company_performance",
          "param_name": "company"
        }
      }
    ],
    "required_tool_results": [
      {
        "tool": "get_params_options",
        "data_contains": [
          "GM"
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "get_params_options",
        "args": {
          "origin": "Getting Started",
          "widget_id": "company_performance",
          "param_name": "company"
        }
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Getting Started",
          "widget_id": "company_performance",
          "data_args": {
            "company": "GM",
            "year": "2024"
          }
        }
      }
    ],
    "limits": {
      "max_turns": 6
    }
  }
}
