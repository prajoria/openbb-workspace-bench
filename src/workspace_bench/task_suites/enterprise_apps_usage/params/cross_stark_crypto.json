{
  "id": "cross_stark_crypto",
  "category": "dashboard",
  "family": "params",
  "difficulty": "hard",
  "prompt": "Build a dashboard with these two widgets after using parameter options for both: Bench Stark Enterprise/crypto_research_dashboard_derivatives_liquidation_heatmap crypto_asset=ETH; Widget Examples/whitepapers sector=defi. Add a note mentioning ETH and options.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "stark-enterprise"
        },
        {
          "name": "widget-examples"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
