{
  "id": "options_constrained_placement_for_sector_exposure",
  "category": "dashboard",
  "family": "params",
  "difficulty": "medium",
  "prompt": "Use get_params_options to choose AAPL for sector, fetch the widget schema, create Widget Examples/live_grid_example, and place it at x=0, y=0, width 20, height 10.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "widget-examples"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Parameter Placement",
        "activate": true,
        "tabs": [
          {
            "id": "",
            "name": ""
          }
        ],
        "dashboard_id": "usage_options_constrained_placement_for_sector_exposure_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "create_widget",
      "update_widget_layout"
    ]
  },
  "eval": {
    "required_widgets": [
      {
        "origin": "Widget Examples",
        "widget_id": "live_grid_example",
        "data_args": {
          "symbol": "AAPL"
        }
      }
    ],
    "required_layouts": [
      {
        "widget_id": "live_grid_example",
        "x": 0,
        "y": 0,
        "w": 20,
        "h": 10
      }
    ],
    "required_tool_results": [
      {
        "tool": "get_params_options",
        "data_contains": [
          "AAPL"
        ]
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference_trace": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Widget Examples"
        }
      },
      {
        "tool": "get_widget_schema",
        "args": {
          "origin": "Widget Examples",
          "widget_id": "live_grid_example"
        }
      },
      {
        "tool": "get_params_options",
        "args": {
          "origin": "Widget Examples",
          "widget_id": "live_grid_example",
          "param_name": "symbol"
        }
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Widget Examples",
          "widget_id": "live_grid_example",
          "data_args": {
            "symbol": "AAPL"
          }
        }
      },
      {
        "tool": "update_widget_layout",
        "args": {
          "widget_id": "live_grid_example",
          "x": 0,
          "y": 0,
          "w": 20,
          "h": 10
        }
      }
    ],
    "max_turns": 9
  }
}
