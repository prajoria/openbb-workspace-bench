{
  "id": "cross_aapl_macro",
  "category": "dashboard",
  "family": "params",
  "difficulty": "hard",
  "prompt": "Build a dashboard with these two widgets after using parameter options for both: Bench Equities/price_performance symbol=AAPL; Bench Macro/macro_timeseries series=DGS10. Add a note mentioning AAPL and DGS10.",
  "fixtures": {
    "backends": [
      {
        "name": "equities"
      },
      {
        "name": "macro"
      }
    ]
  },
  "initial_state": {
    "dashboard": {
      "name": "Cross Options",
      "activate": true,
      "tabs": [
        {
          "id": "",
          "name": ""
        }
      ]
    }
  },
  "allowed_tools": [
    "get_workspace_snapshot",
    "list_available_widgets",
    "get_widget_schema",
    "get_params_options",
    "create_widget",
    "add_generative_widget"
  ],
  "success": {
    "required_widgets": [
      {
        "origin": "Bench Equities",
        "widget_id": "price_performance",
        "data_args": {
          "symbol": "AAPL"
        }
      },
      {
        "origin": "Bench Macro",
        "widget_id": "macro_timeseries",
        "data_args": {
          "series": "DGS10"
        }
      }
    ],
    "required_tool_calls": [
      {
        "tool": "get_params_options",
        "args_contains": {
          "widget_id": "price_performance",
          "param_name": "symbol"
        }
      },
      {
        "tool": "get_params_options",
        "args_contains": {
          "widget_id": "macro_timeseries",
          "param_name": "series"
        }
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "AAPL",
          "DGS10"
        ]
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_snapshot",
      "args": {}
    },
    {
      "tool": "list_available_widgets",
      "args": {
        "origin": "Bench Equities"
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Bench Equities",
        "widget_id": "price_performance"
      }
    },
    {
      "tool": "get_params_options",
      "args": {
        "origin": "Bench Equities",
        "widget_id": "price_performance",
        "param_name": "symbol"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Bench Equities",
        "widget_id": "price_performance",
        "data_args": {
          "symbol": "AAPL"
        }
      }
    },
    {
      "tool": "list_available_widgets",
      "args": {
        "origin": "Bench Macro"
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Bench Macro",
        "widget_id": "macro_timeseries"
      }
    },
    {
      "tool": "get_params_options",
      "args": {
        "origin": "Bench Macro",
        "widget_id": "macro_timeseries",
        "param_name": "series"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Bench Macro",
        "widget_id": "macro_timeseries",
        "data_args": {
          "series": "DGS10"
        }
      }
    },
    {
      "tool": "add_generative_widget",
      "args": {
        "widget_type": "note",
        "name": "Options Note",
        "data": "Options used: AAPL, DGS10."
      }
    }
  ],
  "limits": {
    "max_turns": 12
  }
}
