{
  "id": "options_constrained_placement_for_macro_timeseries",
  "category": "dashboard",
  "family": "params",
  "difficulty": "medium",
  "prompt": "Use get_params_options to choose GM for series, fetch the widget schema, create Getting Started/company_performance, and place it at x=20, y=0, width 20, height 10.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "getting-started"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Parameter Placement",
        "activate": true,
        "tabs": [
          {
            "id": "",
            "name": ""
          }
        ],
        "dashboard_id": "usage_options_constrained_placement_for_macro_timeseries_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "create_widget",
      "update_widget_layout"
    ]
  },
  "eval": {
    "required_widgets": [
      {
        "origin": "Getting Started",
        "widget_id": "company_performance",
        "data_args": {
          "company": "GM",
          "year": "2024"
        }
      }
    ],
    "required_layouts": [
      {
        "widget_id": "company_performance",
        "x": 20,
        "y": 0,
        "w": 20,
        "h": 10
      }
    ],
    "required_tool_results": [
      {
        "tool": "get_params_options",
        "data_contains": [
          "GM"
        ]
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference_trace": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Getting Started"
        }
      },
      {
        "tool": "get_widget_schema",
        "args": {
          "origin": "Getting Started",
          "widget_id": "company_performance"
        }
      },
      {
        "tool": "get_params_options",
        "args": {
          "origin": "Getting Started",
          "widget_id": "company_performance",
          "param_name": "company"
        }
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Getting Started",
          "widget_id": "company_performance",
          "data_args": {
            "company": "GM",
            "year": "2024"
          }
        }
      },
      {
        "tool": "update_widget_layout",
        "args": {
          "widget_id": "company_performance",
          "x": 20,
          "y": 0,
          "w": 20,
          "h": 10
        }
      }
    ],
    "max_turns": 9
  }
}
