        "widgets": [
          {
            "origin": "Widget Examples",
            "widget_id": "test_metric",
            "data_args": {},
            "layout": {
              "x": 0,
              "y": 0,
              "w": 24,
              "h": 12
            },
            "widget_uuid": "usage_repair_portfolio_overlap_widget_001"
          },
          {
            "origin": "Widget Examples",
            "widget_id": "live_grid_example",
            "data_args": {},
