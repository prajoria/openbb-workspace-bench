  "difficulty": "medium",
  "prompt": "Set the getting-started widgets side by side with the 10Y series on the left half and the yield curve on the right half; both should be 10 rows tall starting at row 0.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "getting-started"
        },
        {
          "name": "widget-examples"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Arrangement Task",
        "activate": true,
        "tabs": [
          {
            "id": "",
            "name": ""
          }
        ],
        "widgets": [
          {
            "origin": "Getting Started",
            "widget_id": "company_performance",
            "data_args": {
              "company": "GM",
              "year": "2024"
            },
            "layout": {
              "x": 0,
              "y": 0,
              "w": 18,
              "h": 9
            },
            "widget_uuid": "usage_arrange_split_macro_widget_001"
          },
          {
            "origin": "Widget Examples",
            "widget_id": "test_metric",
            "data_args": {},
            "layout": {
              "x": 0,
              "y": 9,
              "w": 18,
              "h": 9
            },
            "widget_uuid": "usage_arrange_split_macro_widget_002"
          }
        ],
        "dashboard_id": "usage_arrange_split_macro_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "read_widget",
      "update_widget_layout"
    ]
  },
  "eval": {
    "required_layouts": [
      {
        "widget_id": "company_performance",
        "x": 0,
        "y": 0,
        "w": 20,
        "h": 10
      },
      {
        "widget_id": "test_metric",
        "x": 20,
        "y": 0,
        "w": 20,
        "h": 10
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference_trace": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "update_widget_layout",
        "args": {
          "widget_id": "company_performance",
          "x": 0,
          "y": 0,
          "w": 20,
          "h": 10
        }
      },
      {
        "tool": "update_widget_layout",
        "args": {
          "widget_id": "test_metric",
          "x": 20,
          "y": 0,
          "w": 20,
          "h": 10
        }
      }
    ],
    "max_turns": 6
  }
}
