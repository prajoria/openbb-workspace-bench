{
  "id": "twofacts_fundamentals_aapl",
  "category": "read",
  "family": "note",
  "difficulty": "medium",
  "prompt": "Use the existing company-list widget data to add a note on the overview tab with Apple's company id and exact price from the data.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "getting-started"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Existing Review",
        "activate": true,
        "tabs": [
          {
            "id": "overview",
            "name": "Overview"
          }
        ],
        "widgets": [
          {
            "origin": "Getting Started",
            "widget_id": "company_list",
            "data_args": {
              "companyId": "TM"
            },
            "tab_id": "overview",
            "layout": {
              "x": 0,
              "y": 0,
              "w": 20,
              "h": 12
            },
            "widget_uuid": "usage_twofacts_fundamentals_aapl_widget_001"
          }
        ],
        "dashboard_id": "usage_twofacts_fundamentals_aapl_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "get_widget_data",
      "add_generative_widget"
    ]
  },
  "eval": {
    "required_tabs": [
      "overview"
    ],
    "required_widgets": [
      {
        "origin": "Getting Started",
        "widget_id": "company_list",
        "data_args": {
          "companyId": "TM"
        },
        "tab_id": "overview",
        "min_count": 1
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "TM",
          "150.25"
        ],
        "tab_id": "overview"
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference_trace": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "get_widget_data",
        "args": {
          "origin": "Getting Started",
          "widget_id": "company_list",
          "data_args": {
            "companyId": "TM"
          }
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Answer Note",
          "data": "Apple company id TM has price 150.25."
        }
      }
    ],
    "max_turns": 6
  }
