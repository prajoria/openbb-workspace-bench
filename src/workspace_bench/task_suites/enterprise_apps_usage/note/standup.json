{
  "id": "standup",
  "category": "single-widget",
  "family": "note",
  "difficulty": "easy",
  "prompt": "On the dashboard, add a note named Morning Standup stating that the desk meeting moved to 9am and the risk review is at noon.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "getting-started"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Notes Board",
        "activate": true,
        "tabs": [
          {
            "id": "",
            "name": ""
          }
        ],
        "dashboard_id": "usage_standup_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "add_generative_widget"
    ]
  },
  "eval": {
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "name_contains": "Morning Standup",
        "data_contains": [
          "9am",
          "noon"
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference_trace": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Morning Standup",
          "data": "Desk meeting moved to 9am; risk review is at noon."
        }
      }
    ],
    "max_turns": 5
  }
}
