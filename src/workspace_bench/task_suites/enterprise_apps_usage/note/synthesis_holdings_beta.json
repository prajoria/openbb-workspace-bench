{
  "id": "synthesis_holdings_beta",
  "category": "read",
  "family": "note",
  "difficulty": "hard",
  "prompt": "Use the metric and whitepapers widget data to add a note with the first metric label, its exact value, and the returned filename from the data.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "widget-examples"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Existing Review",
        "activate": true,
        "tabs": [
          {
            "id": "",
            "name": ""
          }
        ],
        "widgets": [
          {
            "origin": "Widget Examples",
            "widget_id": "test_metric",
            "data_args": {},
            "layout": {
              "x": 0,
              "y": 0,
              "w": 20,
              "h": 10
            },
            "widget_uuid": "usage_synthesis_holdings_beta_widget_001"
          },
          {
            "origin": "Widget Examples",
            "widget_id": "whitepapers",
            "data_args": {
              "filenames": [
                "bitcoin.pdf"
              ]
            },
            "layout": {
              "x": 20,
              "y": 0,
              "w": 20,
              "h": 10
            },
            "widget_uuid": "usage_synthesis_holdings_beta_widget_002"
          }
        ],
        "dashboard_id": "usage_synthesis_holdings_beta_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "get_widget_data",
      "add_generative_widget"
    ]
  },
  "eval": {
    "required_widgets": [
      {
        "origin": "Widget Examples",
        "widget_id": "test_metric",
        "data_args": {},
        "min_count": 1
      },
      {
        "origin": "Widget Examples",
        "widget_id": "whitepapers",
        "data_args": {
          "filenames": [
            "bitcoin.pdf"
          ]
        },
        "min_count": 1
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "Example Label",
          "12345",
          "bitcoin.pdf"
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference_trace": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "get_widget_data",
        "args": {
          "origin": "Widget Examples",
          "widget_id": "test_metric",
          "data_args": {}
        }
      },
      {
        "tool": "get_widget_data",
        "args": {
          "origin": "Widget Examples",
          "widget_id": "whitepapers",
          "data_args": {
            "filenames": [
              "bitcoin.pdf"
            ]
          }
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Answer Note",
          "data": "First metric Example Label is 12345; returned whitepaper bitcoin.pdf."
        }
      }
    ],
    "max_turns": 7
  }
}
