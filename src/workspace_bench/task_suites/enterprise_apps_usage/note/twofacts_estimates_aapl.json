{
  "id": "twofacts_estimates_aapl",
  "category": "read",
  "family": "note",
  "difficulty": "medium",
  "prompt": "Add a HTML card on the overview tab with the exact price and volume from the data after reviewing the existing AAPL live-grid widget.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "getting-started"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Existing Review",
        "activate": true,
        "tabs": [
          {
            "id": "overview",
            "name": "Overview"
          }
        ],
        "widgets": [
          {
            "origin": "Getting Started",
            "widget_id": "live_grid_data",
            "data_args": {
              "symbol": "AAPL"
            },
            "tab_id": "overview",
            "layout": {
              "x": 0,
              "y": 0,
              "w": 20,
              "h": 12
            },
            "widget_uuid": "usage_twofacts_estimates_aapl_widget_001"
          }
        ],
        "dashboard_id": "usage_twofacts_estimates_aapl_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "get_widget_data",
      "add_generative_widget"
    ]
  },
  "eval": {
    "required_tabs": [
      "overview"
    ],
    "required_widgets": [
      {
        "origin": "Getting Started",
        "widget_id": "live_grid_data",
        "data_args": {
          "symbol": "AAPL"
        },
        "tab_id": "overview",
        "min_count": 1
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "html",
        "data_contains": [
          "AAPL",
          "150.0",
          "1000000"
        ],
        "tab_id": "overview"
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "get_widget_data",
        "args": {
          "origin": "Getting Started",
          "widget_id": "live_grid_data",
          "data_args": {
            "symbol": "AAPL"
          }
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "html",
          "name": "Answer Note",
          "data": "<section>AAPL live grid: price 150.0, volume 1000000.</section>"
        }
      }
    ],
    "limits": {
      "max_turns": 6
    }
  }
}
