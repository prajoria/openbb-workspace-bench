{
  "id": "outage",
  "category": "single-widget",
  "family": "note",
  "difficulty": "easy",
  "prompt": "On the dashboard, add a HTML card named Vendor Outage stating that the FactSet feed is degraded and fallback pricing is active.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "getting-started"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Notes Board",
        "activate": true,
        "tabs": [
          {
            "id": "",
            "name": ""
          }
        ],
        "dashboard_id": "usage_outage_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "add_generative_widget"
    ]
  },
  "eval": {
    "required_generated_widgets": [
      {
        "widget_type": "html",
        "name_contains": "Vendor Outage",
        "data_contains": [
          "FactSet",
          "fallback"
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference_trace": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "html",
          "name": "Vendor Outage",
          "data": "<section>FactSet feed degraded; fallback pricing is active.</section>"
        }
      }
    ],
    "max_turns": 5
  }
}
