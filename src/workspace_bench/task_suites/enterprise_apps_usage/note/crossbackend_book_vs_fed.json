{
  "id": "crossbackend_book_vs_fed",
  "category": "read",
  "family": "note",
  "difficulty": "hard",
  "prompt": "Add a note with the returned filename and TM's exact 2024 global sales from the data after reviewing both widgets.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "getting-started"
        },
        {
          "name": "widget-examples"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Existing Review",
        "activate": true,
        "tabs": [
          {
            "id": "",
            "name": ""
          }
        ],
        "widgets": [
          {
            "origin": "Widget Examples",
            "widget_id": "whitepapers",
            "data_args": {
              "filenames": [
                "bitcoin.pdf"
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "w": 20,
              "h": 10
            },
            "widget_uuid": "usage_crossbackend_book_vs_fed_widget_001"
          },
          {
            "origin": "Getting Started",
            "widget_id": "company_performance",
            "data_args": {
              "company": "TM",
              "year": "2024"
            },
            "layout": {
              "x": 20,
              "y": 0,
              "w": 20,
              "h": 10
            },
            "widget_uuid": "usage_crossbackend_book_vs_fed_widget_002"
          }
        ],
        "dashboard_id": "usage_crossbackend_book_vs_fed_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "get_widget_data",
      "add_generative_widget"
    ]
  },
  "eval": {
    "required_widgets": [
      {
        "origin": "Widget Examples",
        "widget_id": "whitepapers",
        "data_args": {
          "filenames": [
            "bitcoin.pdf"
          ]
        },
        "min_count": 1
      },
      {
        "origin": "Getting Started",
        "widget_id": "company_performance",
        "data_args": {
          "company": "TM",
          "year": "2024"
        },
        "min_count": 1
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "bitcoin.pdf",
          "TM",
          "10.5M"
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "get_widget_data",
        "args": {
          "origin": "Widget Examples",
          "widget_id": "whitepapers",
          "data_args": {
            "filenames": [
              "bitcoin.pdf"
            ]
          }
        }
      },
      {
        "tool": "get_widget_data",
        "args": {
          "origin": "Getting Started",
          "widget_id": "company_performance",
          "data_args": {
            "company": "TM",
            "year": "2024"
          }
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Answer Note",
          "data": "Returned whitepaper bitcoin.pdf; TM 2024 global sales 10.5M."
        }
      }
    ],
    "limits": {
      "max_turns": 6
    }
  }
}
