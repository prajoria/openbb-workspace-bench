{
  "id": "fact_macro_10y",
  "category": "read",
  "family": "note",
  "difficulty": "medium",
  "prompt": "Add a note with the manufacturer and exact 2024 global sales from the data after reviewing the existing GM performance widget.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "getting-started"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Existing Review",
        "activate": true,
        "tabs": [
          {
            "id": "",
            "name": ""
          }
        ],
        "widgets": [
          {
            "origin": "Getting Started",
            "widget_id": "company_performance",
            "data_args": {
              "company": "GM",
              "year": "2024"
            },
            "layout": {
              "x": 0,
              "y": 0,
              "w": 20,
              "h": 12
            },
            "widget_uuid": "usage_fact_macro_10y_widget_001"
          }
        ],
        "dashboard_id": "usage_fact_macro_10y_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "get_widget_data",
      "add_generative_widget"
    ]
  },
  "eval": {
    "required_widgets": [
      {
        "origin": "Getting Started",
        "widget_id": "company_performance",
        "data_args": {
          "company": "GM",
          "year": "2024"
        },
        "min_count": 1
      }
