{
  "id": "fact_top_holding",
  "category": "read",
  "family": "note",
  "difficulty": "medium",
  "prompt": "Use the existing metric widget data to add a note with the first label and its exact value from the data.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "widget-examples"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Existing Review",
        "activate": true,
        "tabs": [
          {
            "id": "",
            "name": ""
          }
        ],
        "widgets": [
          {
            "origin": "Widget Examples",
            "widget_id": "test_metric",
            "data_args": {},
            "layout": {
              "x": 0,
              "y": 0,
              "w": 20,
              "h": 12
            },
            "widget_uuid": "usage_fact_top_holding_widget_001"
          }
        ],
        "dashboard_id": "usage_fact_top_holding_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "get_widget_data",
      "add_generative_widget"
    ]
  },
  "eval": {
    "required_widgets": [
      {
        "origin": "Widget Examples",
        "widget_id": "test_metric",
        "data_args": {},
        "min_count": 1
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "Example Label",
          "12345"
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "get_widget_data",
        "args": {
          "origin": "Widget Examples",
          "widget_id": "test_metric",
          "data_args": {}
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Answer Note",
          "data": "First metric: Example Label is 12345."
        }
      }
    ],
    "limits": {
      "max_turns": 6
    }
  }
}
