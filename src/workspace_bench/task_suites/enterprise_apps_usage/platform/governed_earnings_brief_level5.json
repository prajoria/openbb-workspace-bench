{
  "id": "governed_earnings_brief_level5",
  "category": "platform",
  "difficulty": "level5",
  "prompt": "The desk wants a Governed Earnings Backend with an Earnings Action Register. Following the build-an-app guide, author and add it, publish a Governed Earnings App with an Actions tab, and instantiate it. Widget ids are the snake_case of widget names; tab ids are the snake_case of tab names.",
  "setup": {
    "workspace_baseline": "stark-workspace-a",
    "workspace_backends": [
      "stark-enterprise-x",
      "support-daloopa-skills",
      "getting-started",
      "widget-examples"
    ],
    "workspace_skills": [
      "daloopa-capital-allocation",
      "daloopa-earnings-review",
      "daloopa-guidance-tracker",
      "daloopa-industry",
      "daloopa-inflection",
      "daloopa-tearsheet",
      "finance-comps",
      "finance-earnings-prep",
      "finance-guidance-tracker",
      "finance-tearsheet"
    ],
    "default_selected_dashboard": "Home",
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_tools": [
      {
        "tool": "get_workspace_snapshot",
        "args": {},
        "optional": true
      },
      {
        "tool": "read_workspace_resource",
        "args": {
          "uri": "openbb://workspace/guides/build-an-app"
        },
        "graded_args": [
          "uri"
        ]
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Governed Earnings Backend",
          "url": "http://127.0.0.1:9505",
          "widgets_json": {
            "earnings_action_register": {
              "name": "Earnings Action Register",
              "description": "Wave-1 view for Earnings Action Register.",
              "endpoint": "/earnings-actions",
              "type": "table",
              "gridData": {
                "w": 20,
                "h": 10
              }
            }
          },
          "apps_json": [
            {
              "name": "Governed Earnings App",
              "description": "Wave-1 authored app for Governed Earnings App.",
              "tabs": {
                "actions": {
                  "id": "actions",
                  "name": "Actions",
                  "layout": [
                    {
                      "i": "earnings_action_register",
                      "x": 0,
                      "y": 0,
                      "w": 40,
                      "h": 12
                    }
                  ]
                }
              }
            }
          ]
        },
        "graded_args": [
          "operation",
          "name"
        ]
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "list"
        },
        "optional": true
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_005",
          "app_name": "Governed Earnings App",
          "dashboard_name": "Governed Earnings Live",
          "activate": true
        },
        "graded_args": [
          "operation"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Governed Earnings Backend",
        "widget_id": "earnings_action_register",
        "tab_id": "actions"
      }
    ],
    "required_widget_defs": [
      {
        "backend_name": "Governed Earnings Backend",
        "widget_id": "earnings_action_register",
        "expect": {}
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Governed Earnings Backend",
        "name_contains": "Governed Earnings App",
        "tabs_include": [
          "actions"
        ],
        "layout_refs_valid": true,
        "widgets_on_tab": [
          {
            "tab_id": "actions",
            "widget_id": "earnings_action_register"
          }
        ]
      }
    ],
    "max_turns": 8
  }
}
