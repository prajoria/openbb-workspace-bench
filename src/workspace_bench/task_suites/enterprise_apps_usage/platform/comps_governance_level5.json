{
  "id": "comps_governance_level5",
  "category": "platform",
  "difficulty": "level5",
  "prompt": "Comps-governance governed build: read the Finance Comps skill (finance-comps), add Wave Three Comps Governance with a Comps Governance Register table, publish and instantiate Comps Governance App on Comparables, and add a Comps-governance Build Note containing valuation multiples. Widget ids are the snake_case of widget names; tab ids are the snake_case of tab names.",
  "setup": {
    "workspace_baseline": "stark-workspace-a",
    "workspace_backends": [
      "stark-enterprise-x",
      "support-daloopa-skills",
      "getting-started",
      "widget-examples"
    ],
    "workspace_skills": [
      "daloopa-capital-allocation",
      "daloopa-earnings-review",
      "daloopa-guidance-tracker",
      "daloopa-industry",
      "daloopa-inflection",
      "daloopa-tearsheet",
      "finance-comps",
      "finance-earnings-prep",
      "finance-guidance-tracker",
      "finance-tearsheet"
    ],
    "default_selected_dashboard": "Home",
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_tools": [
      {
        "tool": "get_workspace_snapshot",
        "args": {},
        "optional": true
      },
      {
        "tool": "get_skill_content",
        "args": {
          "slug": "finance-comps"
        },
        "graded_args": [
          "slug"
        ]
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Wave Three Comps Governance",
          "url": "http://127.0.0.1:9709",
          "widgets_json": {
            "comps_governance_register": {
              "name": "Comps Governance Register",
              "description": "Wave-1 view for Comps Governance Register.",
              "endpoint": "/comps_governance_register",
              "type": "table",
              "gridData": {
                "w": 40,
                "h": 10
              }
            }
          },
          "apps_json": [
            {
              "name": "Comps Governance App",
              "description": "Wave-1 authored app for Comps Governance App.",
              "tabs": {
                "comparables": {
                  "id": "comparables",
                  "name": "Comparables",
                  "layout": [
                    {
                      "i": "comps_governance_register",
                      "x": 0,
                      "y": 0,
                      "w": 40,
                      "h": 10
                    }
                  ]
                }
              }
            }
          ]
        },
        "graded_args": [
          "operation",
          "name"
        ]
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "list"
        },
        "optional": true
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_005",
          "app_name": "Comps Governance App",
          "dashboard_name": "Comps-governance Live",
          "activate": true
        },
        "graded_args": [
          "operation"
        ]
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Comps-governance Build Note",
          "data": "valuation multiples"
        },
        "graded_args": [
          "widget_type",
          "name"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Wave Three Comps Governance",
        "widget_id": "comps_governance_register",
        "tab_id": "comparables"
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "name_contains": "Comps-governance Build Note",
        "data_contains": [
          "valuation multiples"
        ]
      }
    ],
    "required_widget_defs": [
      {
        "backend_name": "Wave Three Comps Governance",
        "widget_id": "comps_governance_register",
        "expect": {
          "type": "table"
        }
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Wave Three Comps Governance",
        "name_contains": "Comps Governance App",
        "tabs_include": [
          "comparables"
        ],
        "layout_refs_valid": true,
        "widgets_on_tab": [
          {
            "tab_id": "comparables",
            "widget_id": "comps_governance_register"
          }
        ]
      }
    ],
    "max_turns": 9
  }
}
