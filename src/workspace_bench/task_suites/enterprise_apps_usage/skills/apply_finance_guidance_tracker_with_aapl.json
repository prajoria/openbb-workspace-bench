{
  "id": "apply_finance_guidance_tracker_with_aapl",
  "category": "single-widget",
  "family": "skills",
  "difficulty": "hard",
  "prompt": "Call get_skill_content with slug finance-guidance-tracker. Following that workflow, add the Sample News Feed widget for tech to the active dashboard, then add a note that applies the skill's workflow steps to this widget. Omit dashboard_id when adding the note.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "getting-started"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Skill Review",
        "activate": true,
        "tabs": [
          {
            "id": "overview",
            "name": "Overview"
          }
        ],
        "dashboard_id": "usage_apply_finance_guidance_tracker_with_aapl_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "get_skill_content",
      "list_available_widgets",
      "get_widget_schema",
      "create_widget",
      "add_generative_widget"
    ]
  },
  "eval": {
    "required_tool_calls": [
      {
        "tool": "get_skill_content",
        "args_contains": {
          "slug": "finance-guidance-tracker"
        }
      }
    ],
    "required_tool_results": [
      {
        "tool": "get_skill_content",
        "data_contains": [
          "Guidance tracker workflow",
          "management claims",
          "evidence gaps"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Getting Started",
        "widget_id": "sample_newsfeed",
        "data_args": {
          "category": "tech",
          "limit": 5
        },
        "min_count": 1
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "guidance",
          "claims",
          "tech"
        ]
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference_trace": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "get_skill_content",
        "args": {
          "slug": "finance-guidance-tracker"
        }
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Getting Started"
        }
      },
      {
        "tool": "get_widget_schema",
        "args": {
          "origin": "Getting Started",
          "widget_id": "sample_newsfeed"
        }
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Getting Started",
          "widget_id": "sample_newsfeed",
          "data_args": {
            "category": "tech",
            "limit": 5
          }
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Skill Note",
          "data": "tech guidance: guidance; claims."
        }
      }
    ],
    "max_turns": 9
  }
}
