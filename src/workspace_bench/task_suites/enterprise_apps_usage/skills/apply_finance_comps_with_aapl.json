{
  "id": "apply_finance_comps_with_aapl",
  "category": "single-widget",
  "family": "skills",
  "difficulty": "hard",
  "prompt": "Use get_skill_content with slug finance-comps. Following that workflow, add the Fundamental Metrics widget for AAPL to the active dashboard, then add a note that applies the skill's workflow steps to this widget. Omit dashboard_id when adding the note.",
  "fixtures": {
    "backends": [
      {
        "name": "equities"
      }
    ]
  },
  "initial_state": {
    "dashboard": {
      "name": "Skill Review",
      "activate": true,
      "tabs": [
        {
          "id": "overview",
          "name": "Overview"
        }
      ]
    }
  },
  "allowed_tools": [
    "get_workspace_snapshot",
    "get_skill_content",
    "list_available_widgets",
    "get_widget_schema",
    "create_widget",
    "add_generative_widget"
  ],
  "success": {
    "required_tool_calls": [
      {
        "tool": "get_skill_content",
        "args_contains": {
          "slug": "finance-comps"
        }
      }
    ],
    "required_tool_results": [
      {
        "tool": "get_skill_content",
        "data_contains": [
          "Comps workflow",
          "peer set",
          "valuation multiples"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Bench Equities",
        "widget_id": "fundamental_metrics",
        "data_args": {
          "symbol": "AAPL"
        },
        "min_count": 1
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "comps",
          "peer set",
          "AAPL"
        ]
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_snapshot",
      "args": {}
    },
    {
      "tool": "get_skill_content",
      "args": {
        "slug": "finance-comps"
      }
    },
    {
      "tool": "list_available_widgets",
      "args": {
        "origin": "Bench Equities"
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Bench Equities",
        "widget_id": "fundamental_metrics"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Bench Equities",
        "widget_id": "fundamental_metrics",
        "data_args": {
          "symbol": "AAPL"
        }
      }
    },
    {
      "tool": "add_generative_widget",
      "args": {
        "widget_type": "note",
        "name": "Skill Note",
        "data": "AAPL comps: comps; peer set."
      }
    }
  ],
  "limits": {
    "max_turns": 9
  }
}
