{
  "id": "grounded_finance_comps_for_nvda",
  "category": "single-widget",
  "family": "skills",
  "difficulty": "hard",
  "prompt": "Use get_skill_content with slug finance-comps. Following that workflow, add the Company List with ID Mapping widget for GM, read its data, and add a note that cites the exact key value from the data. Omit dashboard_id when adding the note.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "getting-started"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Skill Review",
        "activate": true,
        "tabs": [
          {
            "id": "overview",
            "name": "Overview"
          }
        ],
        "dashboard_id": "usage_grounded_finance_comps_for_nvda_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "get_skill_content",
      "list_available_widgets",
      "get_widget_schema",
      "create_widget",
      "get_widget_data",
      "add_generative_widget"
    ]
  },
  "eval": {
    "required_tool_calls": [
      {
        "tool": "get_skill_content",
        "args_contains": {
          "slug": "finance-comps"
        }
      },
      {
        "tool": "get_widget_data",
        "args_contains": {
          "widget_id": "company_list"
        }
      }
    ],
    "required_tool_results": [
      {
        "tool": "get_skill_content",
        "data_contains": [
          "Comps workflow",
          "peer set",
          "valuation multiples"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Getting Started",
        "widget_id": "company_list",
        "data_args": {
          "companyId": "GM"
        },
        "min_count": 1
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "VWAGY",
          "350.5",
          "peer set"
        ]
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference_trace": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "get_skill_content",
        "args": {
          "slug": "finance-comps"
        }
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Getting Started"
        }
      },
      {
        "tool": "get_widget_schema",
        "args": {
          "origin": "Getting Started",
          "widget_id": "company_list"
        }
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Getting Started",
          "widget_id": "company_list",
          "data_args": {
            "companyId": "GM"
          }
        }
      },
      {
        "tool": "get_widget_data",
        "args": {
          "origin": "Getting Started",
          "widget_id": "company_list",
          "data_args": {
            "companyId": "GM"
          }
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Skill Note",
          "data": "Company-list comps: VWAGY price 350.5 against the peer set."
        }
      }
    ],
    "max_turns": 9
  }
}
