{
  "id": "read_the_finance_tearsheet_skill",
  "category": "single-widget",
  "family": "skills",
  "difficulty": "easy",
  "prompt": "Call get_skill_content with slug finance-tearsheet, then add a note on the active dashboard naming the Finance Tearsheet skill. Omit dashboard_id when adding the note.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "stark-enterprise"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Skill Review",
        "activate": true,
        "tabs": [
          {
            "id": "overview",
            "name": "Overview"
          }
        ],
        "dashboard_id": "usage_read_the_finance_tearsheet_skill_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "get_skill_content",
      "add_generative_widget"
    ]
  },
  "eval": {
    "required_tool_calls": [
      {
        "tool": "get_skill_content",
        "args_contains": {
          "slug": "finance-tearsheet"
        }
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "Finance Tearsheet"
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 0
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference_trace": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "get_skill_content",
        "args": {
          "slug": "finance-tearsheet"
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Skill Note",
          "data": "Read the Finance Tearsheet skill for this desk."
        }
      }
    ],
    "max_turns": 6
  }
}
