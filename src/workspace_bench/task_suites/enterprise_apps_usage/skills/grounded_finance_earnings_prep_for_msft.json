{
  "id": "grounded_finance_earnings_prep_for_msft",
  "category": "single-widget",
  "family": "skills",
  "difficulty": "hard",
  "prompt": "After calling get_skill_content with slug finance-earnings-prep, follow that workflow by adding the Live Grid widget for MSFT, reading its data, and adding a note that cites the exact key value from the data. Omit dashboard_id when adding the note.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "getting-started"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Skill Review",
        "activate": true,
        "tabs": [
          {
            "id": "overview",
            "name": "Overview"
          }
        ],
        "dashboard_id": "usage_grounded_finance_earnings_prep_for_msft_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "get_skill_content",
      "list_available_widgets",
      "get_widget_schema",
      "create_widget",
      "get_widget_data",
      "add_generative_widget"
    ]
  },
  "eval": {
    "required_tool_calls": [
      {
        "tool": "get_skill_content",
        "args_contains": {
          "slug": "finance-earnings-prep"
        }
      },
      {
        "tool": "get_widget_data",
        "args_contains": {
          "widget_id": "live_grid_data"
        }
      }
    ],
    "required_tool_results": [
      {
        "tool": "get_skill_content",
        "data_contains": [
          "Earnings prep workflow",
          "surprise drivers",
          "portfolio manager"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Getting Started",
        "widget_id": "live_grid_data",
        "data_args": {
          "symbol": "MSFT"
        },
        "min_count": 1
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "MSFT",
          "350.0",
          "surprise drivers"
        ]
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference_trace": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "get_skill_content",
        "args": {
          "slug": "finance-earnings-prep"
        }
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Getting Started"
        }
      },
      {
        "tool": "get_widget_schema",
        "args": {
          "origin": "Getting Started",
          "widget_id": "live_grid_data"
        }
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Getting Started",
          "widget_id": "live_grid_data",
          "data_args": {
            "symbol": "MSFT"
          }
        }
      },
      {
        "tool": "get_widget_data",
        "args": {
          "origin": "Getting Started",
          "widget_id": "live_grid_data",
          "data_args": {
            "symbol": "MSFT"
          }
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Skill Note",
          "data": "MSFT earnings prep: live-grid price 350.0; surprise drivers listed."
        }
      }
    ],
    "max_turns": 9
  }
}
