{
  "id": "full_crypto_research_dashboard",
  "category": "platform",
  "family": "apps",
  "difficulty": "hard",
  "prompt": "From the Bench Stark Enterprise backend, instantiate the Crypto Research Dashboard app as a new dashboard named Digital Assets Desk. Then add the Crypto Market Metrics widget (id crypto_research_dashboard_market_crypto_market_metrics) to the Market tab, and add a note on the same tab mentioning market metrics and token.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "stark-enterprise"
        }
      ]
    },
    "initial_state": {},
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_backends",
      "manage_apps",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "create_widget",
      "add_generative_widget"
    ]
  },
  "eval": {
    "required_dashboard_name_contains": "Digital Assets Desk",
    "required_tabs": [
      "overview",
      "derivatives",
      "market"
    ],
    "required_widgets": [
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "crypto_research_dashboard_derivatives_crypto_volatility_surface",
        "tab_id": "derivatives",
        "min_count": 1
      },
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "crypto_research_dashboard_market_crypto_market_metrics",
        "tab_id": "market",
        "min_count": 1
      },
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "crypto_research_dashboard_market_crypto_market_metrics",
        "tab_id": "market",
        "min_count": 1
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "market metrics",
          "token"
        ],
        "tab_id": "market"
      }
    ],
    "layout": {
      "within_grid": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference": [
      {
        "tool": "manage_backends",
        "args": {
          "operation": "list"
        }
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_001",
          "app_name": "Crypto Research Dashboard",
          "dashboard_name": "Digital Assets Desk",
          "activate": true
        }
      },
      {
        "tool": "navigate_workspace",
        "args": {
          "operation": "tab",
          "tab_id": "market"
        }
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Bench Stark Enterprise"
        }
      },
      {
        "tool": "get_widget_schema",
        "args": {
          "origin": "Bench Stark Enterprise",
          "widget_id": "crypto_research_dashboard_market_crypto_market_metrics"
        }
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Bench Stark Enterprise",
          "widget_id": "crypto_research_dashboard_market_crypto_market_metrics",
          "data_args": {}
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Brief Note",
          "data": "Crypto market metrics added for the token book."
        }
      }
    ],
    "limits": {
      "max_turns": 9
    }
  }
}
