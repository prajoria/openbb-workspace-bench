{
  "id": "extend_strategy_health_monitor",
  "category": "platform",
  "family": "apps",
  "difficulty": "hard",
  "prompt": "From the Bench Stark Enterprise backend, instantiate the Strategy Health Monitor app as a new dashboard named Strategy Health Desk. Then add the Catalyst Calendar widget (id strategy_health_monitor_watchlist_catalyst_calendar) to the Watchlist tab of the new dashboard.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "stark-enterprise"
        }
      ]
    },
    "initial_state": {},
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_backends",
      "manage_apps",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "create_widget"
    ]
  },
  "eval": {
    "required_dashboard_name_contains": "Strategy Health Desk",
    "required_tabs": [
      "overview",
      "capacity",
      "performance",
      "watchlist"
    ],
    "required_widgets": [
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "strategy_health_monitor_capacity_capacity_utilization",
        "tab_id": "capacity",
        "min_count": 1
      },
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "strategy_health_monitor_performance_strategy_health_metrics",
        "tab_id": "performance",
        "min_count": 1
      },
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "strategy_health_monitor_watchlist_catalyst_calendar",
        "tab_id": "watchlist",
        "min_count": 1
      }
    ],
    "layout": {
      "within_grid": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference": [
      {
        "tool": "manage_backends",
        "args": {
          "operation": "list"
        }
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_001",
          "app_name": "Strategy Health Monitor",
          "dashboard_name": "Strategy Health Desk",
          "activate": true
        }
      },
      {
        "tool": "navigate_workspace",
        "args": {
          "operation": "tab",
          "tab_id": "watchlist"
        }
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Bench Stark Enterprise"
        }
      },
      {
        "tool": "get_widget_schema",
        "args": {
          "origin": "Bench Stark Enterprise",
          "widget_id": "strategy_health_monitor_watchlist_catalyst_calendar"
        }
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Bench Stark Enterprise",
          "widget_id": "strategy_health_monitor_watchlist_catalyst_calendar",
          "data_args": {}
        }
      }
    ],
    "limits": {
      "max_turns": 9
    }
  }
}
