{
  "id": "note_quant_research_backtest_lab",
  "category": "platform",
  "family": "apps",
  "difficulty": "medium",
  "prompt": "Instantiate the Quant Research & Backtest Lab app from the Bench Stark Enterprise backend as a new dashboard named Signal Research Lab, then add a note on the Signals tab mentioning signal and decay.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "stark-enterprise"
        }
      ]
    },
    "initial_state": {},
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_backends",
      "manage_apps",
      "navigate_workspace",
      "add_generative_widget"
    ]
  },
  "eval": {
    "required_dashboard_name_contains": "Signal Research Lab",
    "required_tabs": [
      "overview",
      "backtest",
      "optimization",
      "signals"
    ],
    "required_widgets": [
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "quant_research_backtest_lab_backtest_backtest_performance",
        "tab_id": "backtest",
        "min_count": 1
      },
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "quant_research_backtest_lab_optimization_efficient_frontier",
        "tab_id": "optimization",
        "min_count": 1
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "signal",
          "decay"
        ],
        "tab_id": "signals"
      }
    ],
    "layout": {
      "within_grid": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference_trace": [
      {
        "tool": "manage_backends",
        "args": {
          "operation": "list"
        }
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_001",
          "app_name": "Quant Research & Backtest Lab",
          "dashboard_name": "Signal Research Lab",
          "activate": true
        }
      },
      {
        "tool": "navigate_workspace",
        "args": {
          "operation": "tab",
          "tab_id": "signals"
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Brief Note",
          "data": "Signal leaderboard reviewed; watch signal decay."
        }
      }
    ],
    "max_turns": 7
  }
}
