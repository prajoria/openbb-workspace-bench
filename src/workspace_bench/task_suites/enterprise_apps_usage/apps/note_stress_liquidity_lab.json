{
  "id": "note_stress_liquidity_lab",
  "category": "platform",
  "family": "apps",
  "difficulty": "medium",
  "prompt": "Create a new dashboard named Quarterly Stress Review by instantiating the Stress & Liquidity Lab app from the Bench Stark Enterprise backend, then add a HTML card on the Sign Off tab mentioning sign off and residual risk.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "stark-enterprise"
        }
      ]
    },
    "initial_state": {},
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_backends",
      "manage_apps",
      "navigate_workspace",
      "add_generative_widget"
    ]
  },
  "eval": {
    "required_dashboard_name_contains": "Quarterly Stress Review",
    "required_tabs": [
      "overview",
      "liquidity",
      "scenarios",
      "sign_off"
    ],
    "required_widgets": [
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "stress_liquidity_lab_liquidity_days_to_liquidate",
        "tab_id": "liquidity",
        "min_count": 1
      },
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "stress_liquidity_lab_scenarios_scenario_builder_assumptions",
        "tab_id": "scenarios",
        "min_count": 1
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "html",
        "data_contains": [
          "sign off",
          "residual risk"
        ],
        "tab_id": "sign_off"
      }
    ],
    "layout": {
      "within_grid": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference": [
      {
        "tool": "manage_backends",
        "args": {
          "operation": "list"
        }
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_001",
          "app_name": "Stress & Liquidity Lab",
          "dashboard_name": "Quarterly Stress Review",
          "activate": true
        }
      },
      {
        "tool": "navigate_workspace",
        "args": {
          "operation": "tab",
          "tab_id": "sign_off"
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "html",
          "name": "Brief Note",
          "data": "<section>Sign off tracker reviewed; residual risk actions open.</section>"
        }
      }
    ],
    "limits": {
      "max_turns": 7
    }
  }
}
