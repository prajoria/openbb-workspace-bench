{
  "id": "executive_investment_dashboard",
  "category": "platform",
  "family": "apps",
  "difficulty": "medium",
  "prompt": "From the Bench Stark Enterprise backend, instantiate the Executive Investment Dashboard app as a new dashboard named Executive Morning Brief.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "stark-enterprise"
        }
      ]
    },
    "initial_state": {},
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_backends",
      "manage_apps",
      "navigate_workspace"
    ]
  },
  "eval": {
    "required_dashboard_name_contains": "Executive Morning Brief",
    "required_tabs": [
      "overview",
      "firm_overview",
      "issues"
    ],
    "required_widgets": [
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "executive_investment_dashboard_firm_overview_firm_snapshot",
        "tab_id": "firm_overview",
        "min_count": 1
      },
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "executive_investment_dashboard_issues_major_open_issues",
        "tab_id": "issues",
        "min_count": 1
      }
    ],
    "layout": {
      "within_grid": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference": [
      {
        "tool": "manage_backends",
        "args": {
          "operation": "list"
        }
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_001",
          "app_name": "Executive Investment Dashboard",
          "dashboard_name": "Executive Morning Brief",
          "activate": true
        }
      }
    ],
    "limits": {
      "max_turns": 5
    }
  }
}
