{
  "id": "vendor_freshness_repair_level5",
  "category": "repair",
  "difficulty": "level5",
  "prompt": "Vendor Repair went down and took its queue with it. On the open Vendor-freshness Backend Repair dashboard, rebuild the service: add a custom backend Buildout Vendor Repair with a Vendor Repair Queue table to the widgets.json spec, publish and instantiate its app with the queue on Incidents, and leave a Vendor-freshness Rebuild Note recording the final thing the Finance Guidance Tracker skill's workflow lists.",
  "setup": {
    "workspace_baseline": "stark-workspace-a",
    "workspace_backends": [
      "stark-enterprise-x",
      "support-daloopa-skills",
      "getting-started",
      "widget-examples"
    ],
    "workspace_skills": [
      "daloopa-capital-allocation",
      "daloopa-earnings-review",
      "daloopa-guidance-tracker",
      "daloopa-industry",
      "daloopa-inflection",
      "daloopa-tearsheet",
      "finance-comps",
      "finance-earnings-prep",
      "finance-guidance-tracker",
      "finance-tearsheet"
    ],
    "default_selected_dashboard": "Vendor-freshness Backend Repair",
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ],
    "initial_state": {
      "dashboard": {
        "name": "Vendor-freshness Backend Repair",
        "activate": false,
        "tabs": [
          {
            "id": "incidents",
            "name": "Incidents"
          }
        ],
        "widgets": []
      }
    }
  },
  "eval": {
    "required_tools": [
      {
        "tool": "get_workspace_snapshot",
        "args": {},
        "optional": true
      },
      {
        "tool": "get_skill_content",
        "args": {
          "slug": "finance-guidance-tracker"
        },
        "graded_args": [
          "slug"
        ]
      },
      {
        "tool": "read_workspace_resource",
        "args": {
          "uri": "openbb://workspace/specs/widgets-json"
        },
        "optional": true
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Buildout Vendor Repair",
          "url": "http://127.0.0.1:9707",
          "widgets_json": {
            "vendor_repair_queue": {
              "name": "Vendor Repair Queue",
              "description": "Rebuilt queue for Vendor-freshness.",
              "endpoint": "/vendor_repair_queue",
              "type": "table",
              "gridData": {
                "w": 40,
                "h": 12
              }
            }
          },
          "apps_json": [
            {
              "name": "Vendor Repair App",
              "description": "Authored app for Vendor Repair App.",
              "tabs": {
                "incidents": {
                  "id": "incidents",
                  "name": "Incidents",
                  "layout": [
                    {
                      "i": "vendor_repair_queue",
                      "x": 0,
                      "y": 0,
                      "w": 40,
                      "h": 12
                    }
                  ]
                }
              }
            }
          ]
        },
        "graded_args": [
          "operation",
          "name"
        ]
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "list"
        },
        "optional": true
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_005",
          "app_name": "Vendor Repair App",
          "dashboard_name": "Vendor-freshness Restored",
          "activate": true
        },
        "graded_args": [
          "operation"
        ]
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Vendor-freshness Rebuild Note",
          "data": "evidence gaps"
        },
        "graded_args": [
          "widget_type",
          "name"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Buildout Vendor Repair",
        "widget_id": "vendor_repair_queue",
        "tab_id": "incidents"
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "name_contains": "Vendor-freshness Rebuild Note",
        "data_contains": [
          "evidence gaps"
        ]
      }
    ],
    "required_widget_defs": [
      {
        "backend_name": "Buildout Vendor Repair",
        "widget_id": "vendor_repair_queue",
        "expect": {
          "type": "table"
        }
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Buildout Vendor Repair",
        "name_contains": "Vendor Repair App",
        "tabs_include": [
          "incidents"
        ],
        "layout_refs_valid": true,
        "no_overlaps": true,
        "widgets_on_tab": [
          {
            "tab_id": "incidents",
            "widget_id": "vendor_repair_queue"
          }
        ]
      }
    ],
    "max_turns": 10
  }
}
