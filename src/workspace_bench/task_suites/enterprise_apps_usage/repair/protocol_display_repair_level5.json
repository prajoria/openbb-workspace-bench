{
  "id": "protocol_display_repair_level5",
  "category": "repair",
  "difficulty": "level5",
  "prompt": "Protocol-display backend rebuild: Wave Three Protocol Repair was lost from the workspace; on the open Protocol-display Backend Repair dashboard, rebuild it from scratch: add a custom backend Wave Three Protocol Repair with a Protocol Repair Queue table, publish Protocol Repair App, and instantiate it with one non-overlapping Protocol Repair Queue placement on Protocols, keeping all other workspace content. Follow the widgets manifest specification. Widget ids are the snake_case of widget names; tab ids are the snake_case of tab names. Follow the Daloopa Inflection skill (daloopa-inflection) and add a Protocol-display Rebuild Note recording what it flags as inflections.",
  "setup": {
    "workspace_baseline": "stark-workspace-a",
    "workspace_backends": [
      "stark-enterprise-x",
      "support-daloopa-skills",
      "getting-started",
      "widget-examples"
    ],
    "workspace_skills": [
      "daloopa-capital-allocation",
      "daloopa-earnings-review",
      "daloopa-guidance-tracker",
      "daloopa-industry",
      "daloopa-inflection",
      "daloopa-tearsheet",
      "finance-comps",
      "finance-earnings-prep",
      "finance-guidance-tracker",
      "finance-tearsheet"
    ],
    "default_selected_dashboard": "Protocol-display Backend Repair",
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ],
    "initial_state": {
      "dashboard": {
        "name": "Protocol-display Backend Repair",
        "activate": false,
        "tabs": [
          {
            "id": "protocols",
            "name": "Protocols"
          }
        ],
        "widgets": []
      }
    }
  },
  "eval": {
    "required_tools": [
      {
        "tool": "get_workspace_snapshot",
        "args": {},
        "optional": true
      },
      {
        "tool": "get_skill_content",
        "args": {
          "slug": "daloopa-inflection"
        },
        "graded_args": [
          "slug"
        ]
      },
      {
        "tool": "read_workspace_resource",
        "args": {
          "uri": "openbb://workspace/specs/widgets-json"
        },
        "optional": true
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Wave Three Protocol Repair",
          "url": "http://127.0.0.1:9708",
          "widgets_json": {
            "protocol_repair_queue": {
              "name": "Protocol Repair Queue",
              "description": "Rebuilt queue for Protocol-display.",
              "endpoint": "/protocol_repair_queue",
              "type": "table",
              "gridData": {
                "w": 40,
                "h": 12
              }
            }
          },
          "apps_json": [
            {
              "name": "Protocol Repair App",
              "description": "Wave-1 authored app for Protocol Repair App.",
              "tabs": {
                "protocols": {
                  "id": "protocols",
                  "name": "Protocols",
                  "layout": [
                    {
                      "i": "protocol_repair_queue",
                      "x": 0,
                      "y": 0,
                      "w": 40,
                      "h": 12
                    }
                  ]
                }
              }
            }
          ]
        },
        "graded_args": [
          "operation",
          "name"
        ]
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "list"
        },
        "optional": true
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_005",
          "app_name": "Protocol Repair App",
          "dashboard_name": "Protocol-display Restored",
          "activate": true
        },
        "graded_args": [
          "operation"
        ]
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Protocol-display Rebuild Note",
          "data": "growth-rate reversals"
        },
        "graded_args": [
          "widget_type",
          "name"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Wave Three Protocol Repair",
        "widget_id": "protocol_repair_queue",
        "tab_id": "protocols"
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "name_contains": "Protocol-display Rebuild Note",
        "data_contains": [
          "growth-rate reversals"
        ]
      }
    ],
    "required_widget_defs": [
      {
        "backend_name": "Wave Three Protocol Repair",
        "widget_id": "protocol_repair_queue",
        "expect": {
          "type": "table"
        }
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Wave Three Protocol Repair",
        "name_contains": "Protocol Repair App",
        "tabs_include": [
          "protocols"
        ],
        "layout_refs_valid": true,
        "no_overlaps": true,
        "widgets_on_tab": [
          {
            "tab_id": "protocols",
            "widget_id": "protocol_repair_queue"
          }
        ]
      }
    ],
    "max_turns": 10
  }
}
