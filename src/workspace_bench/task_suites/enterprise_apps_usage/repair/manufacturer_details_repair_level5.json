{
  "id": "manufacturer_details_repair_level5",
  "category": "repair",
  "difficulty": "level5",
  "prompt": "Detail-queue backend rebuild: Wave Two Detail Repair was lost from the workspace; on the open Custom Detail Repair dashboard, rebuild it from scratch: add a custom backend Wave Two Detail Repair with a Manufacturer Detail Queue table, publish Detail Repair App, and instantiate it with one non-overlapping Manufacturer Detail Queue placement on Details, keeping all other workspace content. Follow the widgets manifest specification. Widget ids are the snake_case of widget names; tab ids are the snake_case of tab names. Follow the Daloopa Industry skill (daloopa-industry) and add a Detail-queue Rebuild Note recording who it lists from the company directory.",
  "setup": {
    "workspace_baseline": "stark-workspace-a",
    "workspace_backends": [
      "stark-enterprise-x",
      "support-daloopa-skills",
      "getting-started",
      "widget-examples"
    ],
    "workspace_skills": [
      "daloopa-capital-allocation",
      "daloopa-earnings-review",
      "daloopa-guidance-tracker",
      "daloopa-industry",
      "daloopa-inflection",
      "daloopa-tearsheet",
      "finance-comps",
      "finance-earnings-prep",
      "finance-guidance-tracker",
      "finance-tearsheet"
    ],
    "default_selected_dashboard": "Custom Detail Repair",
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ],
    "initial_state": {
      "dashboard": {
        "name": "Custom Detail Repair",
        "activate": false,
        "tabs": [
          {
            "id": "details",
            "name": "Details"
          }
        ],
        "widgets": []
      }
    }
  },
  "eval": {
    "required_tools": [
      {
        "tool": "get_workspace_snapshot",
        "args": {},
        "optional": true
      },
      {
        "tool": "get_skill_content",
        "args": {
          "slug": "daloopa-industry"
        },
        "graded_args": [
          "slug"
        ]
      },
      {
        "tool": "read_workspace_resource",
        "args": {
          "uri": "openbb://workspace/specs/widgets-json"
        },
        "optional": true
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Wave Two Detail Repair",
          "url": "http://127.0.0.1:9604",
          "widgets_json": {
            "manufacturer_detail_queue": {
              "name": "Manufacturer Detail Queue",
              "description": "Rebuilt queue for Detail-queue.",
              "endpoint": "/manufacturer_detail_queue",
              "type": "table",
              "gridData": {
                "w": 40,
                "h": 12
              }
            }
          },
          "apps_json": [
            {
              "name": "Detail Repair App",
              "description": "Wave-1 authored app for Detail Repair App.",
              "tabs": {
                "details": {
                  "id": "details",
                  "name": "Details",
                  "layout": [
                    {
                      "i": "manufacturer_detail_queue",
                      "x": 0,
                      "y": 0,
                      "w": 40,
                      "h": 12
                    }
                  ]
                }
              }
            }
          ]
        },
        "graded_args": [
          "operation",
          "name"
        ]
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "list"
        },
        "optional": true
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_005",
          "app_name": "Detail Repair App",
          "dashboard_name": "Detail-queue Restored",
          "activate": true
        },
        "graded_args": [
          "operation"
        ]
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Detail-queue Rebuild Note",
          "data": "peers"
        },
        "graded_args": [
          "widget_type",
          "name"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Wave Two Detail Repair",
        "widget_id": "manufacturer_detail_queue",
        "tab_id": "details"
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "name_contains": "Detail-queue Rebuild Note",
        "data_contains": [
          "peers"
        ]
      }
    ],
    "required_widget_defs": [
      {
        "backend_name": "Wave Two Detail Repair",
        "widget_id": "manufacturer_detail_queue",
        "expect": {
          "type": "table"
        }
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Wave Two Detail Repair",
        "name_contains": "Detail Repair App",
        "tabs_include": [
          "details"
        ],
        "layout_refs_valid": true,
        "no_overlaps": true,
        "widgets_on_tab": [
          {
            "tab_id": "details",
            "widget_id": "manufacturer_detail_queue"
          }
        ]
      }
    ],
    "max_turns": 10
  }
}
