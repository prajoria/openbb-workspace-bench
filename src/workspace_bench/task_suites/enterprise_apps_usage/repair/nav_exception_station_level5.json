{
  "id": "nav_exception_station_level5",
  "category": "repair",
  "difficulty": "level5",
  "prompt": "Pilot NAV Repair was lost from the workspace; on the open Custom NAV Repair Staging dashboard, rebuild it from scratch: add a custom backend Pilot NAV Repair with a NAV Exception Queue table, publish NAV Repair App, and instantiate it with one non-overlapping NAV Exception Queue placement on Exceptions, keeping all other workspace content. Follow the widgets.json spec. Follow the Daloopa Guidance Tracker skill and add a NAV-exception Rebuild Note recording the last of the three verdict kinds it tallies.",
  "setup": {
    "workspace_baseline": "stark-workspace-a",
    "workspace_backends": [
      "stark-enterprise-x",
      "support-daloopa-skills",
      "getting-started",
      "widget-examples"
    ],
    "workspace_skills": [
      "daloopa-capital-allocation",
      "daloopa-earnings-review",
      "daloopa-guidance-tracker",
      "daloopa-industry",
      "daloopa-inflection",
      "daloopa-tearsheet",
      "finance-comps",
      "finance-earnings-prep",
      "finance-guidance-tracker",
      "finance-tearsheet"
    ],
    "default_selected_dashboard": "Custom NAV Repair Staging",
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ],
    "initial_state": {
      "dashboard": {
        "name": "Custom NAV Repair Staging",
        "activate": false,
        "tabs": [
          {
            "id": "exceptions",
            "name": "Exceptions"
          }
        ],
        "widgets": []
      }
    }
  },
  "eval": {
    "required_tools": [
      {
        "tool": "get_workspace_snapshot",
        "args": {},
        "optional": true
      },
      {
        "tool": "get_skill_content",
        "args": {
          "slug": "daloopa-guidance-tracker"
        },
        "graded_args": [
          "slug"
        ]
      },
      {
        "tool": "read_workspace_resource",
        "args": {
          "uri": "openbb://workspace/specs/widgets-json"
        },
        "optional": true
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Pilot NAV Repair",
          "url": "http://127.0.0.1:9504",
          "widgets_json": {
            "nav_exception_queue": {
              "name": "NAV Exception Queue",
              "description": "Rebuilt queue for NAV-exception.",
              "endpoint": "/nav_exception_queue",
              "type": "table",
              "gridData": {
                "w": 40,
                "h": 12
              }
            }
          },
          "apps_json": [
            {
              "name": "NAV Repair App",
              "description": "Authored app for NAV Repair App.",
              "tabs": {
                "exceptions": {
                  "id": "exceptions",
                  "name": "Exceptions",
                  "layout": [
                    {
                      "i": "nav_exception_queue",
                      "x": 0,
                      "y": 0,
                      "w": 40,
                      "h": 12
                    }
                  ]
                }
              }
            }
          ]
        },
        "graded_args": [
          "operation",
          "name"
        ]
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "list"
        },
        "optional": true
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_005",
          "app_name": "NAV Repair App",
          "dashboard_name": "NAV-exception Restored",
          "activate": true
        },
        "graded_args": [
          "operation"
        ]
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "NAV-exception Rebuild Note",
          "data": "Missed"
        },
        "graded_args": [
          "widget_type",
          "name"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Pilot NAV Repair",
        "widget_id": "nav_exception_queue",
        "tab_id": "exceptions"
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "name_contains": "NAV-exception Rebuild Note",
        "data_contains": [
          "Missed"
        ]
      }
    ],
    "required_widget_defs": [
      {
        "backend_name": "Pilot NAV Repair",
        "widget_id": "nav_exception_queue",
        "expect": {
          "type": "table"
        }
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Pilot NAV Repair",
        "name_contains": "NAV Repair App",
        "tabs_include": [
          "exceptions"
        ],
        "layout_refs_valid": true,
        "no_overlaps": true,
        "widgets_on_tab": [
          {
            "tab_id": "exceptions",
            "widget_id": "nav_exception_queue"
          }
        ]
      }
    ],
    "max_turns": 10
  }
}
