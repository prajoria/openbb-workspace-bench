{
  "id": "full_risk_exposure_monitor",
  "category": "dashboard",
  "family": "resources",
  "difficulty": "hard",
  "prompt": "Use the app-builder index resource openbb://workspace/app-builder/index, instantiate risk-exposure-monitor as Risk Resource Command, navigate to limits, add widget risk_exposure_monitor_limits_limit_utilization, and add a note mentioning limit utilization and resource.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "stark-enterprise"
        }
      ]
    },
    "initial_state": {},
    "allowed_tools": [
      "read_workspace_resource",
      "manage_backends",
      "manage_apps",
      "navigate_workspace",
      "get_widget_schema",
      "create_widget",
      "add_generative_widget"
    ]
  },
  "eval": {
    "required_dashboard_name_contains": "Risk Resource Command",
    "required_resource_reads": [
      {
        "uri": "openbb://workspace/app-builder/index",
        "data_contains": [
          "risk-exposure-monitor"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "risk_exposure_monitor_limits_limit_utilization",
        "tab_id": "limits"
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "limit utilization",
          "resource"
        ],
        "tab_id": "limits"
      }
    ],
    "layout": {
      "within_grid": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference_trace": [
      {
        "tool": "read_workspace_resource",
        "args": {
          "uri": "openbb://workspace/app-builder/index"
        }
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "list"
        }
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_001",
          "template_id": "risk-exposure-monitor",
          "dashboard_name": "Risk Resource Command",
          "activate": true
        }
      },
      {
        "tool": "navigate_workspace",
        "args": {
          "operation": "tab",
          "tab_id": "limits"
        }
      },
      {
        "tool": "get_widget_schema",
        "args": {
          "origin": "Bench Stark Enterprise",
          "widget_id": "risk_exposure_monitor_limits_limit_utilization"
        }
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Bench Stark Enterprise",
          "widget_id": "risk_exposure_monitor_limits_limit_utilization"
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Resource Extension Note",
          "data": "limit utilization added from resource guidance."
        }
      }
    ],
    "max_turns": 9
  }
}
