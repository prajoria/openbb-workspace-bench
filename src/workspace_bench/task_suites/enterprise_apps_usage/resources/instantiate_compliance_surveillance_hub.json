{
  "id": "instantiate_compliance_surveillance_hub",
  "category": "dashboard",
  "family": "resources",
  "difficulty": "medium",
  "prompt": "Use the app-builder index resource openbb://workspace/app-builder/index, then instantiate template compliance-surveillance-hub as a dashboard named Compliance Resource Dashboard.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "stark-enterprise"
        }
      ]
    },
    "initial_state": {},
    "allowed_tools": [
      "read_workspace_resource",
      "manage_backends",
      "manage_apps"
    ]
  },
  "eval": {
    "required_dashboard_name_contains": "Compliance Resource Dashboard",
    "required_resource_reads": [
      {
        "uri": "openbb://workspace/app-builder/index",
        "data_contains": [
          "compliance-surveillance-hub"
        ]
      }
    ],
    "required_tool_calls": [
      {
        "tool": "manage_apps",
        "args_contains": {
          "operation": "instantiate"
        }
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 0
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference_trace": [
      {
        "tool": "read_workspace_resource",
        "args": {
          "uri": "openbb://workspace/app-builder/index"
        }
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "list"
        }
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_001",
          "template_id": "compliance-surveillance-hub",
          "dashboard_name": "Compliance Resource Dashboard",
          "activate": true
        }
      }
    ],
    "max_turns": 6
  }
}
