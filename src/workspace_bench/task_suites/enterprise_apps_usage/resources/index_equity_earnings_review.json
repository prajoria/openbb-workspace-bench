{
  "id": "index_equity_earnings_review",
  "category": "dashboard",
  "family": "resources",
  "difficulty": "easy",
  "prompt": "Call read_workspace_resource with uri openbb://workspace/app-builder/index and add a note naming the Onboarding App for Devs app and its aggrid tab.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "getting-started"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "App Index Review",
        "activate": true,
        "tabs": [
          {
            "id": "",
            "name": ""
          }
        ],
        "dashboard_id": "usage_index_equity_earnings_review_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "read_workspace_resource",
      "add_generative_widget"
    ]
  },
  "eval": {
    "required_resource_reads": [
      {
        "uri": "openbb://workspace/app-builder/index",
        "data_contains": [
          "Onboarding App for Devs",
          "tabs=aggrid"
        ]
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "Onboarding App for Devs",
          "tabs=aggrid"
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 0
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference_trace": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "read_workspace_resource",
        "args": {
          "uri": "openbb://workspace/app-builder/index"
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "App Index Note",
          "data": "Onboarding App for Devs; tabs=aggrid."
        }
      }
    ],
    "max_turns": 6
  }
}
