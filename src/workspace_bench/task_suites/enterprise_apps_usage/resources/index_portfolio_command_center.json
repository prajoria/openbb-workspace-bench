{
  "id": "index_portfolio_command_center",
  "category": "dashboard",
  "family": "resources",
  "difficulty": "easy",
  "prompt": "After calling read_workspace_resource with uri openbb://workspace/app-builder/index, add a note naming the Portfolio Command Center template id portfolio-command-center.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "stark-enterprise"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "App Index Review",
        "activate": true,
        "tabs": [
          {
            "id": "",
            "name": ""
          }
        ],
        "dashboard_id": "usage_index_portfolio_command_center_dashboard_001",
        "widgets": [
          {
            "origin": "Bench Stark Enterprise",
            "widget_id": "vendor_dataset_monitor_quality_row_count_drift",
            "data_args": {},
            "tab_id": "",
            "layout": {
              "x": 0,
              "y": 500,
              "w": 8,
              "h": 4
            },
            "widget_uuid": "usage_index_portfolio_command_center_widget_001"
          }
        ]
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "read_workspace_resource",
      "add_generative_widget"
    ]
  },
  "eval": {
    "required_resource_reads": [
      {
        "uri": "openbb://workspace/app-builder/index",
        "data_contains": [
          "Portfolio Command Center",
          "portfolio-command-center"
        ]
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "Portfolio Command Center",
          "portfolio-command-center"
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 0
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "required_widgets": [
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "vendor_dataset_monitor_quality_row_count_drift",
        "data_args": {},
        "tab_id": "",
        "min_count": 1,
        "max_count": 1
      }
    ],
    "reference": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "read_workspace_resource",
        "args": {
          "uri": "openbb://workspace/app-builder/index"
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "App Index Note",
          "data": "Portfolio Command Center; portfolio-command-center."
        }
      }
    ],
    "limits": {
      "max_turns": 6
    }
  }
}
