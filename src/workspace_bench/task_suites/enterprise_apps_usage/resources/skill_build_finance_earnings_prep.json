{
  "id": "skill_build_finance_earnings_prep",
  "category": "dashboard",
  "family": "resources",
  "difficulty": "medium",
  "prompt": "Read resource openbb://workspace/specs/widgets-json, add Getting Started/live_grid_data with data_args {\"symbol\": \"AAPL\"}, and add a note that mentions surprise drivers.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "getting-started"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Resource Build",
        "activate": true,
        "tabs": [
          {
            "id": "",
            "name": ""
          }
        ],
        "dashboard_id": "usage_skill_build_finance_earnings_prep_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "read_workspace_resource",
      "list_available_widgets",
      "get_widget_schema",
      "create_widget",
      "add_generative_widget"
    ]
  },
  "eval": {
    "required_resource_reads": [
      {
        "uri": "openbb://workspace/specs/widgets-json",
        "data_contains": [
          "widgets.json"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Getting Started",
        "widget_id": "live_grid_data",
        "data_args": {
          "symbol": "AAPL"
        }
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "surprise drivers"
        ]
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "read_workspace_resource",
        "args": {
          "uri": "openbb://workspace/specs/widgets-json"
        }
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Getting Started"
        }
      },
      {
        "tool": "get_widget_schema",
        "args": {
          "origin": "Getting Started",
          "widget_id": "live_grid_data"
        }
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Getting Started",
          "widget_id": "live_grid_data",
          "data_args": {
            "symbol": "AAPL"
          }
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Resource Build Note",
          "data": "Built from resource guidance: surprise drivers."
        }
      }
    ],
    "limits": {
      "max_turns": 9
    }
  }
}
