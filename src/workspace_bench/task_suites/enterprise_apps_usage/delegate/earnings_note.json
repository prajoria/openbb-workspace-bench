{
  "id": "earnings_note",
  "category": "platform",
  "family": "delegate",
  "difficulty": "medium",
  "prompt": "Call assign_tasks_to_agents with two task_requests using ids coverage-analyst and model-analyst for earnings prep work. Then add a coordinator note naming both workstreams on the active dashboard; omit dashboard_id when adding the note.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "stark-enterprise"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Delegation Board",
        "activate": true,
        "tabs": [
          {
            "id": "overview",
            "name": "Overview"
          }
        ],
        "dashboard_id": "usage_earnings_note_dashboard_001",
        "widgets": [
          {
            "origin": "Bench Stark Enterprise",
            "widget_id": "stress_liquidity_lab_sign_off_approval_checklist",
            "data_args": {},
            "tab_id": "overview",
            "layout": {
              "x": 0,
              "y": 500,
              "w": 8,
              "h": 4
            },
            "widget_uuid": "usage_earnings_note_widget_001"
          }
        ]
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "assign_tasks_to_agents",
      "add_generative_widget"
    ]
  },
  "eval": {
    "required_tool_calls": [
      {
        "tool": "assign_tasks_to_agents"
      }
    ],
    "required_tool_results": [
      {
        "tool": "assign_tasks_to_agents",
        "data_contains": [
          "coverage-analyst",
          "model-analyst"
        ]
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "coverage analyst",
          "model analyst",
          "earnings prep"
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 0
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "required_widgets": [
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "stress_liquidity_lab_sign_off_approval_checklist",
        "data_args": {},
        "tab_id": "overview",
        "min_count": 1,
        "max_count": 1
      }
    ],
    "reference_trace": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "assign_tasks_to_agents",
        "args": {
          "task_requests": [
            {
              "id": "coverage-analyst",
              "description": "Review estimate revisions and transcript tone.",
              "assigned_holder_url": "workspace://agents/coverage",
              "assigned_agent_id": "coverage-agent"
            },
            {
              "id": "model-analyst",
              "description": "Check the internal versus street model bridge.",
              "assigned_holder_url": "workspace://agents/model",
              "assigned_agent_id": "model-agent"
            }
          ]
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Delegation Note",
          "data": "coverage analyst; model analyst; earnings prep."
        }
      }
    ],
    "max_turns": 6
  }
}
