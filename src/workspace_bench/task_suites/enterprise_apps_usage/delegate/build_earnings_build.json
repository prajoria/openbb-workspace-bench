{
  "id": "build_earnings_build",
  "category": "platform",
  "family": "delegate",
  "difficulty": "hard",
  "prompt": "Use assign_tasks_to_agents with two task_requests using ids revisions-analyst and reaction-analyst. Then add the Consensus Revisions widget (id earnings_estimates_monitor_estimates_consensus_revisions) from the Bench Stark Enterprise backend so the workstreams have their data, and add a coordinator note naming both workstreams. Omit dashboard_id when adding the note.",
  "fixtures": {
    "backends": [
      {
        "name": "stark-enterprise"
      }
    ]
  },
  "initial_state": {
    "dashboard": {
      "name": "Delegation Board",
      "activate": true,
      "tabs": [
        {
          "id": "overview",
          "name": "Overview"
        }
      ],
      "dashboard_id": "usage_build_earnings_build_dashboard_001",
      "widgets": [
        {
          "origin": "Bench Stark Enterprise",
          "widget_id": "strategy_health_monitor_themes_crowded_names",
          "data_args": {},
          "tab_id": "overview",
          "layout": {
            "x": 0,
            "y": 500,
            "w": 8,
            "h": 4
          },
          "widget_uuid": "usage_build_earnings_build_widget_001"
        }
      ]
    }
  },
  "allowed_tools": [
    "get_workspace_snapshot",
    "assign_tasks_to_agents",
    "list_available_widgets",
    "get_widget_schema",
    "create_widget",
    "add_generative_widget"
  ],
  "success": {
    "required_tool_calls": [
      {
        "tool": "assign_tasks_to_agents"
      }
    ],
    "required_tool_results": [
      {
        "tool": "assign_tasks_to_agents",
        "data_contains": [
          "revisions-analyst",
          "reaction-analyst"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "earnings_estimates_monitor_estimates_consensus_revisions",
        "data_args": {},
        "min_count": 1
      },
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "strategy_health_monitor_themes_crowded_names",
        "data_args": {},
        "tab_id": "overview",
        "min_count": 1,
        "max_count": 1
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "revisions analyst",
          "reaction analyst",
          "consensus revisions"
        ]
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_snapshot",
      "args": {}
    },
    {
      "tool": "assign_tasks_to_agents",
      "args": {
        "task_requests": [
          {
            "id": "revisions-analyst",
            "description": "Track consensus revisions into the print.",
            "assigned_holder_url": "workspace://agents/revisions",
            "assigned_agent_id": "revisions-agent"
          },
          {
            "id": "reaction-analyst",
            "description": "Prepare the post-earnings price reaction view.",
            "assigned_holder_url": "workspace://agents/reaction",
            "assigned_agent_id": "reaction-agent"
          }
        ]
      }
    },
    {
      "tool": "list_available_widgets",
      "args": {
        "origin": "Bench Stark Enterprise"
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Bench Stark Enterprise",
        "widget_id": "earnings_estimates_monitor_estimates_consensus_revisions"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Bench Stark Enterprise",
        "widget_id": "earnings_estimates_monitor_estimates_consensus_revisions",
        "data_args": {}
      }
    },
    {
      "tool": "add_generative_widget",
      "args": {
        "widget_type": "note",
        "name": "Delegation Note",
        "data": "revisions analyst; reaction analyst; consensus revisions."
      }
    }
  ],
  "limits": {
    "max_turns": 8
  }
}
