{
  "id": "build_vendor_build",
  "category": "platform",
  "family": "delegate",
  "difficulty": "hard",
  "prompt": "Call assign_tasks_to_agents with two task_requests using ids triage-analyst and sla-analyst. Then add the Incident Log widget (id vendor_dataset_monitor_incidents_incident_log) from the Bench Stark Enterprise backend so the workstreams have their data, and add a coordinator HTML card naming both workstreams. Omit dashboard_id when adding the HTML card.",
  "fixtures": {
    "backends": [
      {
        "name": "stark-enterprise"
      }
    ]
  },
  "initial_state": {
    "dashboard": {
      "name": "Delegation Board",
      "activate": true,
      "tabs": [
        {
          "id": "overview",
          "name": "Overview"
        }
      ],
      "widgets": [
        {
          "origin": "Bench Stark Enterprise",
          "widget_id": "strategy_health_monitor_watchlist_names_near_action_levels",
          "data_args": {},
          "tab_id": "overview",
          "layout": {
            "x": 0,
            "y": 500,
            "w": 8,
            "h": 4
          }
        }
      ]
    }
  },
  "allowed_tools": [
    "get_workspace_snapshot",
    "assign_tasks_to_agents",
    "list_available_widgets",
    "get_widget_schema",
    "create_widget",
    "add_generative_widget"
  ],
  "success": {
    "required_tool_calls": [
      {
        "tool": "assign_tasks_to_agents"
      }
    ],
    "required_tool_results": [
      {
        "tool": "assign_tasks_to_agents",
        "data_contains": [
          "triage-analyst",
          "sla-analyst"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "vendor_dataset_monitor_incidents_incident_log",
        "data_args": {},
        "min_count": 1
      },
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "strategy_health_monitor_watchlist_names_near_action_levels",
        "data_args": {},
        "tab_id": "overview",
        "min_count": 1,
        "max_count": 1
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "html",
        "data_contains": [
          "triage analyst",
          "sla analyst",
          "incident log"
        ]
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_snapshot",
      "args": {}
    },
    {
      "tool": "assign_tasks_to_agents",
      "args": {
        "task_requests": [
          {
            "id": "triage-analyst",
            "description": "Triage the open vendor incident log.",
            "assigned_holder_url": "workspace://agents/triage",
            "assigned_agent_id": "triage-agent"
          },
          {
            "id": "sla-analyst",
            "description": "Check SLA breach history for the affected vendor.",
            "assigned_holder_url": "workspace://agents/sla",
            "assigned_agent_id": "sla-agent"
          }
        ]
      }
    },
    {
      "tool": "list_available_widgets",
      "args": {
        "origin": "Bench Stark Enterprise"
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Bench Stark Enterprise",
        "widget_id": "vendor_dataset_monitor_incidents_incident_log"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Bench Stark Enterprise",
        "widget_id": "vendor_dataset_monitor_incidents_incident_log",
        "data_args": {}
      }
    },
    {
      "tool": "add_generative_widget",
      "args": {
        "widget_type": "html",
        "name": "Delegation Note",
        "data": "<section>triage analyst; sla analyst; incident log.</section>"
      }
    }
  ],
  "limits": {
    "max_turns": 8
  }
}
