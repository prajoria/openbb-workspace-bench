{
  "id": "risk_single",
  "category": "platform",
  "family": "delegate",
  "difficulty": "easy",
  "prompt": "Call assign_tasks_to_agents with one task_request using id stress-analyst for risk review work: Run the historical stress scenarios and summarize losses.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "stark-enterprise"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Delegation Board",
        "activate": true,
        "tabs": [
          {
            "id": "overview",
            "name": "Overview"
          }
        ],
        "dashboard_id": "usage_risk_single_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_tool_calls": [
      {
        "tool": "assign_tasks_to_agents"
      }
    ],
    "required_tool_results": [
      {
        "tool": "assign_tasks_to_agents",
        "data_contains": [
          "stress-analyst"
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 0
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference_trace": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "assign_tasks_to_agents",
        "args": {
          "task_requests": [
            {
              "id": "stress-analyst",
              "description": "Run the historical stress scenarios and summarize losses.",
              "assigned_holder_url": "workspace://agents/stress",
              "assigned_agent_id": "stress-agent"
            }
          ]
        }
      }
    ],
    "max_turns": 5
  }
}
