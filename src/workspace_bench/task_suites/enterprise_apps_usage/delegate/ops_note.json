{
  "id": "ops_note",
  "category": "platform",
  "family": "delegate",
  "difficulty": "medium",
  "prompt": "For vendor sla monitoring work, call assign_tasks_to_agents with two task_requests using ids triage-analyst and sla-analyst. Then add a coordinator note naming both workstreams on the active dashboard; omit dashboard_id when adding the note.",
  "fixtures": {
    "backends": [
      {
        "name": "stark-enterprise"
      }
    ]
  },
  "initial_state": {
    "dashboard": {
      "name": "Delegation Board",
      "activate": true,
      "tabs": [
        {
          "id": "overview",
          "name": "Overview"
        }
      ],
      "widgets": [
        {
          "origin": "Bench Stark Enterprise",
          "widget_id": "vendor_dataset_monitor_slas_latency_by_feed",
          "data_args": {},
          "tab_id": "overview",
          "layout": {
            "x": 0,
            "y": 500,
            "w": 8,
            "h": 4
          }
        }
      ]
    }
  },
  "allowed_tools": [
    "get_workspace_snapshot",
    "assign_tasks_to_agents",
    "add_generative_widget"
  ],
  "success": {
    "required_tool_calls": [
      {
        "tool": "assign_tasks_to_agents"
      }
    ],
    "required_tool_results": [
      {
        "tool": "assign_tasks_to_agents",
        "data_contains": [
          "triage-analyst",
          "sla-analyst"
        ]
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "triage analyst",
          "sla analyst",
          "vendor"
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 0
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "required_widgets": [
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "vendor_dataset_monitor_slas_latency_by_feed",
        "data_args": {},
        "tab_id": "overview",
        "min_count": 1,
        "max_count": 1
      }
    ]
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_snapshot",
      "args": {}
    },
    {
      "tool": "assign_tasks_to_agents",
      "args": {
        "task_requests": [
          {
            "id": "triage-analyst",
            "description": "Triage the open vendor incident log.",
            "assigned_holder_url": "workspace://agents/triage",
            "assigned_agent_id": "triage-agent"
          },
          {
            "id": "sla-analyst",
            "description": "Check SLA breach history for the affected vendor.",
            "assigned_holder_url": "workspace://agents/sla",
            "assigned_agent_id": "sla-agent"
          }
        ]
      }
    },
    {
      "tool": "add_generative_widget",
      "args": {
        "widget_type": "note",
        "name": "Delegation Note",
        "data": "triage analyst; sla analyst; vendor."
      }
    }
  ],
  "limits": {
    "max_turns": 6
  }
}
