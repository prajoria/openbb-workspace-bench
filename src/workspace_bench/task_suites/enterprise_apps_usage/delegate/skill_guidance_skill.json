      {
        "tool": "get_skill_content",
        "args_contains": {
          "slug": "finance-guidance-tracker"
        }
      },
      {
        "tool": "assign_tasks_to_agents"
      }
    ],
    "required_tool_results": [
      {
        "tool": "get_skill_content",
        "data_contains": [
          "Guidance tracker workflow",
          "management claims",
          "evidence gaps"
        ]
      },
      {
        "tool": "assign_tasks_to_agents",
        "data_contains": [
          "claims-analyst",
          "evidence-analyst"
        ]
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "claims analyst",
          "evidence analyst",
          "guidance"
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 0
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "required_widgets": [
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "workspace_data_control_center_usage_app_usage",
        "data_args": {},
        "tab_id": "overview",
        "min_count": 1,
        "max_count": 1
      }
    ]
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_snapshot",
      "args": {}
    },
    {
      "tool": "get_skill_content",
      "args": {
        "slug": "finance-guidance-tracker"
      }
    },
    {
      "tool": "assign_tasks_to_agents",
      "args": {
        "task_requests": [
          {
            "id": "claims-analyst",
