            "description": "List evidence gaps against prior guidance.",
            "assigned_holder_url": "workspace://agents/evidence",
            "assigned_agent_id": "evidence-agent"
          }
        ]
      }
    },
    {
      "tool": "add_generative_widget",
      "args": {
        "widget_type": "note",
        "name": "Delegation Note",
        "data": "claims analyst; evidence analyst; guidance."
      }
    }
