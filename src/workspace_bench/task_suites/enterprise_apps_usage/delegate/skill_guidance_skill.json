{
  "id": "skill_guidance_skill",
  "category": "platform",
  "family": "delegate",
  "difficulty": "hard",
  "prompt": "After calling get_skill_content with slug finance-guidance-tracker to understand the workflow, call assign_tasks_to_agents with two task_requests using ids claims-analyst and evidence-analyst covering that workflow, and add a coordinator note naming both workstreams. Omit dashboard_id when adding the note.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "stark-enterprise"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Delegation Board",
        "activate": true,
        "tabs": [
          {
            "id": "overview",
            "name": "Overview"
          }
        ],
        "dashboard_id": "usage_skill_guidance_skill_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "get_skill_content",
      "assign_tasks_to_agents",
      "add_generative_widget"
    ]
  },
  "eval": {
    "required_tool_calls": [
      {
        "tool": "get_skill_content",
        "args_contains": {
          "slug": "finance-guidance-tracker"
        }
      },
      {
        "tool": "assign_tasks_to_agents"
      }
    ],
    "required_tool_results": [
      {
        "tool": "get_skill_content",
        "data_contains": [
          "Guidance tracker workflow",
          "management claims",
          "evidence gaps"
        ]
      },
      {
        "tool": "assign_tasks_to_agents",
        "data_contains": [
          "claims-analyst",
          "evidence-analyst"
        ]
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "claims analyst",
          "evidence analyst",
          "guidance"
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 0
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference_trace": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "get_skill_content",
        "args": {
          "slug": "finance-guidance-tracker"
        }
      },
      {
        "tool": "assign_tasks_to_agents",
        "args": {
          "task_requests": [
            {
              "id": "claims-analyst",
              "description": "Extract management claims from the call.",
              "assigned_holder_url": "workspace://agents/claims",
              "assigned_agent_id": "claims-agent"
            },
            {
              "id": "evidence-analyst",
              "description": "List evidence gaps against prior guidance.",
              "assigned_holder_url": "workspace://agents/evidence",
              "assigned_agent_id": "evidence-agent"
            }
          ]
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Delegation Note",
          "data": "claims analyst; evidence analyst; guidance."
        }
      }
    ],
    "max_turns": 7
  }
}
