{
  "id": "inflection_service_lifecycle_level5",
  "category": "platform",
  "difficulty": "level5",
  "prompt": "Inflection-service complete service: follow the widgets manifest specification; add a custom backend Wave Three Inflection Service with Growth-Rate Reversals, Quarterly Series Monitor, Inflection Evidence Log tables, publish Inflection Service App with Growth-Rate Reversals and Quarterly Series Monitor on Review and Inflection Evidence Log on Archive, and instantiate it. Widget ids are the snake_case of widget names; tab ids are the snake_case of tab names. Follow the Daloopa Inflection skill (daloopa-inflection) and add a Inflection-service Governing Note recording the first growth cadence it computes.",
  "setup": {
    "workspace_baseline": "stark-workspace-a",
    "workspace_backends": [
      "stark-enterprise-x",
      "support-daloopa-skills",
      "getting-started",
      "widget-examples"
    ],
    "workspace_skills": [
      "daloopa-capital-allocation",
      "daloopa-earnings-review",
      "daloopa-guidance-tracker",
      "daloopa-industry",
      "daloopa-inflection",
      "daloopa-tearsheet",
      "finance-comps",
      "finance-earnings-prep",
      "finance-guidance-tracker",
      "finance-tearsheet"
    ],
    "default_selected_dashboard": "Home",
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_tools": [
      {
        "tool": "get_workspace_snapshot",
        "args": {},
        "optional": true
      },
      {
        "tool": "get_skill_content",
        "args": {
          "slug": "daloopa-inflection"
        },
        "graded_args": [
          "slug"
        ]
      },
      {
        "tool": "read_workspace_resource",
        "args": {
          "uri": "openbb://workspace/specs/widgets-json"
        },
        "optional": true
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Wave Three Inflection Service",
          "url": "http://127.0.0.1:9711",
          "widgets_json": {
            "growth_rate_reversals": {
              "name": "Growth-Rate Reversals",
              "description": "Wave-1 view for Growth-Rate Reversals.",
              "endpoint": "/growth_rate_reversals",
              "type": "table",
              "gridData": {
                "w": 40,
                "h": 10
              }
            },
            "quarterly_series_monitor": {
              "name": "Quarterly Series Monitor",
              "description": "Wave-1 view for Quarterly Series Monitor.",
              "endpoint": "/quarterly_series_monitor",
              "type": "table",
              "gridData": {
                "w": 40,
                "h": 10
              }
            },
            "inflection_evidence_log": {
              "name": "Inflection Evidence Log",
              "description": "Wave-1 view for Inflection Evidence Log.",
              "endpoint": "/inflection_evidence_log",
              "type": "table",
              "gridData": {
                "w": 40,
                "h": 10
              }
            }
          },
          "apps_json": [
            {
              "name": "Inflection Service App",
              "description": "Wave-1 authored app for Inflection Service App.",
              "tabs": {
                "review": {
                  "id": "review",
                  "name": "Review",
                  "layout": [
                    {
                      "i": "growth_rate_reversals",
                      "x": 0,
                      "y": 0,
                      "w": 40,
                      "h": 10
                    },
                    {
                      "i": "quarterly_series_monitor",
                      "x": 0,
                      "y": 10,
                      "w": 40,
                      "h": 10
                    }
                  ]
                },
                "archive": {
                  "id": "archive",
                  "name": "Archive",
                  "layout": [
                    {
                      "i": "inflection_evidence_log",
                      "x": 0,
                      "y": 0,
                      "w": 40,
                      "h": 10
                    }
                  ]
                }
              }
            }
          ]
        },
        "graded_args": [
          "operation",
          "name"
        ]
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "list"
        },
        "optional": true
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_005",
          "app_name": "Inflection Service App",
          "dashboard_name": "Inflection-service Live",
          "activate": true
        },
        "graded_args": [
          "operation"
        ]
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Inflection-service Governing Note",
          "data": "quarter-over-quarter"
        },
        "graded_args": [
          "widget_type",
          "name"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Wave Three Inflection Service",
        "widget_id": "growth_rate_reversals",
        "tab_id": "review"
      },
      {
        "origin": "Wave Three Inflection Service",
        "widget_id": "quarterly_series_monitor",
        "tab_id": "review"
      },
      {
        "origin": "Wave Three Inflection Service",
        "widget_id": "inflection_evidence_log",
        "tab_id": "archive"
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "name_contains": "Inflection-service Governing Note",
        "data_contains": [
          "quarter-over-quarter"
        ]
      }
    ],
    "required_widget_defs": [
      {
        "backend_name": "Wave Three Inflection Service",
        "widget_id": "growth_rate_reversals",
        "expect": {}
      },
      {
        "backend_name": "Wave Three Inflection Service",
        "widget_id": "quarterly_series_monitor",
        "expect": {}
      },
      {
        "backend_name": "Wave Three Inflection Service",
        "widget_id": "inflection_evidence_log",
        "expect": {}
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Wave Three Inflection Service",
        "name_contains": "Inflection Service App",
        "tabs_include": [
          "review",
          "archive"
        ],
        "layout_refs_valid": true,
        "no_overlaps": true
      }
    ],
    "max_turns": 10
  }
}
