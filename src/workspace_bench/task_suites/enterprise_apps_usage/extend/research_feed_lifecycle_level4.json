{
  "id": "research_feed_lifecycle_level4",
  "category": "platform",
  "difficulty": "level4",
  "prompt": "Set up and add Rollout Research Feed with Research Feed Pulse and Source Freshness Alert, publish Research Feed App with both on Feed, and instantiate it.",
  "setup": {
    "workspace_baseline": "stark-workspace-a",
    "workspace_backends": [
      "stark-enterprise-x",
      "support-daloopa-skills",
      "getting-started",
      "widget-examples"
    ],
    "workspace_skills": [
      "daloopa-capital-allocation",
      "daloopa-earnings-review",
      "daloopa-guidance-tracker",
      "daloopa-industry",
      "daloopa-inflection",
      "daloopa-tearsheet",
      "finance-comps",
      "finance-earnings-prep",
      "finance-guidance-tracker",
      "finance-tearsheet"
    ],
    "default_selected_dashboard": "Home",
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_tools": [
      {
        "tool": "get_workspace_snapshot",
        "args": {},
        "optional": true
      },
      {
        "tool": "read_workspace_resource",
        "args": {
          "uri": "openbb://workspace/specs/widgets-json"
        },
        "optional": true
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Rollout Research Feed",
          "url": "http://127.0.0.1:9606",
          "widgets_json": {
            "research_feed_pulse": {
              "name": "Research Feed Pulse",
              "description": "Refreshed research feed.",
              "endpoint": "/research-feed",
              "type": "table",
              "gridData": {
                "w": 40,
                "h": 10
              }
            },
            "source_freshness_alert": {
              "name": "Source Freshness Alert",
              "description": "Authored view for Source Freshness Alert.",
              "endpoint": "/source-freshness",
              "type": "table",
              "gridData": {
                "w": 20,
                "h": 10
              }
            }
          },
          "apps_json": [
            {
              "name": "Research Feed App",
              "description": "Authored app for Research Feed App.",
              "tabs": {
                "feed": {
                  "id": "feed",
                  "name": "Feed",
                  "layout": [
                    {
                      "i": "research_feed_pulse",
                      "x": 0,
                      "y": 0,
                      "w": 20,
                      "h": 10
                    },
                    {
                      "i": "source_freshness_alert",
                      "x": 20,
                      "y": 0,
                      "w": 20,
                      "h": 10
                    }
                  ]
                }
              }
            }
          ]
        },
        "graded_args": [
          "operation",
          "name"
        ]
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "list"
        },
        "optional": true
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_005",
          "app_name": "Research Feed App",
          "dashboard_name": "Research Feed Live",
          "activate": true
        },
        "graded_args": [
          "operation"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Rollout Research Feed",
        "widget_id": "research_feed_pulse",
        "tab_id": "feed"
      },
      {
        "origin": "Rollout Research Feed",
        "widget_id": "source_freshness_alert",
        "tab_id": "feed"
      }
    ],
    "required_widget_defs": [
      {
        "backend_name": "Rollout Research Feed",
        "widget_id": "research_feed_pulse",
        "expect": {}
      },
      {
        "backend_name": "Rollout Research Feed",
        "widget_id": "source_freshness_alert",
        "expect": {}
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Rollout Research Feed",
        "name_contains": "Research Feed App",
        "tabs_include": [
          "feed"
        ],
        "layout_refs_valid": true,
        "no_overlaps": true
      }
    ],
    "max_turns": 8
  }
}
