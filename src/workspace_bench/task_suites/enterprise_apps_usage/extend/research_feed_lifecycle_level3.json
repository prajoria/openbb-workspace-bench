{
  "id": "research_feed_lifecycle_level3",
  "category": "platform",
  "difficulty": "level3",
  "prompt": "Ship it from the open Research Feed Staging dashboard: add Rollout Research Feed with Research Feed Pulse and a Research Feed App containing Feed.",
  "setup": {
    "workspace_baseline": "stark-workspace-a",
    "workspace_backends": [
      "stark-enterprise-x",
      "support-daloopa-skills",
      "getting-started",
      "widget-examples"
    ],
    "workspace_skills": [
      "daloopa-capital-allocation",
      "daloopa-earnings-review",
      "daloopa-guidance-tracker",
      "daloopa-industry",
      "daloopa-inflection",
      "daloopa-tearsheet",
      "finance-comps",
      "finance-earnings-prep",
      "finance-guidance-tracker",
      "finance-tearsheet"
    ],
    "default_selected_dashboard": "Research Feed Staging",
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ],
    "initial_state": {
      "dashboard": {
        "name": "Research Feed Staging",
        "activate": false,
        "tabs": [
          {
            "id": "review",
            "name": "Review"
          }
        ],
        "widgets": []
      }
    }
  },
  "eval": {
    "required_tools": [
      {
        "tool": "read_workspace_resource",
        "args": {
          "uri": "openbb://workspace/specs/widgets-json"
        },
        "optional": true
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Rollout Research Feed",
          "url": "http://127.0.0.1:9606",
          "widgets_json": {
            "research_feed_pulse": {
              "name": "Research Feed Pulse",
              "description": "Refreshed research feed.",
              "endpoint": "/research-feed",
              "type": "table",
              "gridData": {
                "w": 40,
                "h": 10
              }
            }
          },
          "apps_json": [
            {
              "name": "Research Feed App",
              "description": "Authored app for Research Feed App.",
              "tabs": {
                "feed": {
                  "id": "feed",
                  "name": "Feed",
                  "layout": [
                    {
                      "i": "research_feed_pulse",
                      "x": 0,
                      "y": 0,
                      "w": 40,
                      "h": 10
                    }
                  ]
                }
              }
            }
          ]
        },
        "graded_args": [
          "operation",
          "name"
        ]
      }
    ],
    "required_widget_defs": [
      {
        "backend_name": "Rollout Research Feed",
        "widget_id": "research_feed_pulse",
        "expect": {}
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Rollout Research Feed",
        "name_contains": "Research Feed App",
        "tabs_include": [
          "feed"
        ],
        "layout_refs_valid": true
      }
    ],
    "max_turns": 5
  }
}
