{
  "id": "risk_service_lifecycle_level3",
  "category": "platform",
  "difficulty": "level3",
  "prompt": "The risk desk needs Pilot Risk Service with its Pilot Risk Signal and a Pilot Risk App containing Monitor. Publish and add it.",
  "setup": {
    "workspace_baseline": "stark-workspace-a",
    "workspace_backends": [
      "stark-enterprise-x",
      "support-daloopa-skills",
      "getting-started",
      "widget-examples"
    ],
    "workspace_skills": [
      "daloopa-capital-allocation",
      "daloopa-earnings-review",
      "daloopa-guidance-tracker",
      "daloopa-industry",
      "daloopa-inflection",
      "daloopa-tearsheet",
      "finance-comps",
      "finance-earnings-prep",
      "finance-guidance-tracker",
      "finance-tearsheet"
    ],
    "default_selected_dashboard": "Home",
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_tools": [
      {
        "tool": "read_workspace_resource",
        "args": {
          "uri": "openbb://workspace/specs/widgets-json"
        },
        "optional": true
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Pilot Risk Service",
          "url": "http://127.0.0.1:9506",
          "widgets_json": {
            "pilot_risk_signal": {
              "name": "Pilot Risk Signal",
              "description": "Refreshed risk signal feed.",
              "endpoint": "/risk-signal",
              "type": "table",
              "gridData": {
                "w": 40,
                "h": 10
              }
            }
          },
          "apps_json": [
            {
              "name": "Pilot Risk App",
              "description": "Authored app for Pilot Risk App.",
              "tabs": {
                "monitor": {
                  "id": "monitor",
                  "name": "Monitor",
                  "layout": [
                    {
                      "i": "pilot_risk_signal",
                      "x": 0,
                      "y": 0,
                      "w": 40,
                      "h": 10
                    }
                  ]
                }
              }
            }
          ]
        },
        "graded_args": [
          "operation",
          "name"
        ]
      }
    ],
    "required_widget_defs": [
      {
        "backend_name": "Pilot Risk Service",
        "widget_id": "pilot_risk_signal",
        "expect": {}
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Pilot Risk Service",
        "name_contains": "Pilot Risk App",
        "tabs_include": [
          "monitor"
        ],
        "layout_refs_valid": true
      }
    ],
    "max_turns": 5
  }
}
