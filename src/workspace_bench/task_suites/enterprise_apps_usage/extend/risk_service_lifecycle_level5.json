{
  "id": "risk_service_lifecycle_level5",
  "category": "platform",
  "difficulty": "level5",
  "prompt": "Complete the risk desk build with Wave One Risk Service, Wave One Risk Signal, Wave One Limit Alert, and Wave One Stress Watch. Add the service, publish Wave One Risk App with Monitor and Stress tabs, and instantiate it. Widget ids are the snake_case of widget names; tab ids are the snake_case of tab names. Follow the Finance Guidance Tracker skill (finance-guidance-tracker) and add a Risk Service Build Note recording its governing concept.",
  "setup": {
    "workspace_baseline": "stark-workspace-a",
    "workspace_backends": [
      "stark-enterprise-x",
      "support-daloopa-skills",
      "getting-started",
      "widget-examples"
    ],
    "workspace_skills": [
      "daloopa-capital-allocation",
      "daloopa-earnings-review",
      "daloopa-guidance-tracker",
      "daloopa-industry",
      "daloopa-inflection",
      "daloopa-tearsheet",
      "finance-comps",
      "finance-earnings-prep",
      "finance-guidance-tracker",
      "finance-tearsheet"
    ],
    "default_selected_dashboard": "Home",
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_tools": [
      {
        "tool": "get_skill_content",
        "args": {
          "slug": "finance-guidance-tracker"
        },
        "graded_args": [
          "slug"
        ]
      },
      {
        "tool": "get_workspace_snapshot",
        "args": {},
        "optional": true
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Wave One Risk Service",
          "url": "http://127.0.0.1:9506",
          "widgets_json": {
            "wave_one_risk_signal": {
              "name": "Wave One Risk Signal",
              "description": "Refreshed risk signal feed.",
              "endpoint": "/risk-signal",
              "type": "table",
              "gridData": {
                "w": 40,
                "h": 10
              }
            },
            "wave_one_limit_alert": {
              "name": "Wave One Limit Alert",
              "description": "Wave-1 view for Wave One Limit Alert.",
              "endpoint": "/limit-alert",
              "type": "table",
              "gridData": {
                "w": 20,
                "h": 10
              }
            },
            "wave_one_stress_watch": {
              "name": "Wave One Stress Watch",
              "description": "Wave-1 view for Wave One Stress Watch.",
              "endpoint": "/stress-watch",
              "type": "table",
              "gridData": {
                "w": 40,
                "h": 10
              }
            }
          },
          "apps_json": [
            {
              "name": "Wave One Risk App",
              "description": "Wave-1 authored app for Wave One Risk App.",
              "tabs": {
                "monitor": {
                  "id": "monitor",
                  "name": "Monitor",
                  "layout": [
                    {
                      "i": "wave_one_risk_signal",
                      "x": 0,
                      "y": 0,
                      "w": 20,
                      "h": 10
                    },
                    {
                      "i": "wave_one_limit_alert",
                      "x": 20,
                      "y": 0,
                      "w": 20,
                      "h": 10
                    }
                  ]
                },
                "stress": {
                  "id": "stress",
                  "name": "Stress",
                  "layout": [
                    {
                      "i": "wave_one_stress_watch",
                      "x": 0,
                      "y": 0,
                      "w": 40,
                      "h": 10
                    }
                  ]
                }
              }
            }
          ]
        },
        "graded_args": [
          "operation",
          "name"
        ]
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "list"
        },
        "optional": true
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_005",
          "app_name": "Wave One Risk App",
          "dashboard_name": "Wave One Risk Live",
          "activate": true
        },
        "graded_args": [
          "operation"
        ]
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Risk Service Build Note",
          "data": "evidence gaps"
        },
        "graded_args": [
          "widget_type",
          "name"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Wave One Risk Service",
        "widget_id": "wave_one_risk_signal",
        "tab_id": "monitor"
      },
      {
        "origin": "Wave One Risk Service",
        "widget_id": "wave_one_limit_alert",
        "tab_id": "monitor"
      },
      {
        "origin": "Wave One Risk Service",
        "widget_id": "wave_one_stress_watch",
        "tab_id": "stress"
      }
    ],
    "required_widget_defs": [
      {
        "backend_name": "Wave One Risk Service",
        "widget_id": "wave_one_risk_signal",
        "expect": {}
      },
      {
        "backend_name": "Wave One Risk Service",
        "widget_id": "wave_one_limit_alert",
        "expect": {}
      },
      {
        "backend_name": "Wave One Risk Service",
        "widget_id": "wave_one_stress_watch",
        "expect": {}
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Wave One Risk Service",
        "name_contains": "Wave One Risk App",
        "tabs_include": [
          "monitor",
          "stress"
        ],
        "layout_refs_valid": true,
        "no_overlaps": true
      }
    ],
    "max_turns": 9,
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "name_contains": "Risk Service Build Note",
        "data_contains": [
          "evidence gaps"
        ]
      }
    ]
  }
}
