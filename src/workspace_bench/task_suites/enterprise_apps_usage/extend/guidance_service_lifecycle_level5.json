{
  "id": "guidance_service_lifecycle_level5",
  "category": "platform",
  "difficulty": "level5",
  "prompt": "Guidance goes end to end today: following the widgets.json spec, add the Buildout Guidance Service backend with Evidence Gaps, Changed Assumptions, and Management Claims tables, publish Guidance Service App with Evidence Gaps and Changed Assumptions on Review and Management Claims on Archive, and instantiate it. Then follow the Finance Guidance Tracker skill and leave a Guidance-service Governing Note recording what management claims are compared with.",
  "setup": {
    "workspace_baseline": "stark-workspace-a",
    "workspace_backends": [
      "stark-enterprise-x",
      "support-daloopa-skills",
      "getting-started",
      "widget-examples"
    ],
    "workspace_skills": [
      "daloopa-capital-allocation",
      "daloopa-earnings-review",
      "daloopa-guidance-tracker",
      "daloopa-industry",
      "daloopa-inflection",
      "daloopa-tearsheet",
      "finance-comps",
      "finance-earnings-prep",
      "finance-guidance-tracker",
      "finance-tearsheet"
    ],
    "default_selected_dashboard": "Home",
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_tools": [
      {
        "tool": "get_workspace_snapshot",
        "args": {},
        "optional": true
      },
      {
        "tool": "get_skill_content",
        "args": {
          "slug": "finance-guidance-tracker"
        },
        "graded_args": [
          "slug"
        ]
      },
      {
        "tool": "read_workspace_resource",
        "args": {
          "uri": "openbb://workspace/specs/widgets-json"
        },
        "optional": true
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Buildout Guidance Service",
          "url": "http://127.0.0.1:9712",
          "widgets_json": {
            "evidence_gaps": {
              "name": "Evidence Gaps",
              "description": "Authored view for Evidence Gaps.",
              "endpoint": "/evidence_gaps",
              "type": "table",
              "gridData": {
                "w": 40,
                "h": 10
              }
            },
            "changed_assumptions": {
              "name": "Changed Assumptions",
              "description": "Authored view for Changed Assumptions.",
              "endpoint": "/changed_assumptions",
              "type": "table",
              "gridData": {
                "w": 40,
                "h": 10
              }
            },
            "management_claims": {
              "name": "Management Claims",
              "description": "Authored view for Management Claims.",
              "endpoint": "/management_claims",
              "type": "table",
              "gridData": {
                "w": 40,
                "h": 10
              }
            }
          },
          "apps_json": [
            {
              "name": "Guidance Service App",
              "description": "Authored app for Guidance Service App.",
              "tabs": {
                "review": {
                  "id": "review",
                  "name": "Review",
                  "layout": [
                    {
                      "i": "evidence_gaps",
                      "x": 0,
                      "y": 0,
                      "w": 40,
                      "h": 10
                    },
                    {
                      "i": "changed_assumptions",
                      "x": 0,
                      "y": 10,
                      "w": 40,
                      "h": 10
                    }
                  ]
                },
                "archive": {
                  "id": "archive",
                  "name": "Archive",
                  "layout": [
                    {
                      "i": "management_claims",
                      "x": 0,
                      "y": 0,
                      "w": 40,
                      "h": 10
                    }
                  ]
                }
              }
            }
          ]
        },
        "graded_args": [
          "operation",
          "name"
        ]
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "list"
        },
        "optional": true
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_005",
          "app_name": "Guidance Service App",
          "dashboard_name": "Guidance-service Live",
          "activate": true
        },
        "graded_args": [
          "operation"
        ]
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Guidance-service Governing Note",
          "data": "prior guidance"
        },
        "graded_args": [
          "widget_type",
          "name"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Buildout Guidance Service",
        "widget_id": "evidence_gaps",
        "tab_id": "review"
      },
      {
        "origin": "Buildout Guidance Service",
        "widget_id": "changed_assumptions",
        "tab_id": "review"
      },
      {
        "origin": "Buildout Guidance Service",
        "widget_id": "management_claims",
        "tab_id": "archive"
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "name_contains": "Guidance-service Governing Note",
        "data_contains": [
          "prior guidance"
        ]
      }
    ],
    "required_widget_defs": [
      {
        "backend_name": "Buildout Guidance Service",
        "widget_id": "evidence_gaps",
        "expect": {}
      },
      {
        "backend_name": "Buildout Guidance Service",
        "widget_id": "changed_assumptions",
        "expect": {}
      },
      {
        "backend_name": "Buildout Guidance Service",
        "widget_id": "management_claims",
        "expect": {}
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Buildout Guidance Service",
        "name_contains": "Guidance Service App",
        "tabs_include": [
          "review",
          "archive"
        ],
        "layout_refs_valid": true,
        "no_overlaps": true
      }
    ],
    "max_turns": 10
  }
}
