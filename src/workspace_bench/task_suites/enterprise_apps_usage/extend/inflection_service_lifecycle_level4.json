{
  "id": "inflection_service_lifecycle_level4",
  "category": "platform",
  "difficulty": "level4",
  "prompt": "In line with the Daloopa Inflection skill, add a custom backend Buildout Inflection Service with Growth-Rate Reversals and Quarterly Series Monitor tables, publish Inflection Service App on Review, and instantiate it.",
  "setup": {
    "workspace_baseline": "stark-workspace-a",
    "workspace_backends": [
      "stark-enterprise-x",
      "support-daloopa-skills",
      "getting-started",
      "widget-examples"
    ],
    "workspace_skills": [
      "daloopa-capital-allocation",
      "daloopa-earnings-review",
      "daloopa-guidance-tracker",
      "daloopa-industry",
      "daloopa-inflection",
      "daloopa-tearsheet",
      "finance-comps",
      "finance-earnings-prep",
      "finance-guidance-tracker",
      "finance-tearsheet"
    ],
    "default_selected_dashboard": "Home",
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_tools": [
      {
        "tool": "get_workspace_snapshot",
        "args": {},
        "optional": true
      },
      {
        "tool": "get_skill_content",
        "args": {
          "slug": "daloopa-inflection"
        },
        "graded_args": [
          "slug"
        ]
      },
      {
        "tool": "read_workspace_resource",
        "args": {
          "uri": "openbb://workspace/specs/widgets-json"
        },
        "optional": true
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Buildout Inflection Service",
          "url": "http://127.0.0.1:9711",
          "widgets_json": {
            "growth_rate_reversals": {
              "name": "Growth-Rate Reversals",
              "description": "Authored view for Growth-Rate Reversals.",
              "endpoint": "/growth_rate_reversals",
              "type": "table",
              "gridData": {
                "w": 40,
                "h": 10
              }
            },
            "quarterly_series_monitor": {
              "name": "Quarterly Series Monitor",
              "description": "Authored view for Quarterly Series Monitor.",
              "endpoint": "/quarterly_series_monitor",
              "type": "table",
              "gridData": {
                "w": 40,
                "h": 10
              }
            }
          },
          "apps_json": [
            {
              "name": "Inflection Service App",
              "description": "Authored app for Inflection Service App.",
              "tabs": {
                "review": {
                  "id": "review",
                  "name": "Review",
                  "layout": [
                    {
                      "i": "growth_rate_reversals",
                      "x": 0,
                      "y": 0,
                      "w": 40,
                      "h": 10
                    },
                    {
                      "i": "quarterly_series_monitor",
                      "x": 0,
                      "y": 10,
                      "w": 40,
                      "h": 10
                    }
                  ]
                }
              }
            }
          ]
        },
        "graded_args": [
          "operation",
          "name"
        ]
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "list"
        },
        "optional": true
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_005",
          "app_name": "Inflection Service App",
          "dashboard_name": "Inflection-service Live",
          "activate": true
        },
        "graded_args": [
          "operation"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Buildout Inflection Service",
        "widget_id": "growth_rate_reversals",
        "tab_id": "review"
      },
      {
        "origin": "Buildout Inflection Service",
        "widget_id": "quarterly_series_monitor",
        "tab_id": "review"
      }
    ],
    "required_widget_defs": [
      {
        "backend_name": "Buildout Inflection Service",
        "widget_id": "growth_rate_reversals",
        "expect": {}
      },
      {
        "backend_name": "Buildout Inflection Service",
        "widget_id": "quarterly_series_monitor",
        "expect": {}
      }
    ],
    "max_turns": 9
  }
}
