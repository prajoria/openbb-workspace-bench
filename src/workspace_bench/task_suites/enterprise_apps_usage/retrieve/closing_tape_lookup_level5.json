{
  "id": "closing_tape_lookup_level5",
  "category": "platform",
  "difficulty": "level5",
  "prompt": "Build and add a Wave Two Closing Tape backend with a Closing Tape Lookup table for NVDA, instantiate its Closing Tape App, read the result, and report the latest date and exact close. Follow the widgets manifest specification. Widget ids are the snake_case of widget names; tab ids are the snake_case of tab names.",
  "setup": {
    "workspace_baseline": "stark-workspace-a",
    "workspace_backends": [
      "stark-enterprise-x",
      "support-daloopa-skills",
      "getting-started",
      "widget-examples"
    ],
    "workspace_skills": [
      "daloopa-capital-allocation",
      "daloopa-earnings-review",
      "daloopa-guidance-tracker",
      "daloopa-industry",
      "daloopa-inflection",
      "daloopa-tearsheet",
      "finance-comps",
      "finance-earnings-prep",
      "finance-guidance-tracker",
      "finance-tearsheet"
    ],
    "default_selected_dashboard": "Home",
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents",
      "final_answer"
    ]
  },
  "eval": {
    "required_tools": [
      {
        "tool": "read_workspace_resource",
        "args": {
          "uri": "openbb://workspace/specs/widgets-json"
        },
        "graded_args": [
          "uri"
        ]
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Wave Two Closing Tape",
          "url": "http://127.0.0.1:9601",
          "widgets_json": {
            "closing_tape_lookup": {
              "name": "Closing Tape Lookup",
              "description": "Latest closing-tape lookup.",
              "endpoint": "/closing-tape",
              "type": "table",
              "gridData": {
                "w": 20,
                "h": 10
              },
              "params": [
                {
                  "paramName": "ticker",
                  "type": "text",
                  "label": "Ticker",
                  "value": "NVDA",
                  "options": [
                    {
                      "label": "NVDA",
                      "value": "NVDA"
                    }
                  ]
                }
              ]
            }
          },
          "apps_json": [
            {
              "name": "Closing Tape App",
              "description": "Wave-1 authored app for Closing Tape App.",
              "tabs": {
                "tape": {
                  "id": "tape",
                  "name": "Tape",
                  "layout": [
                    {
                      "i": "closing_tape_lookup",
                      "x": 0,
                      "y": 0,
                      "w": 40,
                      "h": 10,
                      "state": {
                        "params": {
                          "ticker": "NVDA"
                        }
                      }
                    }
                  ]
                }
              }
            }
          ]
        },
        "graded_args": [
          "operation",
          "name"
        ]
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_005",
          "app_name": "Closing Tape App",
          "dashboard_name": "Closing Tape Live",
          "activate": true
        },
        "graded_args": [
          "operation"
        ]
      },
      {
        "tool": "get_widget_data",
        "args": {
          "origin": "Wave Two Closing Tape",
          "widget_id": "closing_tape_lookup",
          "data_args": {
            "ticker": "NVDA"
          }
        },
        "graded_args": [
          "origin",
          "widget_id"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Wave Two Closing Tape",
        "widget_id": "closing_tape_lookup",
        "data_args": {
          "ticker": "NVDA"
        },
        "tab_id": "tape"
      }
    ],
    "required_values_in_answer": [
      "2026-07-10",
      "190.01"
    ],
    "required_widget_defs": [
      {
        "backend_name": "Wave Two Closing Tape",
        "widget_id": "closing_tape_lookup",
        "expect": {
          "type": "table"
        }
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Wave Two Closing Tape",
        "name_contains": "Closing Tape App",
        "tabs_include": [
          "tape"
        ],
        "layout_refs_valid": true,
        "widgets_on_tab": [
          {
            "tab_id": "tape",
            "widget_id": "closing_tape_lookup"
          }
        ]
      }
    ],
    "runtime_checks": {
      "datasets": [
        {
          "name": "wave2-closing-tape",
          "widget_id": "closing_tape_lookup",
          "fields": [
            "ticker",
            "date",
            "close"
          ],
          "path": "/closing-tape",
          "payload": [
            {
              "ticker": "NVDA",
              "date": "2026-07-10",
              "close": 190.01
            }
          ]
        }
      ]
    },
    "reference_answer": "The NVDA lookup ends on 2026-07-10 at 190.01.",
    "max_turns": 7
  }
}
