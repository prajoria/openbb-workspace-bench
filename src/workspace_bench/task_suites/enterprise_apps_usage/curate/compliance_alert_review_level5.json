{
  "id": "compliance_alert_review_level5",
  "category": "platform",
  "difficulty": "level5",
  "prompt": "Stand up Buildout Compliance Review for the audit team: add it with a Compliance Review Register table per the workspace's widgets.json spec, publish and instantiate Compliance Review App on Review, and bring in Open Alert Metrics from Bench Stark Enterprise's Compliance Surveillance Hub plus Getting Started's Markdown Widget with Number Input. Follow the Finance Guidance Tracker skill and close with a Compliance-alert Build Note recording the final thing its workflow lists.",
  "setup": {
    "workspace_baseline": "stark-workspace-a",
    "workspace_backends": [
      "stark-enterprise-x",
      "support-daloopa-skills",
      "getting-started",
      "widget-examples"
    ],
    "workspace_skills": [
      "daloopa-capital-allocation",
      "daloopa-earnings-review",
      "daloopa-guidance-tracker",
      "daloopa-industry",
      "daloopa-inflection",
      "daloopa-tearsheet",
      "finance-comps",
      "finance-earnings-prep",
      "finance-guidance-tracker",
      "finance-tearsheet"
    ],
    "default_selected_dashboard": "Home",
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_tools": [
      {
        "tool": "get_workspace_snapshot",
        "args": {},
        "optional": true
      },
      {
        "tool": "get_skill_content",
        "args": {
          "slug": "finance-guidance-tracker"
        },
        "graded_args": [
          "slug"
        ]
      },
      {
        "tool": "read_workspace_resource",
        "args": {
          "uri": "openbb://workspace/specs/widgets-json"
        },
        "optional": true
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Buildout Compliance Review",
          "url": "http://127.0.0.1:9703",
          "widgets_json": {
            "compliance_review_register": {
              "name": "Compliance Review Register",
              "description": "Authored view for Compliance Review Register.",
              "endpoint": "/compliance_review_register",
              "type": "table",
              "gridData": {
                "w": 40,
                "h": 10
              }
            }
          },
          "apps_json": [
            {
              "name": "Compliance Review App",
              "description": "Authored app for Compliance Review App.",
              "tabs": {
                "review": {
                  "id": "review",
                  "name": "Review",
                  "layout": [
                    {
                      "i": "compliance_review_register",
                      "x": 0,
                      "y": 0,
                      "w": 40,
                      "h": 10
                    }
                  ]
                }
              }
            }
          ]
        },
        "graded_args": [
          "operation",
          "name"
        ]
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "list"
        },
        "optional": true
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_005",
          "app_name": "Compliance Review App",
          "dashboard_name": "Compliance-alert Live",
          "activate": true
        },
        "graded_args": [
          "operation"
        ]
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Bench Stark Enterprise"
        },
        "optional": true
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Getting Started"
        },
        "optional": true
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Bench Stark Enterprise",
          "widget_id": "compliance_surveillance_hub_alerts_open_alert_metrics"
        },
        "graded_args": [
          "origin",
          "widget_id"
        ]
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Getting Started",
          "widget_id": "markdown_widget_with_number_input"
        },
        "graded_args": [
          "origin",
          "widget_id"
        ]
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Compliance-alert Build Note",
          "data": "evidence gaps"
        },
        "graded_args": [
          "widget_type",
          "name"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Buildout Compliance Review",
        "widget_id": "compliance_review_register",
        "tab_id": "review"
      },
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "compliance_surveillance_hub_alerts_open_alert_metrics"
      },
      {
        "origin": "Getting Started",
        "widget_id": "markdown_widget_with_number_input"
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "name_contains": "Compliance-alert Build Note",
        "data_contains": [
          "evidence gaps"
        ]
      }
    ],
    "required_widget_defs": [
      {
        "backend_name": "Buildout Compliance Review",
        "widget_id": "compliance_review_register",
        "expect": {
          "type": "table"
        }
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Buildout Compliance Review",
        "name_contains": "Compliance Review App",
        "tabs_include": [
          "review"
        ],
        "layout_refs_valid": true,
        "widgets_on_tab": [
          {
            "tab_id": "review",
            "widget_id": "compliance_review_register"
          }
        ]
      }
    ],
    "max_turns": 14
  }
}
