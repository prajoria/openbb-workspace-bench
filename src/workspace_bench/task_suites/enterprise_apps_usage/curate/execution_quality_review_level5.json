{
  "id": "execution_quality_review_level5",
  "category": "platform",
  "difficulty": "level5",
  "prompt": "Give the execution desk its own review stack: add Buildout Execution Review with an Execution Review Register table per the workspace's widgets.json spec, publish and instantiate Execution Review App on Quality, then place Live Orders from Bench Stark Enterprise's Execution Desk and Getting Started's Multi PDF Viewer - URL. Follow the Finance Comps skill and wrap up with an Execution-quality Build Note recording what it says deserve premium or discount.",
  "setup": {
    "workspace_baseline": "stark-workspace-a",
    "workspace_backends": [
      "stark-enterprise-x",
      "support-daloopa-skills",
      "getting-started",
      "widget-examples"
    ],
    "workspace_skills": [
      "daloopa-capital-allocation",
      "daloopa-earnings-review",
      "daloopa-guidance-tracker",
      "daloopa-industry",
      "daloopa-inflection",
      "daloopa-tearsheet",
      "finance-comps",
      "finance-earnings-prep",
      "finance-guidance-tracker",
      "finance-tearsheet"
    ],
    "default_selected_dashboard": "Home",
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_tools": [
      {
        "tool": "get_workspace_snapshot",
        "args": {},
        "optional": true
      },
      {
        "tool": "get_skill_content",
        "args": {
          "slug": "finance-comps"
        },
        "graded_args": [
          "slug"
        ]
      },
      {
        "tool": "read_workspace_resource",
        "args": {
          "uri": "openbb://workspace/specs/widgets-json"
        },
        "optional": true
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Buildout Execution Review",
          "url": "http://127.0.0.1:9704",
          "widgets_json": {
            "execution_review_register": {
              "name": "Execution Review Register",
              "description": "Authored view for Execution Review Register.",
              "endpoint": "/execution_review_register",
              "type": "table",
              "gridData": {
                "w": 40,
                "h": 10
              }
            }
          },
          "apps_json": [
            {
              "name": "Execution Review App",
              "description": "Authored app for Execution Review App.",
              "tabs": {
                "quality": {
                  "id": "quality",
                  "name": "Quality",
                  "layout": [
                    {
                      "i": "execution_review_register",
                      "x": 0,
                      "y": 0,
                      "w": 40,
                      "h": 10
                    }
                  ]
                }
              }
            }
          ]
        },
        "graded_args": [
          "operation",
          "name"
        ]
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "list"
        },
        "optional": true
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_005",
          "app_name": "Execution Review App",
          "dashboard_name": "Execution-quality Live",
          "activate": true
        },
        "graded_args": [
          "operation"
        ]
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Bench Stark Enterprise"
        },
        "optional": true
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Getting Started"
        },
        "optional": true
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Bench Stark Enterprise",
          "widget_id": "execution_desk_blotter_live_orders"
        },
        "graded_args": [
          "origin",
          "widget_id"
        ]
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Getting Started",
          "widget_id": "multi_pdf_url"
        },
        "graded_args": [
          "origin",
          "widget_id"
        ]
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Execution-quality Build Note",
          "data": "outliers"
        },
        "graded_args": [
          "widget_type",
          "name"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Buildout Execution Review",
        "widget_id": "execution_review_register",
        "tab_id": "quality"
      },
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "execution_desk_blotter_live_orders"
      },
      {
        "origin": "Getting Started",
        "widget_id": "multi_pdf_url"
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "name_contains": "Execution-quality Build Note",
        "data_contains": [
          "outliers"
        ]
      }
    ],
    "required_widget_defs": [
      {
        "backend_name": "Buildout Execution Review",
        "widget_id": "execution_review_register",
        "expect": {
          "type": "table"
        }
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Buildout Execution Review",
        "name_contains": "Execution Review App",
        "tabs_include": [
          "quality"
        ],
        "layout_refs_valid": true,
        "widgets_on_tab": [
          {
            "tab_id": "quality",
            "widget_id": "execution_review_register"
          }
        ]
      }
    ],
    "max_turns": 14
  }
}
