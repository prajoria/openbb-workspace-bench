      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Telemetry Summary Backend",
          "url": "http://127.0.0.1:9602",
          "widgets_json": {
            "telemetry_summary_tile": {
              "name": "Telemetry Summary Tile",
              "description": "Wave-1 view for Telemetry Summary Tile.",
              "endpoint": "/telemetry-summary",
              "type": "metric",
              "gridData": {
                "w": 40,
                "h": 10
              }
            }
          },
          "apps_json": [
            {
              "name": "Market Telemetry App",
              "description": "Wave-1 authored app for Market Telemetry App.",
              "tabs": {
                "monitor": {
                  "id": "monitor",
                  "name": "Monitor",
                  "layout": [
                    {
                      "i": "telemetry_summary_tile",
                      "x": 0,
                      "y": 0,
                      "w": 40,
                      "h": 10
                    }
                  ]
                }
              }
            }
          ]
        },
        "graded_args": [
          "operation",
          "name"
        ]
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "list"
        },
        "optional": true
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_005",
          "app_name": "Market Telemetry App",
          "dashboard_name": "Market Telemetry Live",
          "activate": true
        },
        "graded_args": [
          "operation"
        ]
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Getting Started"
        },
        "optional": true
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Widget Examples"
        },
        "optional": true
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Getting Started",
          "widget_id": "sparkline_line"
        },
        "graded_args": [
          "origin"
        ]
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Widget Examples",
          "widget_id": "tabs_with_dropdown"
        },
        "graded_args": [
          "origin"
        ]
      },
      {
        "tool": "update_widget_layout",
        "args": {
          "widget_id": "sparkline_line",
          "x": 0,
          "y": 10,
          "w": 20,
          "h": 12,
          "tab_id": "monitor"
        },
        "optional": true
      },
      {
        "tool": "update_widget_layout",
        "args": {
          "widget_id": "tabs_with_dropdown",
          "x": 20,
          "y": 10,
          "w": 20,
          "h": 12,
          "tab_id": "monitor"
        },
        "optional": true
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Market Telemetry Build Note",
          "data": "price action"
        },
        "graded_args": [
          "widget_type",
          "name"
        ]
      }
    ],
    "required_widgets": [
      {
        "origin": "Getting Started",
        "widget_id": "sparkline_line",
        "tab_id": "monitor"
      },
      {
        "origin": "Widget Examples",
        "widget_id": "tabs_with_dropdown",
        "tab_id": "monitor"
      },
      {
        "origin": "Telemetry Summary Backend",
        "widget_id": "telemetry_summary_tile"
      }
    ],
    "required_widget_defs": [
      {
        "backend_name": "Telemetry Summary Backend",
        "widget_id": "telemetry_summary_tile",
        "expect": {
          "type": "metric"
        }
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Telemetry Summary Backend",
        "name_contains": "Market Telemetry App",
        "tabs_include": [
          "monitor"
        ],
        "layout_refs_valid": true,
        "widgets_on_tab": [
          {
            "tab_id": "monitor",
            "widget_id": "telemetry_summary_tile"
          }
        ]
      }
    ],
    "max_turns": 15,
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "name_contains": "Market Telemetry Build Note",
        "data_contains": [
          "price action"
        ]
      }
    ]
  }
