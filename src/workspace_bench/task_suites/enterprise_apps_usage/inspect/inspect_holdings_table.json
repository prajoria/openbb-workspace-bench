{
  "id": "inspect_holdings_table",
  "category": "read",
  "family": "inspect",
  "difficulty": "easy",
  "prompt": "After calling read_widget with widget_id test_metric for the existing Widget Examples/test_metric widget, add a note mentioning holdings.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "widget-examples"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Inspect Board",
        "activate": true,
        "tabs": [
          {
            "id": "",
            "name": ""
          }
        ],
        "widgets": [
          {
            "origin": "Widget Examples",
            "widget_id": "test_metric",
            "data_args": {},
            "layout": {
              "x": 0,
              "y": 0,
              "w": 20,
              "h": 10
            },
            "widget_uuid": "usage_inspect_holdings_table_widget_001"
          }
        ],
        "dashboard_id": "usage_inspect_holdings_table_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "read_widget",
      "add_generative_widget"
    ]
  },
  "eval": {
    "required_tool_calls": [
      {
        "tool": "read_widget",
        "args_contains": {
          "widget_id": "test_metric"
        }
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "holdings"
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "read_widget",
        "args": {
          "widget_id": "test_metric"
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Inspect Note",
          "data": "Inspected test_metric: holdings."
        }
      }
    ],
    "limits": {
      "max_turns": 6
    }
  }
}
