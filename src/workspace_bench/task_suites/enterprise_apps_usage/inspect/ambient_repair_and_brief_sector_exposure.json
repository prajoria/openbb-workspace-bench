{
  "id": "ambient_repair_and_brief_sector_exposure",
  "category": "repair",
  "family": "inspect",
  "difficulty": "hard",
  "prompt": "Inspect the dashboard, find the widget with sector=Consumer Staples, repair it to Technology, keep the companion widget, and add a note mentioning the repair.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "widget-examples"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Inspect Full Repair",
        "activate": true,
        "tabs": [
          {
            "id": "",
            "name": ""
          }
        ],
        "widgets": [
          {
            "origin": "Widget Examples",
            "widget_id": "whitepapers",
            "data_args": {
              "filenames": [
                "bitcoin.pdf"
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "w": 20,
              "h": 10
            },
            "widget_uuid": "usage_ambient_repair_and_brief_sector_exposure_widget_001"
          },
          {
            "origin": "Widget Examples",
            "widget_id": "live_grid_example",
            "data_args": {
              "symbol": "TSLA"
            },
            "layout": {
              "x": 20,
              "y": 0,
              "w": 20,
              "h": 10
            },
            "widget_uuid": "usage_ambient_repair_and_brief_sector_exposure_widget_002"
          }
        ],
        "dashboard_id": "usage_ambient_repair_and_brief_sector_exposure_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "read_widget",
      "update_widget",
      "add_generative_widget"
    ]
  },
  "eval": {
    "required_widgets": [
      {
        "origin": "Widget Examples",
        "widget_id": "whitepapers",
        "data_args": {
          "filenames": [
            "bitcoin.pdf"
          ]
        }
      },
      {
        "origin": "Widget Examples",
        "widget_id": "live_grid_example",
        "data_args": {
          "symbol": "AAPL"
        }
      },
      {
        "origin": "Widget Examples",
        "widget_id": "live_grid_example",
        "data_args": {
          "symbol": "TSLA"
        },
        "min_count": 0,
        "max_count": 0
      }
    ],
    "required_tool_calls": [
      {
        "tool": "read_widget",
        "min_count": 1
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "Consumer Staples",
          "Technology",
          "repair"
        ]
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "read_widget",
        "args": {
          "widget_uuid": "usage_ambient_repair_and_brief_sector_exposure_widget_002"
        }
      },
      {
        "tool": "update_widget",
        "args": {
          "widget_uuid": "usage_ambient_repair_and_brief_sector_exposure_widget_002",
          "data_args": {
            "symbol": "AAPL"
          }
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Inspect Repair Note",
          "data": "Repair changed Consumer Staples to Technology."
        }
      }
    ],
    "limits": {
      "max_turns": 6
    }
  }
}
