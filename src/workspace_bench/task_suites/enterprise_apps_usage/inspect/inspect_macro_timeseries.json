{
  "id": "inspect_macro_timeseries",
  "category": "read",
  "family": "inspect",
  "difficulty": "easy",
  "prompt": "Call read_widget with widget_id company_performance for the existing Getting Started/company_performance widget, then add a note mentioning GM.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "getting-started"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Inspect Board",
        "activate": true,
        "tabs": [
          {
            "id": "",
            "name": ""
          }
        ],
        "widgets": [
          {
            "origin": "Getting Started",
            "widget_id": "company_performance",
            "data_args": {
              "company": "GM",
              "year": "2024"
            },
            "layout": {
              "x": 0,
              "y": 0,
              "w": 20,
              "h": 10
            },
            "widget_uuid": "usage_inspect_macro_timeseries_widget_001"
          }
        ],
        "dashboard_id": "usage_inspect_macro_timeseries_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "read_widget",
      "add_generative_widget"
    ]
  },
  "eval": {
    "required_tool_calls": [
      {
        "tool": "read_widget",
        "args_contains": {
          "widget_id": "company_performance"
        }
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "GM"
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "read_widget",
        "args": {
          "widget_id": "company_performance"
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Inspect Note",
          "data": "Inspected company_performance: GM."
        }
      }
    ],
    "limits": {
      "max_turns": 6
    }
  }
}
