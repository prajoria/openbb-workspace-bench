{
  "id": "inspect_workflow_overview",
  "category": "read",
  "family": "inspect",
  "difficulty": "easy",
  "prompt": "Call read_widget with widget_id portfolio_command_center_overview_workflow_overview for the existing Bench Stark Enterprise/portfolio_command_center_overview_workflow_overview widget, then add a note mentioning stark.",
  "setup": {
    "fixtures": {
      "backends": [
        {
          "name": "stark-enterprise"
        }
      ]
    },
    "initial_state": {
      "dashboard": {
        "name": "Inspect Board",
        "activate": true,
        "tabs": [
          {
            "id": "",
            "name": ""
          }
        ],
        "widgets": [
          {
            "origin": "Bench Stark Enterprise",
            "widget_id": "portfolio_command_center_overview_workflow_overview",
            "data_args": {},
            "layout": {
              "x": 0,
              "y": 0,
              "w": 20,
              "h": 10
            },
            "widget_uuid": "usage_inspect_workflow_overview_widget_001"
          }
        ],
        "dashboard_id": "usage_inspect_workflow_overview_dashboard_001"
      }
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "read_widget",
      "add_generative_widget"
    ]
  },
  "eval": {
    "required_tool_calls": [
      {
        "tool": "read_widget",
        "args_contains": {
          "widget_id": "portfolio_command_center_overview_workflow_overview"
        }
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "stark"
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "max_repeated_snapshots": 1
    },
    "workspace_checks": {
      "preserve_other_dashboards": true
    },
    "reference_trace": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "read_widget",
        "args": {
          "widget_id": "portfolio_command_center_overview_workflow_overview"
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Inspect Note",
          "data": "Inspected portfolio_command_center_overview_workflow_overview: stark."
        }
      }
    ],
    "max_turns": 6
  }
}
