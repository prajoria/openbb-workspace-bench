{
  "id": "surprise_metric_room",
  "category": "platform",
  "family": "settings",
  "difficulty": "hard",
  "prompt": "The desk needs a production-ready earnings and estimates workflow for an equity-research analyst. The workspace must cover average EPS surprise last 4 quarters. The workspace must cover preview note for the earnings call. The workspace must cover EPS beat and miss history. An analyst can filter the analysis by ticker. Leave the complete working workspace open for review. Use your judgment on the architecture and leave other work intact.",
  "business_terms": [
    "ticker"
  ],
  "setup": {
    "fixtures": {},
    "initial_state": {},
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "trace_checks": {
      "max_invalid_tool_calls": 2,
      "max_repeated_snapshots": 2
    },
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 1,
      "max_custom_backend_delta": 1
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "earnings-prep-data__earnings_chart",
          "widget_id": "earnings_chart",
          "fields": [
            "earnings_chart_value"
          ],
          "path": "/eps-history",
          "payload": [
            {
              "earnings_chart_value": 10.25
            },
            {
              "earnings_chart_value": 20.5
            },
            {
              "earnings_chart_value": 30.75
            }
          ]
        },
        {
          "name": "earnings-prep-data__earnings_note",
          "widget_id": "earnings_note",
          "fields": [
            "earnings_note_value"
          ],
          "path": "/earnings-preview",
          "payload": "Earnings Preview fixture-backed runtime summary."
        },
        {
          "name": "earnings-prep-data__surprise_metric",
          "widget_id": "surprise_metric",
          "fields": [
            "label",
            "surprise_metric_value",
            "value"
          ],
          "path": "/avg-surprise",
          "payload": {
            "label": "Avg Surprise",
            "surprise_metric_value": 10.25,
            "value": 42.5
          }
        }
      ],
      "pinned_paths": false
    },
    "required_capabilities": [
      {
        "name": "capability_1_earnings-chart",
        "datasets": [
          "earnings-prep-data__earnings_chart"
        ],
        "widget_kind": "chart-like",
        "must_cover_fields": [
          "earnings_chart_value"
        ],
        "required_param_kinds": [
          "ticker"
        ],
        "required_config": {}
      },
      {
        "name": "capability_2_earnings-note",
        "datasets": [
          "earnings-prep-data__earnings_note"
        ],
        "widget_kind": "markdown",
        "must_cover_fields": [
          "earnings_note_value"
        ],
        "required_param_kinds": [
          "ticker"
        ],
        "required_config": {}
      },
      {
        "name": "capability_3_surprise-metric",
        "datasets": [
          "earnings-prep-data__surprise_metric"
        ],
        "widget_kind": "metric",
        "must_cover_fields": [
          "surprise_metric_value"
        ],
        "required_param_kinds": [],
        "required_config": {
          "runButton": true
        }
      }
    ],
    "app_structure": {
      "required": true,
      "layout_refs_valid": true,
      "no_overlaps": true
    },
    "polish": [
      {
        "code": "polish_refresh_policy",
        "backend_name": "Earnings Prep Data",
        "widget_id": "surprise_metric",
        "path": "refetchInterval",
        "expected": 45000
      }
    ],
    "reference_trace": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Earnings Prep Data",
          "url": "http://localhost:7805",
          "widgets_json": {
            "surprise_metric": {
              "name": "Avg Surprise",
              "description": "Average EPS surprise last 4 quarters.",
              "endpoint": "/avg-surprise",
              "type": "metric",
              "gridData": {
                "w": 6,
                "h": 4
              },
              "runButton": true,
              "refetchInterval": 45000,
              "data": {
                "valueField": "surprise_metric_value"
              }
            },
            "earnings_note": {
              "name": "Earnings Preview",
              "description": "Preview note for the earnings call.",
              "endpoint": "/earnings-preview",
              "type": "markdown",
              "gridData": {
                "w": 12,
                "h": 8
              },
              "params": [
                {
                  "paramName": "symbol",
                  "type": "endpoint",
                  "label": "Symbol",
                  "value": "AAPL",
                  "optionsEndpoint": "/symbols"
                }
              ],
              "runButton": true,
              "refetchInterval": 45000,
              "data": {
                "valueField": "earnings_note_value"
              }
            },
            "earnings_chart": {
              "name": "EPS History",
              "description": "Plotly EPS beat/miss history.",
              "endpoint": "/eps-history",
              "type": "chart",
              "gridData": {
                "w": 20,
                "h": 9
              },
              "params": [
                {
                  "paramName": "symbol",
                  "type": "endpoint",
                  "label": "Symbol",
                  "value": "AAPL",
                  "optionsEndpoint": "/symbols"
                }
              ],
              "raw": true,
              "runButton": true,
              "refetchInterval": 45000,
              "data": {
                "valueField": "earnings_chart_value"
              }
            }
          },
          "apps_json": [
            {
              "name": "Earnings Settings Room",
              "description": "Surprise, preview, and chart settings.",
              "tabs": {
                "summary": {
                  "id": "summary",
                  "name": "Summary",
                  "layout": [
                    {
                      "i": "surprise_metric",
                      "x": 0,
                      "y": 0,
                      "w": 6,
                      "h": 4
                    },
                    {
                      "i": "earnings_chart",
                      "x": 6,
                      "y": 0,
                      "w": 20,
                      "h": 9
                    }
                  ]
                },
                "preview": {
                  "id": "preview",
                  "name": "Preview",
                  "layout": [
                    {
                      "i": "earnings_note",
                      "x": 0,
                      "y": 0,
                      "w": 12,
                      "h": 8
                    }
                  ]
                }
              },
              "groups": []
            }
          ]
        }
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_001",
          "app_name": "Earnings Settings Room",
          "dashboard_name": "Earnings Settings Room Live",
          "activate": true
        }
      }
    ],
    "max_turns": 14
  }
}
