{
  "id": "gas_metric_room",
  "category": "platform",
  "family": "settings",
  "specification_level": "partially-specified",
  "difficulty": "hard",
  "prompt": "Create a usable chain activity and liquidity workflow for a digital-assets analyst. The workspace must cover current gas price snapshot. The workspace must cover written details for one protocol. Leave the complete working workspace open for review. The source contract must retain `protocol`; decide the remaining implementation and preserve unrelated workspace state.",
  "business_terms": [
    "protocol"
  ],
  "setup": {
    "fixtures": {},
    "initial_state": {},
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "trace_checks": {
      "max_invalid_tool_calls": 2,
      "max_repeated_snapshots": 2
    },
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 1,
      "max_custom_backend_delta": 1
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "chain-tvl-data__gas_metric",
          "widget_id": "gas_metric",
          "fields": [
            "gas_metric_value",
            "label",
            "value"
          ],
          "path": "/gas-now",
          "payload": {
            "gas_metric_value": 10.25,
            "label": "Gas Now",
            "value": 42.5
          }
        },
        {
          "name": "chain-tvl-data__protocol_details",
          "widget_id": "protocol_details",
          "fields": [
            "protocol_details_value"
          ],
          "path": "/protocol-details",
          "payload": "Protocol Details fixture-backed runtime summary."
        }
      ],
      "pinned_paths": false
    },
    "required_capabilities": [
      {
        "name": "capability_1_gas-metric",
        "datasets": [
          "chain-tvl-data__gas_metric"
        ],
        "widget_kind": "metric",
        "must_cover_fields": [
          "gas_metric_value"
        ],
        "required_param_kinds": [],
        "required_config": {}
      },
      {
        "name": "capability_2_protocol-details",
        "datasets": [
          "chain-tvl-data__protocol_details"
        ],
        "widget_kind": "markdown",
        "must_cover_fields": [
          "protocol_details_value"
        ],
        "required_param_kinds": [
          "text"
        ],
        "required_config": {}
      }
    ],
    "app_structure": {
      "required": true,
      "layout_refs_valid": true,
      "no_overlaps": true
    },
    "polish": [
      {
        "code": "polish_refresh_policy",
        "backend_name": "Chain TVL Data",
        "widget_id": "gas_metric",
        "path": "refetchInterval",
        "expected": 30000
      }
    ],
    "reference_trace": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Chain TVL Data",
          "url": "http://localhost:7802",
          "widgets_json": {
            "gas_metric": {
              "name": "Gas Now",
              "description": "Current gas price snapshot.",
              "endpoint": "/gas-now",
              "type": "metric",
              "gridData": {
                "w": 5,
                "h": 4
              },
              "category": "Network Ops",
              "refetchInterval": 30000,
              "data": {
                "valueField": "gas_metric_value"
              }
            },
            "protocol_details": {
              "name": "Protocol Details",
              "description": "Markdown details for one protocol.",
              "endpoint": "/protocol-details",
              "type": "markdown",
              "gridData": {
                "w": 12,
                "h": 8
              },
              "params": [
                {
                  "paramName": "protocol",
                  "type": "text",
                  "label": "Protocol",
                  "value": "uniswap",
                  "description": "Protocol slug to describe."
                }
              ],
              "category": "Network Ops",
              "refetchInterval": 30000,
              "data": {
                "valueField": "protocol_details_value"
              }
            }
          },
          "apps_json": [
            {
              "name": "Network Settings Room",
              "description": "Gas and protocol settings.",
              "tabs": {
                "gas": {
                  "id": "gas",
                  "name": "Gas",
                  "layout": [
                    {
                      "i": "gas_metric",
                      "x": 0,
                      "y": 0,
                      "w": 6,
                      "h": 4
                    }
                  ]
                },
                "protocol": {
                  "id": "protocol",
                  "name": "Protocol",
                  "layout": [
                    {
                      "i": "protocol_details",
                      "x": 0,
                      "y": 0,
                      "w": 12,
                      "h": 8
                    }
                  ]
                }
              },
              "groups": []
            }
          ]
        }
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_001",
          "app_name": "Network Settings Room",
          "dashboard_name": "Network Settings Room Live",
          "activate": true
        }
      }
    ],
    "max_turns": 14
  }
}
