{
  "id": "vol_ship",
  "category": "platform",
  "family": "settings",
  "difficulty": "hard",
  "prompt": "The desk needs a production-ready volatility and derivatives workflow for a volatility analyst. The workspace must cover current volatility regime score. The workspace must cover morning volatility commentary. The workspace must cover daily CBOE VIX closes with returns. Analysts need to inspect date, close, return percentage. Leave the complete working workspace open for review. Add a short completion note that naturally includes the desk-required terms 'Vol Config Live', '15-minute cache', 'Vol Desk Data', 'stress'. Use your judgment on the architecture and leave other work intact.",
  "business_terms": [
    "Vol Config Live",
    "15-minute cache",
    "Vol Desk Data",
    "stress"
  ],
  "setup": {
    "fixtures": {},
    "initial_state": {},
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "Vol Config Live",
          "15-minute cache",
          "Vol Desk Data",
          "stress"
        ],
        "min_count": 1
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 2,
      "max_repeated_snapshots": 2
    },
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 1,
      "max_custom_backend_delta": 1
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "vol-desk-data__vix_history",
          "widget_id": "vix_history",
          "fields": [
            "close",
            "date",
            "return_pct"
          ],
          "path": "/vix-history",
          "payload": [
            {
              "close": 10.25,
              "date": "2026-01-13",
              "return_pct": 10.25
            },
            {
              "close": 20.5,
              "date": "2026-01-14",
              "return_pct": 20.5
            },
            {
              "close": 30.75,
              "date": "2026-01-15",
              "return_pct": 30.75
            }
          ]
        },
        {
          "name": "vol-desk-data__vol_commentary",
          "widget_id": "vol_commentary",
          "fields": [
            "vol_commentary_value"
          ],
          "path": "/vol-commentary",
          "payload": "Vol Commentary fixture-backed runtime summary."
        },
        {
          "name": "vol-desk-data__vol_regime_metric",
          "widget_id": "vol_regime_metric",
          "fields": [
            "label",
            "value",
            "vol_regime_metric_value"
          ],
          "path": "/vol-regime",
          "payload": {
            "label": "Vol Regime",
            "value": 42.5,
            "vol_regime_metric_value": 10.25
          }
        }
      ],
      "pinned_paths": false
    },
    "required_capabilities": [
      {
        "name": "capability_1_vol-commentary",
        "datasets": [
          "vol-desk-data__vol_commentary"
        ],
        "widget_kind": "markdown",
        "must_cover_fields": [
          "vol_commentary_value"
        ],
        "required_param_kinds": [
          "text"
        ],
        "required_config": {}
      },
      {
        "name": "capability_2_vol-regime-metric",
        "datasets": [
          "vol-desk-data__vol_regime_metric"
        ],
        "widget_kind": "metric",
        "must_cover_fields": [
          "vol_regime_metric_value"
        ],
        "required_param_kinds": [
          "text"
        ],
        "required_config": {
          "runButton": true
        }
      }
    ],
    "app_structure": {
      "required": true,
      "layout_refs_valid": true,
      "no_overlaps": true
    },
    "polish": [
      {
        "code": "polish_refresh_policy",
        "backend_name": "Vol Desk Data",
        "widget_id": "vol_regime_metric",
        "path": "staleTime",
        "expected": 900000
      }
    ],
    "reference": [
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Vol Desk Data",
          "url": "http://localhost:7801",
          "widgets_json": {
            "vol_regime_metric": {
              "name": "Vol Regime",
              "description": "Current volatility regime score.",
              "endpoint": "/vol-regime",
              "type": "metric",
              "gridData": {
                "w": 6,
                "h": 4
              },
              "staleTime": 900000,
              "runButton": true,
              "params": [
                {
                  "paramName": "regime_view",
                  "type": "text",
                  "label": "Regime View",
                  "value": "summary",
                  "description": "Vol regime view to show."
                }
              ],
              "data": {
                "valueField": "vol_regime_metric_value"
              }
            },
            "vol_commentary": {
              "name": "Vol Commentary",
              "description": "Morning volatility commentary.",
              "endpoint": "/vol-commentary",
              "type": "markdown",
              "gridData": {
                "w": 12,
                "h": 8
              },
              "params": [
                {
                  "paramName": "desk",
                  "type": "text",
                  "label": "Desk",
                  "value": "index",
                  "options": [
                    {
                      "label": "Index",
                      "value": "index"
                    },
                    {
                      "label": "Single Stock",
                      "value": "single"
                    }
                  ]
                }
              ],
              "staleTime": 900000,
              "runButton": true,
              "data": {
                "valueField": "vol_commentary_value"
              }
            },
            "vix_history": {
              "name": "VIX History",
              "description": "Daily CBOE VIX closes with returns.",
              "endpoint": "/vix-history",
              "type": "table",
              "gridData": {
                "w": 20,
                "h": 9
              },
              "params": [
                {
                  "paramName": "window",
                  "type": "number",
                  "label": "Window",
                  "value": 30,
                  "min": 5,
                  "max": 365
                }
              ],
              "data": {
                "table": {
                  "columnsDefs": [
                    {
                      "field": "date",
                      "headerName": "Date",
                      "cellDataType": "dateString"
                    },
                    {
                      "field": "close",
                      "headerName": "Close",
                      "cellDataType": "number"
                    },
                    {
                      "field": "return_pct",
                      "headerName": "Return %",
                      "cellDataType": "number",
                      "formatterFn": "percent",
                      "renderFn": "greenRed"
                    }
                  ]
                }
              },
              "staleTime": 900000,
              "runButton": true
            }
          },
          "apps_json": [
            {
              "name": "Vol Config Live",
              "description": "Configured vol metric and commentary.",
              "tabs": {
                "vol": {
                  "id": "vol",
                  "name": "Vol",
                  "layout": [
                    {
                      "i": "vol_regime_metric",
                      "x": 0,
                      "y": 0,
                      "w": 8,
                      "h": 5
                    }
                  ]
                },
                "posture": {
                  "id": "posture",
                  "name": "Posture",
                  "layout": [
                    {
                      "i": "vol_commentary",
                      "x": 0,
                      "y": 0,
                      "w": 20,
                      "h": 9
                    }
                  ]
                }
              },
              "groups": []
            }
          ]
        }
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_001",
          "app_name": "Vol Config Live",
          "dashboard_name": "Vol Config Live Board",
          "activate": true
        }
      },
      {
        "tool": "update_widget",
        "args": {
          "widget_id": "vol_regime_metric",
          "data_args": {
            "regime_view": "stress"
          }
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Vol Config Live",
          "data": "Vol Config Live shipped from Vol Desk Data: 15-minute cache. Configured regime_view=stress."
        }
      }
    ],
    "limits": {
      "max_turns": 14
    }
  }
}
