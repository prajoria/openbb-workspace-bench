{
  "id": "vol_param_cockpit",
  "category": "platform",
  "family": "params",
  "difficulty": "hard",
  "prompt": "Build a volatility analyst a dependable volatility and derivatives workspace. The workspace must cover screen names by implied-vol criteria. The workspace must cover daily CBOE VIX closes with returns. The workspace must cover morning volatility commentary. Analysts need to inspect date, close, return percentage. An analyst can filter the analysis by ticker. An analyst can choose the relevant business date. An analyst can adjust the relevant numeric scope. An analyst can toggle the relevant screening constraint. Leave the complete working workspace open for review. Decide how best to organize the experience and preserve unrelated work.",
  "business_terms": [
    "ticker",
    "date"
  ],
  "setup": {
    "fixtures": {},
    "initial_state": {},
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "trace_checks": {
      "max_invalid_tool_calls": 2,
      "max_repeated_snapshots": 2
    },
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 1,
      "max_custom_backend_delta": 1
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "vol-desk-data__vix_history",
          "widget_id": "vix_history",
          "fields": [
            "close",
            "date",
            "return_pct"
          ],
          "path": "/vix-history",
          "payload": [
            {
              "close": 10.25,
              "date": "2026-01-13",
              "return_pct": 10.25
            },
            {
              "close": 20.5,
              "date": "2026-01-14",
              "return_pct": 20.5
            },
            {
              "close": 30.75,
              "date": "2026-01-15",
              "return_pct": 30.75
            }
          ]
        },
        {
          "name": "vol-desk-data__vol_commentary",
          "widget_id": "vol_commentary",
          "fields": [
            "vol_commentary_value"
          ],
          "path": "/vol-commentary",
          "payload": "Vol Commentary fixture-backed runtime summary."
        },
        {
          "name": "vol-desk-data__vol_screener",
          "widget_id": "vol_screener",
          "fields": [
            "vol_screener_value"
          ],
          "path": "/vol-screener",
          "payload": [
            {
              "vol_screener_value": 10.25
            },
            {
              "vol_screener_value": 20.5
            },
            {
              "vol_screener_value": 30.75
            }
          ]
        },
        {
          "name": "capability-union__vol_param_cockpit",
          "widget_id": "capability_union_vol_param_cockpit",
          "fields": [
            "close",
            "date",
            "return_pct",
            "vol_screener_value"
          ],
          "path": "/capability-union",
          "payload": [
            {
              "close": 10.25,
              "date": "2026-01-13",
              "return_pct": 10.25,
              "vol_screener_value": 10.25
            },
            {
              "close": 20.5,
              "date": "2026-01-14",
              "return_pct": 20.5,
              "vol_screener_value": 20.5
            },
            {
              "close": 30.75,
              "date": "2026-01-15",
              "return_pct": 30.75,
              "vol_screener_value": 30.75
            }
          ]
        }
      ],
      "pinned_paths": false
    },
    "required_capabilities": [
      {
        "name": "capability_1_vix-history",
        "datasets": [
          "vol-desk-data__vix_history",
          "capability-union__vol_param_cockpit"
        ],
        "widget_kind": "table-like",
        "must_cover_fields": [
          "close",
          "date",
          "return_pct"
        ],
        "required_param_kinds": [
          "number"
        ],
        "required_config": {}
      },
      {
        "name": "capability_2_vol-commentary",
        "datasets": [
          "vol-desk-data__vol_commentary"
        ],
        "widget_kind": "markdown",
        "must_cover_fields": [
          "vol_commentary_value"
        ],
        "required_param_kinds": [
          "text"
        ],
        "required_config": {}
      },
      {
        "name": "capability_3_vol-screener",
        "datasets": [
          "vol-desk-data__vol_screener",
          "capability-union__vol_param_cockpit"
        ],
        "widget_kind": "table-like",
        "must_cover_fields": [
          "vol_screener_value"
        ],
        "required_param_kinds": [
          "boolean",
          "date",
          "ticker"
        ],
        "required_config": {}
      }
    ],
    "app_structure": {
      "required": true,
      "layout_refs_valid": true,
      "no_overlaps": true
    },
    "reference": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Vol Desk Data",
          "url": "http://localhost:7801",
          "widgets_json": {
            "vol_screener": {
              "name": "Vol Screener",
              "description": "Screen names by implied-vol criteria.",
              "endpoint": "/vol-screener",
              "type": "table",
              "gridData": {
                "w": 24,
                "h": 10
              },
              "params": [
                {
                  "paramName": "ticker",
                  "type": "ticker",
                  "label": "Ticker"
                },
                {
                  "paramName": "as_of",
                  "type": "date",
                  "label": "As of",
                  "value": "$currentDate-1d"
                },
                {
                  "paramName": "only_liquid",
                  "type": "boolean",
                  "label": "Liquid only",
                  "value": true
                }
              ],
              "staleTime": 900000,
              "data": {
                "valueField": "vol_screener_value"
              }
            },
            "vix_history": {
              "name": "VIX History",
              "description": "Daily CBOE VIX closes with returns.",
              "endpoint": "/vix-history",
              "type": "table",
              "gridData": {
                "w": 20,
                "h": 9
              },
              "params": [
                {
                  "paramName": "window",
                  "type": "number",
                  "label": "Window",
                  "value": 30,
                  "min": 5,
                  "max": 365
                }
              ],
              "data": {
                "table": {
                  "columnsDefs": [
                    {
                      "field": "date",
                      "headerName": "Date",
                      "cellDataType": "dateString"
                    },
                    {
                      "field": "close",
                      "headerName": "Close",
                      "cellDataType": "number"
                    },
                    {
                      "field": "return_pct",
                      "headerName": "Return %",
                      "cellDataType": "number",
                      "formatterFn": "percent",
                      "renderFn": "greenRed"
                    }
                  ]
                }
              },
              "staleTime": 900000
            },
            "vol_commentary": {
              "name": "Vol Commentary",
              "description": "Morning volatility commentary.",
              "endpoint": "/vol-commentary",
              "type": "markdown",
              "gridData": {
                "w": 12,
                "h": 8
              },
              "params": [
                {
                  "paramName": "desk",
                  "type": "text",
                  "label": "Desk",
                  "value": "index",
                  "options": [
                    {
                      "label": "Index",
                      "value": "index"
                    },
                    {
                      "label": "Single Stock",
                      "value": "single"
                    }
                  ]
                }
              ],
              "staleTime": 900000,
              "data": {
                "valueField": "vol_commentary_value"
              }
            }
          },
          "apps_json": [
            {
              "name": "Vol Param Cockpit",
              "description": "Screen, history, and commentary filters.",
              "tabs": {
                "screen": {
                  "id": "screen",
                  "name": "Screen",
                  "layout": [
                    {
                      "i": "vol_screener",
                      "x": 0,
                      "y": 0,
                      "w": 24,
                      "h": 10
                    },
                    {
                      "i": "vol_commentary",
                      "x": 24,
                      "y": 0,
                      "w": 12,
                      "h": 8
                    }
                  ]
                },
                "history": {
                  "id": "history",
                  "name": "History",
                  "layout": [
                    {
                      "i": "vix_history",
                      "x": 0,
                      "y": 0,
                      "w": 20,
                      "h": 9
                    }
                  ]
                }
              },
              "groups": []
            }
          ]
        }
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_001",
          "app_name": "Vol Param Cockpit",
          "dashboard_name": "Vol Param Cockpit Live",
          "activate": true
        }
      }
    ],
    "limits": {
      "max_turns": 14
    }
  }
}
