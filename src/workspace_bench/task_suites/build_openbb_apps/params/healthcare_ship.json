{
  "id": "healthcare_ship",
  "category": "platform",
  "family": "params",
  "difficulty": "hard",
  "prompt": "A healthcare-research analyst needs a decision-ready Workspace for clinical catalysts and pipelines. The workspace must cover trial review filtered by symbol. The workspace must cover catalysts in the next 30 days. The workspace must cover upcoming clinical trial readouts. Analysts need to inspect ticker, phase, readout date. An analyst can filter the analysis by ticker. Leave the complete working workspace open for review. Add a short completion note that naturally includes the desk-required terms 'Trial Symbol Live', 'trial symbol', 'Healthcare Research Data', 'PFE', 'ticker'. Choose an effective architecture and avoid unrelated changes.",
  "business_terms": [
    "Trial Symbol Live",
    "trial symbol",
    "Healthcare Research Data",
    "PFE",
    "ticker"
  ],
  "setup": {
    "fixtures": {},
    "initial_state": {},
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "Trial Symbol Live",
          "trial symbol",
          "Healthcare Research Data",
          "PFE"
        ],
        "min_count": 1
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 2,
      "max_repeated_snapshots": 2
    },
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 1,
      "max_custom_backend_delta": 1
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "healthcare-research-data__catalyst_metric",
          "widget_id": "catalyst_metric",
          "fields": [
            "catalyst_metric_value",
            "label",
            "value"
          ],
          "path": "/catalyst-count",
          "payload": {
            "catalyst_metric_value": 10.25,
            "label": "Catalysts 30d",
            "value": 42.5
          }
        },
        {
          "name": "healthcare-research-data__trial_catalysts",
          "widget_id": "trial_catalysts",
          "fields": [
            "phase",
            "readout_date",
            "ticker"
          ],
          "path": "/trial-catalysts",
          "payload": [
            {
              "phase": "Primary",
              "readout_date": "2026-01-13",
              "ticker": "AAPL"
            },
            {
              "phase": "Review",
              "readout_date": "2026-01-14",
              "ticker": "MSFT"
            },
            {
              "phase": "Approved",
              "readout_date": "2026-01-15",
              "ticker": "NVDA"
            }
          ]
        },
        {
          "name": "healthcare-research-data__trial_symbol_pack",
          "widget_id": "trial_symbol_pack",
          "fields": [
            "trial_symbol_pack_value"
          ],
          "path": "/trial-symbol-pack",
          "payload": [
            {
              "trial_symbol_pack_value": 10.25
            },
            {
              "trial_symbol_pack_value": 20.5
            },
            {
              "trial_symbol_pack_value": 30.75
            }
          ]
        }
      ],
      "pinned_paths": false
    },
    "required_capabilities": [
      {
        "name": "capability_1_catalyst-metric",
        "datasets": [
          "healthcare-research-data__catalyst_metric"
        ],
        "widget_kind": "metric",
        "must_cover_fields": [
          "catalyst_metric_value"
        ],
        "required_param_kinds": [],
        "required_config": {}
      },
      {
        "name": "capability_2_trial-symbol-pack",
        "datasets": [
          "healthcare-research-data__trial_symbol_pack"
        ],
        "widget_kind": "table-like",
        "must_cover_fields": [
          "trial_symbol_pack_value"
        ],
        "required_param_kinds": [
          "ticker"
        ],
        "required_config": {}
      }
    ],
    "app_structure": {
      "required": true,
      "layout_refs_valid": true,
      "no_overlaps": true
    },
    "reference_trace": [
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Healthcare Research Data",
          "url": "http://localhost:7808",
          "widgets_json": {
            "trial_symbol_pack": {
              "name": "Trial Symbol Pack",
              "description": "Trial review filtered by symbol.",
              "endpoint": "/trial-symbol-pack",
              "type": "table",
              "gridData": {
                "w": 20,
                "h": 9
              },
              "params": [
                {
                  "paramName": "symbol",
                  "type": "ticker",
                  "label": "Symbol",
                  "value": "MRNA"
                }
              ],
              "staleTime": 900000,
              "data": {
                "valueField": "trial_symbol_pack_value"
              }
            },
            "catalyst_metric": {
              "name": "Catalysts 30d",
              "description": "Catalysts in the next 30 days.",
              "endpoint": "/catalyst-count",
              "type": "metric",
              "gridData": {
                "w": 6,
                "h": 4
              },
              "staleTime": 900000,
              "data": {
                "valueField": "catalyst_metric_value"
              }
            },
            "trial_catalysts": {
              "name": "Trial Catalysts",
              "description": "Upcoming clinical trial readouts.",
              "endpoint": "/trial-catalysts",
              "type": "table",
              "gridData": {
                "w": 20,
                "h": 9
              },
              "params": [
                {
                  "paramName": "ticker",
                  "type": "endpoint",
                  "label": "Ticker",
                  "value": "PFE",
                  "optionsEndpoint": "/tickers"
                }
              ],
              "data": {
                "table": {
                  "columnsDefs": [
                    {
                      "field": "ticker",
                      "headerName": "Ticker",
                      "cellDataType": "text"
                    },
                    {
                      "field": "phase",
                      "headerName": "Phase",
                      "cellDataType": "text"
                    },
                    {
                      "field": "readout_date",
                      "headerName": "Readout",
                      "cellDataType": "dateString"
                    }
                  ]
                }
              },
              "staleTime": 900000
            }
          },
          "apps_json": [
            {
              "name": "Trial Symbol Live",
              "description": "Preset symbol catalyst review.",
              "tabs": {
                "trials": {
                  "id": "trials",
                  "name": "Trials",
                  "layout": [
                    {
                      "i": "trial_symbol_pack",
                      "x": 0,
                      "y": 0,
                      "w": 20,
                      "h": 9,
                      "state": {
                        "params": {
                          "symbol": "MRNA"
                        }
                      }
                    }
                  ]
                },
                "posture": {
                  "id": "posture",
                  "name": "Posture",
                  "layout": [
                    {
                      "i": "catalyst_metric",
                      "x": 0,
                      "y": 0,
                      "w": 12,
                      "h": 6
                    }
                  ]
                }
              },
              "groups": []
            }
          ]
        }
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_001",
          "app_name": "Trial Symbol Live",
          "dashboard_name": "Trial Symbol Live Board",
          "activate": true
        }
      },
      {
        "tool": "update_widget",
        "args": {
          "widget_id": "trial_symbol_pack",
          "data_args": {
            "symbol": "PFE"
          }
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Trial Symbol Live",
          "data": "Trial Symbol Live is live from Healthcare Research Data: trial symbol ready. Configured symbol=PFE."
        }
      }
    ],
    "max_turns": 14
  }
}
