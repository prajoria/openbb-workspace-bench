{
  "id": "symbol_param_desk",
  "category": "platform",
  "family": "params",
  "difficulty": "hard",
  "split": "train",
  "prompt": "An equity-research analyst needs a decision-ready Workspace for earnings and estimates. The workspace must cover preview note for the earnings call. The workspace must cover street estimate revisions by quarter. The workspace must cover EPS beat and miss history. Analysts need to inspect quarter, EPS estimate, revenue estimate billions. An analyst can filter the analysis by ticker. Leave the complete working workspace open for review. Choose an effective architecture and avoid unrelated changes.",
  "business_terms": [
    "ticker"
  ],
  "fixtures": {},
  "initial_state": {},
  "allowed_tools": [
    "get_workspace_snapshot",
    "manage_dashboard",
    "manage_navigation_bar",
    "navigate_workspace",
    "list_available_widgets",
    "get_widget_schema",
    "get_params_options",
    "get_widget_data",
    "create_widget",
    "update_widget",
    "update_widget_layout",
    "delete_widget",
    "add_generative_widget",
    "read_widget",
    "manage_backends",
    "manage_apps",
    "get_skill_content",
    "read_workspace_resource",
    "get_workspace_prompt",
    "assign_tasks_to_agents"
  ],
  "success": {
    "trace_checks": {
      "max_invalid_tool_calls": 2,
      "max_repeated_snapshots": 2
    },
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 1,
      "max_custom_backend_delta": 1
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "earnings-prep-data__earnings_chart",
          "widget_id": "earnings_chart",
          "fields": [
            "earnings_chart_value"
          ],
          "path": "/eps-history",
          "payload": [
            {
              "earnings_chart_value": 10.25
            },
            {
              "earnings_chart_value": 20.5
            },
            {
              "earnings_chart_value": 30.75
            }
          ]
        },
        {
          "name": "earnings-prep-data__earnings_note",
          "widget_id": "earnings_note",
          "fields": [
            "earnings_note_value"
          ],
          "path": "/earnings-preview",
          "payload": "Earnings Preview fixture-backed runtime summary."
        },
        {
          "name": "earnings-prep-data__estimate_revisions",
          "widget_id": "estimate_revisions",
          "fields": [
            "eps_estimate",
            "quarter",
            "revenue_estimate_b"
          ],
          "path": "/estimate-revisions",
          "payload": [
            {
              "eps_estimate": 10.25,
              "quarter": "quarter-1",
              "revenue_estimate_b": 10.25
            },
            {
              "eps_estimate": 20.5,
              "quarter": "quarter-2",
              "revenue_estimate_b": 20.5
            },
            {
              "eps_estimate": 30.75,
              "quarter": "quarter-3",
              "revenue_estimate_b": 30.75
            }
          ]
        }
      ],
      "pinned_paths": false
    },
    "required_capabilities": [
      {
        "name": "capability_1_earnings-chart",
        "datasets": [
          "earnings-prep-data__earnings_chart"
        ],
        "widget_kind": "chart-like",
        "must_cover_fields": [
          "earnings_chart_value"
        ],
        "required_param_kinds": [
          "ticker"
        ],
        "required_config": {}
      },
      {
        "name": "capability_2_earnings-note",
        "datasets": [
          "earnings-prep-data__earnings_note"
        ],
        "widget_kind": "markdown",
        "must_cover_fields": [
          "earnings_note_value"
        ],
        "required_param_kinds": [
          "ticker"
        ],
        "required_config": {}
      },
      {
        "name": "capability_3_estimate-revisions",
        "datasets": [
          "earnings-prep-data__estimate_revisions"
        ],
        "widget_kind": "table-like",
        "must_cover_fields": [
          "eps_estimate",
          "quarter",
          "revenue_estimate_b"
        ],
        "required_param_kinds": [
          "ticker"
        ],
        "required_config": {}
      }
    ],
    "app_structure": {
      "required": true,
      "layout_refs_valid": true,
      "no_overlaps": true
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_snapshot",
      "args": {}
    },
    {
      "tool": "manage_backends",
      "args": {
        "operation": "add",
        "name": "Earnings Prep Data",
        "url": "http://localhost:7805",
        "widgets_json": {
          "earnings_note": {
            "name": "Earnings Preview",
            "description": "Preview note for the earnings call.",
            "endpoint": "/earnings-preview",
            "type": "markdown",
            "gridData": {
              "w": 12,
              "h": 8
            },
            "params": [
              {
                "paramName": "symbol",
                "type": "endpoint",
                "label": "Symbol",
                "value": "AAPL",
                "optionsEndpoint": "/symbols"
              }
            ],
            "data": {
              "valueField": "earnings_note_value"
            }
          },
          "estimate_revisions": {
            "name": "Estimate Revisions",
            "description": "Street estimate revisions by quarter.",
            "endpoint": "/estimate-revisions",
            "type": "table",
            "gridData": {
              "w": 20,
              "h": 9
            },
            "params": [
              {
                "paramName": "symbol",
                "type": "endpoint",
                "label": "Symbol",
                "value": "AAPL",
                "optionsEndpoint": "/symbols"
              }
            ],
            "data": {
              "table": {
                "columnsDefs": [
                  {
                    "field": "quarter",
                    "headerName": "Quarter",
                    "cellDataType": "text"
                  },
                  {
                    "field": "eps_estimate",
                    "headerName": "EPS Est",
                    "cellDataType": "number"
                  },
                  {
                    "field": "revenue_estimate_b",
                    "headerName": "Revenue Est ($B)",
                    "cellDataType": "number"
                  }
                ]
              }
            }
          },
          "earnings_chart": {
            "name": "EPS History",
            "description": "Plotly EPS beat/miss history.",
            "endpoint": "/eps-history",
            "type": "chart",
            "gridData": {
              "w": 20,
              "h": 9
            },
            "params": [
              {
                "paramName": "symbol",
                "type": "endpoint",
                "label": "Symbol",
                "value": "AAPL",
                "optionsEndpoint": "/symbols"
              }
            ],
            "raw": true,
            "data": {
              "valueField": "earnings_chart_value"
            }
          }
        },
        "apps_json": [
          {
            "name": "Symbol Param Desk",
            "description": "Shared-symbol earnings review.",
            "tabs": {
              "review": {
                "id": "review",
                "name": "Review",
                "layout": [
                  {
                    "i": "earnings_note",
                    "x": 0,
                    "y": 0,
                    "w": 12,
                    "h": 8
                  },
                  {
                    "i": "estimate_revisions",
                    "x": 12,
                    "y": 0,
                    "w": 20,
                    "h": 9
                  }
                ]
              },
              "price": {
                "id": "price",
                "name": "Price",
                "layout": [
                  {
                    "i": "earnings_chart",
                    "x": 0,
                    "y": 0,
                    "w": 20,
                    "h": 9
                  }
                ]
              }
            },
            "groups": []
          }
        ]
      }
    },
    {
      "tool": "manage_apps",
      "args": {
        "operation": "instantiate",
        "backend_id": "backend_001",
        "app_name": "Symbol Param Desk",
        "dashboard_name": "Symbol Param Desk Live",
        "activate": true
      }
    }
  ],
  "limits": {
    "max_turns": 14
  }
}
