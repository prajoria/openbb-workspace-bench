{
  "id": "vol_ship",
  "category": "platform",
  "family": "params",
  "difficulty": "hard",
  "split": "test",
  "prompt": "The desk needs a production-ready volatility and derivatives workflow for a volatility analyst. The workspace must cover volatility review filtered by symbol. The workspace must cover current volatility regime score. The workspace must cover daily CBOE VIX closes with returns. Analysts need to inspect date, close, return percentage. An analyst can filter the analysis by ticker. An analyst can toggle the relevant screening constraint. Leave the complete working workspace open for review. Add a short completion note that naturally includes the desk-required terms 'Vol Symbol Live', 'vol symbol', 'Vol Desk Data', 'AAPL', 'ticker'. Use your judgment on the architecture and leave other work intact.",
  "business_terms": [
    "Vol Symbol Live",
    "vol symbol",
    "Vol Desk Data",
    "AAPL",
    "ticker"
  ],
  "fixtures": {},
  "initial_state": {},
  "allowed_tools": [
    "get_workspace_snapshot",
    "manage_dashboard",
    "manage_navigation_bar",
    "navigate_workspace",
    "list_available_widgets",
    "get_widget_schema",
    "get_params_options",
    "get_widget_data",
    "create_widget",
    "update_widget",
    "update_widget_layout",
    "delete_widget",
    "add_generative_widget",
    "read_widget",
    "manage_backends",
    "manage_apps",
    "get_skill_content",
    "read_workspace_resource",
    "get_workspace_prompt",
    "assign_tasks_to_agents"
  ],
  "success": {
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "Vol Symbol Live",
          "vol symbol",
          "Vol Desk Data",
          "AAPL"
        ],
        "min_count": 1
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 2,
      "max_repeated_snapshots": 2
    },
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 1,
      "max_custom_backend_delta": 1
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "vol-desk-data__vix_history",
          "widget_id": "vix_history",
          "fields": [
            "close",
            "date",
            "return_pct"
          ],
          "path": "/vix-history",
          "payload": [
            {
              "close": 10.25,
              "date": "2026-01-13",
              "return_pct": 10.25
            },
            {
              "close": 20.5,
              "date": "2026-01-14",
              "return_pct": 20.5
            },
            {
              "close": 30.75,
              "date": "2026-01-15",
              "return_pct": 30.75
            }
          ]
        },
        {
          "name": "vol-desk-data__vol_regime_metric",
          "widget_id": "vol_regime_metric",
          "fields": [
            "label",
            "value",
            "vol_regime_metric_value"
          ],
          "path": "/vol-regime",
          "payload": {
            "label": "Vol Regime",
            "value": 42.5,
            "vol_regime_metric_value": 10.25
          }
        },
        {
          "name": "vol-desk-data__vol_symbol_pack",
          "widget_id": "vol_symbol_pack",
          "fields": [
            "vol_symbol_pack_value"
          ],
          "path": "/vol-symbol-pack",
          "payload": [
            {
              "vol_symbol_pack_value": 10.25
            },
            {
              "vol_symbol_pack_value": 20.5
            },
            {
              "vol_symbol_pack_value": 30.75
            }
          ]
        }
      ],
      "pinned_paths": false
    },
    "required_capabilities": [
      {
        "name": "capability_1_vol-regime-metric",
        "datasets": [
          "vol-desk-data__vol_regime_metric"
        ],
        "widget_kind": "metric",
        "must_cover_fields": [
          "vol_regime_metric_value"
        ],
        "required_param_kinds": [],
        "required_config": {}
      },
      {
        "name": "capability_2_vol-symbol-pack",
        "datasets": [
          "vol-desk-data__vol_symbol_pack"
        ],
        "widget_kind": "table-like",
        "must_cover_fields": [
          "vol_symbol_pack_value"
        ],
        "required_param_kinds": [
          "boolean",
          "ticker"
        ],
        "required_config": {}
      }
    ],
    "app_structure": {
      "required": true,
      "layout_refs_valid": true,
      "no_overlaps": true
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "manage_backends",
      "args": {
        "operation": "add",
        "name": "Vol Desk Data",
        "url": "http://localhost:7801",
        "widgets_json": {
          "vol_symbol_pack": {
            "name": "Vol Symbol Pack",
            "description": "Volatility review filtered by symbol.",
            "endpoint": "/vol-symbol-pack",
            "type": "table",
            "gridData": {
              "w": 20,
              "h": 9
            },
            "params": [
              {
                "paramName": "symbol",
                "type": "ticker",
                "label": "Symbol",
                "value": "MSFT"
              },
              {
                "paramName": "only_liquid",
                "type": "boolean",
                "label": "Liquid only",
                "value": true
              }
            ],
            "staleTime": 900000,
            "data": {
              "valueField": "vol_symbol_pack_value"
            }
          },
          "vol_regime_metric": {
            "name": "Vol Regime",
            "description": "Current volatility regime score.",
            "endpoint": "/vol-regime",
            "type": "metric",
            "gridData": {
              "w": 6,
              "h": 4
            },
            "staleTime": 900000,
            "data": {
              "valueField": "vol_regime_metric_value"
            }
          },
          "vix_history": {
            "name": "VIX History",
            "description": "Daily CBOE VIX closes with returns.",
            "endpoint": "/vix-history",
            "type": "table",
            "gridData": {
              "w": 20,
              "h": 9
            },
            "params": [
              {
                "paramName": "window",
                "type": "number",
                "label": "Window",
                "value": 30,
                "min": 5,
                "max": 365
              }
            ],
            "data": {
              "table": {
                "columnsDefs": [
                  {
                    "field": "date",
                    "headerName": "Date",
                    "cellDataType": "dateString"
                  },
                  {
                    "field": "close",
                    "headerName": "Close",
                    "cellDataType": "number"
                  },
                  {
                    "field": "return_pct",
                    "headerName": "Return %",
                    "cellDataType": "number",
                    "formatterFn": "percent",
                    "renderFn": "greenRed"
                  }
                ]
              }
            },
            "staleTime": 900000
          }
        },
        "apps_json": [
          {
            "name": "Vol Symbol Live",
            "description": "Preset symbol volatility review.",
            "tabs": {
              "vol": {
                "id": "vol",
                "name": "Vol",
                "layout": [
                  {
                    "i": "vol_symbol_pack",
                    "x": 0,
                    "y": 0,
                    "w": 20,
                    "h": 9,
                    "state": {
                      "params": {
                        "symbol": "MSFT"
                      }
                    }
                  }
                ]
              },
              "posture": {
                "id": "posture",
                "name": "Posture",
                "layout": [
                  {
                    "i": "vol_regime_metric",
                    "x": 0,
                    "y": 0,
                    "w": 12,
                    "h": 6
                  }
                ]
              }
            },
            "groups": []
          }
        ]
      }
    },
    {
      "tool": "manage_apps",
      "args": {
        "operation": "instantiate",
        "backend_id": "backend_001",
        "app_name": "Vol Symbol Live",
        "dashboard_name": "Vol Symbol Live Board",
        "activate": true
      }
    },
    {
      "tool": "update_widget",
      "args": {
        "widget_id": "vol_symbol_pack",
        "data_args": {
          "symbol": "AAPL"
        }
      }
    },
    {
      "tool": "add_generative_widget",
      "args": {
        "widget_type": "note",
        "name": "Vol Symbol Live",
        "data": "Vol Symbol Live is live from Vol Desk Data: vol symbol ready. Configured symbol=AAPL."
      }
    }
  ],
  "limits": {
    "max_turns": 14
  }
}
