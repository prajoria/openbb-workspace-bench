{
  "id": "realized_screen",
  "category": "platform",
  "family": "aggrid",
  "difficulty": "medium",
  "prompt": "Deliver an analyst-ready Workspace solution for volatility and derivatives. The workspace must cover realized volatility by tenor. Analysts need to inspect tenor, realized percentage, as of. Use `tenor` and `realized_pct` as the only fixed contract anchors, and make the other implementation choices yourself without collateral changes.",
  "business_terms": [
    "tenor",
    "realized_pct"
  ],
  "setup": {
    "fixtures": {},
    "initial_state": {},
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "trace_checks": {
      "max_invalid_tool_calls": 1,
      "max_repeated_snapshots": 2,
      "must_call_schema_before_create": true
    },
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 0,
      "max_custom_backend_delta": 1
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "vol-desk-data__realized_screen",
          "widget_id": "realized_screen",
          "fields": [
            "as_of",
            "realized_pct",
            "tenor"
          ],
          "path": "/realized-vol",
          "payload": [
            {
              "as_of": "2026-01-13",
              "realized_pct": 10.25,
              "tenor": "tenor-1"
            },
            {
              "as_of": "2026-01-14",
              "realized_pct": 20.5,
              "tenor": "tenor-2"
            },
            {
              "as_of": "2026-01-15",
              "realized_pct": 30.75,
              "tenor": "tenor-3"
            }
          ]
        }
      ],
      "pinned_paths": false
    },
    "required_capabilities": [
      {
        "name": "capability_1_realized-screen",
        "datasets": [
          "vol-desk-data__realized_screen"
        ],
        "widget_kind": "table-like",
        "must_cover_fields": [
          "as_of",
          "realized_pct",
          "tenor"
        ],
        "required_param_kinds": [],
        "required_config": {}
      }
    ],
    "polish": [
      {
        "code": "polish_refresh_policy",
        "backend_name": "Vol Desk Data",
        "widget_id": "realized_screen",
        "path": "staleTime",
        "expected": 1200000
      }
    ],
    "reference": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Vol Desk Data",
          "url": "http://localhost:7801",
          "widgets_json": {
            "realized_screen": {
              "name": "Realized Vol Screen",
              "description": "Realized volatility by tenor.",
              "endpoint": "/realized-vol",
              "type": "table",
              "gridData": {
                "w": 20,
                "h": 9
              },
              "data": {
                "table": {
                  "columnsDefs": [
                    {
                      "field": "tenor",
                      "headerName": "Tenor",
                      "cellDataType": "text"
                    },
                    {
                      "field": "realized_pct",
                      "headerName": "Realized Pct",
                      "cellDataType": "number",
                      "formatterFn": "percent",
                      "renderFn": "greenRed"
                    },
                    {
                      "field": "as_of",
                      "headerName": "As Of",
                      "cellDataType": "dateString"
                    }
                  ]
                }
              },
              "staleTime": 1200000
            }
          }
        }
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Vol Desk Data"
        }
      },
      {
        "tool": "get_widget_schema",
        "args": {
          "origin": "Vol Desk Data",
          "widget_id": "realized_screen"
        }
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Vol Desk Data",
          "widget_id": "realized_screen"
        }
      }
    ],
    "limits": {
      "max_turns": 13
    }
  }
