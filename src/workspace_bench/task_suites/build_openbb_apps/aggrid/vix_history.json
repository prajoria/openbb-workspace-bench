{
  "id": "vix_history",
  "category": "platform",
  "family": "aggrid",
  "specification_level": "explicit",
  "difficulty": "medium",
  "split": "test",
  "prompt": "Register the backend and place the specified widget on the active dashboard. Use 'Vol Desk Data' at http://localhost:7801. Make the data grid behavior and columns usable. The experience needs VIX History (`vix_history`, table) using `/vix-history` for daily CBOE VIX closes with returns; user controls: Window (`window`, number); columns: date (dateString), close (number), return_pct (number, percent, greenRed). Choose the appropriate Workspace tools, validate the result, and avoid unrelated changes.",
  "fixtures": {},
  "initial_state": {},
  "allowed_tools": [
    "get_workspace_snapshot",
    "manage_dashboard",
    "manage_navigation_bar",
    "navigate_workspace",
    "list_available_widgets",
    "get_widget_schema",
    "get_params_options",
    "get_widget_data",
    "create_widget",
    "update_widget",
    "update_widget_layout",
    "delete_widget",
    "add_generative_widget",
    "read_widget",
    "manage_backends",
    "manage_apps",
    "get_skill_content",
    "read_workspace_resource",
    "get_workspace_prompt",
    "assign_tasks_to_agents"
  ],
  "success": {
    "required_widget_defs": [
      {
        "backend_name": "Vol Desk Data",
        "widget_id": "vix_history",
        "expect": {
          "type": "table",
          "endpoint": "/vix-history"
        },
        "params_include": [
          {
            "paramName": "window",
            "type": "number"
          }
        ],
        "columns_include": [
          {
            "field": "date",
            "cellDataType": "dateString"
          },
          {
            "field": "close",
            "cellDataType": "number"
          },
          {
            "field": "return_pct",
            "cellDataType": "number",
            "formatterFn": "percent",
            "renderFn": "greenRed"
          }
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 1,
      "max_repeated_snapshots": 2,
      "must_call_schema_before_create": true
    },
    "required_widgets": [
      {
        "origin": "Vol Desk Data",
        "widget_id": "vix_history",
        "min_count": 1
      }
    ],
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 0,
      "max_custom_backend_delta": 1
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "vol-desk-data__vix_history",
          "widget_id": "vix_history",
          "fields": [
            "close",
            "date",
            "return_pct"
          ],
          "path": "/vix-history",
          "payload": [
            {
              "close": 10.25,
              "date": "2026-01-13",
              "return_pct": 10.25
            },
            {
              "close": 20.5,
              "date": "2026-01-14",
              "return_pct": 20.5
            },
            {
              "close": 30.75,
              "date": "2026-01-15",
              "return_pct": 30.75
            }
          ]
        }
      ],
      "pinned_paths": false
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "manage_backends",
      "args": {
        "operation": "add",
        "name": "Vol Desk Data",
        "url": "http://localhost:7801",
        "widgets_json": {
          "vix_history": {
            "name": "VIX History",
            "description": "Daily CBOE VIX closes with returns.",
            "endpoint": "/vix-history",
            "type": "table",
            "gridData": {
              "w": 20,
              "h": 9
            },
            "params": [
              {
                "paramName": "window",
                "type": "number",
                "label": "Window",
                "value": 30,
                "min": 5,
                "max": 365
              }
            ],
            "data": {
              "table": {
                "columnsDefs": [
                  {
                    "field": "date",
                    "headerName": "Date",
                    "cellDataType": "dateString"
                  },
                  {
                    "field": "close",
                    "headerName": "Close",
                    "cellDataType": "number"
                  },
                  {
                    "field": "return_pct",
                    "headerName": "Return %",
                    "cellDataType": "number",
                    "formatterFn": "percent",
                    "renderFn": "greenRed"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "tool": "list_available_widgets",
      "args": {
        "origin": "Vol Desk Data"
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Vol Desk Data",
        "widget_id": "vix_history"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Vol Desk Data",
        "widget_id": "vix_history"
      }
