{
  "id": "earnings_ship",
  "category": "platform",
  "family": "aggrid",
  "difficulty": "hard",
  "prompt": "An equity-research analyst needs a decision-ready Workspace for earnings and estimates. The workspace must cover beat/miss by ticker this season. The workspace must cover average EPS surprise last 4 quarters. The workspace must cover preview note for the earnings call. Analysts need to inspect ticker, EPS surprise percentage, revenue beat. An analyst can filter the analysis by ticker. Leave the complete working workspace open for review. Add a short completion note that naturally includes the desk-required terms 'Season Tracker', 'season', 'Earnings Prep Data', 'MSFT', 'ticker'. Choose an effective architecture and avoid unrelated changes.",
  "business_terms": [
    "Season Tracker",
    "season",
    "Earnings Prep Data",
    "MSFT",
    "ticker"
  ],
  "fixtures": {},
  "initial_state": {},
  "allowed_tools": [
    "get_workspace_snapshot",
    "manage_dashboard",
    "manage_navigation_bar",
    "navigate_workspace",
    "list_available_widgets",
    "get_widget_schema",
    "get_params_options",
    "get_widget_data",
    "create_widget",
    "update_widget",
    "update_widget_layout",
    "delete_widget",
    "add_generative_widget",
    "read_widget",
    "manage_backends",
    "manage_apps",
    "get_skill_content",
    "read_workspace_resource",
    "get_workspace_prompt",
    "assign_tasks_to_agents"
  ],
  "success": {
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "Season Tracker",
          "season",
          "Earnings Prep Data",
          "MSFT"
        ],
        "min_count": 1
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 2,
      "max_repeated_snapshots": 2
    },
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 1,
      "max_custom_backend_delta": 1
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "earnings-prep-data__beat_miss_grid",
          "widget_id": "beat_miss_grid",
          "fields": [
            "eps_surprise_pct",
            "revenue_beat",
            "ticker"
          ],
          "path": "/beat-miss",
          "payload": [
            {
              "eps_surprise_pct": 10.25,
              "revenue_beat": true,
              "ticker": "AAPL"
            },
            {
              "eps_surprise_pct": 20.5,
              "revenue_beat": false,
              "ticker": "MSFT"
            },
            {
              "eps_surprise_pct": 30.75,
              "revenue_beat": true,
              "ticker": "NVDA"
            }
          ]
        },
        {
          "name": "earnings-prep-data__earnings_note",
          "widget_id": "earnings_note",
          "fields": [
            "earnings_note_value"
          ],
          "path": "/earnings-preview",
          "payload": "Earnings Preview fixture-backed runtime summary."
        },
        {
          "name": "earnings-prep-data__surprise_metric",
          "widget_id": "surprise_metric",
          "fields": [
            "label",
            "surprise_metric_value",
            "value"
          ],
          "path": "/avg-surprise",
          "payload": {
            "label": "Avg Surprise",
            "surprise_metric_value": 10.25,
            "value": 42.5
          }
        }
      ],
      "pinned_paths": false
    },
    "required_capabilities": [
      {
        "name": "capability_1_beat-miss-grid",
        "datasets": [
          "earnings-prep-data__beat_miss_grid"
        ],
        "widget_kind": "table-like",
        "must_cover_fields": [
          "eps_surprise_pct",
          "revenue_beat",
          "ticker"
        ],
        "required_param_kinds": [
          "ticker"
        ],
        "required_config": {}
      },
      {
        "name": "capability_2_surprise-metric",
        "datasets": [
          "earnings-prep-data__surprise_metric"
        ],
        "widget_kind": "metric",
        "must_cover_fields": [
          "surprise_metric_value"
        ],
        "required_param_kinds": [],
        "required_config": {}
      }
    ],
    "app_structure": {
      "required": true,
      "layout_refs_valid": true,
      "no_overlaps": true
    },
    "polish": [
      {
        "code": "polish_refresh_policy",
        "backend_name": "Earnings Prep Data",
        "widget_id": "beat_miss_grid",
        "path": "staleTime",
        "expected": 900000
      }
    ]
  },
  "oracle_tool_calls": [
    {
      "tool": "manage_backends",
      "args": {
        "operation": "add",
        "name": "Earnings Prep Data",
        "url": "http://localhost:7805",
        "widgets_json": {
          "beat_miss_grid": {
            "name": "Beat Miss Grid",
            "description": "Beat/miss by ticker this season.",
            "endpoint": "/beat-miss",
            "type": "table",
            "gridData": {
              "w": 20,
              "h": 9
            },
            "data": {
              "table": {
                "columnsDefs": [
                  {
                    "field": "ticker",
                    "headerName": "Ticker",
                    "cellDataType": "text"
                  },
                  {
                    "field": "eps_surprise_pct",
                    "headerName": "Eps Surprise Pct",
                    "cellDataType": "number",
                    "formatterFn": "percent"
                  },
                  {
                    "field": "revenue_beat",
                    "headerName": "Revenue Beat",
                    "cellDataType": "boolean"
                  }
                ]
              }
            },
            "params": [
              {
                "paramName": "ticker",
                "type": "text",
                "label": "Ticker",
                "value": "AAPL",
                "description": "Ticker in focus."
              }
            ],
            "staleTime": 900000
          },
          "surprise_metric": {
            "name": "Avg Surprise",
            "description": "Average EPS surprise last 4 quarters.",
            "endpoint": "/avg-surprise",
            "type": "metric",
            "gridData": {
              "w": 6,
              "h": 4
            },
            "staleTime": 900000,
            "data": {
              "valueField": "surprise_metric_value"
            }
          },
          "earnings_note": {
            "name": "Earnings Preview",
            "description": "Preview note for the earnings call.",
            "endpoint": "/earnings-preview",
            "type": "markdown",
            "gridData": {
              "w": 12,
              "h": 8
            },
            "params": [
              {
                "paramName": "symbol",
                "type": "endpoint",
                "label": "Symbol",
                "value": "AAPL",
                "optionsEndpoint": "/symbols"
              }
            ],
            "staleTime": 900000,
            "data": {
              "valueField": "earnings_note_value"
            }
          }
        },
        "apps_json": [
          {
            "name": "Season Tracker",
            "description": "Beats, misses, surprises.",
            "tabs": {
              "season": {
                "id": "season",
                "name": "Season",
                "layout": [
                  {
                    "i": "beat_miss_grid",
                    "x": 0,
                    "y": 0,
                    "w": 20,
                    "h": 9
                  }
                ]
              },
              "signals": {
                "id": "signals",
                "name": "Signals",
                "layout": [
                  {
                    "i": "surprise_metric",
                    "x": 0,
                    "y": 0,
                    "w": 12,
                    "h": 6
                  }
                ]
              }
            },
            "groups": []
          }
        ]
      }
    },
    {
      "tool": "manage_apps",
      "args": {
        "operation": "instantiate",
        "backend_id": "backend_001",
        "app_name": "Season Tracker",
        "dashboard_name": "Season Tracker Live",
        "activate": true
      }
    },
    {
      "tool": "update_widget",
      "args": {
        "widget_id": "beat_miss_grid",
        "data_args": {
          "ticker": "MSFT"
        }
      }
    },
    {
      "tool": "add_generative_widget",
      "args": {
        "widget_type": "note",
        "name": "Season Tracker",
        "data": "Season Tracker is live from Earnings Prep Data: season on tap. Configured ticker=MSFT."
      }
    }
  ],
  "limits": {
    "max_turns": 14
  }
}
