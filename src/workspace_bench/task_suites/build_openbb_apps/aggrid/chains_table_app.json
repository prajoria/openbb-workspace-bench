{
  "id": "chains_table_app",
  "category": "platform",
  "family": "aggrid",
  "specification_level": "explicit",
  "difficulty": "medium",
  "prompt": "Publish the requested app and open it in Workspace to verify it works. Use 'Chain TVL Data' at http://localhost:7802. Make the data grid behavior and columns usable. The experience needs Top Chains by TVL (`chains_table`, table) using `/chains-table` for current TVL of all chains from the desk aggregator; columns: name (text), tvl_usd (number, int), change_1d (number, percent, greenRed). Organize it as app 'Chains Board' with tabs Overview (chains_table). Choose the appropriate Workspace tools, validate the result, and avoid unrelated changes.",
  "fixtures": {},
  "initial_state": {},
  "allowed_tools": [
    "get_workspace_snapshot",
    "manage_dashboard",
    "manage_navigation_bar",
    "navigate_workspace",
    "list_available_widgets",
    "get_widget_schema",
    "get_params_options",
    "get_widget_data",
    "create_widget",
    "update_widget",
    "update_widget_layout",
    "delete_widget",
    "add_generative_widget",
    "read_widget",
    "manage_backends",
    "manage_apps",
    "get_skill_content",
    "read_workspace_resource",
    "get_workspace_prompt",
    "assign_tasks_to_agents"
  ],
  "success": {
    "required_widget_defs": [
      {
        "backend_name": "Chain TVL Data",
        "widget_id": "chains_table",
        "expect": {
          "type": "table",
          "endpoint": "/chains-table"
        },
        "columns_include": [
          {
            "field": "name",
            "cellDataType": "text"
          },
          {
            "field": "tvl_usd",
            "cellDataType": "number",
            "formatterFn": "int"
          },
          {
            "field": "change_1d",
            "cellDataType": "number",
            "formatterFn": "percent",
            "renderFn": "greenRed"
          }
        ],
        "params_include": []
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Chain TVL Data",
        "layout_refs_valid": true,
        "no_overlaps": true,
        "name_contains": "Chains Board",
        "tabs_include": [
          "overview"
        ],
        "tab_count": 1,
        "widgets_on_tab": [
          {
            "tab_id": "overview",
            "widget_id": "chains_table"
          }
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 1,
      "max_repeated_snapshots": 2
    },
    "required_dashboard_name_contains": "Chains Board",
    "required_widgets": [
      {
        "origin": "Chain TVL Data",
        "widget_id": "chains_table",
        "tab_id": "overview",
        "min_count": 1
      }
    ],
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 1,
      "max_custom_backend_delta": 1
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "chain-tvl-data__chains_table",
          "widget_id": "chains_table",
          "fields": [
            "change_1d",
            "name",
            "tvl_usd"
          ],
          "path": "/chains-table",
          "payload": [
            {
              "change_1d": 10.25,
              "name": "name-1",
              "tvl_usd": 10.25
            },
            {
              "change_1d": 20.5,
              "name": "name-2",
              "tvl_usd": 20.5
            },
            {
              "change_1d": 30.75,
              "name": "name-3",
              "tvl_usd": 30.75
            }
          ]
        }
      ],
      "pinned_paths": false
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_snapshot",
      "args": {}
    },
    {
      "tool": "manage_backends",
      "args": {
        "operation": "add",
        "name": "Chain TVL Data",
        "url": "http://localhost:7802",
        "widgets_json": {
          "chains_table": {
            "name": "Top Chains by TVL",
            "description": "Current TVL of all chains from the desk aggregator.",
            "endpoint": "/chains-table",
            "type": "table",
            "gridData": {
              "w": 20,
              "h": 9
            },
            "data": {
              "table": {
                "columnsDefs": [
                  {
                    "field": "name",
                    "headerName": "Chain",
                    "cellDataType": "text"
                  },
                  {
                    "field": "tvl_usd",
                    "headerName": "TVL ($)",
                    "cellDataType": "number",
                    "formatterFn": "int"
                  },
                  {
                    "field": "change_1d",
                    "headerName": "1d Change",
                    "cellDataType": "number",
                    "formatterFn": "percent",
                    "renderFn": "greenRed"
                  }
                ]
              }
            }
          }
        },
        "apps_json": [
          {
            "name": "Chains Board",
            "description": "Chain TVL at a glance.",
            "tabs": {
              "overview": {
                "id": "overview",
                "name": "Overview",
                "layout": [
                  {
                    "i": "chains_table",
                    "x": 0,
                    "y": 0,
                    "w": 20,
                    "h": 9
                  }
                ]
              }
            },
            "groups": []
          }
        ]
      }
    },
    {
      "tool": "manage_apps",
      "args": {
        "operation": "instantiate",
        "backend_id": "backend_001",
        "app_name": "Chains Board",
        "dashboard_name": "Chains Board Live",
        "activate": true
      }
    }
  ],
  "limits": {
    "max_turns": 6
  }
}
