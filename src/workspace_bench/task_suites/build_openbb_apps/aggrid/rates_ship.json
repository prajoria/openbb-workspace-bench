  "business_terms": [
    "Auction Desk",
    "auctions",
    "Rates Watch Data",
    "30Y Bond"
  ],
  "fixtures": {},
  "initial_state": {},
  "allowed_tools": [
    "get_workspace_snapshot",
    "manage_dashboard",
    "manage_navigation_bar",
