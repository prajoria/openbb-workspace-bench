{
  "id": "execution_ship",
  "category": "platform",
  "family": "aggrid",
  "difficulty": "hard",
  "prompt": "The desk needs a production-ready orders and venue quality workflow for an execution analyst. The workspace must cover execution quality by venue. The workspace must cover open execution exceptions. The workspace must cover slippage distribution by venue. Analysts need to inspect venue, fills, slippage percentage. Leave the complete working workspace open for review. Add a short completion HTML card that naturally includes the desk-required terms 'Execution Room', 'venues', 'Execution Desk Data', 'EDGX'. Use your judgment on the architecture and leave other work intact.",
  "business_terms": [
    "Execution Room",
    "venues",
    "Execution Desk Data",
    "EDGX"
  ],
  "setup": {
    "fixtures": {},
    "initial_state": {},
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_generated_widgets": [
      {
        "widget_type": "html",
        "data_contains": [
          "Execution Room",
          "venues",
          "Execution Desk Data",
          "EDGX"
        ],
        "min_count": 1
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 2,
      "max_repeated_snapshots": 2
    },
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 1,
      "max_custom_backend_delta": 1
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "execution-desk-data__exception_metric",
          "widget_id": "exception_metric",
          "fields": [
            "exception_metric_value",
            "label",
            "value"
          ],
          "path": "/exception-count",
          "payload": {
            "exception_metric_value": 10.25,
            "label": "Exceptions",
            "value": 42.5
          }
        },
        {
          "name": "execution-desk-data__slippage_chart",
          "widget_id": "slippage_chart",
          "fields": [
            "slippage_chart_value"
          ],
          "path": "/slippage-by-venue",
          "payload": [
            {
              "slippage_chart_value": 10.25
            },
            {
              "slippage_chart_value": 20.5
            },
            {
              "slippage_chart_value": 30.75
            }
          ]
        },
        {
          "name": "execution-desk-data__venue_scorecard",
          "widget_id": "venue_scorecard",
          "fields": [
            "fills",
            "slippage_pct",
            "venue"
          ],
          "path": "/venue-scorecard",
          "payload": [
            {
              "fills": 10.25,
              "slippage_pct": 10.25,
              "venue": "Primary"
            },
            {
              "fills": 20.5,
              "slippage_pct": 20.5,
              "venue": "Review"
            },
            {
              "fills": 30.75,
              "slippage_pct": 30.75,
              "venue": "Approved"
            }
          ]
        }
      ],
      "pinned_paths": false
    },
    "required_capabilities": [
      {
        "name": "capability_1_exception-metric",
        "datasets": [
          "execution-desk-data__exception_metric"
        ],
        "widget_kind": "metric",
        "must_cover_fields": [
          "exception_metric_value"
        ],
        "required_param_kinds": [],
        "required_config": {}
      },
      {
        "name": "capability_2_venue-scorecard",
        "datasets": [
          "execution-desk-data__venue_scorecard"
        ],
        "widget_kind": "table-like",
        "must_cover_fields": [
          "fills",
          "slippage_pct",
          "venue"
        ],
        "required_param_kinds": [
          "text"
        ],
        "required_config": {}
      }
    ],
    "app_structure": {
      "required": true,
      "layout_refs_valid": true,
      "no_overlaps": true
    },
    "polish": [
      {
        "code": "polish_refresh_policy",
        "backend_name": "Execution Desk Data",
        "widget_id": "venue_scorecard",
        "path": "staleTime",
        "expected": 900000
      }
    ],
    "reference_trace": [
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Execution Desk Data",
          "url": "http://localhost:7806",
          "widgets_json": {
            "venue_scorecard": {
              "name": "Venue Scorecard",
              "description": "Execution quality by venue.",
              "endpoint": "/venue-scorecard",
              "type": "table",
              "gridData": {
                "w": 20,
                "h": 9
              },
              "data": {
                "table": {
                  "columnsDefs": [
                    {
                      "field": "venue",
                      "headerName": "Venue",
                      "cellDataType": "text"
                    },
                    {
                      "field": "fills",
                      "headerName": "Fills",
                      "cellDataType": "number"
                    },
                    {
                      "field": "slippage_pct",
                      "headerName": "Slippage Pct",
                      "cellDataType": "number",
                      "formatterFn": "percent"
                    }
                  ]
                }
              },
              "params": [
                {
                  "paramName": "venue",
                  "type": "text",
                  "label": "Venue",
                  "value": "ARCA",
                  "description": "Venue in focus."
                }
              ],
              "staleTime": 900000
            },
            "exception_metric": {
              "name": "Exceptions",
              "description": "Open execution exceptions.",
              "endpoint": "/exception-count",
              "type": "metric",
              "gridData": {
                "w": 5,
                "h": 4
              },
              "staleTime": 900000,
              "data": {
                "valueField": "exception_metric_value"
              }
            },
            "slippage_chart": {
              "name": "Slippage by Venue",
              "description": "Plotly slippage distribution by venue.",
              "endpoint": "/slippage-by-venue",
              "type": "chart",
              "gridData": {
                "w": 20,
                "h": 9
              },
              "raw": true,
              "staleTime": 900000,
              "data": {
                "valueField": "slippage_chart_value"
              }
            }
          },
          "apps_json": [
            {
              "name": "Execution Room",
              "description": "Venue quality and exceptions.",
              "tabs": {
                "venues": {
                  "id": "venues",
                  "name": "Venues",
                  "layout": [
                    {
                      "i": "venue_scorecard",
                      "x": 0,
                      "y": 0,
                      "w": 20,
                      "h": 9
                    }
                  ]
                },
                "signals": {
                  "id": "signals",
                  "name": "Signals",
                  "layout": [
                    {
                      "i": "exception_metric",
                      "x": 0,
                      "y": 0,
                      "w": 12,
                      "h": 6
                    }
                  ]
                }
              },
              "groups": []
            }
          ]
        }
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_001",
          "app_name": "Execution Room",
          "dashboard_name": "Execution Room Live",
          "activate": true
        }
      },
      {
        "tool": "update_widget",
        "args": {
          "widget_id": "venue_scorecard",
          "data_args": {
            "venue": "EDGX"
          }
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "html",
          "name": "Execution Room",
          "data": "<section>Execution Room is live from Execution Desk Data: venues on tap. Configured venue=EDGX.</section>"
        }
      }
    ],
    "max_turns": 14
  }
}
