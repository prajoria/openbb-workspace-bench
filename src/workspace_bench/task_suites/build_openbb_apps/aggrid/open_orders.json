{
  "id": "open_orders",
  "category": "platform",
  "family": "aggrid",
  "specification_level": "explicit",
  "difficulty": "medium",
  "prompt": "Connect the backend and make its first widget usable on the current dashboard. Use 'Execution Desk Data' at http://localhost:7806. Make the data grid behavior and columns usable. The experience needs Open Orders (`open_orders`, table) using `/open-orders` for live open orders blotter; columns: order_id (text), symbol (text), qty (number, int), status (text, titleCase). Choose the appropriate Workspace tools, validate the result, and avoid unrelated changes.",
  "setup": {
    "fixtures": {},
    "initial_state": {},
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_widget_defs": [
      {
        "backend_name": "Execution Desk Data",
        "widget_id": "open_orders",
        "expect": {
          "type": "table",
          "endpoint": "/open-orders"
        },
        "columns_include": [
          {
            "field": "order_id",
            "cellDataType": "text"
          },
          {
            "field": "symbol",
            "cellDataType": "text"
          },
          {
            "field": "qty",
            "cellDataType": "number",
            "formatterFn": "int"
          },
          {
            "field": "status",
            "cellDataType": "text",
            "renderFn": "titleCase"
          }
        ],
        "params_include": []
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 1,
      "max_repeated_snapshots": 2,
      "must_call_schema_before_create": true
    },
    "required_widgets": [
      {
        "origin": "Execution Desk Data",
        "widget_id": "open_orders",
        "min_count": 1
      }
    ],
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 0,
      "max_custom_backend_delta": 1
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "execution-desk-data__open_orders",
          "widget_id": "open_orders",
          "fields": [
            "order_id",
            "qty",
            "status",
            "symbol"
          ],
          "path": "/open-orders",
          "payload": [
            {
              "order_id": "order_id-1",
              "qty": 10.25,
              "status": "Primary",
              "symbol": "AAPL"
            },
            {
              "order_id": "order_id-2",
              "qty": 20.5,
              "status": "Review",
              "symbol": "MSFT"
            },
            {
              "order_id": "order_id-3",
              "qty": 30.75,
              "status": "Approved",
              "symbol": "NVDA"
            }
          ]
        }
      ],
      "pinned_paths": false
    },
    "reference_trace": [
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Execution Desk Data",
          "url": "http://localhost:7806",
          "widgets_json": {
            "open_orders": {
              "name": "Open Orders",
              "description": "Live open orders blotter.",
              "endpoint": "/open-orders",
              "type": "table",
              "gridData": {
                "w": 20,
                "h": 9
              },
              "data": {
                "table": {
                  "columnsDefs": [
                    {
                      "field": "order_id",
                      "headerName": "Order",
                      "cellDataType": "text"
                    },
                    {
                      "field": "symbol",
                      "headerName": "Symbol",
                      "cellDataType": "text"
                    },
                    {
                      "field": "qty",
                      "headerName": "Qty",
                      "cellDataType": "number",
                      "formatterFn": "int"
                    },
                    {
                      "field": "status",
                      "headerName": "Status",
                      "cellDataType": "text",
                      "renderFn": "titleCase"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Execution Desk Data"
        }
      },
      {
        "tool": "get_widget_schema",
        "args": {
          "origin": "Execution Desk Data",
          "widget_id": "open_orders"
        }
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Execution Desk Data",
          "widget_id": "open_orders"
        }
      }
    ],
    "max_turns": 7
  }
}
