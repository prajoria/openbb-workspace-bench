{
  "id": "healthcare_ship",
  "category": "platform",
  "family": "aggrid",
  "difficulty": "hard",
  "prompt": "A healthcare-research analyst needs a decision-ready Workspace for clinical catalysts and pipelines. The workspace must cover upcoming trial readouts. The workspace must cover catalysts in the next 30 days. The workspace must cover FDA decision and notice feed. Analysts need to inspect ticker, phase, readout. Leave the complete working workspace open for review. Add a short completion note that naturally includes the desk-required terms 'Readout Desk', 'readouts', 'Healthcare Research Data', 'II'. Choose an effective architecture and avoid unrelated changes.",
  "business_terms": [
    "Readout Desk",
    "readouts",
    "Healthcare Research Data",
    "II"
  ],
  "setup": {
    "fixtures": {},
    "initial_state": {},
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "Readout Desk",
          "readouts",
          "Healthcare Research Data",
          "II"
        ],
        "min_count": 1
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 2,
      "max_repeated_snapshots": 2
    },
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 1,
      "max_custom_backend_delta": 1
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "healthcare-research-data__catalyst_metric",
          "widget_id": "catalyst_metric",
          "fields": [
            "catalyst_metric_value",
            "label",
            "value"
          ],
          "path": "/catalyst-count",
          "payload": {
            "catalyst_metric_value": 10.25,
            "label": "Catalysts 30d",
            "value": 42.5
          }
        },
        {
          "name": "healthcare-research-data__fda_newsfeed",
          "widget_id": "fda_newsfeed",
          "fields": [
            "fda_newsfeed_value",
            "published_at",
            "summary",
            "title"
          ],
          "path": "/fda-notices",
          "payload": [
            {
              "fda_newsfeed_value": 10.25,
              "published_at": "2026-01-15T14:30:00Z",
              "summary": "Fixture-backed desk update with verified data.",
              "title": "FDA Notices update"
            }
          ]
        },
        {
          "name": "healthcare-research-data__readout_calendar",
          "widget_id": "readout_calendar",
          "fields": [
            "phase",
            "readout",
            "ticker"
          ],
          "path": "/readout-calendar",
          "payload": [
            {
              "phase": "Primary",
              "readout": "2026-01-13",
              "ticker": "AAPL"
            },
            {
              "phase": "Review",
              "readout": "2026-01-14",
              "ticker": "MSFT"
            },
            {
              "phase": "Approved",
              "readout": "2026-01-15",
              "ticker": "NVDA"
            }
          ]
        }
      ],
      "pinned_paths": false
    },
    "required_capabilities": [
      {
        "name": "capability_1_catalyst-metric",
        "datasets": [
          "healthcare-research-data__catalyst_metric"
        ],
        "widget_kind": "metric",
        "must_cover_fields": [
          "catalyst_metric_value"
        ],
        "required_param_kinds": [],
        "required_config": {}
      },
      {
        "name": "capability_2_readout-calendar",
        "datasets": [
          "healthcare-research-data__readout_calendar"
        ],
        "widget_kind": "table-like",
        "must_cover_fields": [
          "phase",
          "readout",
          "ticker"
        ],
        "required_param_kinds": [
          "text"
        ],
        "required_config": {}
      }
    ],
    "app_structure": {
      "required": true,
      "layout_refs_valid": true,
      "no_overlaps": true
    },
    "polish": [
      {
        "code": "polish_refresh_policy",
        "backend_name": "Healthcare Research Data",
        "widget_id": "readout_calendar",
        "path": "staleTime",
        "expected": 900000
      }
    ],
    "reference_trace": [
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Healthcare Research Data",
          "url": "http://localhost:7808",
          "widgets_json": {
            "readout_calendar": {
              "name": "Readout Calendar",
              "description": "Upcoming trial readouts.",
              "endpoint": "/readout-calendar",
              "type": "table",
              "gridData": {
                "w": 20,
                "h": 9
              },
              "data": {
                "table": {
                  "columnsDefs": [
                    {
                      "field": "ticker",
                      "headerName": "Ticker",
                      "cellDataType": "text"
                    },
                    {
                      "field": "phase",
                      "headerName": "Phase",
                      "cellDataType": "text"
                    },
                    {
                      "field": "readout",
                      "headerName": "Readout",
                      "cellDataType": "dateString"
                    }
                  ]
                }
              },
              "params": [
                {
                  "paramName": "phase",
                  "type": "text",
                  "label": "Phase",
                  "value": "III",
                  "description": "Trial phase filter."
                }
              ],
              "staleTime": 900000
            },
            "catalyst_metric": {
              "name": "Catalysts 30d",
              "description": "Catalysts in the next 30 days.",
              "endpoint": "/catalyst-count",
              "type": "metric",
              "gridData": {
                "w": 6,
                "h": 4
              },
              "staleTime": 900000,
              "data": {
                "valueField": "catalyst_metric_value"
              }
            },
            "fda_newsfeed": {
              "name": "FDA Notices",
              "description": "FDA decision and notice feed.",
              "endpoint": "/fda-notices",
              "type": "newsfeed",
              "gridData": {
                "w": 12,
                "h": 10
              },
              "staleTime": 900000,
              "data": {
                "valueField": "fda_newsfeed_value"
              }
            }
          },
          "apps_json": [
            {
              "name": "Readout Desk",
              "description": "Trial readouts and catalysts.",
              "tabs": {
                "readouts": {
                  "id": "readouts",
                  "name": "Readouts",
                  "layout": [
                    {
                      "i": "readout_calendar",
                      "x": 0,
                      "y": 0,
                      "w": 20,
                      "h": 9
                    }
                  ]
                },
                "signals": {
                  "id": "signals",
                  "name": "Signals",
                  "layout": [
                    {
                      "i": "catalyst_metric",
                      "x": 0,
                      "y": 0,
                      "w": 12,
                      "h": 6
                    }
                  ]
                }
              },
              "groups": []
            }
          ]
        }
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_001",
          "app_name": "Readout Desk",
          "dashboard_name": "Readout Desk Live",
          "activate": true
        }
      },
      {
        "tool": "update_widget",
        "args": {
          "widget_id": "readout_calendar",
          "data_args": {
            "phase": "II"
          }
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Readout Desk",
          "data": "Readout Desk is live from Healthcare Research Data: readouts on tap. Configured phase=II."
        }
      }
    ],
    "max_turns": 14
  }
}
