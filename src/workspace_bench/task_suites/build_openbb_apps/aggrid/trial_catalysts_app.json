{
  "id": "trial_catalysts_app",
  "category": "platform",
  "family": "aggrid",
  "specification_level": "partially-specified",
  "difficulty": "hard",
  "prompt": "Deliver an analyst-ready Workspace solution for clinical catalysts and pipelines. The workspace must cover upcoming clinical trial readouts. Analysts need to inspect ticker, phase, readout date. An analyst can filter the analysis by ticker. Leave the complete working workspace open for review. Use `ticker` and `phase` as the only fixed contract anchors, and make the other implementation choices yourself without collateral changes.",
  "business_terms": [
    "ticker",
    "phase"
  ],
  "fixtures": {},
  "initial_state": {},
  "allowed_tools": [
    "get_workspace_snapshot",
    "manage_dashboard",
    "manage_navigation_bar",
    "navigate_workspace",
    "list_available_widgets",
    "get_widget_schema",
    "get_params_options",
    "get_widget_data",
    "create_widget",
    "update_widget",
    "update_widget_layout",
    "delete_widget",
    "add_generative_widget",
    "read_widget",
    "manage_backends",
    "manage_apps",
    "get_skill_content",
    "read_workspace_resource",
    "get_workspace_prompt",
    "assign_tasks_to_agents"
  ],
  "success": {
    "trace_checks": {
      "max_invalid_tool_calls": 1,
      "max_repeated_snapshots": 2
    },
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 1,
      "max_custom_backend_delta": 1
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "healthcare-research-data__trial_catalysts",
          "widget_id": "trial_catalysts",
          "fields": [
            "phase",
            "readout_date",
            "ticker"
          ],
          "path": "/trial-catalysts",
          "payload": [
            {
              "phase": "Primary",
              "readout_date": "2026-01-13",
              "ticker": "AAPL"
            },
            {
              "phase": "Review",
              "readout_date": "2026-01-14",
              "ticker": "MSFT"
            },
            {
              "phase": "Approved",
              "readout_date": "2026-01-15",
              "ticker": "NVDA"
            }
          ]
        }
      ],
      "pinned_paths": false
    },
    "required_capabilities": [
      {
        "name": "capability_1_trial-catalysts",
        "datasets": [
          "healthcare-research-data__trial_catalysts"
        ],
        "widget_kind": "table-like",
        "must_cover_fields": [
          "phase",
          "readout_date",
          "ticker"
        ],
        "required_param_kinds": [
          "ticker"
        ],
        "required_config": {}
      }
    ],
    "app_structure": {
      "required": true,
      "layout_refs_valid": true,
      "no_overlaps": true
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_snapshot",
      "args": {}
    },
    {
      "tool": "manage_backends",
      "args": {
        "operation": "add",
        "name": "Healthcare Research Data",
        "url": "http://localhost:7808",
        "widgets_json": {
          "trial_catalysts": {
            "name": "Trial Catalysts",
            "description": "Upcoming clinical trial readouts.",
            "endpoint": "/trial-catalysts",
            "type": "table",
            "gridData": {
              "w": 20,
              "h": 9
            },
            "params": [
              {
                "paramName": "ticker",
                "type": "endpoint",
                "label": "Ticker",
                "value": "PFE",
                "optionsEndpoint": "/tickers"
              }
            ],
            "data": {
              "table": {
                "columnsDefs": [
                  {
                    "field": "ticker",
                    "headerName": "Ticker",
                    "cellDataType": "text"
                  },
                  {
                    "field": "phase",
                    "headerName": "Phase",
                    "cellDataType": "text"
                  },
                  {
                    "field": "readout_date",
                    "headerName": "Readout",
                    "cellDataType": "dateString"
                  }
                ]
              }
            }
          }
        },
        "apps_json": [
          {
            "name": "Catalyst Watch",
            "description": "Upcoming trial catalysts.",
            "tabs": {
              "catalysts": {
                "id": "catalysts",
                "name": "Catalysts",
                "layout": [
                  {
                    "i": "trial_catalysts",
                    "x": 0,
                    "y": 0,
                    "w": 24,
                    "h": 10
                  }
                ]
              }
            },
            "groups": []
          }
        ]
      }
    },
    {
      "tool": "manage_apps",
      "args": {
        "operation": "instantiate",
        "backend_id": "backend_001",
        "app_name": "Catalyst Watch",
        "dashboard_name": "Catalyst Watch Live",
