{
  "id": "sla_ship",
  "category": "platform",
  "family": "apps",
  "difficulty": "hard",
  "prompt": "Build a vendor-operations manager a dependable vendor service levels workspace. The workspace must cover count of open SLA breaches. The workspace must cover vendor SLA state with breach flags. The workspace must cover vendor incident notices feed. Analysts need to inspect vendor, status, latency milliseconds, breach. Leave the complete working workspace open for review. Add a short completion note that naturally includes the desk-required terms 'Vendor Live', 'vendors', 'Vendor SLA Data', 'detail'. Decide how best to organize the experience and preserve unrelated work.",
  "business_terms": [
    "Vendor Live",
    "vendors",
    "Vendor SLA Data",
    "detail"
  ],
  "setup": {
    "fixtures": {},
    "initial_state": {},
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "Vendor Live",
          "vendors",
          "Vendor SLA Data",
          "detail"
        ],
        "min_count": 1
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 2,
      "max_repeated_snapshots": 2
    },
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 1,
      "max_custom_backend_delta": 1
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "vendor-sla-data__breach_metric",
          "widget_id": "breach_metric",
          "fields": [
            "breach_metric_value",
            "label",
            "value"
          ],
          "path": "/breach-count",
          "payload": {
            "breach_metric_value": 10.25,
            "label": "Open Breaches",
            "value": 42.5
          }
        },
        {
          "name": "vendor-sla-data__sla_newsfeed",
          "widget_id": "sla_newsfeed",
          "fields": [
            "published_at",
            "sla_newsfeed_value",
            "summary",
            "title"
          ],
          "path": "/vendor-notices",
          "payload": [
            {
              "published_at": "2026-01-15T14:30:00Z",
              "sla_newsfeed_value": 10.25,
              "summary": "Fixture-backed desk update with verified data.",
              "title": "Vendor Notices update"
            }
          ]
        },
        {
          "name": "vendor-sla-data__vendor_sla_table",
          "widget_id": "vendor_sla_table",
          "fields": [
            "breach",
            "latency_ms",
            "status",
            "vendor"
          ],
          "path": "/vendor-sla",
          "payload": [
            {
              "breach": true,
              "latency_ms": 10.25,
              "status": "Primary",
              "vendor": "vendor-1"
            },
            {
              "breach": false,
              "latency_ms": 20.5,
              "status": "Review",
              "vendor": "vendor-2"
            },
            {
              "breach": true,
              "latency_ms": 30.75,
              "status": "Approved",
              "vendor": "vendor-3"
            }
          ]
        }
      ],
      "pinned_paths": false
    },
    "required_capabilities": [
      {
        "name": "capability_1_breach-metric",
        "datasets": [
          "vendor-sla-data__breach_metric"
        ],
        "widget_kind": "metric",
        "must_cover_fields": [
          "breach_metric_value"
        ],
        "required_param_kinds": [
          "text"
        ],
        "required_config": {}
      },
      {
        "name": "capability_2_vendor-sla-table",
        "datasets": [
          "vendor-sla-data__vendor_sla_table"
        ],
        "widget_kind": "table-like",
        "must_cover_fields": [
          "breach",
          "latency_ms",
          "status",
          "vendor"
        ],
        "required_param_kinds": [
          "text"
        ],
        "required_config": {}
      }
    ],
    "app_structure": {
      "required": true,
      "layout_refs_valid": true,
      "no_overlaps": true
    },
    "reference": [
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Vendor SLA Data",
          "url": "http://localhost:7804",
          "widgets_json": {
            "breach_metric": {
              "name": "Open Breaches",
              "description": "Count of open SLA breaches.",
              "endpoint": "/breach-count",
              "type": "metric",
              "gridData": {
                "w": 6,
                "h": 4
              },
              "params": [
                {
                  "paramName": "desk_view",
                  "type": "text",
                  "label": "Desk View",
                  "value": "summary",
                  "description": "Which posture view the metric shows."
                }
              ],
              "staleTime": 900000,
              "data": {
                "valueField": "breach_metric_value"
              }
            },
            "vendor_sla_table": {
              "name": "Vendor SLA Status",
              "description": "Vendor SLA state with breach flags.",
              "endpoint": "/vendor-sla",
              "type": "table",
              "gridData": {
                "w": 20,
                "h": 9
              },
              "params": [
                {
                  "paramName": "status",
                  "type": "text",
                  "label": "Status",
                  "value": "Open",
                  "options": [
                    {
                      "label": "Open",
                      "value": "Open"
                    },
                    {
                      "label": "Escalated",
                      "value": "Escalated"
                    },
                    {
                      "label": "Resolved",
                      "value": "Resolved"
                    }
                  ]
                }
              ],
              "data": {
                "table": {
                  "columnsDefs": [
                    {
                      "field": "vendor",
                      "headerName": "Vendor",
                      "cellDataType": "text"
                    },
                    {
                      "field": "status",
                      "headerName": "Status",
                      "cellDataType": "text",
                      "renderFn": "titleCase"
                    },
                    {
                      "field": "latency_ms",
                      "headerName": "Latency (ms)",
                      "cellDataType": "number"
                    },
                    {
                      "field": "breach",
                      "headerName": "Breach",
                      "cellDataType": "boolean"
                    }
                  ]
                }
              },
              "staleTime": 900000
            },
            "sla_newsfeed": {
              "name": "Vendor Notices",
              "description": "Vendor incident notices feed.",
              "endpoint": "/vendor-notices",
              "type": "newsfeed",
              "gridData": {
                "w": 12,
                "h": 10
              },
              "staleTime": 900000,
              "data": {
                "valueField": "sla_newsfeed_value"
              }
            }
          },
          "apps_json": [
            {
              "name": "Vendor Live",
              "description": "Vendors and breaches.",
              "tabs": {
                "vendors": {
                  "id": "vendors",
                  "name": "Vendors",
                  "layout": [
                    {
                      "i": "breach_metric",
                      "x": 0,
                      "y": 0,
                      "w": 20,
                      "h": 9
                    }
                  ]
                },
                "posture": {
                  "id": "posture",
                  "name": "Posture",
                  "layout": [
                    {
                      "i": "vendor_sla_table",
                      "x": 0,
                      "y": 0,
                      "w": 12,
                      "h": 6
                    }
                  ]
                }
              },
              "groups": []
            }
          ]
        }
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_001",
          "app_name": "Vendor Live",
          "dashboard_name": "Vendor Live Board",
          "activate": true
        }
      },
      {
        "tool": "update_widget",
        "args": {
          "widget_id": "breach_metric",
          "data_args": {
            "desk_view": "detail"
          }
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Vendor Live",
          "data": "Vendor Live shipped from Vendor SLA Data: vendors live. Configured desk_view=detail."
        }
      }
    ],
    "limits": {
      "max_turns": 14
    }
  }
}
