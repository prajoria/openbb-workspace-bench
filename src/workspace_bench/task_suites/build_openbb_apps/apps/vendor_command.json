{
  "id": "vendor_command",
  "category": "platform",
  "family": "apps",
  "difficulty": "medium",
  "split": "validation",
  "prompt": "Build a working Workspace experience for a vendor-operations manager covering vendor service levels. The workspace must cover vendor SLA state with breach flags. The workspace must cover count of open SLA breaches. The workspace must cover vendor incident notices feed. Analysts need to inspect vendor, status, latency milliseconds, breach. Leave the complete working workspace open for review. Keep these source-contract anchors: `status` and `vendor`. Choose the rest of the architecture and avoid unrelated changes.",
  "business_terms": [
    "status",
    "vendor"
  ],
  "fixtures": {},
  "initial_state": {
    "custom_backends": [
      {
        "name": "Vendor SLA Data",
        "url": "http://localhost:7804",
        "backend_id": "backend_001",
        "widgets_json": {
          "vendor_sla_table": {
            "name": "Vendor SLA Status",
            "description": "Vendor SLA state with breach flags.",
            "endpoint": "/vendor-sla",
            "type": "table",
            "gridData": {
              "w": 20,
              "h": 9
            },
            "params": [
              {
                "paramName": "status",
                "type": "text",
                "label": "Status",
                "value": "Open",
                "options": [
                  {
                    "label": "Open",
                    "value": "Open"
                  },
                  {
                    "label": "Escalated",
                    "value": "Escalated"
                  },
                  {
                    "label": "Resolved",
                    "value": "Resolved"
                  }
                ]
              }
            ],
            "data": {
              "table": {
                "columnsDefs": [
                  {
                    "field": "vendor",
                    "headerName": "Vendor",
                    "cellDataType": "text"
                  },
                  {
                    "field": "status",
                    "headerName": "Status",
                    "cellDataType": "text",
                    "renderFn": "titleCase"
                  },
                  {
                    "field": "latency_ms",
                    "headerName": "Latency (ms)",
                    "cellDataType": "number"
                  },
                  {
                    "field": "breach",
                    "headerName": "Breach",
                    "cellDataType": "boolean"
                  }
                ]
              }
            }
          },
          "breach_metric": {
            "name": "Open Breaches",
            "description": "Count of open SLA breaches.",
            "endpoint": "/breach-count",
            "type": "metric",
            "gridData": {
              "w": 6,
              "h": 4
            },
            "data": {
              "valueField": "breach_metric_value"
            }
          },
          "sla_newsfeed": {
            "name": "Vendor Notices",
            "description": "Vendor incident notices feed.",
            "endpoint": "/vendor-notices",
            "type": "newsfeed",
            "gridData": {
              "w": 12,
              "h": 10
            },
            "data": {
              "valueField": "sla_newsfeed_value"
            }
          }
        }
      }
    ]
  },
  "allowed_tools": [
    "get_workspace_snapshot",
    "manage_dashboard",
    "manage_navigation_bar",
    "navigate_workspace",
    "list_available_widgets",
    "get_widget_schema",
    "get_params_options",
    "get_widget_data",
    "create_widget",
    "update_widget",
    "update_widget_layout",
    "delete_widget",
    "add_generative_widget",
    "read_widget",
    "manage_backends",
    "manage_apps",
    "get_skill_content",
    "read_workspace_resource",
    "get_workspace_prompt",
    "assign_tasks_to_agents"
  ],
  "success": {
    "trace_checks": {
      "max_invalid_tool_calls": 1,
      "max_repeated_snapshots": 2
    },
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 1,
      "max_custom_backend_delta": 0
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "vendor-sla-data__breach_metric",
          "widget_id": "breach_metric",
          "fields": [
            "breach_metric_value",
            "label",
            "value"
          ],
          "path": "/breach-count",
          "payload": {
            "breach_metric_value": 10.25,
            "label": "Open Breaches",
            "value": 42.5
          }
        },
        {
          "name": "vendor-sla-data__sla_newsfeed",
          "widget_id": "sla_newsfeed",
          "fields": [
            "published_at",
            "sla_newsfeed_value",
            "summary",
            "title"
          ],
          "path": "/vendor-notices",
          "payload": [
            {
              "published_at": "2026-01-15T14:30:00Z",
              "sla_newsfeed_value": 10.25,
              "summary": "Fixture-backed desk update with verified data.",
              "title": "Vendor Notices update"
            }
          ]
        },
        {
          "name": "vendor-sla-data__vendor_sla_table",
          "widget_id": "vendor_sla_table",
          "fields": [
            "breach",
            "latency_ms",
            "status",
            "vendor"
          ],
          "path": "/vendor-sla",
          "payload": [
            {
              "breach": true,
              "latency_ms": 10.25,
              "status": "Primary",
              "vendor": "vendor-1"
            },
            {
              "breach": false,
              "latency_ms": 20.5,
              "status": "Review",
              "vendor": "vendor-2"
            },
            {
              "breach": true,
              "latency_ms": 30.75,
              "status": "Approved",
              "vendor": "vendor-3"
            }
          ]
        }
      ],
      "pinned_paths": false
    },
    "required_capabilities": [
      {
        "name": "capability_1_breach-metric",
        "datasets": [
          "vendor-sla-data__breach_metric"
        ],
        "widget_kind": "metric",
        "must_cover_fields": [
          "breach_metric_value"
        ],
        "required_param_kinds": [],
        "required_config": {}
      },
      {
        "name": "capability_2_sla-newsfeed",
        "datasets": [
          "vendor-sla-data__sla_newsfeed"
        ],
        "widget_kind": "newsfeed",
        "must_cover_fields": [
          "sla_newsfeed_value"
        ],
        "required_param_kinds": [],
        "required_config": {}
      },
      {
        "name": "capability_3_vendor-sla-table",
        "datasets": [
          "vendor-sla-data__vendor_sla_table"
        ],
        "widget_kind": "table-like",
        "must_cover_fields": [
          "breach",
          "latency_ms",
          "status",
          "vendor"
        ],
        "required_param_kinds": [
          "text"
        ],
        "required_config": {}
      }
    ],
    "app_structure": {
      "required": true,
      "layout_refs_valid": true,
      "no_overlaps": true
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_snapshot",
      "args": {}
    },
    {
      "tool": "manage_backends",
      "args": {
        "operation": "refresh",
        "backend_id": "backend_001",
        "apps_json": [
          {
            "name": "Vendor Command",
            "description": "Vendors, breaches, headlines.",
            "tabs": {
              "vendors": {
                "id": "vendors",
                "name": "Vendors",
                "layout": [
                  {
                    "i": "vendor_sla_table",
                    "x": 0,
                    "y": 0,
                    "w": 20,
                    "h": 9,
                    "state": {
                      "params": {
                        "status": "breach"
                      }
                    }
                  },
                  {
                    "i": "breach_metric",
                    "x": 20,
                    "y": 0,
                    "w": 12,
                    "h": 6
                  },
                  {
                    "i": "sla_newsfeed",
                    "x": 20,
                    "y": 6,
                    "w": 12,
                    "h": 8
                  }
                ]
              }
            },
            "groups": [],
            "prompts": [
              "Which vendors breached SLA this week?"
            ]
          }
        ]
      }
    },
    {
      "tool": "manage_apps",
      "args": {
        "operation": "instantiate",
        "backend_id": "backend_001",
        "app_name": "Vendor Command",
        "dashboard_name": "Vendor Command Live",
        "activate": true
      }
    }
  ],
  "limits": {
    "max_turns": 13
  }
}
