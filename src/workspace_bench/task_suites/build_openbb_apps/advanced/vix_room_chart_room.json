                "label": "Window",
                "value": 30,
                "min": 5,
                "max": 365
              },
              {
                "paramName": "window_days",
                "type": "number",
                "label": "Window days",
                "value": 30,
                "min": 5,
                "max": 365
              }
            ],
            "data": {
              "table": {
                "columnsDefs": [
                  {
                    "field": "date",
                    "headerName": "Date",
                    "cellDataType": "dateString"
                  },
                  {
                    "field": "close",
                    "headerName": "Close",
                    "cellDataType": "number"
                  },
                  {
                    "field": "return_pct",
                    "headerName": "Return %",
                    "cellDataType": "number",
