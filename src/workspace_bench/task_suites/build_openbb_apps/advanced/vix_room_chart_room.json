        "required_param_kinds": [
          "number"
        ],
        "required_config": {}
      },
      {
        "name": "capability_2_vix-room-chart",
        "datasets": [
          "vol-desk-data__vix_room_chart"
        ],
        "widget_kind": "chart-like",
        "must_cover_fields": [
