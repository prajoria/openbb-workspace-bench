                  "vix_room_chart",
                  "vix_history"
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "tool": "manage_apps",
      "args": {
        "operation": "instantiate",
        "backend_id": "backend_001",
        "app_name": "Vol Chart Room",
        "dashboard_name": "Vol Chart Room Live",
