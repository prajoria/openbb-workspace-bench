{
  "id": "vix_advanced_app",
  "category": "platform",
  "family": "advanced",
  "difficulty": "easy",
  "prompt": "Publish the requested app and open it in Workspace to verify it works. Use 'Vol Desk Data' at http://localhost:7801. Implement the live or advanced interaction correctly. The experience needs VIX Advanced Chart (`vix_advanced`, advanced_charting) using `/udf` for tradingView advanced charting for VIX futures; default symbol `VIX`; update frequency `60000`. Organize it as app 'Vol Advanced' with tabs Chart (vix_advanced). Choose the appropriate Workspace tools, validate the result, and avoid unrelated changes.",
  "setup": {
    "fixtures": {},
    "initial_state": {},
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_widget_defs": [
      {
        "backend_name": "Vol Desk Data",
        "widget_id": "vix_advanced",
        "expect": {
          "type": "advanced_charting",
          "endpoint": "/udf"
        },
        "params_include": [],
        "columns_include": []
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Vol Desk Data",
        "layout_refs_valid": true,
        "no_overlaps": true,
        "name_contains": "Vol Advanced",
        "tabs_include": [
          "chart"
        ],
        "tab_count": 1,
        "widgets_on_tab": [
          {
            "tab_id": "chart",
            "widget_id": "vix_advanced"
          }
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 1,
      "max_repeated_snapshots": 2
    },
    "required_dashboard_name_contains": "Vol Advanced",
    "required_widgets": [
      {
        "origin": "Vol Desk Data",
        "widget_id": "vix_advanced",
        "tab_id": "chart",
        "min_count": 1
      }
    ],
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 1,
      "max_custom_backend_delta": 1
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "vol-desk-data__vix_advanced",
          "widget_id": "vix_advanced",
          "fields": [
            "category",
            "value"
          ],
          "path": "/udf",
          "payload": [
            {
              "category": "Primary",
              "value": 10.25
            },
            {
              "category": "Review",
              "value": 20.5
            },
            {
              "category": "Approved",
              "value": 30.75
            }
          ]
        }
      ],
      "pinned_paths": false
    },
    "reference": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Vol Desk Data",
          "url": "http://localhost:7801",
          "widgets_json": {
            "vix_advanced": {
              "name": "VIX Advanced Chart",
              "description": "TradingView advanced charting for VIX futures.",
              "endpoint": "/udf",
              "type": "advanced_charting",
              "gridData": {
                "w": 20,
                "h": 20
              },
              "data": {
                "defaultSymbol": "VIX",
                "updateFrequency": 60000
              }
            }
          },
          "apps_json": [
            {
              "name": "Vol Advanced",
              "description": "TradingView VIX view.",
              "tabs": {
                "chart": {
                  "id": "chart",
                  "name": "Chart",
                  "layout": [
                    {
                      "i": "vix_advanced",
                      "x": 0,
                      "y": 0,
                      "w": 20,
                      "h": 20
                    }
                  ]
                }
              },
              "groups": []
            }
          ]
        }
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_001",
          "app_name": "Vol Advanced",
          "dashboard_name": "Vol Advanced Live",
          "activate": true
        }
      }
    ],
    "limits": {
      "max_turns": 6
    }
  }
}
