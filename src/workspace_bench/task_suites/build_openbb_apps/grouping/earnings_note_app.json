{
  "id": "earnings_note_app",
  "title": "Ship Earnings Preview with a grouping app",
  "workflow": "earnings-prep",
  "subdomain": "equity-research",
  "tags": [
    "family-grouping",
    "cell3",
    "build-openbb-apps",
    "widgets-json",
    "apps-json",
    "grouping"
  ],
  "prompt": "Build a working Workspace experience for an equity-research analyst covering earnings and estimates. The workspace must cover preview note for the earnings call. An analyst can filter the analysis by ticker. Leave the complete working workspace open for review. Keep these source-contract anchors: `symbol`. Choose the rest of the architecture and avoid unrelated changes.",
  "fixtures": {},
  "initial_state": {},
  "allowed_tools": [
    "get_workspace_snapshot",
    "manage_dashboard",
    "manage_navigation_bar",
    "navigate_workspace",
    "list_available_widgets",
    "get_widget_schema",
    "get_params_options",
    "get_widget_data",
    "create_widget",
    "update_widget",
    "update_widget_layout",
    "delete_widget",
    "add_generative_widget",
    "read_widget",
    "manage_backends",
    "manage_apps",
    "get_skill_content",
    "read_workspace_resource",
    "get_workspace_prompt",
    "assign_tasks_to_agents"
  ],
  "success": {
    "trace_checks": {
      "max_invalid_tool_calls": 1,
      "max_repeated_snapshots": 2
    },
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 1,
      "max_custom_backend_delta": 1
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "earnings-prep-data__earnings_note",
          "widget_id": "earnings_note",
          "fields": [
            "earnings_note_value"
          ],
          "path": "/earnings-preview",
          "payload": "Earnings Preview fixture-backed runtime summary."
        }
      ],
      "pinned_paths": false
    },
    "required_capabilities": [
      {
        "name": "capability_1_earnings-note",
        "datasets": [
          "earnings-prep-data__earnings_note"
        ],
        "widget_kind": "markdown",
        "must_cover_fields": [
          "earnings_note_value"
        ],
        "required_param_kinds": [
          "ticker"
        ],
        "required_config": {}
      }
    ],
    "app_structure": {
      "required": true,
      "layout_refs_valid": true,
      "no_overlaps": true
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_snapshot",
      "args": {}
    },
    {
      "tool": "manage_backends",
      "args": {
        "operation": "add",
        "name": "Earnings Prep Data",
        "url": "http://localhost:7805",
        "widgets_json": {
          "earnings_note": {
            "name": "Earnings Preview",
            "description": "Preview note for the earnings call.",
            "endpoint": "/earnings-preview",
            "type": "markdown",
            "gridData": {
              "w": 12,
              "h": 8
            },
            "params": [
              {
                "paramName": "symbol",
                "type": "endpoint",
                "label": "Symbol",
                "value": "AAPL",
                "optionsEndpoint": "/symbols"
              }
            ],
            "data": {
              "valueField": "earnings_note_value"
            }
          }
        },
        "apps_json": [
          {
            "name": "Preview Group App",
            "description": "Grouped earnings preview by symbol.",
            "tabs": {
              "preview": {
                "id": "preview",
                "name": "Preview",
                "layout": [
                  {
                    "i": "earnings_note",
                    "x": 0,
                    "y": 0,
                    "w": 20,
                    "h": 9
                  }
                ]
              }
            },
            "groups": [
              {
                "name": "Preview Symbol Group",
                "type": "param",
                "paramName": "symbol",
                "widgetIds": [
                  "earnings_note"
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "tool": "manage_apps",
      "args": {
        "operation": "instantiate",
        "backend_id": "backend_001",
        "app_name": "Preview Group App",
        "dashboard_name": "Preview Group App Live",
        "activate": true
      }
    }
  ],
  "domain": "finance",
  "source": "workspace-bench-build-apps-gen",
  "schema_version": "workspace-bench-task",
  "category": "platform",
  "family": "grouping",
  "capability": "widget-building",
  "specification_level": "partially-specified",
  "difficulty": "hard",
  "business_terms": [
    "symbol"
  ],
  "limits": {
    "max_turns": 6
  },
  "split": "train",
  "novelty": "Unique grouping/earnings_note_app building exercise using get_workspace_snapshot, manage_apps, manage_backends with checks capability, repeated_snapshots, too_many_invalid_calls on custom:Earnings Prep Data; artifact capabilities:capability_1_earnings-note:markdown:earnings_note_value."
}
