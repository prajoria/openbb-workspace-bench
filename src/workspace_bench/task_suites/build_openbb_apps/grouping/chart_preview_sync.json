{
  "id": "chart_preview_sync",
  "category": "platform",
  "family": "grouping",
  "specification_level": "partially-specified",
  "difficulty": "hard",
  "prompt": "Build a working Workspace experience for an equity-research analyst covering earnings and estimates. The workspace must cover EPS beat and miss history. The workspace must cover preview note for the earnings call. An analyst can filter the analysis by ticker. A selection in one part of the analysis stays linked to related results. Leave the complete working workspace open for review. Keep these source-contract anchors: `symbol`. Choose the rest of the architecture and avoid unrelated changes.",
  "business_terms": [
    "symbol"
  ],
  "setup": {
    "fixtures": {},
    "initial_state": {
      "custom_backends": [
        {
          "name": "Earnings Prep Data",
          "url": "http://localhost:7805",
          "backend_id": "backend_001",
          "widgets_json": {
            "earnings_chart": {
              "name": "EPS History",
              "description": "Plotly EPS beat/miss history.",
              "endpoint": "/eps-history",
              "type": "chart",
              "gridData": {
                "w": 20,
                "h": 9
              },
              "params": [
                {
                  "paramName": "symbol",
                  "type": "endpoint",
                  "label": "Symbol",
                  "value": "AAPL",
                  "optionsEndpoint": "/symbols"
                }
              ],
              "raw": true
            },
            "earnings_note": {
              "name": "Earnings Preview",
              "description": "Preview note for the earnings call.",
              "endpoint": "/earnings-preview",
              "type": "markdown",
              "gridData": {
                "w": 12,
                "h": 8
              },
              "params": [
                {
                  "paramName": "symbol",
                  "type": "endpoint",
                  "label": "Symbol",
                  "value": "AAPL",
                  "optionsEndpoint": "/symbols"
                }
              ]
            }
          }
        }
      ]
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "trace_checks": {
      "max_invalid_tool_calls": 1,
      "max_repeated_snapshots": 2
    },
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 1,
      "max_custom_backend_delta": 0
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "earnings-prep-data__earnings_chart",
          "widget_id": "earnings_chart",
          "fields": [
            "earnings_chart_value"
          ],
          "path": "/eps-history",
          "payload": [
            {
              "earnings_chart_value": 10.25
            },
            {
              "earnings_chart_value": 20.5
            },
            {
              "earnings_chart_value": 30.75
            }
          ]
        },
        {
          "name": "earnings-prep-data__earnings_note",
          "widget_id": "earnings_note",
          "fields": [
            "earnings_note_value"
          ],
          "path": "/earnings-preview",
          "payload": "Earnings Preview fixture-backed runtime summary."
        }
      ],
      "pinned_paths": false
    },
    "required_capabilities": [
      {
        "name": "capability_1_earnings-chart",
        "datasets": [
          "earnings-prep-data__earnings_chart"
        ],
        "widget_kind": "chart-like",
        "must_cover_fields": [
          "earnings_chart_value"
        ],
        "required_param_kinds": [
          "ticker"
        ],
        "required_config": {}
      },
      {
        "name": "capability_2_earnings-note",
        "datasets": [
          "earnings-prep-data__earnings_note"
        ],
        "widget_kind": "markdown",
        "must_cover_fields": [
          "earnings_note_value"
        ],
        "required_param_kinds": [
          "ticker"
        ],
        "required_config": {}
      }
    ],
    "capability_connections": [
      {
        "source": "capability_1_earnings-chart",
        "target": "capability_2_earnings-note",
        "param_kind": "ticker"
      }
    ],
    "app_structure": {
      "required": true,
      "layout_refs_valid": true,
      "no_overlaps": true
    },
    "reference": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "refresh",
          "backend_id": "backend_001",
          "widgets_json": {
            "earnings_chart": {
              "name": "EPS History",
              "description": "Plotly EPS beat/miss history.",
              "endpoint": "/eps-history",
              "type": "chart",
              "gridData": {
                "w": 20,
                "h": 9
              },
              "params": [
                {
                  "paramName": "symbol",
                  "type": "endpoint",
                  "label": "Symbol",
                  "value": "AAPL",
                  "optionsEndpoint": "/symbols"
                }
              ],
              "raw": true,
              "staleTime": 900000,
              "data": {
                "valueField": "earnings_chart_value"
              }
            },
            "earnings_note": {
              "name": "Earnings Preview",
              "description": "Preview note for the earnings call.",
              "endpoint": "/earnings-preview",
              "type": "markdown",
              "gridData": {
                "w": 12,
                "h": 8
              },
              "params": [
                {
                  "paramName": "symbol",
                  "type": "endpoint",
                  "label": "Symbol",
                  "value": "AAPL",
                  "optionsEndpoint": "/symbols"
                }
              ],
              "data": {
                "valueField": "earnings_note_value"
              }
            }
          },
          "apps_json": [
            {
              "name": "Chart Preview Sync",
              "description": "Preset chart and preview note.",
              "tabs": {
                "chart": {
                  "id": "chart",
                  "name": "Chart",
                  "layout": [
                    {
                      "i": "earnings_chart",
                      "x": 0,
                      "y": 0,
                      "w": 20,
                      "h": 9,
                      "state": {
                        "params": {
                          "symbol": "AAPL"
                        }
                      }
                    },
                    {
                      "i": "earnings_note",
                      "x": 20,
                      "y": 0,
                      "w": 12,
                      "h": 9
                    }
                  ]
                }
              },
              "groups": [
                {
                  "name": "Chart Symbol Sync",
                  "type": "param",
                  "paramName": "symbol",
                  "widgetIds": [
                    "earnings_chart",
                    "earnings_note"
                  ]
                }
              ],
              "prompts": [
                "Compare the chart and preview for the synced symbol."
              ]
            }
          ]
        }
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_001",
          "app_name": "Chart Preview Sync",
          "dashboard_name": "Chart Preview Sync Live",
          "activate": true
        }
      }
    ],
    "limits": {
      "max_turns": 13
    }
  }
}
