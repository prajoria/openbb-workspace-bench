{
  "id": "click_sync_live",
  "category": "platform",
  "family": "grouping",
  "difficulty": "hard",
  "split": "train",
  "prompt": "Build an equity-research analyst a dependable earnings and estimates workspace. The workspace must cover clickable live symbol rows for grouped review. The workspace must cover EPS beat and miss history. The workspace must cover preview HTML card for the earnings call. Analysts need to inspect symbol, revision percentage. An analyst can filter the analysis by ticker. A selection in one part of the analysis stays linked to related results. Leave the complete working workspace open for review. Add a short completion HTML card that naturally includes the desk-required terms 'Click Sync Live', 'click sync', 'Earnings Prep Data', 'AAPL', 'ticker'. Decide how best to organize the experience and preserve unrelated work.",
  "business_terms": [
    "Click Sync Live",
    "click sync",
    "Earnings Prep Data",
    "AAPL",
    "ticker"
  ],
  "fixtures": {},
  "initial_state": {},
  "allowed_tools": [
    "get_workspace_snapshot",
    "manage_dashboard",
    "manage_navigation_bar",
    "navigate_workspace",
    "list_available_widgets",
    "get_widget_schema",
    "get_params_options",
    "get_widget_data",
    "create_widget",
    "update_widget",
    "update_widget_layout",
    "delete_widget",
    "add_generative_widget",
    "read_widget",
    "manage_backends",
    "manage_apps",
    "get_skill_content",
    "read_workspace_resource",
    "get_workspace_prompt",
    "assign_tasks_to_agents"
  ],
  "success": {
    "required_generated_widgets": [
      {
        "widget_type": "html",
        "data_contains": [
          "Click Sync Live",
          "click sync",
          "Earnings Prep Data",
          "AAPL"
        ],
        "min_count": 1
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 2,
      "max_repeated_snapshots": 2
    },
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 1,
      "max_custom_backend_delta": 1
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "earnings-prep-data__click_live_table",
          "widget_id": "click_live_table",
          "fields": [
            "revision_pct",
            "symbol"
          ],
          "path": "/click-live-table",
          "payload": [
            {
              "revision_pct": 10.25,
              "symbol": "AAPL"
            },
            {
              "revision_pct": 20.5,
              "symbol": "MSFT"
            },
            {
              "revision_pct": 30.75,
              "symbol": "NVDA"
            }
          ]
        },
        {
          "name": "earnings-prep-data__earnings_chart",
          "widget_id": "earnings_chart",
          "fields": [
            "earnings_chart_value"
          ],
          "path": "/eps-history",
          "payload": [
            {
              "earnings_chart_value": 10.25
            },
            {
              "earnings_chart_value": 20.5
            },
            {
              "earnings_chart_value": 30.75
            }
          ]
        },
        {
          "name": "earnings-prep-data__earnings_note",
          "widget_id": "earnings_note",
          "fields": [
            "earnings_note_value"
          ],
          "path": "/earnings-preview",
          "payload": "Earnings Preview fixture-backed runtime summary."
        }
      ],
      "pinned_paths": false
    },
    "required_capabilities": [
      {
        "name": "capability_1_click-live-table",
        "datasets": [
          "earnings-prep-data__click_live_table"
        ],
        "widget_kind": "table-like",
        "must_cover_fields": [
          "revision_pct",
          "symbol"
        ],
        "required_param_kinds": [
          "ticker"
        ],
        "required_config": {}
      },
      {
        "name": "capability_2_earnings-chart",
        "datasets": [
          "earnings-prep-data__earnings_chart"
        ],
        "widget_kind": "chart-like",
        "must_cover_fields": [
          "earnings_chart_value"
        ],
        "required_param_kinds": [
          "ticker"
        ],
        "required_config": {}
      }
    ],
    "capability_connections": [
      {
        "source": "capability_1_click-live-table",
        "target": "capability_2_earnings-chart",
        "param_kind": "ticker"
      }
    ],
    "app_structure": {
      "required": true,
      "layout_refs_valid": true,
      "no_overlaps": true
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "manage_backends",
      "args": {
        "operation": "add",
        "name": "Earnings Prep Data",
        "url": "http://localhost:7805",
        "widgets_json": {
          "click_live_table": {
            "name": "Click Live Table",
            "description": "Clickable live symbol rows for grouped review.",
            "endpoint": "/click-live-table",
