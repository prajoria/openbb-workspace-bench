            "params": [
              {
                "paramName": "symbol",
                "type": "endpoint",
                "label": "Symbol",
                "value": "AAPL",
                "optionsEndpoint": "/symbols"
              }
            ],
            "data": {
              "table": {
                "columnsDefs": [
                  {
                    "field": "symbol",
                    "headerName": "Symbol",
                    "cellDataType": "text",
                    "renderFn": "cellOnClick",
                    "renderFnParams": {
                      "actionType": "groupBy",
                      "groupByParamName": "symbol"
                    },
                    "cellOnClick": {
                      "actionType": "groupBy",
                      "groupByParamName": "symbol"
                    }
                  },
                  {
                    "field": "revision_pct",
                    "headerName": "Revision %",
                    "cellDataType": "number",
                    "formatterFn": "percent"
                  }
                ]
              }
            },
            "gridData": {
              "w": 20,
              "h": 9
            }
          },
          "earnings_chart": {
            "name": "EPS History",
            "description": "Plotly EPS beat/miss history.",
            "endpoint": "/eps-history",
            "type": "chart",
            "gridData": {
              "w": 20,
              "h": 9
            },
            "params": [
              {
                "paramName": "symbol",
                "type": "endpoint",
                "label": "Symbol",
                "value": "AAPL",
                "optionsEndpoint": "/symbols"
              }
            ],
            "raw": true,
            "data": {
              "valueField": "earnings_chart_value"
            }
          },
          "earnings_note": {
            "name": "Earnings Preview",
            "description": "Preview note for the earnings call.",
            "endpoint": "/earnings-preview",
            "type": "markdown",
            "gridData": {
              "w": 12,
              "h": 8
            },
            "params": [
              {
                "paramName": "symbol",
                "type": "endpoint",
                "label": "Symbol",
                "value": "AAPL",
                "optionsEndpoint": "/symbols"
              }
            ],
            "data": {
              "valueField": "earnings_note_value"
            }
          }
        },
        "apps_json": [
          {
            "name": "Click Sync Live",
            "description": "Live grouped click table and chart.",
            "tabs": {
              "clicks": {
                "id": "clicks",
                "name": "Clicks",
                "layout": [
                  {
                    "i": "click_live_table",
                    "x": 0,
                    "y": 0,
                    "w": 20,
                    "h": 9,
                    "state": {
                      "params": {
                        "symbol": "NVDA"
                      }
                    }
                  }
                ]
              },
              "linked": {
                "id": "linked",
                "name": "Linked",
                "layout": [
                  {
                    "i": "earnings_chart",
                    "x": 0,
                    "y": 0,
                    "w": 12,
                    "h": 9
                  }
                ]
              }
            },
            "groups": [
              {
                "name": "Click Live Sync",
                "type": "param",
                "paramName": "symbol",
                "widgetIds": [
                  "click_live_table",
                  "earnings_chart"
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "tool": "manage_apps",
      "args": {
        "operation": "instantiate",
        "backend_id": "backend_001",
        "app_name": "Click Sync Live",
        "dashboard_name": "Click Sync Live Board",
        "activate": true
      }
    },
    {
      "tool": "update_widget",
      "args": {
        "widget_id": "click_live_table",
        "data_args": {
          "symbol": "AAPL"
        }
      }
    },
    {
      "tool": "add_generative_widget",
      "args": {
        "widget_type": "html",
        "name": "Click Sync Live",
        "data": "<section>Click Sync Live is live from Earnings Prep Data: click sync ready. Configured symbol=AAPL.</section>"
      }
