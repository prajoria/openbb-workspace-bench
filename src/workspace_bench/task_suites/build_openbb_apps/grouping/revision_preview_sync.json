{
  "id": "revision_preview_sync",
  "category": "platform",
  "family": "grouping",
  "specification_level": "partially-specified",
  "difficulty": "hard",
  "prompt": "Build a working Workspace experience for an equity-research analyst covering earnings and estimates. The workspace must cover street estimate revisions by quarter. The workspace must cover preview note for the earnings call. Analysts need to inspect quarter, EPS estimate, revenue estimate billions. An analyst can filter the analysis by ticker. A selection in one part of the analysis stays linked to related results. Leave the complete working workspace open for review. Keep these source-contract anchors: `symbol` and `quarter`. Choose the rest of the architecture and avoid unrelated changes.",
  "business_terms": [
    "symbol",
    "quarter"
  ],
  "setup": {
    "fixtures": {},
    "initial_state": {
      "custom_backends": [
        {
          "name": "Earnings Prep Data",
          "url": "http://localhost:7805",
          "backend_id": "backend_001",
          "widgets_json": {
            "estimate_revisions": {
              "name": "Estimate Revisions",
              "description": "Street estimate revisions by quarter.",
              "endpoint": "/estimate-revisions",
              "type": "table",
              "gridData": {
                "w": 20,
                "h": 9
              },
              "params": [
                {
                  "paramName": "symbol",
                  "type": "endpoint",
                  "label": "Symbol",
                  "value": "AAPL",
                  "optionsEndpoint": "/symbols"
                }
              ],
              "data": {
                "table": {
                  "columnsDefs": [
                    {
                      "field": "quarter",
                      "headerName": "Quarter",
                      "cellDataType": "text"
                    },
                    {
                      "field": "eps_estimate",
                      "headerName": "EPS Est",
                      "cellDataType": "number"
                    },
                    {
                      "field": "revenue_estimate_b",
                      "headerName": "Revenue Est ($B)",
                      "cellDataType": "number"
                    }
                  ]
                }
              }
            },
            "earnings_note": {
              "name": "Earnings Preview",
              "description": "Preview note for the earnings call.",
              "endpoint": "/earnings-preview",
              "type": "markdown",
              "gridData": {
                "w": 12,
                "h": 8
              },
              "params": [
                {
                  "paramName": "symbol",
                  "type": "endpoint",
                  "label": "Symbol",
                  "value": "AAPL",
                  "optionsEndpoint": "/symbols"
                }
              ]
            }
          }
        }
      ]
    },
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "trace_checks": {
      "max_invalid_tool_calls": 1,
      "max_repeated_snapshots": 2
    },
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 1,
      "max_custom_backend_delta": 0
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "earnings-prep-data__earnings_note",
          "widget_id": "earnings_note",
          "fields": [
            "earnings_note_value"
          ],
          "path": "/earnings-preview",
          "payload": "Earnings Preview fixture-backed runtime summary."
        },
        {
          "name": "earnings-prep-data__estimate_revisions",
          "widget_id": "estimate_revisions",
          "fields": [
            "eps_estimate",
            "quarter",
            "revenue_estimate_b"
          ],
          "path": "/estimate-revisions",
          "payload": [
            {
              "eps_estimate": 10.25,
              "quarter": "quarter-1",
              "revenue_estimate_b": 10.25
            },
            {
              "eps_estimate": 20.5,
              "quarter": "quarter-2",
              "revenue_estimate_b": 20.5
            },
            {
              "eps_estimate": 30.75,
              "quarter": "quarter-3",
              "revenue_estimate_b": 30.75
            }
          ]
        }
      ],
      "pinned_paths": false
    },
    "required_capabilities": [
      {
        "name": "capability_1_earnings-note",
        "datasets": [
          "earnings-prep-data__earnings_note"
        ],
        "widget_kind": "markdown",
        "must_cover_fields": [
          "earnings_note_value"
        ],
        "required_param_kinds": [
          "ticker"
        ],
        "required_config": {}
      },
      {
        "name": "capability_2_estimate-revisions",
        "datasets": [
          "earnings-prep-data__estimate_revisions"
        ],
        "widget_kind": "table-like",
        "must_cover_fields": [
          "eps_estimate",
          "quarter",
          "revenue_estimate_b"
        ],
        "required_param_kinds": [
          "ticker"
        ],
        "required_config": {}
      }
    ],
    "capability_connections": [
      {
        "source": "capability_2_estimate-revisions",
        "target": "capability_1_earnings-note",
        "param_kind": "ticker"
      }
    ],
    "app_structure": {
      "required": true,
      "layout_refs_valid": true,
      "no_overlaps": true
    },
    "reference": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "refresh",
          "backend_id": "backend_001",
          "widgets_json": {
            "estimate_revisions": {
              "name": "Estimate Revisions",
              "description": "Street estimate revisions by quarter.",
              "endpoint": "/estimate-revisions",
              "type": "table",
              "gridData": {
                "w": 20,
                "h": 9
              },
              "params": [
                {
                  "paramName": "symbol",
                  "type": "endpoint",
                  "label": "Symbol",
                  "value": "AAPL",
                  "optionsEndpoint": "/symbols"
                }
              ],
              "data": {
                "table": {
                  "columnsDefs": [
                    {
                      "field": "quarter",
                      "headerName": "Quarter",
                      "cellDataType": "text"
                    },
                    {
                      "field": "eps_estimate",
                      "headerName": "EPS Est",
                      "cellDataType": "number"
                    },
                    {
                      "field": "revenue_estimate_b",
                      "headerName": "Revenue Est ($B)",
                      "cellDataType": "number"
                    }
                  ]
                }
              },
              "staleTime": 900000
            },
            "earnings_note": {
              "name": "Earnings Preview",
              "description": "Preview note for the earnings call.",
              "endpoint": "/earnings-preview",
              "type": "markdown",
              "gridData": {
                "w": 12,
                "h": 8
              },
              "params": [
                {
                  "paramName": "symbol",
                  "type": "endpoint",
                  "label": "Symbol",
                  "value": "AAPL",
                  "optionsEndpoint": "/symbols"
                }
              ],
              "data": {
                "valueField": "earnings_note_value"
              }
            }
          },
          "apps_json": [
            {
              "name": "Revision Preview Sync",
              "description": "Preset preview note with synced revisions.",
              "tabs": {
                "preview": {
                  "id": "preview",
                  "name": "Preview",
                  "layout": [
                    {
                      "i": "estimate_revisions",
                      "x": 0,
                      "y": 0,
                      "w": 20,
                      "h": 9
                    },
                    {
                      "i": "earnings_note",
                      "x": 20,
                      "y": 0,
                      "w": 12,
                      "h": 9,
                      "state": {
                        "params": {
                          "symbol": "MSFT"
                        }
                      }
                    }
                  ]
                }
              },
              "groups": [
                {
                  "name": "Preview Symbol Sync",
                  "type": "param",
                  "paramName": "symbol",
                  "widgetIds": [
                    "estimate_revisions",
                    "earnings_note"
                  ]
                }
              ],
              "prompts": [
                "Draft a preview note for the synced symbol."
              ]
            }
          ]
        }
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_001",
          "app_name": "Revision Preview Sync",
          "dashboard_name": "Revision Preview Sync Live",
          "activate": true
        }
      }
    ],
    "limits": {
      "max_turns": 13
    }
  }
}
