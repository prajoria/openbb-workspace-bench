        {
          "name": "earnings-prep-data__earnings_chart",
          "widget_id": "earnings_chart",
          "fields": [
            "category",
            "value"
          ],
          "path": "/eps-history",
          "payload": [
            {
              "category": "Primary",
              "value": 10.25
            },
            {
              "category": "Review",
              "value": 20.5
            },
            {
              "category": "Approved",
              "value": 30.75
            }
          ]
        }
      ],
      "pinned_paths": false
    }
  },
  "oracle_tool_calls": [
