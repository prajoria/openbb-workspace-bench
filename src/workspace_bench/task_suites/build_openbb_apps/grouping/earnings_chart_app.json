{
  "id": "earnings_chart_app",
  "category": "platform",
  "family": "grouping",
  "specification_level": "explicit",
  "difficulty": "hard",
  "prompt": "Publish the requested app and open it in Workspace to verify it works. Use 'Earnings Prep Data' at http://localhost:7805. Make the cross-widget interaction work. The experience needs EPS History (`earnings_chart`, chart) using `/eps-history` for plotly EPS beat/miss history; user controls: Symbol (`symbol`, endpoint) from `/symbols`; consume the raw backend payload. Organize it as app 'Chart Group App' with tabs Chart (earnings_chart) with shared interactions Chart Symbol Group across earnings_chart via `symbol`. Choose the appropriate Workspace tools, validate the result, and avoid unrelated changes.",
  "fixtures": {},
  "initial_state": {},
  "allowed_tools": [
    "get_workspace_snapshot",
    "manage_dashboard",
    "manage_navigation_bar",
    "navigate_workspace",
    "list_available_widgets",
    "get_widget_schema",
    "get_params_options",
    "get_widget_data",
    "create_widget",
    "update_widget",
    "update_widget_layout",
    "delete_widget",
    "add_generative_widget",
    "read_widget",
    "manage_backends",
    "manage_apps",
    "get_skill_content",
    "read_workspace_resource",
    "get_workspace_prompt",
    "assign_tasks_to_agents"
  ],
  "success": {
    "required_widget_defs": [
      {
        "backend_name": "Earnings Prep Data",
        "widget_id": "earnings_chart",
        "expect": {
          "type": "chart",
          "endpoint": "/eps-history"
        },
        "params_include": [
          {
            "paramName": "symbol",
            "type": "endpoint",
            "optionsEndpoint": "/symbols"
          }
        ],
        "columns_include": []
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Earnings Prep Data",
        "layout_refs_valid": true,
        "no_overlaps": true,
        "name_contains": "Chart Group App",
        "tabs_include": [
          "chart"
        ],
        "tab_count": 1,
        "widgets_on_tab": [
          {
            "tab_id": "chart",
            "widget_id": "earnings_chart"
          }
        ],
        "groups_include": [
          {
            "name": "Chart Symbol Group",
            "type": "param",
            "paramName": "symbol",
            "widgetIds_include": [
              "earnings_chart"
            ]
          }
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 1,
      "max_repeated_snapshots": 2
    },
    "required_dashboard_name_contains": "Chart Group App",
    "required_widgets": [
      {
        "origin": "Earnings Prep Data",
        "widget_id": "earnings_chart",
        "tab_id": "chart",
        "min_count": 1
      }
    ],
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 1,
      "max_custom_backend_delta": 1
    },
    "runtime_checks": {
