{
  "id": "estimate_revisions_app",
  "category": "platform",
  "family": "grouping",
  "specification_level": "explicit",
  "difficulty": "hard",
  "prompt": "Implement the requested app and confirm it by opening it in Workspace. Use 'Earnings Prep Data' at http://localhost:7805. Make the cross-widget interaction work. The experience needs Estimate Revisions (`estimate_revisions`, table) using `/estimate-revisions` for street estimate revisions by quarter; user controls: Symbol (`symbol`, endpoint) from `/symbols`; columns: quarter (text), eps_estimate (number), revenue_estimate_b (number). Organize it as app 'Revision Group App' with tabs Revisions (estimate_revisions) with shared interactions Revision Symbol Group across estimate_revisions via `symbol`. Choose the appropriate Workspace tools, validate the result, and avoid unrelated changes.",
  "setup": {
    "fixtures": {},
    "initial_state": {},
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_widget_defs": [
      {
        "backend_name": "Earnings Prep Data",
        "widget_id": "estimate_revisions",
        "expect": {
          "type": "table",
          "endpoint": "/estimate-revisions"
        },
        "params_include": [
          {
            "paramName": "symbol",
            "type": "endpoint",
            "optionsEndpoint": "/symbols"
          }
        ],
        "columns_include": [
          {
            "field": "quarter",
            "cellDataType": "text"
          },
          {
            "field": "eps_estimate",
            "cellDataType": "number"
          },
          {
            "field": "revenue_estimate_b",
            "cellDataType": "number"
          }
        ]
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Earnings Prep Data",
        "layout_refs_valid": true,
        "no_overlaps": true,
        "name_contains": "Revision Group App",
        "tabs_include": [
          "revisions"
        ],
        "tab_count": 1,
        "widgets_on_tab": [
          {
            "tab_id": "revisions",
            "widget_id": "estimate_revisions"
          }
        ],
        "groups_include": [
          {
            "name": "Revision Symbol Group",
            "type": "param",
            "paramName": "symbol",
            "widgetIds_include": [
              "estimate_revisions"
            ]
          }
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 1,
      "max_repeated_snapshots": 2
    },
    "required_dashboard_name_contains": "Revision Group App",
    "required_widgets": [
      {
        "origin": "Earnings Prep Data",
        "widget_id": "estimate_revisions",
        "tab_id": "revisions",
        "min_count": 1
      }
    ],
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 1,
      "max_custom_backend_delta": 1
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "earnings-prep-data__estimate_revisions",
          "widget_id": "estimate_revisions",
          "fields": [
            "eps_estimate",
            "quarter",
            "revenue_estimate_b"
          ],
          "path": "/estimate-revisions",
          "payload": [
            {
              "eps_estimate": 10.25,
              "quarter": "quarter-1",
              "revenue_estimate_b": 10.25
            },
            {
              "eps_estimate": 20.5,
              "quarter": "quarter-2",
              "revenue_estimate_b": 20.5
            },
            {
              "eps_estimate": 30.75,
              "quarter": "quarter-3",
              "revenue_estimate_b": 30.75
            }
          ]
        }
      ],
      "pinned_paths": false
    },
    "reference": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Earnings Prep Data",
          "url": "http://localhost:7805",
          "widgets_json": {
            "estimate_revisions": {
              "name": "Estimate Revisions",
              "description": "Street estimate revisions by quarter.",
              "endpoint": "/estimate-revisions",
              "type": "table",
              "gridData": {
                "w": 20,
                "h": 9
              },
              "params": [
                {
                  "paramName": "symbol",
                  "type": "endpoint",
                  "label": "Symbol",
                  "value": "AAPL",
                  "optionsEndpoint": "/symbols"
                }
              ],
              "data": {
                "table": {
                  "columnsDefs": [
                    {
                      "field": "quarter",
                      "headerName": "Quarter",
                      "cellDataType": "text"
                    },
                    {
                      "field": "eps_estimate",
                      "headerName": "EPS Est",
                      "cellDataType": "number"
                    },
                    {
                      "field": "revenue_estimate_b",
                      "headerName": "Revenue Est ($B)",
                      "cellDataType": "number"
                    }
                  ]
                }
              }
            }
          },
          "apps_json": [
            {
              "name": "Revision Group App",
              "description": "Grouped revisions by symbol.",
              "tabs": {
                "revisions": {
                  "id": "revisions",
                  "name": "Revisions",
                  "layout": [
                    {
                      "i": "estimate_revisions",
                      "x": 0,
                      "y": 0,
                      "w": 20,
                      "h": 9
                    }
                  ]
                }
              },
              "groups": [
                {
                  "name": "Revision Symbol Group",
                  "type": "param",
                  "paramName": "symbol",
                  "widgetIds": [
                    "estimate_revisions"
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_001",
          "app_name": "Revision Group App",
          "dashboard_name": "Revision Group App Live",
          "activate": true
        }
      }
    ],
    "limits": {
      "max_turns": 6
    }
  }
}
