{
  "id": "chart_note_board",
  "category": "platform",
  "family": "grouping",
  "specification_level": "explicit",
  "difficulty": "medium",
  "prompt": "Build the specified app, publish it, and leave a working instance open. Use 'Earnings Prep Data' at http://localhost:7805. Make the cross-widget interaction work. The experience needs EPS History (`earnings_chart`, chart) using `/eps-history` for plotly EPS beat/miss history; user controls: Symbol (`symbol`, endpoint) from `/symbols`; consume the raw backend payload; Earnings Preview (`earnings_note`, markdown) using `/earnings-preview` for preview note for the earnings call; user controls: Symbol (`symbol`, endpoint) from `/symbols`. Organize it as app 'Chart Note Board' with tabs Preview (earnings_chart, earnings_note) with shared interactions Preview Symbol Sync across earnings_chart, earnings_note via `symbol`. Choose the appropriate Workspace tools, validate the result, and avoid unrelated changes.",
  "fixtures": {},
  "initial_state": {
    "custom_backends": [
      {
        "name": "Earnings Prep Data",
        "url": "http://localhost:7805",
        "backend_id": "backend_001",
        "widgets_json": {
          "earnings_chart": {
            "name": "EPS History",
            "description": "Plotly EPS beat/miss history.",
            "endpoint": "/eps-history",
            "type": "chart",
            "gridData": {
              "w": 20,
              "h": 9
            },
            "params": [
              {
                "paramName": "symbol",
                "type": "endpoint",
                "label": "Symbol",
                "value": "AAPL",
                "optionsEndpoint": "/symbols"
              }
            ],
            "raw": true
          },
          "earnings_note": {
            "name": "Earnings Preview",
            "description": "Preview note for the earnings call.",
            "endpoint": "/earnings-preview",
            "type": "markdown",
            "gridData": {
              "w": 12,
              "h": 8
            },
            "params": [
              {
                "paramName": "symbol",
                "type": "endpoint",
                "label": "Symbol",
                "value": "AAPL",
                "optionsEndpoint": "/symbols"
              }
            ]
          }
        }
      }
    ]
  },
  "allowed_tools": [
    "get_workspace_snapshot",
    "manage_dashboard",
    "manage_navigation_bar",
    "navigate_workspace",
    "list_available_widgets",
    "get_widget_schema",
    "get_params_options",
    "get_widget_data",
    "create_widget",
    "update_widget",
    "update_widget_layout",
    "delete_widget",
    "add_generative_widget",
    "read_widget",
    "manage_backends",
    "manage_apps",
    "get_skill_content",
    "read_workspace_resource",
    "get_workspace_prompt",
    "assign_tasks_to_agents"
  ],
  "success": {
    "required_app_defs": [
      {
        "backend_name": "Earnings Prep Data",
        "layout_refs_valid": true,
        "no_overlaps": true,
        "name_contains": "Chart Note Board",
        "tabs_include": [
          "preview"
        ],
        "tab_count": 1,
        "widgets_on_tab": [
          {
            "tab_id": "preview",
            "widget_id": "earnings_chart"
          },
          {
            "tab_id": "preview",
            "widget_id": "earnings_note"
          }
        ],
        "groups_include": [
          {
            "name": "Preview Symbol Sync",
            "type": "param",
            "paramName": "symbol",
            "widgetIds_include": [
              "earnings_chart",
              "earnings_note"
            ]
          }
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 1,
      "max_repeated_snapshots": 2
    },
    "required_dashboard_name_contains": "Chart Note Board",
    "required_widgets": [
      {
        "origin": "Earnings Prep Data",
        "widget_id": "earnings_chart",
        "tab_id": "preview",
        "min_count": 1
      },
      {
        "origin": "Earnings Prep Data",
        "widget_id": "earnings_note",
        "tab_id": "preview",
        "min_count": 1
      }
    ],
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 1,
      "max_custom_backend_delta": 0
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "earnings-prep-data__earnings_chart",
          "widget_id": "earnings_chart",
          "fields": [
            "category",
            "value"
          ],
          "path": "/eps-history",
          "payload": [
            {
              "category": "Primary",
              "value": 10.25
            },
            {
              "category": "Review",
              "value": 20.5
            },
            {
              "category": "Approved",
              "value": 30.75
            }
          ]
        },
        {
          "name": "earnings-prep-data__earnings_note",
          "widget_id": "earnings_note",
          "fields": [],
          "path": "/earnings-preview",
          "payload": "Earnings Preview fixture-backed runtime summary."
        }
      ],
      "pinned_paths": false
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_snapshot",
      "args": {}
    },
    {
      "tool": "manage_backends",
      "args": {
        "operation": "refresh",
        "backend_id": "backend_001",
        "apps_json": [
          {
            "name": "Chart Note Board",
            "description": "Chart and preview note synced by symbol.",
            "tabs": {
              "preview": {
                "id": "preview",
                "name": "Preview",
                "layout": [
                  {
                    "i": "earnings_chart",
                    "x": 0,
                    "y": 0,
                    "w": 20,
                    "h": 9
                  },
                  {
                    "i": "earnings_note",
                    "x": 20,
                    "y": 0,
                    "w": 12,
                    "h": 9
                  }
                ]
              }
            },
            "groups": [
              {
                "name": "Preview Symbol Sync",
                "type": "param",
                "paramName": "symbol",
                "widgetIds": [
                  "earnings_chart",
                  "earnings_note"
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "tool": "manage_apps",
      "args": {
        "operation": "instantiate",
        "backend_id": "backend_001",
        "app_name": "Chart Note Board",
        "dashboard_name": "Chart Note Board Live",
        "activate": true
      }
    }
  ],
  "limits": {
    "max_turns": 6
  }
}
