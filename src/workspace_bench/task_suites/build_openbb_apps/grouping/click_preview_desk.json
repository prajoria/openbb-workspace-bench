                  "click_preview_table",
                  "earnings_note"
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "tool": "manage_apps",
      "args": {
        "operation": "instantiate",
        "backend_id": "backend_001",
        "app_name": "Click Preview Desk",
        "dashboard_name": "Click Preview Desk Live",
        "activate": true
      }
    }
