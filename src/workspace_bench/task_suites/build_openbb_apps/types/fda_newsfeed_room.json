{
  "id": "fda_newsfeed_room",
  "category": "platform",
  "family": "types",
  "specification_level": "partially-specified",
  "difficulty": "hard",
  "prompt": "Build a working Workspace experience for a healthcare-research analyst covering clinical catalysts and pipelines. The workspace must cover FDA decision and notice feed. The workspace must cover catalysts in the next 30 days. A selection in one part of the analysis stays linked to related results. Leave the complete working workspace open for review. Keep these source-contract anchors: `therapy_area`. Choose the rest of the architecture and avoid unrelated changes.",
  "business_terms": [
    "therapy_area"
  ],
  "setup": {
    "fixtures": {},
    "initial_state": {},
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "trace_checks": {
      "max_invalid_tool_calls": 2,
      "max_repeated_snapshots": 2
    },
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 1,
      "max_custom_backend_delta": 1
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "healthcare-research-data__catalyst_metric",
          "widget_id": "catalyst_metric",
          "fields": [
            "catalyst_metric_value",
            "label",
            "value"
          ],
          "path": "/catalyst-count",
          "payload": {
            "catalyst_metric_value": 10.25,
            "label": "Catalysts 30d",
            "value": 42.5
          }
        },
        {
          "name": "healthcare-research-data__fda_newsfeed",
          "widget_id": "fda_newsfeed",
          "fields": [
            "fda_newsfeed_value",
            "published_at",
            "summary",
            "title"
          ],
          "path": "/fda-notices",
          "payload": [
            {
              "fda_newsfeed_value": 10.25,
              "published_at": "2026-01-15T14:30:00Z",
              "summary": "Fixture-backed desk update with verified data.",
              "title": "FDA Notices update"
            }
          ]
        }
      ],
      "pinned_paths": false
    },
    "required_capabilities": [
      {
        "name": "capability_1_catalyst-metric",
        "datasets": [
          "healthcare-research-data__catalyst_metric"
        ],
        "widget_kind": "metric",
        "must_cover_fields": [
          "catalyst_metric_value"
        ],
        "required_param_kinds": [
          "text"
        ],
        "required_config": {}
      },
      {
        "name": "capability_2_fda-newsfeed",
        "datasets": [
          "healthcare-research-data__fda_newsfeed"
        ],
        "widget_kind": "newsfeed",
        "must_cover_fields": [
          "fda_newsfeed_value"
        ],
        "required_param_kinds": [
          "text"
        ],
        "required_config": {}
      }
    ],
    "capability_connections": [
      {
        "source": "capability_2_fda-newsfeed",
        "target": "capability_1_catalyst-metric",
        "param_kind": "text"
      }
    ],
    "app_structure": {
      "required": true,
      "layout_refs_valid": true,
      "no_overlaps": true
    },
    "reference": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Healthcare Research Data",
          "url": "http://localhost:7808",
          "widgets_json": {
            "fda_newsfeed": {
              "name": "FDA Notices",
              "description": "FDA decision and notice feed.",
              "endpoint": "/fda-notices",
              "type": "newsfeed",
              "gridData": {
                "w": 12,
                "h": 10
              },
              "params": [
                {
                  "paramName": "therapy_area",
                  "type": "text",
                  "label": "Therapy area",
                  "value": "Oncology",
                  "description": "Therapy area for the catalyst wire."
                }
              ],
              "data": {
                "valueField": "fda_newsfeed_value"
              }
            },
            "catalyst_metric": {
              "name": "Catalysts 30d",
              "description": "Catalysts in the next 30 days.",
              "endpoint": "/catalyst-count",
              "type": "metric",
              "gridData": {
                "w": 6,
                "h": 4
              },
              "params": [
                {
                  "paramName": "therapy_area",
                  "type": "text",
                  "label": "Therapy area",
                  "value": "Oncology",
                  "description": "Therapy area for the catalyst wire."
                }
              ],
              "data": {
                "valueField": "catalyst_metric_value"
              }
            }
          },
          "apps_json": [
            {
              "name": "Catalyst Wire",
              "description": "FDA notices and catalyst count.",
              "tabs": {
                "wire": {
                  "id": "wire",
                  "name": "Wire",
                  "layout": [
                    {
                      "i": "fda_newsfeed",
                      "x": 0,
                      "y": 0,
                      "w": 12,
                      "h": 10
                    }
                  ]
                },
                "metrics": {
                  "id": "metrics",
                  "name": "Metrics",
                  "layout": [
                    {
                      "i": "catalyst_metric",
                      "x": 0,
                      "y": 0,
                      "w": 6,
                      "h": 4
                    }
                  ]
                }
              },
              "groups": [
                {
                  "name": "Therapy Sync",
                  "type": "param",
                  "paramName": "therapy_area",
                  "widgetIds": [
                    "fda_newsfeed",
                    "catalyst_metric"
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_001",
          "app_name": "Catalyst Wire",
          "dashboard_name": "Catalyst Wire Live",
          "activate": true
        }
      }
    ],
    "limits": {
      "max_turns": 14
    }
  }
}
