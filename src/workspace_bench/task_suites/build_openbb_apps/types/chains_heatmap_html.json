          "payload": "<section><h1>Chain Heatmap</h1><p>Runtime data ready.</p></section>"
        }
      ],
      "pinned_paths": false
    },
    "reference_trace": [
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Chain TVL Data",
          "url": "http://localhost:7802",
          "widgets_json": {
            "chains_heatmap_html": {
