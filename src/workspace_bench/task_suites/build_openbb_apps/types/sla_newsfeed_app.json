{
  "id": "sla_newsfeed_app",
  "category": "platform",
  "family": "types",
  "difficulty": "easy",
  "prompt": "Implement the requested app and confirm it by opening it in Workspace. Use 'Vendor SLA Data' at http://localhost:7804. Choose the native widget type that fits the content. The experience needs Vendor Notices (`sla_newsfeed`, newsfeed) using `/vendor-notices` for vendor incident notices feed. Organize it as app 'Vendor Notices' with tabs Notices (sla_newsfeed). Choose the appropriate Workspace tools, validate the result, and avoid unrelated changes.",
  "setup": {
    "fixtures": {},
    "initial_state": {},
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_widget_defs": [
      {
        "backend_name": "Vendor SLA Data",
        "widget_id": "sla_newsfeed",
        "expect": {
          "type": "newsfeed",
          "endpoint": "/vendor-notices"
        },
        "params_include": [],
        "columns_include": []
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Vendor SLA Data",
        "layout_refs_valid": true,
        "no_overlaps": true,
        "name_contains": "Vendor Notices",
        "tabs_include": [
          "notices"
        ],
        "tab_count": 1,
        "widgets_on_tab": [
          {
            "tab_id": "notices",
            "widget_id": "sla_newsfeed"
          }
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 1,
      "max_repeated_snapshots": 2
    },
    "required_dashboard_name_contains": "Vendor Notices",
    "required_widgets": [
      {
        "origin": "Vendor SLA Data",
        "widget_id": "sla_newsfeed",
        "tab_id": "notices",
        "min_count": 1
      }
    ],
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 1,
      "max_custom_backend_delta": 1
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "vendor-sla-data__sla_newsfeed",
          "widget_id": "sla_newsfeed",
          "fields": [
            "published_at",
            "summary",
            "title"
          ],
          "path": "/vendor-notices",
          "payload": [
            {
              "published_at": "2026-01-15T14:30:00Z",
              "summary": "Fixture-backed desk update with verified data.",
              "title": "Vendor Notices update"
            }
          ]
        }
      ],
      "pinned_paths": false
    },
    "reference_trace": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Vendor SLA Data",
          "url": "http://localhost:7804",
          "widgets_json": {
            "sla_newsfeed": {
              "name": "Vendor Notices",
              "description": "Vendor incident notices feed.",
              "endpoint": "/vendor-notices",
              "type": "newsfeed",
              "gridData": {
                "w": 12,
                "h": 10
              }
            }
          },
          "apps_json": [
            {
              "name": "Vendor Notices",
              "description": "Vendor incident notices.",
              "tabs": {
                "notices": {
                  "id": "notices",
                  "name": "Notices",
                  "layout": [
                    {
                      "i": "sla_newsfeed",
                      "x": 0,
                      "y": 0,
                      "w": 12,
                      "h": 10
                    }
                  ]
                }
              },
              "groups": []
            }
          ]
        }
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_001",
          "app_name": "Vendor Notices",
          "dashboard_name": "Vendor Notices Live",
          "activate": true
        }
      }
    ],
    "max_turns": 6
  }
}
