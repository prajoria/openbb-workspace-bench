{
  "id": "sla_newsfeed_ship",
  "category": "platform",
  "family": "types",
  "difficulty": "hard",
  "prompt": "Build a vendor-operations manager a dependable vendor service levels workspace. The workspace must cover vendor incident notices feed. The workspace must cover count of open SLA breaches. The workspace must cover vendor SLA state with breach flags. Analysts need to inspect vendor, status, latency milliseconds, breach. Leave the complete working workspace open for review. Add a short completion HTML card that naturally includes the desk-required terms 'Vendor Notice Room', 'notices', 'Vendor SLA Data', 'QuoteStream'. Decide how best to organize the experience and preserve unrelated work.",
  "business_terms": [
    "Vendor Notice Room",
    "notices",
    "Vendor SLA Data",
    "QuoteStream"
  ],
  "setup": {
    "fixtures": {},
    "initial_state": {},
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_generated_widgets": [
      {
        "widget_type": "html",
        "data_contains": [
          "Vendor Notice Room",
          "notices",
          "Vendor SLA Data",
          "QuoteStream"
        ],
        "min_count": 1
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 2,
      "max_repeated_snapshots": 2
    },
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 1,
      "max_custom_backend_delta": 1
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "vendor-sla-data__breach_metric",
          "widget_id": "breach_metric",
          "fields": [
            "breach_metric_value",
            "label",
            "value"
          ],
          "path": "/breach-count",
          "payload": {
            "breach_metric_value": 10.25,
            "label": "Open Breaches",
            "value": 42.5
          }
        },
        {
          "name": "vendor-sla-data__sla_newsfeed",
          "widget_id": "sla_newsfeed",
          "fields": [
            "published_at",
            "sla_newsfeed_value",
            "summary",
            "title"
          ],
          "path": "/vendor-notices",
          "payload": [
            {
              "published_at": "2026-01-15T14:30:00Z",
              "sla_newsfeed_value": 10.25,
              "summary": "Fixture-backed desk update with verified data.",
              "title": "Vendor Notices update"
            }
          ]
        },
        {
          "name": "vendor-sla-data__vendor_sla_table",
          "widget_id": "vendor_sla_table",
          "fields": [
            "breach",
            "latency_ms",
            "status",
            "vendor"
          ],
          "path": "/vendor-sla",
          "payload": [
            {
              "breach": true,
              "latency_ms": 10.25,
              "status": "Primary",
              "vendor": "vendor-1"
            },
            {
              "breach": false,
              "latency_ms": 20.5,
              "status": "Review",
              "vendor": "vendor-2"
            },
            {
              "breach": true,
              "latency_ms": 30.75,
              "status": "Approved",
              "vendor": "vendor-3"
            }
          ]
        }
      ],
      "pinned_paths": false
    },
    "required_capabilities": [
      {
        "name": "capability_1_breach-metric",
        "datasets": [
          "vendor-sla-data__breach_metric"
        ],
        "widget_kind": "metric",
        "must_cover_fields": [
          "breach_metric_value"
        ],
        "required_param_kinds": [],
        "required_config": {}
      },
      {
        "name": "capability_2_sla-newsfeed",
        "datasets": [
          "vendor-sla-data__sla_newsfeed"
        ],
        "widget_kind": "newsfeed",
        "must_cover_fields": [
          "sla_newsfeed_value"
        ],
        "required_param_kinds": [
          "text"
        ],
        "required_config": {}
      }
    ],
    "app_structure": {
      "required": true,
      "layout_refs_valid": true,
      "no_overlaps": true
    },
    "reference_trace": [
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Vendor SLA Data",
          "url": "http://localhost:7804",
          "widgets_json": {
            "sla_newsfeed": {
              "name": "Vendor Notices",
              "description": "Vendor incident notices feed.",
              "endpoint": "/vendor-notices",
              "type": "newsfeed",
              "gridData": {
                "w": 12,
                "h": 10
              },
              "params": [
                {
                  "paramName": "vendor",
                  "type": "text",
                  "label": "Vendor",
                  "value": "AlphaFeed",
                  "description": "Vendor filter for notices."
                }
              ],
              "staleTime": 900000,
              "data": {
                "valueField": "sla_newsfeed_value"
              }
            },
            "breach_metric": {
              "name": "Open Breaches",
              "description": "Count of open SLA breaches.",
              "endpoint": "/breach-count",
              "type": "metric",
              "gridData": {
                "w": 6,
                "h": 4
              },
              "staleTime": 900000,
              "data": {
                "valueField": "breach_metric_value"
              }
            },
            "vendor_sla_table": {
              "name": "Vendor SLA Status",
              "description": "Vendor SLA state with breach flags.",
              "endpoint": "/vendor-sla",
              "type": "table",
              "gridData": {
                "w": 20,
                "h": 9
              },
              "params": [
                {
                  "paramName": "status",
                  "type": "text",
                  "label": "Status",
                  "value": "Open",
                  "options": [
                    {
                      "label": "Open",
                      "value": "Open"
                    },
                    {
                      "label": "Escalated",
                      "value": "Escalated"
                    },
                    {
                      "label": "Resolved",
                      "value": "Resolved"
                    }
                  ]
                }
              ],
              "data": {
                "table": {
                  "columnsDefs": [
                    {
                      "field": "vendor",
                      "headerName": "Vendor",
                      "cellDataType": "text"
                    },
                    {
                      "field": "status",
                      "headerName": "Status",
                      "cellDataType": "text",
                      "renderFn": "titleCase"
                    },
                    {
                      "field": "latency_ms",
                      "headerName": "Latency (ms)",
                      "cellDataType": "number"
                    },
                    {
                      "field": "breach",
                      "headerName": "Breach",
                      "cellDataType": "boolean"
                    }
                  ]
                }
              },
              "staleTime": 900000
            }
          },
          "apps_json": [
            {
              "name": "Vendor Notice Room",
              "description": "Vendor notices and breach count.",
              "tabs": {
                "notices": {
                  "id": "notices",
                  "name": "Notices",
                  "layout": [
                    {
                      "i": "sla_newsfeed",
                      "x": 0,
                      "y": 0,
                      "w": 20,
                      "h": 12
                    }
                  ]
                },
                "signals": {
                  "id": "signals",
                  "name": "Signals",
                  "layout": [
                    {
                      "i": "breach_metric",
                      "x": 0,
                      "y": 0,
                      "w": 8,
                      "h": 5
                    }
                  ]
                }
              },
              "groups": []
            }
          ]
        }
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_001",
          "app_name": "Vendor Notice Room",
          "dashboard_name": "Vendor Notice Room Live",
          "activate": true
        }
      },
      {
        "tool": "update_widget",
        "args": {
          "widget_id": "sla_newsfeed",
          "data_args": {
            "vendor": "QuoteStream"
          }
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "html",
          "name": "Vendor Notice Room",
          "data": "<section>Vendor Notice Room is live from Vendor SLA Data: notices ready. Configured vendor=QuoteStream.</section>"
        }
      }
    ],
    "max_turns": 14
  }
}
