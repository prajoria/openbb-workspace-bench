{
  "id": "vol_commentary",
  "category": "platform",
  "family": "types",
  "difficulty": "easy",
  "prompt": "Register the backend and place the specified widget on the active dashboard. Use 'Vol Desk Data' at http://localhost:7801. Choose the native widget type that fits the content. The experience needs Vol Commentary (`vol_commentary`, markdown) using `/vol-commentary` for morning volatility commentary; user controls: Desk (`desk`, text); cache for 15 minutes. Choose the appropriate Workspace tools, validate the result, and avoid unrelated changes.",
  "setup": {
    "fixtures": {},
    "initial_state": {},
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_widget_defs": [
      {
        "backend_name": "Vol Desk Data",
        "widget_id": "vol_commentary",
        "expect": {
          "type": "markdown",
          "endpoint": "/vol-commentary"
        },
        "params_include": [
          {
            "paramName": "desk",
            "type": "text"
          }
        ],
        "columns_include": []
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 1,
      "max_repeated_snapshots": 2,
      "must_call_schema_before_create": true
    },
    "required_widgets": [
      {
        "origin": "Vol Desk Data",
        "widget_id": "vol_commentary",
        "min_count": 1
      }
    ],
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 0,
      "max_custom_backend_delta": 1
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "vol-desk-data__vol_commentary",
          "widget_id": "vol_commentary",
          "fields": [],
          "path": "/vol-commentary",
          "payload": "Vol Commentary fixture-backed runtime summary."
        }
      ],
      "pinned_paths": false
    },
    "reference": [
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Vol Desk Data",
          "url": "http://localhost:7801",
          "widgets_json": {
            "vol_commentary": {
              "name": "Vol Commentary",
              "description": "Morning volatility commentary.",
              "endpoint": "/vol-commentary",
              "type": "markdown",
              "gridData": {
                "w": 12,
                "h": 8
              },
              "params": [
                {
                  "paramName": "desk",
                  "type": "text",
                  "label": "Desk",
                  "value": "index",
                  "options": [
                    {
                      "label": "Index",
                      "value": "index"
                    },
                    {
                      "label": "Single Stock",
                      "value": "single"
                    }
                  ]
                }
              ],
              "staleTime": 900000
            }
          }
        }
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Vol Desk Data"
        }
      },
      {
        "tool": "get_widget_schema",
        "args": {
          "origin": "Vol Desk Data",
          "widget_id": "vol_commentary"
        }
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Vol Desk Data",
          "widget_id": "vol_commentary"
        }
      }
    ],
    "limits": {
      "max_turns": 7
    }
  }
}
