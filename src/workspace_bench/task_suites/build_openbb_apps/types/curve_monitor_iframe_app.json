{
  "id": "curve_monitor_iframe_app",
  "category": "platform",
  "family": "types",
  "specification_level": "explicit",
  "difficulty": "medium",
  "prompt": "Build the specified app, publish it, and leave a working instance open. Use 'Rates Watch Data' at http://localhost:7803. Choose the native widget type that fits the content. The experience needs Curve Monitor App (`curve_monitor_iframe`, iframe) using `http://localhost:5173` for embedded standalone curve monitor application. Organize it as app 'Curve Monitor' with tabs Monitor (curve_monitor_iframe). Choose the appropriate Workspace tools, validate the result, and avoid unrelated changes.",
  "setup": {
    "fixtures": {},
    "initial_state": {},
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_widget_defs": [
      {
        "backend_name": "Rates Watch Data",
        "widget_id": "curve_monitor_iframe",
        "expect": {
          "type": "iframe",
          "endpoint": "http://localhost:5173"
        },
        "params_include": [],
        "columns_include": []
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Rates Watch Data",
        "layout_refs_valid": true,
        "no_overlaps": true,
        "name_contains": "Curve Monitor",
        "tabs_include": [
          "monitor"
        ],
        "tab_count": 1,
        "widgets_on_tab": [
          {
            "tab_id": "monitor",
            "widget_id": "curve_monitor_iframe"
          }
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 1,
      "max_repeated_snapshots": 2
    },
    "required_dashboard_name_contains": "Curve Monitor",
    "required_widgets": [
      {
        "origin": "Rates Watch Data",
        "widget_id": "curve_monitor_iframe",
        "tab_id": "monitor",
        "min_count": 1
      }
    ],
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 1,
      "max_custom_backend_delta": 1
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "rates-watch-data__curve_monitor_iframe",
          "widget_id": "curve_monitor_iframe",
          "fields": [
            "title",
            "url"
          ],
          "path": "/",
          "payload": {
            "title": "Curve Monitor App",
            "url": "https://fixtures.workspace-bench.invalid/curve_monitor_iframe"
          }
        }
      ],
      "pinned_paths": false
    },
    "reference_trace": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Rates Watch Data",
          "url": "http://localhost:7803",
          "widgets_json": {
            "curve_monitor_iframe": {
              "name": "Curve Monitor App",
              "description": "Embedded standalone curve monitor application.",
              "endpoint": "http://localhost:5173",
              "type": "iframe",
              "gridData": {
                "w": 24,
                "h": 16
              }
            }
          },
          "apps_json": [
            {
              "name": "Curve Monitor",
              "description": "Embedded curve monitor.",
              "tabs": {
                "monitor": {
                  "id": "monitor",
                  "name": "Monitor",
                  "layout": [
                    {
                      "i": "curve_monitor_iframe",
                      "x": 0,
                      "y": 0,
                      "w": 24,
                      "h": 16
                    }
                  ]
                }
              },
              "groups": []
            }
          ]
        }
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_001",
          "app_name": "Curve Monitor",
          "dashboard_name": "Curve Monitor Live",
          "activate": true
        }
      }
    ],
    "max_turns": 6
  }
}
