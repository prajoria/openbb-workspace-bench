{
  "id": "compliance_ship",
  "category": "platform",
  "family": "forms",
  "difficulty": "hard",
  "prompt": "The desk needs a production-ready cases and compliance alerts workflow for a surveillance analyst. The workspace must cover escalate a surveillance case to a reviewer. The workspace must cover open alert count. The workspace must cover open surveillance alerts. Analysts need to inspect alert ID, desk, severity, age days. An analyst can choose the relevant business date. The user can enter the required details and submit the workflow. Leave the complete working workspace open for review. Add a short completion note that naturally includes the desk-required terms 'Case Intake Live', 'case intake', 'Surveillance Data', 'C-1044', 'date'. Use your judgment on the architecture and leave other work intact.",
  "business_terms": [
    "Case Intake Live",
    "case intake",
    "Surveillance Data",
    "C-1044",
    "date"
  ],
  "setup": {
    "fixtures": {},
    "initial_state": {},
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "Case Intake Live",
          "case intake",
          "Surveillance Data",
          "C-1044"
        ],
        "min_count": 1
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 2,
      "max_repeated_snapshots": 2
    },
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 1,
      "max_custom_backend_delta": 1
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "surveillance-data__alert_metric",
          "widget_id": "alert_metric",
          "fields": [
            "alert_metric_value",
            "label",
            "value"
          ],
          "path": "/alert-count",
          "payload": {
            "alert_metric_value": 10.25,
            "label": "Open Alerts",
            "value": 42.5
          }
        },
        {
          "name": "surveillance-data__alert_queue",
          "widget_id": "alert_queue",
          "fields": [
            "age_days",
            "alert_id",
            "desk",
            "severity"
          ],
          "path": "/alert-queue",
          "payload": [
            {
              "age_days": 10.25,
              "alert_id": "alert_id-1",
              "desk": "Primary",
              "severity": "Primary"
            },
            {
              "age_days": 20.5,
              "alert_id": "alert_id-2",
              "desk": "Review",
              "severity": "Review"
            },
            {
              "age_days": 30.75,
              "alert_id": "alert_id-3",
              "desk": "Approved",
              "severity": "Approved"
            }
          ]
        },
        {
          "name": "surveillance-data__case_escalation_form",
          "widget_id": "case_escalation_form",
          "fields": [
            "case_escalation_form_value"
          ],
          "path": "/case-escalation",
          "payload": [
            {
              "case_escalation_form_value": 10.25
            },
            {
              "case_escalation_form_value": 20.5
            },
            {
              "case_escalation_form_value": 30.75
            }
          ],
          "form_endpoint": "/case-escalation-submit"
        }
      ],
      "pinned_paths": false
    },
    "required_capabilities": [
      {
        "name": "capability_1_alert-metric",
        "datasets": [
          "surveillance-data__alert_metric"
        ],
        "widget_kind": "metric",
        "must_cover_fields": [
          "alert_metric_value"
        ],
        "required_param_kinds": [],
        "required_config": {}
      },
      {
        "name": "capability_2_case-escalation-form",
        "datasets": [
          "surveillance-data__case_escalation_form"
        ],
        "widget_kind": "form",
        "must_cover_fields": [
          "case_escalation_form_value"
        ],
        "required_param_kinds": [
          "button",
          "date",
          "form",
          "text"
        ],
        "required_config": {}
      }
    ],
    "app_structure": {
      "required": true,
      "layout_refs_valid": true,
      "no_overlaps": true
    },
    "reference": [
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Surveillance Data",
          "url": "http://localhost:7807",
          "widgets_json": {
            "case_escalation_form": {
              "name": "Case Escalation Form",
              "description": "Escalate a surveillance case to a reviewer.",
              "endpoint": "/case-escalation",
              "type": "table",
              "gridData": {
                "w": 20,
                "h": 10
              },
              "params": [
                {
                  "paramName": "escalation",
                  "type": "form",
                  "label": "Escalation",
                  "endpoint": "/case-escalation-submit",
                  "method": "POST",
                  "inputParams": [
                    {
                      "paramName": "case_id",
                      "type": "text",
                      "label": "Case",
                      "value": "C-1042"
                    },
                    {
                      "paramName": "due_date",
                      "type": "date",
                      "label": "Due date",
                      "value": "$currentDate+2d"
                    },
                    {
                      "paramName": "escalate",
                      "type": "button",
                      "label": "Escalate"
                    }
                  ]
                },
                {
                  "paramName": "case_scope",
                  "type": "text",
                  "label": "Case Scope",
                  "value": "C-1042",
                  "description": "Case intake filter."
                }
              ],
              "staleTime": 900000,
              "data": {
                "valueField": "case_escalation_form_value"
              }
            },
            "alert_metric": {
              "name": "Open Alerts",
              "description": "Open alert count.",
              "endpoint": "/alert-count",
              "type": "metric",
              "gridData": {
                "w": 5,
                "h": 4
              },
              "staleTime": 900000,
              "data": {
                "valueField": "alert_metric_value"
              }
            },
            "alert_queue": {
              "name": "Alert Queue",
              "description": "Open surveillance alerts.",
              "endpoint": "/alert-queue",
              "type": "table",
              "gridData": {
                "w": 20,
                "h": 9
              },
              "params": [
                {
                  "paramName": "severity",
                  "type": "text",
                  "label": "Severity",
                  "value": "high",
                  "options": [
                    {
                      "label": "High",
                      "value": "high"
                    },
                    {
                      "label": "Medium",
                      "value": "medium"
                    },
                    {
                      "label": "Low",
                      "value": "low"
                    }
                  ]
                }
              ],
              "data": {
                "table": {
                  "columnsDefs": [
                    {
                      "field": "alert_id",
                      "headerName": "Alert",
                      "cellDataType": "text"
                    },
                    {
                      "field": "desk",
                      "headerName": "Desk",
                      "cellDataType": "text"
                    },
                    {
                      "field": "severity",
                      "headerName": "Severity",
                      "cellDataType": "text",
                      "renderFn": "titleCase"
                    },
                    {
                      "field": "age_days",
                      "headerName": "Age (d)",
                      "cellDataType": "number",
                      "formatterFn": "int"
                    }
                  ]
                }
              },
              "staleTime": 900000
            }
          },
          "apps_json": [
            {
              "name": "Case Intake Live",
              "description": "Case escalation and alert count.",
              "tabs": {
                "cases": {
                  "id": "cases",
                  "name": "Cases",
                  "layout": [
                    {
                      "i": "case_escalation_form",
                      "x": 0,
                      "y": 0,
                      "w": 20,
                      "h": 10
                    }
                  ]
                },
                "status": {
                  "id": "status",
                  "name": "Status",
                  "layout": [
                    {
                      "i": "alert_metric",
                      "x": 0,
                      "y": 0,
                      "w": 8,
                      "h": 6
                    }
                  ]
                }
              },
              "groups": []
            }
          ]
        }
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_001",
          "app_name": "Case Intake Live",
          "dashboard_name": "Case Intake Live Board",
          "activate": true
        }
      },
      {
        "tool": "update_widget",
        "args": {
          "widget_id": "case_escalation_form",
          "data_args": {
            "case_scope": "C-1044"
          }
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Case Intake Live",
          "data": "Case Intake Live is live from Surveillance Data: case intake ready. Configured case_scope=C-1044."
        }
      }
    ],
    "limits": {
      "max_turns": 14
    }
  }
}
