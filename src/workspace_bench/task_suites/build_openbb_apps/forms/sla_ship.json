{
  "id": "sla_ship",
  "category": "platform",
  "family": "forms",
  "difficulty": "hard",
  "split": "test",
  "prompt": "Build a vendor-operations manager a dependable vendor service levels workspace. The workspace must cover submit a new vendor record into the SLA register. The workspace must cover count of open SLA breaches. The workspace must cover vendor SLA state with breach flags. Analysts need to inspect vendor, status, latency milliseconds, breach. An analyst can adjust the relevant numeric scope. The user can enter the required details and submit the workflow. Leave the complete working workspace open for review. Add a short completion note that naturally includes the desk-required terms 'Vendor Intake Live', 'vendor intake', 'Vendor SLA Data', 'QuoteStream'. Decide how best to organize the experience and preserve unrelated work.",
  "business_terms": [
    "Vendor Intake Live",
    "vendor intake",
    "Vendor SLA Data",
    "QuoteStream"
  ],
  "fixtures": {},
  "initial_state": {},
  "allowed_tools": [
    "get_workspace_snapshot",
    "manage_dashboard",
    "manage_navigation_bar",
    "navigate_workspace",
    "list_available_widgets",
    "get_widget_schema",
    "get_params_options",
    "get_widget_data",
    "create_widget",
    "update_widget",
    "update_widget_layout",
    "delete_widget",
    "add_generative_widget",
    "read_widget",
    "manage_backends",
    "manage_apps",
    "get_skill_content",
    "read_workspace_resource",
    "get_workspace_prompt",
    "assign_tasks_to_agents"
  ],
  "success": {
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "Vendor Intake Live",
          "vendor intake",
          "Vendor SLA Data",
          "QuoteStream"
        ],
        "min_count": 1
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 2,
      "max_repeated_snapshots": 2
    },
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 1,
      "max_custom_backend_delta": 1
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "vendor-sla-data__breach_metric",
          "widget_id": "breach_metric",
          "fields": [
            "breach_metric_value",
            "label",
            "value"
          ],
          "path": "/breach-count",
          "payload": {
            "breach_metric_value": 10.25,
            "label": "Open Breaches",
            "value": 42.5
          }
        },
        {
          "name": "vendor-sla-data__vendor_intake_form",
          "widget_id": "vendor_intake_form",
          "fields": [
            "vendor_intake_form_value"
          ],
          "path": "/vendor-intake",
          "payload": [
            {
              "vendor_intake_form_value": 10.25
            },
            {
              "vendor_intake_form_value": 20.5
            },
            {
              "vendor_intake_form_value": 30.75
            }
          ],
          "form_endpoint": "/vendor-intake-submit"
        },
        {
          "name": "vendor-sla-data__vendor_sla_table",
          "widget_id": "vendor_sla_table",
          "fields": [
            "breach",
            "latency_ms",
            "status",
            "vendor"
          ],
          "path": "/vendor-sla",
          "payload": [
            {
              "breach": true,
              "latency_ms": 10.25,
              "status": "Primary",
              "vendor": "vendor-1"
            },
            {
              "breach": false,
              "latency_ms": 20.5,
              "status": "Review",
              "vendor": "vendor-2"
            },
            {
              "breach": true,
              "latency_ms": 30.75,
              "status": "Approved",
              "vendor": "vendor-3"
            }
          ]
        }
      ],
      "pinned_paths": false
    },
    "required_capabilities": [
      {
        "name": "capability_1_breach-metric",
        "datasets": [
          "vendor-sla-data__breach_metric"
        ],
        "widget_kind": "metric",
        "must_cover_fields": [
          "breach_metric_value"
        ],
        "required_param_kinds": [],
        "required_config": {}
      },
      {
        "name": "capability_2_vendor-intake-form",
        "datasets": [
          "vendor-sla-data__vendor_intake_form"
        ],
        "widget_kind": "form",
        "must_cover_fields": [
          "vendor_intake_form_value"
        ],
        "required_param_kinds": [
          "button",
          "form",
          "number",
          "text"
        ],
        "required_config": {}
      }
    ],
    "app_structure": {
      "required": true,
      "layout_refs_valid": true,
      "no_overlaps": true
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "manage_backends",
      "args": {
        "operation": "add",
        "name": "Vendor SLA Data",
        "url": "http://localhost:7804",
        "widgets_json": {
          "vendor_intake_form": {
            "name": "Vendor Intake Form",
            "description": "Submit a new vendor record into the SLA register.",
            "endpoint": "/vendor-intake",
            "type": "table",
            "gridData": {
              "w": 20,
              "h": 10
            },
            "params": [
              {
                "paramName": "intake",
                "type": "form",
                "label": "New Vendor",
                "endpoint": "/vendor-intake-submit",
                "method": "POST",
                "inputParams": [
                  {
                    "paramName": "vendor",
                    "type": "text",
                    "label": "Vendor"
                  },
                  {
                    "paramName": "tier",
                    "type": "number",
                    "label": "Tier"
                  },
                  {
                    "paramName": "submit",
                    "type": "button",
                    "label": "Add Vendor"
                  }
                ]
              },
              {
                "paramName": "vendor_scope",
                "type": "text",
                "label": "Vendor Scope",
                "value": "AlphaFeed",
                "description": "Vendor intake filter."
              }
            ],
            "staleTime": 900000,
            "data": {
              "valueField": "vendor_intake_form_value"
            }
          },
          "breach_metric": {
            "name": "Open Breaches",
            "description": "Count of open SLA breaches.",
            "endpoint": "/breach-count",
            "type": "metric",
            "gridData": {
              "w": 6,
              "h": 4
            },
            "staleTime": 900000,
            "data": {
              "valueField": "breach_metric_value"
            }
          },
          "vendor_sla_table": {
            "name": "Vendor SLA Status",
            "description": "Vendor SLA state with breach flags.",
            "endpoint": "/vendor-sla",
            "type": "table",
            "gridData": {
              "w": 20,
              "h": 9
            },
            "params": [
              {
                "paramName": "status",
                "type": "text",
                "label": "Status",
                "value": "Open",
                "options": [
                  {
                    "label": "Open",
                    "value": "Open"
                  },
                  {
                    "label": "Escalated",
                    "value": "Escalated"
                  },
                  {
                    "label": "Resolved",
                    "value": "Resolved"
                  }
                ]
              }
            ],
            "data": {
              "table": {
                "columnsDefs": [
                  {
                    "field": "vendor",
                    "headerName": "Vendor",
                    "cellDataType": "text"
                  },
                  {
                    "field": "status",
                    "headerName": "Status",
                    "cellDataType": "text",
                    "renderFn": "titleCase"
                  },
                  {
                    "field": "latency_ms",
                    "headerName": "Latency (ms)",
                    "cellDataType": "number"
                  },
                  {
                    "field": "breach",
                    "headerName": "Breach",
                    "cellDataType": "boolean"
                  }
                ]
              }
            },
            "staleTime": 900000
          }
        },
        "apps_json": [
          {
            "name": "Vendor Intake Live",
            "description": "Vendor intake and breach count.",
            "tabs": {
              "intake": {
                "id": "intake",
                "name": "Intake",
                "layout": [
                  {
                    "i": "vendor_intake_form",
                    "x": 0,
                    "y": 0,
                    "w": 20,
                    "h": 10
                  }
                ]
              },
              "status": {
                "id": "status",
                "name": "Status",
                "layout": [
                  {
                    "i": "breach_metric",
                    "x": 0,
                    "y": 0,
                    "w": 8,
                    "h": 6
                  }
                ]
              }
            },
            "groups": []
          }
        ]
      }
    },
    {
      "tool": "manage_apps",
      "args": {
        "operation": "instantiate",
        "backend_id": "backend_001",
        "app_name": "Vendor Intake Live",
        "dashboard_name": "Vendor Intake Live Board",
        "activate": true
      }
    },
    {
      "tool": "update_widget",
      "args": {
        "widget_id": "vendor_intake_form",
        "data_args": {
          "vendor_scope": "QuoteStream"
        }
      }
    },
    {
      "tool": "add_generative_widget",
      "args": {
        "widget_type": "note",
        "name": "Vendor Intake Live",
        "data": "Vendor Intake Live is live from Vendor SLA Data: vendor intake ready. Configured vendor_scope=QuoteStream."
      }
    }
  ],
  "limits": {
    "max_turns": 14
  }
}
