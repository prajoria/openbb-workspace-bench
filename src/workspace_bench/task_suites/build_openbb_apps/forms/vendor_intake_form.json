      "max_repeated_snapshots": 2,
      "must_call_schema_before_create": true
    },
    "required_widgets": [
      {
        "origin": "Vendor SLA Data",
        "widget_id": "vendor_intake_form",
        "min_count": 1
      }
    ],
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 0,
      "max_custom_backend_delta": 1
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "vendor-sla-data__vendor_intake_form",
          "widget_id": "vendor_intake_form",
          "fields": [
            "category",
            "value"
          ],
          "path": "/vendor-intake",
          "payload": [
            {
              "category": "Primary",
              "value": 10.25
            },
            {
              "category": "Review",
              "value": 20.5
            },
            {
              "category": "Approved",
              "value": 30.75
            }
          ],
          "form_endpoint": "/vendor-intake-submit"
        }
      ],
      "pinned_paths": false
    },
    "reference": [
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Vendor SLA Data",
          "url": "http://localhost:7804",
          "widgets_json": {
