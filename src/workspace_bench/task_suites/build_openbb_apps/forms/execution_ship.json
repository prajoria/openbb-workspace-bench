{
  "id": "execution_ship",
  "category": "platform",
  "family": "forms",
  "difficulty": "hard",
  "split": "train",
  "prompt": "The desk needs a production-ready orders and venue quality workflow for an execution analyst. The workspace must cover record an execution venue exception. The workspace must cover open execution exceptions. The workspace must cover live open orders blotter. Analysts need to inspect order ID, symbol, quantity, status. An analyst can adjust the relevant numeric scope. The user can enter the required details and submit the workflow. Leave the complete working workspace open for review. Add a short completion HTML card that naturally includes the desk-required terms 'Exception Intake Live', 'exception intake', 'Execution Desk Data', 'EDGX'. Use your judgment on the architecture and leave other work intact.",
  "business_terms": [
    "Exception Intake Live",
    "exception intake",
    "Execution Desk Data",
    "EDGX"
  ],
  "fixtures": {},
  "initial_state": {},
  "allowed_tools": [
    "get_workspace_snapshot",
    "manage_dashboard",
    "manage_navigation_bar",
    "navigate_workspace",
    "list_available_widgets",
    "get_widget_schema",
    "get_params_options",
    "get_widget_data",
    "create_widget",
    "update_widget",
    "update_widget_layout",
    "delete_widget",
    "add_generative_widget",
    "read_widget",
    "manage_backends",
    "manage_apps",
    "get_skill_content",
    "read_workspace_resource",
    "get_workspace_prompt",
    "assign_tasks_to_agents"
  ],
  "success": {
    "required_generated_widgets": [
      {
        "widget_type": "html",
        "data_contains": [
          "Exception Intake Live",
          "exception intake",
          "Execution Desk Data",
          "EDGX"
        ],
        "min_count": 1
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 2,
      "max_repeated_snapshots": 2
    },
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 1,
      "max_custom_backend_delta": 1
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "execution-desk-data__exception_metric",
          "widget_id": "exception_metric",
          "fields": [
            "exception_metric_value",
            "label",
            "value"
          ],
          "path": "/exception-count",
          "payload": {
            "exception_metric_value": 10.25,
            "label": "Exceptions",
            "value": 42.5
          }
        },
        {
          "name": "execution-desk-data__open_orders",
          "widget_id": "open_orders",
          "fields": [
            "order_id",
            "qty",
            "status",
            "symbol"
          ],
          "path": "/open-orders",
          "payload": [
            {
              "order_id": "order_id-1",
              "qty": 10.25,
              "status": "Primary",
              "symbol": "AAPL"
            },
            {
              "order_id": "order_id-2",
              "qty": 20.5,
              "status": "Review",
              "symbol": "MSFT"
            },
            {
              "order_id": "order_id-3",
              "qty": 30.75,
              "status": "Approved",
              "symbol": "NVDA"
            }
          ]
        },
        {
          "name": "execution-desk-data__venue_exception_form",
          "widget_id": "venue_exception_form",
          "fields": [
            "venue_exception_form_value"
          ],
          "path": "/venue-exception",
          "payload": [
            {
              "venue_exception_form_value": 10.25
            },
            {
              "venue_exception_form_value": 20.5
            },
            {
              "venue_exception_form_value": 30.75
            }
          ],
          "form_endpoint": "/venue-exception-submit"
        }
      ],
      "pinned_paths": false
    },
    "required_capabilities": [
      {
        "name": "capability_1_exception-metric",
        "datasets": [
          "execution-desk-data__exception_metric"
        ],
        "widget_kind": "metric",
        "must_cover_fields": [
          "exception_metric_value"
        ],
        "required_param_kinds": [],
        "required_config": {}
      },
      {
        "name": "capability_2_venue-exception-form",
        "datasets": [
          "execution-desk-data__venue_exception_form"
        ],
        "widget_kind": "form",
        "must_cover_fields": [
          "venue_exception_form_value"
        ],
        "required_param_kinds": [
          "button",
          "form",
          "number",
          "text"
        ],
        "required_config": {}
      }
    ],
    "app_structure": {
      "required": true,
      "layout_refs_valid": true,
      "no_overlaps": true
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "manage_backends",
      "args": {
        "operation": "add",
        "name": "Execution Desk Data",
        "url": "http://localhost:7806",
        "widgets_json": {
          "venue_exception_form": {
            "name": "Venue Exception Form",
            "description": "Record an execution venue exception.",
            "endpoint": "/venue-exception",
            "type": "table",
            "gridData": {
              "w": 20,
              "h": 10
            },
            "params": [
              {
                "paramName": "exception",
                "type": "form",
                "label": "Exception",
                "endpoint": "/venue-exception-submit",
                "method": "POST",
                "inputParams": [
                  {
                    "paramName": "venue",
                    "type": "text",
                    "label": "Venue",
                    "value": "ARCA"
                  },
                  {
                    "paramName": "slippage_bps",
                    "type": "number",
                    "label": "Slippage bps",
                    "value": 12,
                    "min": 0
                  },
                  {
                    "paramName": "record",
                    "type": "button",
                    "label": "Record"
                  }
                ]
              },
              {
                "paramName": "venue_scope",
                "type": "text",
                "label": "Venue Scope",
                "value": "ARCA",
                "description": "Venue exception filter."
              }
            ],
            "data": {
              "valueField": "venue_exception_form_value"
            },
            "staleTime": 900000
          },
          "exception_metric": {
            "name": "Exceptions",
            "description": "Open execution exceptions.",
            "endpoint": "/exception-count",
            "type": "metric",
            "gridData": {
              "w": 5,
              "h": 4
            },
            "staleTime": 900000,
            "data": {
              "valueField": "exception_metric_value"
            }
          },
          "open_orders": {
            "name": "Open Orders",
            "description": "Live open orders blotter.",
            "endpoint": "/open-orders",
            "type": "table",
            "gridData": {
              "w": 20,
              "h": 9
            },
            "data": {
              "table": {
                "columnsDefs": [
                  {
                    "field": "order_id",
                    "headerName": "Order",
                    "cellDataType": "text"
                  },
                  {
                    "field": "symbol",
                    "headerName": "Symbol",
                    "cellDataType": "text"
                  },
                  {
                    "field": "qty",
                    "headerName": "Qty",
                    "cellDataType": "number",
                    "formatterFn": "int"
                  },
                  {
                    "field": "status",
                    "headerName": "Status",
                    "cellDataType": "text",
                    "renderFn": "titleCase"
                  }
                ]
              }
            },
            "staleTime": 900000
          }
        },
        "apps_json": [
          {
            "name": "Exception Intake Live",
            "description": "Venue exceptions and exception count.",
            "tabs": {
              "exceptions": {
                "id": "exceptions",
                "name": "Exceptions",
                "layout": [
                  {
                    "i": "venue_exception_form",
                    "x": 0,
                    "y": 0,
                    "w": 20,
                    "h": 10
                  }
                ]
              },
              "status": {
                "id": "status",
                "name": "Status",
                "layout": [
                  {
                    "i": "exception_metric",
                    "x": 0,
                    "y": 0,
                    "w": 8,
                    "h": 6
                  }
                ]
              }
            },
            "groups": []
          }
        ]
      }
    },
    {
      "tool": "manage_apps",
      "args": {
        "operation": "instantiate",
        "backend_id": "backend_001",
        "app_name": "Exception Intake Live",
        "dashboard_name": "Exception Intake Live Board",
        "activate": true
      }
    },
    {
      "tool": "update_widget",
      "args": {
        "widget_id": "venue_exception_form",
        "data_args": {
          "venue_scope": "EDGX"
        }
      }
    },
    {
      "tool": "add_generative_widget",
      "args": {
        "widget_type": "html",
        "name": "Exception Intake Live",
        "data": "<section>Exception Intake Live is live from Execution Desk Data: exception intake ready. Configured venue_scope=EDGX.</section>"
      }
    }
  ],
  "limits": {
    "max_turns": 14
  }
}
