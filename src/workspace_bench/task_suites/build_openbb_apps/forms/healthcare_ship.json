              "ticker": "MSFT"
            },
            {
              "phase": "Approved",
              "readout_date": "2026-01-15",
              "ticker": "NVDA"
            }
          ]
        },
        {
          "name": "healthcare-research-data__trial_readout_form",
          "widget_id": "trial_readout_form",
          "fields": [
            "trial_readout_form_value"
          ],
          "path": "/trial-readout-form",
          "payload": [
            {
              "trial_readout_form_value": 10.25
            },
            {
              "trial_readout_form_value": 20.5
            },
            {
              "trial_readout_form_value": 30.75
            }
          ],
          "form_endpoint": "/trial-readout-submit"
