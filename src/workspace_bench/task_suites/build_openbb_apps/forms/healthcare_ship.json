    "required_capabilities": [
      {
        "name": "capability_1_catalyst-metric",
        "datasets": [
          "healthcare-research-data__catalyst_metric"
        ],
        "widget_kind": "metric",
        "must_cover_fields": [
          "catalyst_metric_value"
        ],
        "required_param_kinds": [],
        "required_config": {}
      },
      {
        "name": "capability_2_trial-readout-form",
        "datasets": [
          "healthcare-research-data__trial_readout_form"
        ],
        "widget_kind": "form",
        "must_cover_fields": [
          "trial_readout_form_value"
        ],
        "required_param_kinds": [
          "button",
          "date",
          "form",
          "text",
          "ticker"
        ],
        "required_config": {}
      }
    ],
    "app_structure": {
      "required": true,
      "layout_refs_valid": true,
      "no_overlaps": true
    }
  },
  "oracle_tool_calls": [
    {
