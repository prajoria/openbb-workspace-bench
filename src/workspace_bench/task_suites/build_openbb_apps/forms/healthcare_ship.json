                "id": "trials",
                "name": "Trials",
                "layout": [
                  {
                    "i": "trial_readout_form",
                    "x": 0,
                    "y": 0,
                    "w": 20,
                    "h": 10
                  }
                ]
              },
              "status": {
                "id": "status",
                "name": "Status",
                "layout": [
                  {
                    "i": "catalyst_metric",
                    "x": 0,
                    "y": 0,
                    "w": 8,
                    "h": 6
                  }
                ]
              }
            },
            "groups": []
          }
        ]
      }
    },
    {
      "tool": "manage_apps",
      "args": {
        "operation": "instantiate",
        "backend_id": "backend_001",
        "app_name": "Trial Intake Live",
        "dashboard_name": "Trial Intake Live Board",
        "activate": true
      }
    },
    {
      "tool": "update_widget",
      "args": {
        "widget_id": "trial_readout_form",
