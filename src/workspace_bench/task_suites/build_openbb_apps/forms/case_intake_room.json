{
  "id": "case_intake_room",
  "category": "platform",
  "family": "forms",
  "specification_level": "partially-specified",
  "difficulty": "hard",
  "prompt": "Build a working Workspace experience for a surveillance analyst covering cases and compliance alerts. The workspace must cover escalate a surveillance case to a reviewer. The workspace must cover open surveillance alerts. Analysts need to inspect alert ID, desk, severity, age days. An analyst can choose the relevant business date. The user can enter the required details and submit the workflow. A selection in one part of the analysis stays linked to related results. Leave the complete working workspace open for review. Keep these source-contract anchors: `escalation` and `case_id`. Choose the rest of the architecture and avoid unrelated changes.",
  "business_terms": [
    "escalation",
    "case_id"
  ],
  "setup": {
    "fixtures": {},
    "initial_state": {},
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "trace_checks": {
      "max_invalid_tool_calls": 2,
      "max_repeated_snapshots": 2
    },
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 1,
      "max_custom_backend_delta": 1
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "surveillance-data__alert_queue",
          "widget_id": "alert_queue",
          "fields": [
            "age_days",
            "alert_id",
            "desk",
            "severity"
          ],
          "path": "/alert-queue",
          "payload": [
            {
              "age_days": 10.25,
              "alert_id": "alert_id-1",
              "desk": "Primary",
              "severity": "Primary"
            },
            {
              "age_days": 20.5,
              "alert_id": "alert_id-2",
              "desk": "Review",
              "severity": "Review"
            },
            {
              "age_days": 30.75,
              "alert_id": "alert_id-3",
              "desk": "Approved",
              "severity": "Approved"
            }
          ]
        },
        {
          "name": "surveillance-data__case_escalation_form",
          "widget_id": "case_escalation_form",
          "fields": [
            "case_escalation_form_value"
          ],
          "path": "/case-escalation",
          "payload": [
            {
              "case_escalation_form_value": 10.25
            },
            {
              "case_escalation_form_value": 20.5
            },
            {
              "case_escalation_form_value": 30.75
            }
          ],
          "form_endpoint": "/case-escalation-submit"
        }
      ],
      "pinned_paths": false
    },
    "required_capabilities": [
      {
        "name": "capability_1_alert-queue",
        "datasets": [
          "surveillance-data__alert_queue"
        ],
        "widget_kind": "table-like",
        "must_cover_fields": [
          "age_days",
          "alert_id",
          "desk",
          "severity"
        ],
        "required_param_kinds": [
          "text"
        ],
        "required_config": {}
      },
      {
        "name": "capability_2_case-escalation-form",
        "datasets": [
          "surveillance-data__case_escalation_form"
        ],
        "widget_kind": "form",
        "must_cover_fields": [
          "case_escalation_form_value"
        ],
        "required_param_kinds": [
          "button",
          "date",
          "form",
          "text"
        ],
        "required_config": {}
      }
    ],
    "capability_connections": [
      {
        "source": "capability_2_case-escalation-form",
        "target": "capability_1_alert-queue",
        "param_kind": "text"
      }
    ],
    "app_structure": {
      "required": true,
      "layout_refs_valid": true,
      "no_overlaps": true
    },
    "reference_trace": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Surveillance Data",
          "url": "http://localhost:7807",
          "widgets_json": {
            "case_escalation_form": {
              "name": "Case Escalation Form",
              "description": "Escalate a surveillance case to a reviewer.",
              "endpoint": "/case-escalation",
              "type": "table",
              "gridData": {
                "w": 20,
                "h": 10
              },
              "params": [
                {
                  "paramName": "escalation",
                  "type": "form",
                  "label": "Escalation",
                  "endpoint": "/case-escalation-submit",
                  "method": "POST",
                  "inputParams": [
                    {
                      "paramName": "case_id",
                      "type": "text",
                      "label": "Case",
                      "value": "C-1042"
                    },
                    {
                      "paramName": "due_date",
                      "type": "date",
                      "label": "Due date",
                      "value": "$currentDate+2d"
                    },
                    {
                      "paramName": "escalate",
                      "type": "button",
                      "label": "Escalate"
                    }
                  ]
                },
                {
                  "paramName": "case_scope",
                  "type": "text",
                  "label": "Case scope",
                  "value": "C-1042",
                  "description": "Case bundle reviewed by intake and status."
                }
              ],
              "data": {
                "valueField": "case_escalation_form_value"
              }
            },
            "alert_queue": {
              "name": "Alert Queue",
              "description": "Open surveillance alerts.",
              "endpoint": "/alert-queue",
              "type": "table",
              "gridData": {
                "w": 20,
                "h": 9
              },
              "params": [
                {
                  "paramName": "severity",
                  "type": "text",
                  "label": "Severity",
                  "value": "high",
                  "options": [
                    {
                      "label": "High",
                      "value": "high"
                    },
                    {
                      "label": "Medium",
                      "value": "medium"
                    },
                    {
                      "label": "Low",
                      "value": "low"
                    }
                  ]
                },
                {
                  "paramName": "case_scope",
                  "type": "text",
                  "label": "Case scope",
                  "value": "C-1042",
                  "description": "Case bundle reviewed by intake and status."
                }
              ],
              "data": {
                "table": {
                  "columnsDefs": [
                    {
                      "field": "alert_id",
                      "headerName": "Alert",
                      "cellDataType": "text"
                    },
                    {
                      "field": "desk",
                      "headerName": "Desk",
                      "cellDataType": "text"
                    },
                    {
                      "field": "severity",
                      "headerName": "Severity",
                      "cellDataType": "text",
                      "renderFn": "titleCase"
                    },
                    {
                      "field": "age_days",
                      "headerName": "Age (d)",
                      "cellDataType": "number",
                      "formatterFn": "int"
                    }
                  ]
                }
              }
            }
          },
          "apps_json": [
            {
              "name": "Case Intake Room",
              "description": "Case escalation and alert status.",
              "tabs": {
                "intake": {
                  "id": "intake",
                  "name": "Intake",
                  "layout": [
                    {
                      "i": "case_escalation_form",
                      "x": 0,
                      "y": 0,
                      "w": 20,
                      "h": 10
                    }
                  ]
                },
                "status": {
                  "id": "status",
                  "name": "Status",
                  "layout": [
                    {
                      "i": "alert_queue",
                      "x": 0,
                      "y": 0,
                      "w": 24,
                      "h": 10
                    }
                  ]
                }
              },
              "groups": [
                {
                  "name": "Case Sync",
                  "type": "param",
                  "paramName": "case_scope",
                  "widgetIds": [
                    "case_escalation_form",
                    "alert_queue"
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_001",
          "app_name": "Case Intake Room",
          "dashboard_name": "Case Intake Room Live",
          "activate": true
        }
      }
    ],
    "max_turns": 14
  }
}
