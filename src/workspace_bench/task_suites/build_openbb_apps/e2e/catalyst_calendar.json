                      "headerName": "Event Date",
                      "cellDataType": "dateString"
                    },
                    {
                      "field": "impact_score",
                      "headerName": "Impact Score",
                      "cellDataType": "number"
                    }
                  ]
                }
              },
              "params": [
                {
                  "paramName": "ticker",
                  "type": "text",
                  "label": "Ticker",
                  "value": "MRNA",
                  "description": "Catalyst Calendar Table focus field."
                }
              ]
            },
            "catalyst_metric": {
              "name": "Catalysts 30d",
              "description": "Catalysts in the next 30 days.",
              "endpoint": "/catalyst-count",
              "type": "metric",
              "gridData": {
                "w": 6,
                "h": 4
              },
              "data": {
                "valueField": "catalyst_metric_value"
              }
            }
          },
          "apps_json": [
            {
              "name": "Catalyst Calendar",
              "description": "Catalyst calendar and 30-day count.",
              "tabs": {
                "calendar": {
                  "id": "calendar",
                  "name": "Calendar",
                  "layout": [
                    {
                      "i": "catalyst_calendar_table",
                      "x": 0,
                      "y": 0,
                      "w": 20,
                      "h": 9
                    }
                  ]
                },
                "count": {
                  "id": "count",
                  "name": "Count",
                  "layout": [
                    {
                      "i": "catalyst_metric",
                      "x": 0,
                      "y": 0,
                      "w": 20,
                      "h": 9
                    }
                  ]
                }
              },
              "groups": []
            }
          ]
        }
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_001",
          "app_name": "Catalyst Calendar",
          "dashboard_name": "Catalyst Calendar Live",
          "activate": true
        }
      },
      {
        "tool": "update_widget",
        "args": {
          "widget_id": "catalyst_calendar_table",
          "data_args": {
            "ticker": "PFE"
          }
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Catalyst Calendar",
          "data": "Catalyst Calendar is live from Healthcare Research Data: catalyst calendar ready. Configured ticker=PFE."
        }
      }
    ],
    "limits": {
      "max_turns": 14
    }
  }
}
