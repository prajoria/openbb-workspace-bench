{
  "id": "catalyst_calendar",
  "category": "platform",
  "family": "e2e",
  "difficulty": "hard",
  "prompt": "Build a healthcare-research analyst a dependable clinical catalysts and pipelines workspace. The workspace must cover healthcare catalysts and impact scores. The workspace must cover catalysts in the next 30 days. Analysts need to inspect ticker, event, event date, impact score. An analyst can filter the analysis by ticker. Leave the complete working workspace open for review. Add a short completion note that naturally includes the desk-required terms 'Catalyst Calendar', 'Healthcare Research Data', 'PFE', 'ticker'. Decide how best to organize the experience and preserve unrelated work.",
  "business_terms": [
    "Catalyst Calendar",
    "Healthcare Research Data",
    "PFE",
    "ticker"
  ],
  "setup": {
    "fixtures": {},
    "initial_state": {},
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "Catalyst Calendar",
          "catalyst calendar",
          "Healthcare Research Data",
          "PFE"
        ],
        "min_count": 1
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 2,
      "max_repeated_snapshots": 2
    },
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 1,
      "max_custom_backend_delta": 1
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "healthcare-research-data__catalyst_calendar_table",
          "widget_id": "catalyst_calendar_table",
          "fields": [
            "event",
            "event_date",
            "impact_score",
            "ticker"
          ],
          "path": "/catalyst-calendar-table",
          "payload": [
            {
              "event": "event-1",
              "event_date": "2026-01-13",
              "impact_score": 10.25,
              "ticker": "AAPL"
            },
            {
              "event": "event-2",
              "event_date": "2026-01-14",
              "impact_score": 20.5,
              "ticker": "MSFT"
            },
            {
              "event": "event-3",
              "event_date": "2026-01-15",
              "impact_score": 30.75,
              "ticker": "NVDA"
            }
          ]
        },
        {
          "name": "healthcare-research-data__catalyst_metric",
          "widget_id": "catalyst_metric",
          "fields": [
            "catalyst_metric_value",
            "label",
            "value"
          ],
          "path": "/catalyst-count",
          "payload": {
            "catalyst_metric_value": 10.25,
            "label": "Catalysts 30d",
            "value": 42.5
          }
        }
      ],
      "pinned_paths": false
    },
    "required_capabilities": [
      {
        "name": "capability_1_catalyst-calendar-table",
        "datasets": [
          "healthcare-research-data__catalyst_calendar_table"
        ],
        "widget_kind": "table-like",
        "must_cover_fields": [
          "event",
          "event_date",
          "impact_score",
          "ticker"
        ],
        "required_param_kinds": [
          "ticker"
        ],
        "required_config": {}
      },
      {
        "name": "capability_2_catalyst-metric",
        "datasets": [
          "healthcare-research-data__catalyst_metric"
        ],
        "widget_kind": "metric",
        "must_cover_fields": [
          "catalyst_metric_value"
        ],
        "required_param_kinds": [],
        "required_config": {}
      }
    ],
    "app_structure": {
      "required": true,
      "layout_refs_valid": true,
      "no_overlaps": true
    },
    "business_names": [
      {
        "scope": "dashboard",
        "contains": "Catalyst Calendar"
      }
    ],
    "reference": [
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Healthcare Research Data",
          "url": "http://localhost:7808",
          "widgets_json": {
            "catalyst_calendar_table": {
              "name": "Catalyst Calendar Table",
              "description": "Healthcare catalysts and impact scores.",
              "endpoint": "/catalyst-calendar-table",
              "type": "table",
              "gridData": {
                "w": 20,
                "h": 9
              },
              "data": {
                "table": {
                  "columnsDefs": [
                    {
                      "field": "ticker",
                      "headerName": "Ticker",
                      "cellDataType": "text"
                    },
                    {
                      "field": "event",
                      "headerName": "Event",
                      "cellDataType": "text"
                    },
                    {
