{
  "id": "vendor_ops",
  "category": "platform",
  "family": "e2e",
  "difficulty": "hard",
  "prompt": "The desk needs a production-ready vendor service levels workflow for a vendor-operations manager. The workspace must cover vendor uptime and latency posture. The workspace must cover count of open SLA breaches. Analysts need to inspect vendor, uptime percentage, latency milliseconds, status. Leave the complete working workspace open for review. Add a short completion note that naturally includes the desk-required terms 'Vendor Ops', 'Vendor SLA Data', 'QuoteStream'. Use your judgment on the architecture and leave other work intact.",
  "business_terms": [
    "Vendor Ops",
    "Vendor SLA Data",
    "QuoteStream"
  ],
  "setup": {
    "fixtures": {},
    "initial_state": {},
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "Vendor Ops",
          "vendor ops",
          "Vendor SLA Data",
          "QuoteStream"
        ],
        "min_count": 1
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 2,
      "max_repeated_snapshots": 2
    },
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 1,
      "max_custom_backend_delta": 1
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "vendor-sla-data__breach_metric",
          "widget_id": "breach_metric",
          "fields": [
            "breach_metric_value",
            "label",
            "value"
          ],
          "path": "/breach-count",
          "payload": {
            "breach_metric_value": 10.25,
            "label": "Open Breaches",
            "value": 42.5
          }
        },
        {
          "name": "vendor-sla-data__vendor_ops_table",
          "widget_id": "vendor_ops_table",
          "fields": [
            "latency_ms",
            "status",
            "uptime_pct",
            "vendor"
          ],
          "path": "/vendor-ops-table",
          "payload": [
            {
              "latency_ms": 10.25,
              "status": "Primary",
              "uptime_pct": "2026-01-13",
              "vendor": "vendor-1"
            },
            {
              "latency_ms": 20.5,
              "status": "Review",
              "uptime_pct": "2026-01-14",
              "vendor": "vendor-2"
            },
            {
              "latency_ms": 30.75,
              "status": "Approved",
              "uptime_pct": "2026-01-15",
              "vendor": "vendor-3"
            }
          ]
        }
      ],
      "pinned_paths": false
    },
    "required_capabilities": [
      {
        "name": "capability_1_breach-metric",
        "datasets": [
          "vendor-sla-data__breach_metric"
        ],
        "widget_kind": "metric",
        "must_cover_fields": [
          "breach_metric_value"
        ],
        "required_param_kinds": [],
        "required_config": {}
      },
      {
        "name": "capability_2_vendor-ops-table",
        "datasets": [
          "vendor-sla-data__vendor_ops_table"
        ],
        "widget_kind": "table-like",
        "must_cover_fields": [
          "latency_ms",
          "status",
          "uptime_pct",
          "vendor"
        ],
        "required_param_kinds": [
          "text"
        ],
        "required_config": {}
      }
    ],
    "app_structure": {
      "required": true,
      "layout_refs_valid": true,
      "no_overlaps": true
    },
    "business_names": [
      {
        "scope": "dashboard",
        "contains": "Vendor Ops"
      }
    ],
    "reference_trace": [
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Vendor SLA Data",
          "url": "http://localhost:7804",
          "widgets_json": {
