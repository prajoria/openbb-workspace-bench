          ]
        }
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_001",
          "app_name": "Vendor Ops",
          "dashboard_name": "Vendor Ops Live",
          "activate": true
        }
      },
      {
        "tool": "update_widget",
        "args": {
          "widget_id": "vendor_ops_table",
          "data_args": {
            "vendor": "QuoteStream"
          }
        }
      },
      {
        "tool": "add_generative_widget",
        "args": {
          "widget_type": "note",
          "name": "Vendor Ops",
          "data": "Vendor Ops is live from Vendor SLA Data: vendor ops ready. Configured vendor=QuoteStream."
        }
      }
    ],
    "max_turns": 14
  }
}
