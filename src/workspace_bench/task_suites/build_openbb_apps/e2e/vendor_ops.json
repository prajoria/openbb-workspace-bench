                "w": 6,
                "h": 4
              },
              "data": {
                "valueField": "breach_metric_value"
              }
            }
          },
          "apps_json": [
            {
              "name": "Vendor Ops",
              "description": "Vendor uptime, latency, and breaches.",
              "tabs": {
                "vendors": {
                  "id": "vendors",
                  "name": "Vendors",
                  "layout": [
                    {
                      "i": "vendor_ops_table",
                      "x": 0,
