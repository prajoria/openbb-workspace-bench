                    {
                      "field": "latency_ms",
                      "headerName": "Latency Ms",
                      "cellDataType": "number"
                    },
                    {
                      "field": "status",
                      "headerName": "Status",
                      "cellDataType": "text"
                    }
                  ]
                }
              },
              "params": [
                {
                  "paramName": "vendor",
                  "type": "text",
                  "label": "Vendor",
