{
  "id": "earnings_ship",
  "category": "platform",
  "family": "charts",
  "difficulty": "hard",
  "split": "train",
  "prompt": "An equity-research analyst needs a decision-ready Workspace for earnings and estimates. The workspace must cover EPS beat and miss history. The workspace must cover average EPS surprise last 4 quarters. The workspace must cover street estimate revisions by quarter. Analysts need to inspect quarter, EPS estimate, revenue estimate billions. An analyst can filter the analysis by ticker. Leave the complete working workspace open for review. Add a short completion note that naturally includes the desk-required terms 'Earnings Chart Live', 'earnings history', 'Earnings Prep Data', 'MSFT', 'ticker'. Choose an effective architecture and avoid unrelated changes.",
  "business_terms": [
    "Earnings Chart Live",
    "earnings history",
    "Earnings Prep Data",
    "MSFT",
    "ticker"
  ],
  "fixtures": {},
  "initial_state": {},
  "allowed_tools": [
    "get_workspace_snapshot",
    "manage_dashboard",
    "manage_navigation_bar",
    "navigate_workspace",
    "list_available_widgets",
    "get_widget_schema",
    "get_params_options",
    "get_widget_data",
    "create_widget",
    "update_widget",
    "update_widget_layout",
    "delete_widget",
    "add_generative_widget",
    "read_widget",
    "manage_backends",
    "manage_apps",
    "get_skill_content",
    "read_workspace_resource",
    "get_workspace_prompt",
    "assign_tasks_to_agents"
  ],
  "success": {
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "Earnings Chart Live",
          "earnings history",
          "Earnings Prep Data",
          "MSFT"
        ],
        "min_count": 1
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 2,
      "max_repeated_snapshots": 2
    },
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 1,
      "max_custom_backend_delta": 1
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "earnings-prep-data__earnings_chart",
          "widget_id": "earnings_chart",
          "fields": [
            "earnings_chart_value"
          ],
          "path": "/eps-history",
          "payload": [
            {
              "earnings_chart_value": 10.25
            },
            {
              "earnings_chart_value": 20.5
            },
            {
              "earnings_chart_value": 30.75
            }
          ]
        },
        {
          "name": "earnings-prep-data__estimate_revisions",
          "widget_id": "estimate_revisions",
          "fields": [
            "eps_estimate",
            "quarter",
            "revenue_estimate_b"
          ],
          "path": "/estimate-revisions",
          "payload": [
            {
              "eps_estimate": 10.25,
              "quarter": "quarter-1",
              "revenue_estimate_b": 10.25
            },
            {
              "eps_estimate": 20.5,
              "quarter": "quarter-2",
              "revenue_estimate_b": 20.5
            },
            {
              "eps_estimate": 30.75,
              "quarter": "quarter-3",
              "revenue_estimate_b": 30.75
            }
          ]
        },
        {
          "name": "earnings-prep-data__surprise_metric",
          "widget_id": "surprise_metric",
          "fields": [
            "label",
            "surprise_metric_value",
            "value"
          ],
          "path": "/avg-surprise",
          "payload": {
            "label": "Avg Surprise",
            "surprise_metric_value": 10.25,
            "value": 42.5
          }
        }
      ],
      "pinned_paths": false
    },
    "required_capabilities": [
      {
        "name": "capability_1_earnings-chart",
        "datasets": [
          "earnings-prep-data__earnings_chart"
        ],
        "widget_kind": "chart-like",
        "must_cover_fields": [
          "earnings_chart_value"
        ],
        "required_param_kinds": [
          "ticker"
        ],
        "required_config": {
          "raw": true
        }
      },
      {
        "name": "capability_2_surprise-metric",
        "datasets": [
          "earnings-prep-data__surprise_metric"
        ],
        "widget_kind": "metric",
        "must_cover_fields": [
          "surprise_metric_value"
        ],
        "required_param_kinds": [],
        "required_config": {}
      }
    ],
    "app_structure": {
      "required": true,
      "layout_refs_valid": true,
      "no_overlaps": true
    },
    "polish": [
      {
        "code": "polish_refresh_policy",
        "backend_name": "Earnings Prep Data",
        "widget_id": "earnings_chart",
        "path": "staleTime",
        "expected": 900000
      }
    ]
  },
  "oracle_tool_calls": [
    {
      "tool": "manage_backends",
      "args": {
        "operation": "add",
        "name": "Earnings Prep Data",
        "url": "http://localhost:7805",
        "widgets_json": {
          "earnings_chart": {
            "name": "EPS History",
            "description": "Plotly EPS beat/miss history.",
            "endpoint": "/eps-history",
            "type": "chart",
            "gridData": {
              "w": 20,
              "h": 9
            },
            "params": [
              {
                "paramName": "symbol",
                "type": "endpoint",
                "label": "Symbol",
                "value": "AAPL",
                "optionsEndpoint": "/symbols"
              }
            ],
            "raw": true,
            "staleTime": 900000,
            "data": {
              "valueField": "earnings_chart_value"
            }
          },
          "surprise_metric": {
            "name": "Avg Surprise",
            "description": "Average EPS surprise last 4 quarters.",
            "endpoint": "/avg-surprise",
            "type": "metric",
            "gridData": {
              "w": 6,
              "h": 4
            },
            "staleTime": 900000,
            "data": {
              "valueField": "surprise_metric_value"
            }
          },
          "estimate_revisions": {
            "name": "Estimate Revisions",
            "description": "Street estimate revisions by quarter.",
            "endpoint": "/estimate-revisions",
            "type": "table",
            "gridData": {
              "w": 20,
              "h": 9
            },
            "params": [
              {
                "paramName": "symbol",
                "type": "endpoint",
                "label": "Symbol",
                "value": "AAPL",
                "optionsEndpoint": "/symbols"
              }
            ],
            "data": {
              "table": {
                "columnsDefs": [
                  {
                    "field": "quarter",
                    "headerName": "Quarter",
                    "cellDataType": "text"
                  },
                  {
                    "field": "eps_estimate",
                    "headerName": "EPS Est",
                    "cellDataType": "number"
                  },
                  {
                    "field": "revenue_estimate_b",
                    "headerName": "Revenue Est ($B)",
                    "cellDataType": "number"
                  }
                ]
              }
            },
            "staleTime": 900000
          }
        },
        "apps_json": [
          {
            "name": "Earnings Chart Live",
            "description": "EPS chart and surprise metric.",
            "tabs": {
              "earnings": {
                "id": "earnings",
                "name": "Earnings",
                "layout": [
                  {
                    "i": "earnings_chart",
                    "x": 0,
                    "y": 0,
                    "w": 20,
                    "h": 9
                  }
                ]
              },
              "signals": {
                "id": "signals",
                "name": "Signals",
                "layout": [
                  {
                    "i": "surprise_metric",
                    "x": 0,
                    "y": 0,
                    "w": 8,
                    "h": 5
                  }
                ]
              }
            },
            "groups": []
          }
        ]
      }
    },
    {
      "tool": "manage_apps",
      "args": {
        "operation": "instantiate",
        "backend_id": "backend_001",
        "app_name": "Earnings Chart Live",
        "dashboard_name": "Earnings Chart Live Board",
        "activate": true
      }
    },
    {
      "tool": "update_widget",
      "args": {
        "widget_id": "earnings_chart",
        "data_args": {
          "symbol": "MSFT"
        }
      }
    },
    {
      "tool": "add_generative_widget",
      "args": {
        "widget_type": "note",
        "name": "Earnings Chart Live",
        "data": "Earnings Chart Live shipped from Earnings Prep Data: earnings history live. Configured symbol=MSFT."
      }
    }
  ],
  "limits": {
    "max_turns": 14
  }
}
