{
  "id": "earnings_chart",
  "category": "platform",
  "family": "charts",
  "specification_level": "explicit",
  "difficulty": "hard",
  "prompt": "Register the backend and place the specified widget on the active dashboard. Use 'Earnings Prep Data' at http://localhost:7805. Choose a working chart representation for the data. The experience needs EPS History (`earnings_chart`, chart) using `/eps-history` for plotly EPS beat/miss history; user controls: Symbol (`symbol`, endpoint) from `/symbols`; cache for 15 minutes; consume the raw backend payload. Choose the appropriate Workspace tools, validate the result, and avoid unrelated changes.",
  "setup": {
    "fixtures": {},
    "initial_state": {},
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "required_widget_defs": [
      {
        "backend_name": "Earnings Prep Data",
        "widget_id": "earnings_chart",
        "expect": {
          "type": "chart",
          "endpoint": "/eps-history",
          "staleTime": 900000,
          "raw": true
        },
        "params_include": [
          {
            "paramName": "symbol",
            "type": "endpoint",
            "optionsEndpoint": "/symbols"
          }
        ],
        "columns_include": []
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 1,
      "max_repeated_snapshots": 2,
      "must_call_schema_before_create": true
    },
    "required_widgets": [
      {
        "origin": "Earnings Prep Data",
        "widget_id": "earnings_chart",
        "min_count": 1
      }
    ],
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 0,
      "max_custom_backend_delta": 1
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "earnings-prep-data__earnings_chart",
          "widget_id": "earnings_chart",
          "fields": [
            "category",
            "value"
          ],
          "path": "/eps-history",
          "payload": [
            {
              "category": "Primary",
              "value": 10.25
            },
            {
              "category": "Review",
              "value": 20.5
            },
            {
              "category": "Approved",
              "value": 30.75
            }
          ]
        }
      ],
      "pinned_paths": false
    },
    "reference": [
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Earnings Prep Data",
          "url": "http://localhost:7805",
          "widgets_json": {
            "earnings_chart": {
              "name": "EPS History",
              "description": "Plotly EPS beat/miss history.",
              "endpoint": "/eps-history",
              "type": "chart",
              "gridData": {
                "w": 20,
                "h": 9
              },
              "params": [
                {
                  "paramName": "symbol",
                  "type": "endpoint",
                  "label": "Symbol",
                  "value": "AAPL",
                  "optionsEndpoint": "/symbols"
                }
              ],
              "raw": true,
              "staleTime": 900000
            }
          }
        }
      },
      {
        "tool": "list_available_widgets",
        "args": {
          "origin": "Earnings Prep Data"
        }
      },
      {
        "tool": "get_widget_schema",
        "args": {
          "origin": "Earnings Prep Data",
          "widget_id": "earnings_chart"
        }
      },
      {
        "tool": "create_widget",
        "args": {
          "origin": "Earnings Prep Data",
          "widget_id": "earnings_chart"
        }
      }
    ],
    "limits": {
      "max_turns": 7
    }
  }
}
