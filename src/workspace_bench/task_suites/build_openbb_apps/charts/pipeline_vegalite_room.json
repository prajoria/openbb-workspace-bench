{
  "id": "pipeline_vegalite_room",
  "category": "platform",
  "family": "charts",
  "difficulty": "hard",
  "prompt": "The desk needs a production-ready clinical catalysts and pipelines workflow for a healthcare-research analyst. The workspace must cover distribution of pipeline phase mix. The workspace must cover upcoming clinical trial readouts. The workspace must cover catalysts in the next 30 days. Analysts need to inspect ticker, phase, readout date. An analyst can filter the analysis by ticker. A selection in one part of the analysis stays linked to related results. Leave the complete working workspace open for review. Use your judgment on the architecture and leave other work intact.",
  "business_terms": [
    "ticker"
  ],
  "setup": {
    "fixtures": {},
    "initial_state": {},
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "trace_checks": {
      "max_invalid_tool_calls": 2,
      "max_repeated_snapshots": 2
    },
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 1,
      "max_custom_backend_delta": 1
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "healthcare-research-data__catalyst_metric",
          "widget_id": "catalyst_metric",
          "fields": [
            "catalyst_metric_value",
            "label",
            "value"
          ],
          "path": "/catalyst-count",
          "payload": {
            "catalyst_metric_value": 10.25,
            "label": "Catalysts 30d",
            "value": 42.5
          }
        },
        {
          "name": "healthcare-research-data__pipeline_vegalite",
          "widget_id": "pipeline_vegalite",
          "fields": [
            "pipeline_vegalite_value"
          ],
          "path": "/pipeline-vegalite",
          "payload": [
            {
              "pipeline_vegalite_value": 10.25
            },
            {
              "pipeline_vegalite_value": 20.5
            },
            {
              "pipeline_vegalite_value": 30.75
            }
          ]
        },
        {
          "name": "healthcare-research-data__trial_catalysts",
          "widget_id": "trial_catalysts",
          "fields": [
            "phase",
            "readout_date",
            "ticker"
          ],
          "path": "/trial-catalysts",
          "payload": [
            {
              "phase": "Primary",
              "readout_date": "2026-01-13",
              "ticker": "AAPL"
            },
            {
              "phase": "Review",
              "readout_date": "2026-01-14",
              "ticker": "MSFT"
            },
            {
              "phase": "Approved",
              "readout_date": "2026-01-15",
              "ticker": "NVDA"
            }
          ]
        }
      ],
      "pinned_paths": false
    },
    "required_capabilities": [
      {
        "name": "capability_1_catalyst-metric",
        "datasets": [
          "healthcare-research-data__catalyst_metric"
        ],
        "widget_kind": "metric",
        "must_cover_fields": [
          "catalyst_metric_value"
        ],
        "required_param_kinds": [],
        "required_config": {}
      },
      {
        "name": "capability_2_pipeline-vegalite",
        "datasets": [
          "healthcare-research-data__pipeline_vegalite"
        ],
        "widget_kind": "chart-like",
        "must_cover_fields": [
          "pipeline_vegalite_value"
        ],
        "required_param_kinds": [
          "endpoint"
        ],
        "required_config": {}
      },
      {
        "name": "capability_3_trial-catalysts",
        "datasets": [
          "healthcare-research-data__trial_catalysts"
        ],
        "widget_kind": "table-like",
        "must_cover_fields": [
          "phase",
          "readout_date",
          "ticker"
        ],
        "required_param_kinds": [
          "endpoint",
          "ticker"
        ],
        "required_config": {}
      }
    ],
    "capability_connections": [
      {
        "source": "capability_2_pipeline-vegalite",
        "target": "capability_3_trial-catalysts",
        "param_kind": "endpoint"
      }
    ],
    "app_structure": {
      "required": true,
      "layout_refs_valid": true,
      "no_overlaps": true
    },
    "reference": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Healthcare Research Data",
          "url": "http://localhost:7808",
          "widgets_json": {
            "pipeline_vegalite": {
              "name": "Pipeline Mix (Vega-Lite)",
              "description": "Vega-Lite bar spec of pipeline phase mix.",
              "endpoint": "/pipeline-vegalite",
              "type": "chart-vegalite",
              "gridData": {
                "w": 20,
                "h": 9
              },
              "params": [
                {
                  "paramName": "pipeline_ticker",
                  "type": "endpoint",
                  "label": "Pipeline ticker",
                  "value": "PFE",
                  "optionsEndpoint": "/tickers"
                }
              ],
              "data": {
                "valueField": "pipeline_vegalite_value"
              }
            },
            "trial_catalysts": {
              "name": "Trial Catalysts",
              "description": "Upcoming clinical trial readouts.",
              "endpoint": "/trial-catalysts",
              "type": "table",
              "gridData": {
                "w": 20,
                "h": 9
              },
              "params": [
                {
                  "paramName": "ticker",
                  "type": "endpoint",
                  "label": "Ticker",
                  "value": "PFE",
                  "optionsEndpoint": "/tickers"
                },
                {
                  "paramName": "pipeline_ticker",
                  "type": "endpoint",
                  "label": "Pipeline ticker",
                  "value": "PFE",
                  "optionsEndpoint": "/tickers"
                }
              ],
              "data": {
                "table": {
                  "columnsDefs": [
                    {
                      "field": "ticker",
                      "headerName": "Ticker",
                      "cellDataType": "text"
                    },
                    {
                      "field": "phase",
                      "headerName": "Phase",
                      "cellDataType": "text"
                    },
                    {
                      "field": "readout_date",
                      "headerName": "Readout",
                      "cellDataType": "dateString"
                    }
                  ]
                }
              }
            },
            "catalyst_metric": {
              "name": "Catalysts 30d",
              "description": "Catalysts in the next 30 days.",
              "endpoint": "/catalyst-count",
              "type": "metric",
              "gridData": {
                "w": 6,
                "h": 4
              },
              "data": {
                "valueField": "catalyst_metric_value"
              }
            }
          },
          "apps_json": [
            {
              "name": "Pipeline Chart Room",
              "description": "Pipeline chart, trials, and catalyst count.",
              "tabs": {
                "pipeline": {
                  "id": "pipeline",
                  "name": "Pipeline",
                  "layout": [
                    {
                      "i": "pipeline_vegalite",
                      "x": 0,
                      "y": 0,
                      "w": 20,
                      "h": 9
                    },
                    {
                      "i": "catalyst_metric",
                      "x": 20,
                      "y": 0,
                      "w": 6,
                      "h": 4
                    }
                  ]
                },
                "trials": {
                  "id": "trials",
                  "name": "Trials",
                  "layout": [
                    {
                      "i": "trial_catalysts",
                      "x": 0,
                      "y": 0,
                      "w": 20,
                      "h": 9
                    }
                  ]
                }
              },
              "groups": [
                {
                  "name": "Pipeline Sync",
                  "type": "param",
                  "paramName": "pipeline_ticker",
                  "widgetIds": [
                    "pipeline_vegalite",
                    "trial_catalysts"
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_001",
          "app_name": "Pipeline Chart Room",
          "dashboard_name": "Pipeline Chart Room Live",
          "activate": true
        }
      }
    ],
    "limits": {
      "max_turns": 14
    }
  }
}
