                  {
                    "i": "yield_curve",
                    "x": 0,
                    "y": 0,
                    "w": 20,
                    "h": 9
                  }
                ]
              },
              "spread": {
                "id": "spread",
                "name": "Spread",
                "layout": [
                  {
                    "i": "curve_spread_metric",
                    "x": 0,
                    "y": 0,
                    "w": 6,
                    "h": 4
                  }
                ]
              }
            },
            "groups": [
              {
                "name": "Curve Sync",
                "type": "param",
                "paramName": "curve_scope",
                "widgetIds": [
                  "yield_curve",
                  "curve_spread_metric"
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "tool": "manage_apps",
      "args": {
        "operation": "instantiate",
        "backend_id": "backend_001",
        "app_name": "Rates Chart Room",
        "dashboard_name": "Rates Chart Room Live",
