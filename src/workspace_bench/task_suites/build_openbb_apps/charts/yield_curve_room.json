        {
          "name": "rates-watch-data__curve_spread_metric",
          "widget_id": "curve_spread_metric",
          "fields": [
            "curve_spread_metric_value",
            "label",
            "value"
          ],
          "path": "/curve-spread",
          "payload": {
            "curve_spread_metric_value": 10.25,
            "label": "2s10s Spread",
            "value": 42.5
          }
        },
        {
          "name": "rates-watch-data__yield_curve",
          "widget_id": "yield_curve",
          "fields": [
            "yield_curve_value"
          ],
          "path": "/yield-curve",
          "payload": [
            {
              "yield_curve_value": 10.25
            },
            {
              "yield_curve_value": 20.5
            },
            {
              "yield_curve_value": 30.75
            }
          ]
        }
      ],
      "pinned_paths": false
    },
    "required_capabilities": [
      {
        "name": "capability_1_curve-spread-metric",
        "datasets": [
          "rates-watch-data__curve_spread_metric"
        ],
        "widget_kind": "metric",
        "must_cover_fields": [
          "curve_spread_metric_value"
        ],
        "required_param_kinds": [
          "text"
        ],
        "required_config": {}
      },
      {
        "name": "capability_2_yield-curve",
        "datasets": [
          "rates-watch-data__yield_curve"
        ],
        "widget_kind": "chart-like",
        "must_cover_fields": [
          "yield_curve_value"
        ],
        "required_param_kinds": [
          "text"
        ],
        "required_config": {
          "raw": true
        }
      }
    ],
    "capability_connections": [
      {
        "source": "capability_2_yield-curve",
        "target": "capability_1_curve-spread-metric",
        "param_kind": "text"
      }
    ],
    "app_structure": {
      "required": true,
      "layout_refs_valid": true,
      "no_overlaps": true
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_snapshot",
      "args": {}
    },
    {
      "tool": "manage_backends",
      "args": {
        "operation": "add",
        "name": "Rates Watch Data",
        "url": "http://localhost:7803",
        "widgets_json": {
          "yield_curve": {
            "name": "Yield Curve",
            "description": "Plotly treasury yield curve snapshot.",
            "endpoint": "/yield-curve",
            "type": "chart",
            "gridData": {
              "w": 20,
              "h": 9
            },
            "raw": true,
            "params": [
              {
                "paramName": "curve_scope",
                "type": "text",
                "label": "Curve scope",
                "value": "UST 2s10s",
                "description": "Curve segment shared across chart and spread."
              }
            ],
            "data": {
              "valueField": "yield_curve_value"
            }
          },
          "curve_spread_metric": {
            "name": "2s10s Spread",
            "description": "Current 2s10s spread in bps.",
            "endpoint": "/curve-spread",
            "type": "metric",
            "gridData": {
              "w": 6,
              "h": 4
            },
            "params": [
              {
                "paramName": "curve_scope",
                "type": "text",
                "label": "Curve scope",
                "value": "UST 2s10s",
                "description": "Curve segment shared across chart and spread."
