{
  "id": "earnings_chart_room",
  "category": "platform",
  "family": "charts",
  "difficulty": "hard",
  "prompt": "The desk needs a production-ready earnings and estimates workflow for an equity-research analyst. The workspace must cover EPS beat and miss history. The workspace must cover street estimate revisions by quarter. The workspace must cover average EPS surprise last 4 quarters. Analysts need to inspect quarter, EPS estimate, revenue estimate billions. An analyst can filter the analysis by ticker. A selection in one part of the analysis stays linked to related results. Leave the complete working workspace open for review. Use your judgment on the architecture and leave other work intact.",
  "business_terms": [
    "ticker"
  ],
  "setup": {
    "fixtures": {},
    "initial_state": {},
    "allowed_tools": [
      "get_workspace_snapshot",
      "manage_dashboard",
      "manage_navigation_bar",
      "navigate_workspace",
      "list_available_widgets",
      "get_widget_schema",
      "get_params_options",
      "get_widget_data",
      "create_widget",
      "update_widget",
      "update_widget_layout",
      "delete_widget",
      "add_generative_widget",
      "read_widget",
      "manage_backends",
      "manage_apps",
      "get_skill_content",
      "read_workspace_resource",
      "get_workspace_prompt",
      "assign_tasks_to_agents"
    ]
  },
  "eval": {
    "trace_checks": {
      "max_invalid_tool_calls": 2,
      "max_repeated_snapshots": 2
    },
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 1,
      "max_custom_backend_delta": 1
    },
    "runtime_checks": {
      "datasets": [
        {
          "name": "earnings-prep-data__earnings_chart",
          "widget_id": "earnings_chart",
          "fields": [
            "earnings_chart_value"
          ],
          "path": "/eps-history",
          "payload": [
            {
              "earnings_chart_value": 10.25
            },
            {
              "earnings_chart_value": 20.5
            },
            {
              "earnings_chart_value": 30.75
            }
          ]
        },
        {
          "name": "earnings-prep-data__estimate_revisions",
          "widget_id": "estimate_revisions",
          "fields": [
            "eps_estimate",
            "quarter",
            "revenue_estimate_b"
          ],
          "path": "/estimate-revisions",
          "payload": [
            {
              "eps_estimate": 10.25,
              "quarter": "quarter-1",
              "revenue_estimate_b": 10.25
            },
            {
              "eps_estimate": 20.5,
              "quarter": "quarter-2",
              "revenue_estimate_b": 20.5
            },
            {
              "eps_estimate": 30.75,
              "quarter": "quarter-3",
              "revenue_estimate_b": 30.75
            }
          ]
        },
        {
          "name": "earnings-prep-data__surprise_metric",
          "widget_id": "surprise_metric",
          "fields": [
            "label",
            "surprise_metric_value",
            "value"
          ],
          "path": "/avg-surprise",
          "payload": {
            "label": "Avg Surprise",
            "surprise_metric_value": 10.25,
            "value": 42.5
          }
        }
      ],
      "pinned_paths": false
    },
    "required_capabilities": [
      {
        "name": "capability_1_earnings-chart",
        "datasets": [
          "earnings-prep-data__earnings_chart"
        ],
        "widget_kind": "chart-like",
        "must_cover_fields": [
          "earnings_chart_value"
        ],
        "required_param_kinds": [
          "text",
          "ticker"
        ],
        "required_config": {
          "raw": true
        }
      },
      {
        "name": "capability_2_estimate-revisions",
        "datasets": [
          "earnings-prep-data__estimate_revisions"
        ],
        "widget_kind": "table-like",
        "must_cover_fields": [
          "eps_estimate",
          "quarter",
          "revenue_estimate_b"
        ],
        "required_param_kinds": [
          "text",
          "ticker"
        ],
        "required_config": {}
      },
      {
        "name": "capability_3_surprise-metric",
        "datasets": [
          "earnings-prep-data__surprise_metric"
        ],
        "widget_kind": "metric",
        "must_cover_fields": [
          "surprise_metric_value"
        ],
        "required_param_kinds": [],
        "required_config": {}
      }
    ],
    "capability_connections": [
      {
        "source": "capability_1_earnings-chart",
        "target": "capability_2_estimate-revisions",
        "param_kind": "text"
      }
    ],
    "app_structure": {
      "required": true,
      "layout_refs_valid": true,
      "no_overlaps": true
    },
    "reference_trace": [
      {
        "tool": "get_workspace_snapshot",
        "args": {}
      },
      {
        "tool": "manage_backends",
        "args": {
          "operation": "add",
          "name": "Earnings Prep Data",
          "url": "http://localhost:7805",
          "widgets_json": {
            "earnings_chart": {
              "name": "EPS History",
              "description": "Plotly EPS beat/miss history.",
              "endpoint": "/eps-history",
              "type": "chart",
              "gridData": {
                "w": 20,
                "h": 9
              },
              "params": [
                {
                  "paramName": "symbol",
                  "type": "endpoint",
                  "label": "Symbol",
                  "value": "AAPL",
                  "optionsEndpoint": "/symbols"
                },
                {
                  "paramName": "period",
                  "type": "text",
                  "label": "Period",
                  "value": "quarterly",
                  "options": [
                    {
                      "label": "Quarterly",
                      "value": "quarterly"
                    },
                    {
                      "label": "Annual",
                      "value": "annual"
                    }
                  ]
                }
              ],
              "raw": true,
              "data": {
                "valueField": "earnings_chart_value"
              }
            },
            "estimate_revisions": {
              "name": "Estimate Revisions",
              "description": "Street estimate revisions by quarter.",
              "endpoint": "/estimate-revisions",
              "type": "table",
              "gridData": {
                "w": 20,
                "h": 9
              },
              "params": [
                {
                  "paramName": "symbol",
                  "type": "endpoint",
                  "label": "Symbol",
                  "value": "AAPL",
                  "optionsEndpoint": "/symbols"
                },
                {
                  "paramName": "period",
                  "type": "text",
                  "label": "Period",
                  "value": "quarterly",
                  "options": [
                    {
                      "label": "Quarterly",
                      "value": "quarterly"
                    },
                    {
                      "label": "Annual",
                      "value": "annual"
                    }
                  ]
                }
              ],
              "data": {
                "table": {
                  "columnsDefs": [
                    {
                      "field": "quarter",
                      "headerName": "Quarter",
                      "cellDataType": "text"
                    },
                    {
                      "field": "eps_estimate",
                      "headerName": "EPS Est",
                      "cellDataType": "number"
                    },
                    {
                      "field": "revenue_estimate_b",
                      "headerName": "Revenue Est ($B)",
                      "cellDataType": "number"
                    }
                  ]
                }
              }
            },
            "surprise_metric": {
              "name": "Avg Surprise",
              "description": "Average EPS surprise last 4 quarters.",
              "endpoint": "/avg-surprise",
              "type": "metric",
              "gridData": {
                "w": 6,
                "h": 4
              },
              "data": {
                "valueField": "surprise_metric_value"
              }
            }
          },
          "apps_json": [
            {
              "name": "Earnings Chart Room",
              "description": "EPS chart, revisions, and surprise metric.",
              "tabs": {
                "chart": {
                  "id": "chart",
                  "name": "Chart",
                  "layout": [
                    {
                      "i": "earnings_chart",
                      "x": 0,
                      "y": 0,
                      "w": 20,
                      "h": 9
                    },
                    {
                      "i": "surprise_metric",
                      "x": 20,
                      "y": 0,
                      "w": 6,
                      "h": 4
                    }
                  ]
                },
                "revisions": {
                  "id": "revisions",
                  "name": "Revisions",
                  "layout": [
                    {
                      "i": "estimate_revisions",
                      "x": 0,
                      "y": 0,
                      "w": 20,
                      "h": 9
                    }
                  ]
                }
              },
              "groups": [
                {
                  "name": "Period Sync",
                  "type": "param",
                  "paramName": "period",
                  "widgetIds": [
                    "earnings_chart",
                    "estimate_revisions"
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "tool": "manage_apps",
        "args": {
          "operation": "instantiate",
          "backend_id": "backend_001",
          "app_name": "Earnings Chart Room",
          "dashboard_name": "Earnings Chart Room Live",
          "activate": true
        }
      }
    ],
    "max_turns": 14
  }
}
