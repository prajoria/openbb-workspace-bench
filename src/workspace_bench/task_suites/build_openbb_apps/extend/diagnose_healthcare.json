{
  "id": "diagnose_healthcare",
  "category": "repair",
  "family": "extend",
  "specification_level": "partially-specified",
  "difficulty": "hard",
  "prompt": "Deliver an analyst-ready Workspace solution for clinical catalysts and pipelines. The workspace must cover upcoming clinical trial readouts. The workspace must cover distribution of pipeline phase mix. The workspace must cover FDA decision and notice feed. The workspace must cover catalysts in the next 30 days. Analysts need to inspect ticker, phase, readout date. An analyst can filter the analysis by ticker. Use `ticker` and `phase` as the only fixed contract anchors, and make the other implementation choices yourself without collateral changes.",
  "business_terms": [
    "ticker",
    "phase"
  ],
  "setup": {
    "fixtures": {},
    "initial_state": {
      "custom_backends": [
        {
          "name": "Healthcare Research Data",
          "url": "http://localhost:7808",
          "backend_id": "backend_001",
          "widgets_json": {
            "trial_catalysts": {
              "name": "Trial Catalysts",
              "description": "Upcoming clinical trial readouts.",
              "endpoint": "/trial-catalysts",
              "type": "table",
              "gridData": {
                "w": 20,
                "h": 9
              },
              "params": [
                {
                  "paramName": "ticker",
                  "type": "endpoint",
                  "label": "Ticker",
                  "value": "PFE",
                  "optionsEndpoint": "/tickers"
                }
              ],
              "data": {
                "table": {
                  "columnsDefs": [
                    {
                      "field": "ticker",
