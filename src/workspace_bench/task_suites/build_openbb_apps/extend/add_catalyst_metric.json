      {
        "backend_name": "Healthcare Research Data",
        "widget_id": "catalyst_metric",
        "expect": {
          "type": "metric",
          "endpoint": "/catalyst-count",
          "staleTime": 900000
        },
        "params_include": [],
        "columns_include": []
      },
      {
        "backend_name": "Healthcare Research Data",
        "widget_id": "pipeline_chart",
        "expect": {
          "type": "chart",
          "endpoint": "/pipeline-by-phase"
        },
        "params_include": [],
        "columns_include": []
      }
    ],
    "trace_checks": {
