        "origin": "Healthcare Research Data",
        "widget_id": "pipeline_chart",
        "min_count": 1
      }
    ],
    "workspace_checks": {
      "preserve_other_dashboards": true,
      "max_dashboard_delta": 0,
      "max_custom_backend_delta": 0
