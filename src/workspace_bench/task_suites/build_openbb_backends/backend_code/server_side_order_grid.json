{
  "allowed_tools": [
    "filesystem",
    "shell"
  ],
  "category": "platform",
  "code_task": {
    "command_timeout_ms": 120000,
    "core_module": "app.py",
    "health_path": "/health",
    "install_command": [
      "uv",
      "sync",
      "--quiet"
    ],
    "oracle_path": "fixtures/server_side_order_grid/oracle",
    "probes": [
      {
        "expected_values": {
          "first_symbol": "NVDA",
          "page_size": 2,
          "totalRows": 5
        },
        "field_types": {
          "order_id": "string",
          "price": "number",
          "status": "string",
          "symbol": "string"
        },
        "json_body": {
