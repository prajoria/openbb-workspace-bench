          "sortModel": [
            {
              "colId": "symbol",
              "sort": "desc"
            }
          ],
          "startRow": 1
        },
        "method": "POST",
        "minimum_items": 2,
        "name": "sorted order page",
        "path": "/orders/search",
        "query": {},
        "required_fields": [
          "order_id",
          "symbol",
          "price",
          "status"
        ],
        "widget_id": "order_search"
      }
    ],
    "request_timeout_ms": 3000,
    "require_apps": false,
    "schema_version": "workspace-bench-code-task/v0",
    "start_command": [
      "{python}",
      "-m",
      "uvicorn",
      "app:app",
      "--host",
      "127.0.0.1",
      "--port",
      "{port}"
    ],
    "starter_path": "fixtures/server_side_order_grid/starter",
    "startup_timeout_ms": 20000,
    "test_command": [
      "{python}",
      "-m",
      "pytest",
      "-q",
      "--junitxml={junit}"
    ]
  },
  "difficulty": "hard",
  "family": "backend-code",
  "fixtures": {
    "backends": []
  },
  "id": "server_side_order_grid",
  "initial_state": {},
  "limits": {
    "max_turns": 40
  },
  "oracle_tool_calls": [],
  "prompt": "Execution operations needs a responsive server-side order grid. Implement POST-backed pagination and single-column sorting from the supplied row-model request. Return the requested slice, total row count, page size, and first visible symbol accurately.",
  "split": "test",
  "success": {}
}
