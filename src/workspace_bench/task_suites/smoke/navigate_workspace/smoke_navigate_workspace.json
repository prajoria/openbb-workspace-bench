{
  "id": "smoke_navigate_workspace",
  "category": "dashboard",
  "family": "navigate_workspace",
  "specification_level": "explicit",
  "difficulty": "easy",
  "prompt": "Use navigate_workspace operation='tab' to switch to tab_id 'details', then use add_generative_widget to add a note named 'Navigation Marker' on that tab.",
  "business_terms": [],
  "fixtures": {},
  "initial_state": {
    "dashboard": {
      "name": "Smoke navigate_workspace",
      "tabs": [
        {
          "id": "overview",
          "name": "Overview"
        },
        {
          "id": "details",
          "name": "Details"
        }
      ],
      "widgets": [],
      "activate": true
    }
  },
  "allowed_tools": [
    "navigate_workspace",
    "add_generative_widget"
  ],
  "success": {
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "name_contains": "Navigation Marker",
        "tab_id": "details"
      }
    ]
  },
  "oracle_tool_calls": [
    {
      "tool": "navigate_workspace",
      "args": {
        "operation": "tab",
        "tab_id": "details"
      }
    },
    {
      "tool": "add_generative_widget",
      "args": {
        "widget_type": "note",
        "name": "Navigation Marker",
        "data": "Navigation round trip complete."
      }
    }
  ],
  "limits": {
    "max_turns": 2
  }
}
