  "prompt": "Check the workspace, then connect \"Rates Watch Data\" at http://localhost:7803. Its widgets.json serves one widget \u2014 `curve_monitor_iframe`: name \"Curve Monitor App\", description \"Embedded standalone curve monitor application.\", endpoint http://localhost:5173, type iframe, sized w=24 h=16 on the grid. Its apps.json ships an app named \"Curve Monitor\" (description \"Embedded curve monitor.\") with a single tab `monitor` named \"Monitor\" that places `curve_monitor_iframe` at x=0 y=0 w=24 h=16. Publish both in the same manage_backends add.",
  "fixtures": {},
  "initial_state": {},
  "allowed_tools": [
    "get_workspace_snapshot",
    "manage_backends"
  ],
  "success": {
    "required_widget_defs": [
      {
        "backend_name": "Rates Watch Data",
        "widget_id": "curve_monitor_iframe",
        "expect": {
          "type": "iframe",
          "endpoint": "http://localhost:5173",
          "gridData.w": 24,
          "gridData.h": 16
        }
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Rates Watch Data",
        "layout_refs_valid": true,
        "no_overlaps": true,
        "name_contains": "Curve Monitor",
        "tabs_include": [
          "monitor"
        ],
        "tab_count": 1,
        "widgets_on_tab": [
          {
            "tab_id": "monitor",
            "widget_id": "curve_monitor_iframe"
          }
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 1,
      "max_repeated_snapshots": 2
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_snapshot",
      "args": {}
    },
    {
      "tool": "manage_backends",
      "args": {
        "operation": "add",
        "name": "Rates Watch Data",
        "url": "http://localhost:7803",
        "widgets_json": {
