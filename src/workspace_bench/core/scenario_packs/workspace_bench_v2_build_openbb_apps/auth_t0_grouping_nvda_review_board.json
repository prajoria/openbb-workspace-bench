  "prompt": "Your backend \"Earnings Prep Data\" is already connected and serves `estimate_revisions`, `earnings_chart`. Ship its apps.json - exactly one grouped app: app \"NVDA Review Board\", description \"A second symbol-synced earnings review.\", tab `nvda` named \"NVDA\" places: `estimate_revisions` at x=0 y=0 w=20 h=9; `earnings_chart` at x=20 y=0 w=12 h=9, group \"NVDA Symbol Sync\" (type param) syncing param symbol across [\"estimate_revisions\", \"earnings_chart\"]. Submit it with manage_backends refresh (apps_json).",
  "fixtures": {},
  "initial_state": {
    "custom_backends": [
      {
        "name": "Earnings Prep Data",
        "url": "http://localhost:7805",
        "backend_id": "backend_001",
        "widgets_json": {
          "estimate_revisions": {
            "name": "Estimate Revisions",
            "description": "Street estimate revisions by quarter.",
            "endpoint": "/estimate-revisions",
            "type": "table",
            "gridData": {
              "w": 20,
              "h": 9
            },
            "params": [
              {
                "paramName": "symbol",
                "type": "endpoint",
                "label": "Symbol",
                "value": "AAPL",
                "optionsEndpoint": "/symbols"
              }
            ],
            "data": {
              "table": {
                "columnsDefs": [
                  {
                    "field": "quarter",
                    "headerName": "Quarter",
                    "cellDataType": "text"
                  },
                  {
                    "field": "eps_estimate",
                    "headerName": "EPS Est",
                    "cellDataType": "number"
                  },
                  {
                    "field": "revenue_estimate_b",
                    "headerName": "Revenue Est ($B)",
                    "cellDataType": "number"
                  }
                ]
              }
            }
          },
          "earnings_chart": {
            "name": "EPS History",
            "description": "Plotly EPS beat/miss history.",
            "endpoint": "/eps-history",
            "type": "chart",
            "gridData": {
              "w": 20,
              "h": 9
            },
            "params": [
              {
                "paramName": "symbol",
                "type": "endpoint",
                "label": "Symbol",
                "value": "AAPL",
                "optionsEndpoint": "/symbols"
              }
            ],
            "raw": true
          }
        }
      }
    ]
  },
  "allowed_tools": [
    "get_workspace_snapshot",
    "manage_backends"
  ],
  "success": {
    "required_app_defs": [
      {
        "backend_name": "Earnings Prep Data",
        "layout_refs_valid": true,
        "no_overlaps": true,
        "name_contains": "NVDA Review Board",
        "tabs_include": [
          "nvda"
        ],
        "tab_count": 1,
        "widgets_on_tab": [
          {
            "tab_id": "nvda",
            "widget_id": "estimate_revisions"
          },
          {
            "tab_id": "nvda",
            "widget_id": "earnings_chart"
          }
        ],
        "groups_include": [
          {
            "name": "NVDA Symbol Sync",
            "type": "param",
            "paramName": "symbol",
            "widgetIds_include": [
              "estimate_revisions",
              "earnings_chart"
            ]
          }
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 1,
      "max_repeated_snapshots": 2
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_snapshot",
      "args": {}
    },
    {
      "tool": "manage_backends",
      "args": {
        "operation": "refresh",
        "backend_id": "backend_001",
        "apps_json": [
          {
            "name": "NVDA Review Board",
            "description": "A second symbol-synced earnings review.",
            "tabs": {
              "nvda": {
                "id": "nvda",
                "name": "NVDA",
                "layout": [
                  {
                    "i": "estimate_revisions",
                    "x": 0,
                    "y": 0,
                    "w": 20,
                    "h": 9
                  },
                  {
                    "i": "earnings_chart",
                    "x": 20,
                    "y": 0,
                    "w": 12,
                    "h": 9
                  }
                ]
              }
            },
            "groups": [
              {
                "name": "NVDA Symbol Sync",
                "type": "param",
                "paramName": "symbol",
                "widgetIds": [
                  "estimate_revisions",
                  "earnings_chart"
                ]
              }
            ]
          }
        ]
      }
    }
  ],
  "domain": "finance",
