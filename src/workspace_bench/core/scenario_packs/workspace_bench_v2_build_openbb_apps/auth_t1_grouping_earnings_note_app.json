{
  "id": "auth_t1_grouping_earnings_note_app",
  "title": "Ship Earnings Preview with a grouping app",
  "workflow": "earnings-prep",
  "subdomain": "equity-research",
  "tags": [
    "family-grouping",
    "tier-t1",
    "cell3",
    "build-openbb-apps",
    "widgets-json",
    "apps-json",
    "grouping"
  ],
  "prompt": "Build widgets.json (`earnings_note`: name \"Earnings Preview\", description \"Preview note for the earnings call.\", endpoint /earnings-preview, type markdown, sized w=12 h=8 on the grid, params required: symbol \u2014 a dropdown (type endpoint), labeled \"Symbol\", options fetched from /symbols, default \"AAPL\") and apps.json (app \"Preview Group App\", description \"Grouped earnings preview by symbol.\", tab `preview` named \"Preview\" places: `earnings_note` at x=0 y=0 w=20 h=9, group \"Preview Symbol Group\" (type param) syncing param symbol across [\"earnings_note\"]) for \"Earnings Prep Data\" at http://localhost:7805; add them together.",
  "fixtures": {},
  "initial_state": {},
  "allowed_tools": [
    "get_workspace_snapshot",
    "manage_backends"
  ],
  "success": {
    "required_widget_defs": [
      {
        "backend_name": "Earnings Prep Data",
        "widget_id": "earnings_note",
        "expect": {
          "type": "markdown",
          "endpoint": "/earnings-preview",
          "gridData.w": 12,
          "gridData.h": 8
        },
        "params_include": [
          {
            "paramName": "symbol",
            "type": "endpoint",
            "optionsEndpoint": "/symbols"
          }
        ]
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Earnings Prep Data",
        "layout_refs_valid": true,
        "no_overlaps": true,
        "name_contains": "Preview Group App",
        "tabs_include": [
          "preview"
        ],
        "tab_count": 1,
        "widgets_on_tab": [
          {
            "tab_id": "preview",
            "widget_id": "earnings_note"
          }
        ],
        "groups_include": [
          {
            "name": "Preview Symbol Group",
            "type": "param",
            "paramName": "symbol",
            "widgetIds_include": [
              "earnings_note"
            ]
          }
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 1,
      "max_repeated_snapshots": 2
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_snapshot",
      "args": {}
    },
    {
      "tool": "manage_backends",
      "args": {
        "operation": "add",
        "name": "Earnings Prep Data",
        "url": "http://localhost:7805",
        "widgets_json": {
          "earnings_note": {
            "name": "Earnings Preview",
            "description": "Preview note for the earnings call.",
            "endpoint": "/earnings-preview",
            "type": "markdown",
            "gridData": {
              "w": 12,
              "h": 8
            },
            "params": [
              {
                "paramName": "symbol",
                "type": "endpoint",
                "label": "Symbol",
                "value": "AAPL",
                "optionsEndpoint": "/symbols"
              }
            ]
          }
        },
        "apps_json": [
          {
            "name": "Preview Group App",
            "description": "Grouped earnings preview by symbol.",
            "tabs": {
              "preview": {
                "id": "preview",
                "name": "Preview",
                "layout": [
                  {
                    "i": "earnings_note",
                    "x": 0,
                    "y": 0,
                    "w": 20,
                    "h": 9
                  }
                ]
              }
            },
            "groups": [
              {
                "name": "Preview Symbol Group",
                "type": "param",
                "paramName": "symbol",
                "widgetIds": [
                  "earnings_note"
                ]
              }
            ]
          }
        ]
      }
    }
  ],
  "domain": "finance",
  "source": "workspace-bench-build-apps-gen",
  "level": "L3",
  "capability": "widget-building",
  "difficulty": "medium",
  "limits": {
    "max_turns": 5
  },
  "split": "train",
  "novelty": "Unique grouping/t1 building exercise using get_workspace_snapshot, manage_backends with checks app_def, repeated_snapshots, too_many_invalid_calls, widget_def on custom:Earnings Prep Data; artifact widgetdefs:Earnings Prep Data/earnings_note; appdefs:Earnings Prep Data/Preview Group App."
}
