{
  "id": "auth_t0_params_kpi_tabs_table",
  "title": "Build the KPI Tabs parameter widget",
  "workflow": "earnings-prep",
  "subdomain": "equity-research",
  "tags": [
    "family-params",
    "tier-t0",
    "cell4",
    "build-openbb-apps",
    "widgets-json",
    "params"
  ],
  "prompt": "Connect a new custom backend named \"Earnings Prep Data\" at http://localhost:7805. Its widgets.json serves exactly one widget - `kpi_tabs_table`: name \"KPI Tabs\", description \"KPI table with static and dynamic tab views.\", endpoint /kpi-tabs, type table, sized w=24 h=10 on the grid, params required: view \u2014 a tabs switcher (type tabs), labeled \"View\", static options [\"Growth\"=\"growth\", \"Margins\"=\"margins\"], default \"growth\". Register it with manage_backends.",
  "fixtures": {},
  "initial_state": {},
  "allowed_tools": [
    "get_workspace_snapshot",
    "manage_backends"
  ],
  "success": {
    "required_widget_defs": [
      {
        "backend_name": "Earnings Prep Data",
        "widget_id": "kpi_tabs_table",
        "expect": {
          "type": "table",
          "endpoint": "/kpi-tabs",
          "gridData.w": 24,
          "gridData.h": 10
        },
        "params_include": [
          {
            "paramName": "view",
            "type": "tabs"
          }
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 1,
      "max_repeated_snapshots": 2
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "manage_backends",
      "args": {
        "operation": "add",
        "name": "Earnings Prep Data",
        "url": "http://localhost:7805",
        "widgets_json": {
          "kpi_tabs_table": {
            "name": "KPI Tabs",
            "description": "KPI table with static and dynamic tab views.",
            "endpoint": "/kpi-tabs",
            "type": "table",
            "gridData": {
              "w": 24,
              "h": 10
            },
            "params": [
              {
                "paramName": "view",
                "type": "tabs",
                "label": "View",
                "value": "growth",
                "options": [
                  {
                    "label": "Growth",
                    "value": "growth"
                  },
                  {
                    "label": "Margins",
                    "value": "margins"
                  }
                ]
              }
            ]
          }
        }
      }
    }
  ],
  "domain": "finance",
  "source": "workspace-bench-build-apps-gen",
  "level": "L3",
  "capability": "widget-building",
  "difficulty": "easy",
  "limits": {
    "max_turns": 4
  },
  "split": "train",
  "novelty": "Unique params/t0 building exercise using manage_backends with checks repeated_snapshots, too_many_invalid_calls, widget_def on custom:Earnings Prep Data; artifact widgetdefs:Earnings Prep Data/kpi_tabs_table."
}
