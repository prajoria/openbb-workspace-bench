  "success": {
    "required_app_defs": [
      {
        "backend_name": "Vendor SLA Data",
        "layout_refs_valid": true,
        "no_overlaps": true,
        "name_contains": "Vendor Command",
        "tabs_include": [
          "vendors"
        ],
        "tab_count": 1,
        "widgets_on_tab": [
          {
            "tab_id": "vendors",
            "widget_id": "vendor_sla_table"
          },
          {
            "tab_id": "vendors",
            "widget_id": "breach_metric"
          },
          {
            "tab_id": "vendors",
            "widget_id": "sla_newsfeed"
          }
        ],
        "prompts_min_count": 1
      }
