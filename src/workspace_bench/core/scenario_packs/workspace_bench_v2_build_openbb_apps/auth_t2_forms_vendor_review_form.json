      "args": {}
    },
    {
      "tool": "manage_backends",
      "args": {
        "operation": "add",
        "name": "Vendor SLA Data",
        "url": "http://localhost:7804",
        "widgets_json": {
          "vendor_review_form": {
            "name": "Vendor Review Form",
            "description": "Create a vendor review item.",
