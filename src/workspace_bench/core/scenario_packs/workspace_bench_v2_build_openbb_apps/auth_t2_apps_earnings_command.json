  "prompt": "Check the workspace. Your backend \"Earnings Prep Data\" already serves `estimate_revisions`, `earnings_chart`, `surprise_metric`; its apps.json is missing. Build it \u2014 one app: app \"Earnings Command\", description \"Symbol-synced earnings review.\", tab `review` named \"Review\" places: `estimate_revisions` at x=0 y=0 w=20 h=9; `earnings_chart` at x=20 y=0 w=12 h=9 preset with params {\"symbol\": \"NVDA\"}; `surprise_metric` at x=32 y=0 w=8 h=6, group \"Symbol Sync\" (type param) syncing param symbol across [\"estimate_revisions\", \"earnings_chart\"]. Ship it via manage_backends refresh.",
  "fixtures": {},
  "initial_state": {
    "custom_backends": [
      {
        "name": "Earnings Prep Data",
        "url": "http://localhost:7805",
        "backend_id": "backend_001",
        "widgets_json": {
          "estimate_revisions": {
            "name": "Estimate Revisions",
            "description": "Street estimate revisions by quarter.",
            "endpoint": "/estimate-revisions",
            "type": "table",
            "gridData": {
              "w": 20,
              "h": 9
            },
            "params": [
              {
                "paramName": "symbol",
                "type": "endpoint",
                "label": "Symbol",
                "value": "AAPL",
                "optionsEndpoint": "/symbols"
              }
            ],
            "data": {
              "table": {
                "columnsDefs": [
                  {
                    "field": "quarter",
                    "headerName": "Quarter",
                    "cellDataType": "text"
                  },
                  {
                    "field": "eps_estimate",
                    "headerName": "EPS Est",
                    "cellDataType": "number"
                  },
                  {
                    "field": "revenue_estimate_b",
                    "headerName": "Revenue Est ($B)",
                    "cellDataType": "number"
                  }
                ]
              }
            }
          },
          "earnings_chart": {
            "name": "EPS History",
            "description": "Plotly EPS beat/miss history.",
            "endpoint": "/eps-history",
            "type": "chart",
            "gridData": {
              "w": 20,
              "h": 9
            },
            "params": [
              {
                "paramName": "symbol",
                "type": "endpoint",
                "label": "Symbol",
                "value": "AAPL",
                "optionsEndpoint": "/symbols"
              }
            ],
            "raw": true
          },
          "surprise_metric": {
            "name": "Avg Surprise",
            "description": "Average EPS surprise last 4 quarters.",
            "endpoint": "/avg-surprise",
            "type": "metric",
            "gridData": {
              "w": 6,
              "h": 4
            }
          }
        }
      }
    ]
  },
  "allowed_tools": [
    "get_workspace_snapshot",
    "manage_backends"
  ],
  "success": {
    "required_app_defs": [
      {
        "backend_name": "Earnings Prep Data",
        "layout_refs_valid": true,
        "no_overlaps": true,
        "name_contains": "Earnings Command",
        "tabs_include": [
          "review"
        ],
        "tab_count": 1,
        "widgets_on_tab": [
          {
            "tab_id": "review",
            "widget_id": "estimate_revisions"
          },
          {
            "tab_id": "review",
            "widget_id": "earnings_chart"
          },
          {
            "tab_id": "review",
            "widget_id": "surprise_metric"
          }
        ],
        "groups_include": [
          {
            "name": "Symbol Sync",
            "type": "param",
            "paramName": "symbol",
            "widgetIds_include": [
              "estimate_revisions",
              "earnings_chart"
            ]
          }
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 1,
      "max_repeated_snapshots": 2
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_snapshot",
      "args": {}
    },
    {
      "tool": "manage_backends",
      "args": {
        "operation": "refresh",
        "backend_id": "backend_001",
        "apps_json": [
          {
            "name": "Earnings Command",
            "description": "Symbol-synced earnings review.",
            "tabs": {
              "review": {
                "id": "review",
                "name": "Review",
                "layout": [
                  {
                    "i": "estimate_revisions",
                    "x": 0,
                    "y": 0,
                    "w": 20,
                    "h": 9
                  },
                  {
                    "i": "earnings_chart",
                    "x": 20,
                    "y": 0,
                    "w": 12,
                    "h": 9,
                    "state": {
                      "params": {
                        "symbol": "NVDA"
                      }
                    }
                  },
                  {
                    "i": "surprise_metric",
                    "x": 32,
                    "y": 0,
                    "w": 8,
                    "h": 6
                  }
                ]
              }
            },
            "groups": [
              {
                "name": "Symbol Sync",
                "type": "param",
                "paramName": "symbol",
                "widgetIds": [
                  "estimate_revisions",
                  "earnings_chart"
                ]
              }
            ]
          }
        ]
      }
    }
  ],
  "domain": "finance",
  "source": "workspace-bench-build-apps-gen",
  "level": "L3",
  "capability": "app-building",
  "difficulty": "medium",
  "limits": {
    "max_turns": 5
  },
  "split": "train",
  "novelty": "Unique apps/t2 building exercise using get_workspace_snapshot, manage_backends with checks app_def, repeated_snapshots, too_many_invalid_calls on custom:Earnings Prep Data; artifact appdefs:Earnings Prep Data/Earnings Command."
