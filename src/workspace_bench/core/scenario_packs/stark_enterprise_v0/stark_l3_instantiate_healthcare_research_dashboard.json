{
  "id": "stark_l3_instantiate_healthcare_research_dashboard",
  "title": "Instantiate Healthcare Research Dashboard",
  "level": "L3",
  "capability": "app-instantiation",
  "workflow": "healthcare-catalyst-review",
  "domain": "finance",
  "subdomain": "healthcare-research",
  "difficulty": "medium",
  "split": "dev",
  "tags": [
    "stark",
    "apps",
    "healthcare",
    "research"
  ],
  "source": "stark-enterprise-v0",
  "prompt": "Instantiate the Healthcare Research Dashboard as Healthcare Catalyst Review and add a note on the Documents tab mentioning clinical catalysts and sell-side research PDFs.",
  "fixtures": {
    "backends": [
      {
        "name": "stark-enterprise"
      }
    ]
  },
  "initial_state": {},
  "allowed_tools": [
    "manage_backends",
    "manage_apps",
    "navigate_workspace",
    "add_generative_widget"
  ],
  "success": {
    "required_dashboard_name_contains": "Healthcare Catalyst Review",
    "required_tabs": [
      "clinical",
      "documents"
    ],
    "required_widgets": [
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "healthcare_research_dashboard_clinical_trial_catalyst_calendar",
        "tab_id": "clinical"
      },
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "healthcare_research_dashboard_documents_sell_side_research_pdfs",
        "tab_id": "documents"
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "clinical catalysts",
          "sell-side research PDFs"
        ],
        "tab_id": "documents"
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 0
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "manage_backends",
      "args": {
        "operation": "list"
      }
    },
    {
      "tool": "manage_apps",
      "args": {
        "operation": "instantiate",
        "backend_id": "backend_001",
        "app_name": "Healthcare Research Dashboard",
        "dashboard_name": "Healthcare Catalyst Review",
        "activate": true
      }
    },
    {
      "tool": "navigate_workspace",
      "args": {
        "operation": "tab",
        "tab_id": "documents"
      }
    },
    {
      "tool": "add_generative_widget",
      "args": {
        "widget_type": "note",
        "name": "Healthcare Research Note",
        "data": "Use clinical catalysts and sell-side research PDFs to connect trial timing, thesis evidence, and healthcare coverage decisions."
      }
    }
  ],
  "limits": {
    "max_turns": 10
  }
}
