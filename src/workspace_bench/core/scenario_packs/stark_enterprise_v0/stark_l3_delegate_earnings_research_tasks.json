{
  "id": "stark_l3_delegate_earnings_research_tasks",
  "title": "Delegate Earnings Research Tasks",
  "level": "L3",
  "capability": "mcp-tool-use",
  "workflow": "earnings-prep",
  "domain": "finance",
  "subdomain": "equity-research",
  "difficulty": "medium",
  "split": "dev",
  "tags": [
    "stark",
    "agents",
    "earnings",
    "delegation"
  ],
  "source": "stark-enterprise-v0",
  "prompt": "Call assign_tasks_to_agents with two task_requests using ids coverage-analyst and model-analyst for earnings prep work. Then add a coordinator note naming the coverage analyst and model analyst workstreams on the active dashboard; omit dashboard_id when adding the note.",
  "fixtures": {
    "backends": [
      {
        "name": "stark-enterprise"
      }
    ]
  },
  "initial_state": {
    "dashboard": {
      "name": "Earnings Delegation",
      "activate": true,
      "tabs": [
        {
          "id": "overview",
          "name": "Overview"
        }
      ]
    }
  },
  "allowed_tools": [
    "get_workspace_snapshot",
    "assign_tasks_to_agents",
    "add_generative_widget"
  ],
  "success": {
    "required_tool_calls": [
      {
        "tool": "assign_tasks_to_agents"
      }
    ],
    "required_tool_results": [
      {
        "tool": "assign_tasks_to_agents",
        "data_contains": [
          "coverage-analyst",
          "model-analyst"
        ]
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "coverage analyst",
          "model analyst",
          "earnings prep"
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 0
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_snapshot",
      "args": {}
    },
    {
      "tool": "assign_tasks_to_agents",
      "args": {
        "task_requests": [
          {
            "id": "coverage-analyst",
            "description": "Review estimate revisions and transcript tone for earnings prep.",
            "assigned_holder_url": "workspace://agents/coverage",
            "assigned_agent_id": "coverage-agent"
          },
          {
            "id": "model-analyst",
            "description": "Check internal versus street model bridge and guidance assumptions.",
            "assigned_holder_url": "workspace://agents/model",
            "assigned_agent_id": "model-agent"
          }
        ]
      }
    },
    {
      "tool": "add_generative_widget",
      "args": {
        "widget_type": "note",
        "name": "Delegation Note",
        "data": "Earnings prep delegated: coverage analyst handles estimate revisions and transcript tone; model analyst checks the internal versus street model bridge and guidance assumptions."
      }
    }
  ],
  "limits": {
    "max_turns": 7
  }
}
