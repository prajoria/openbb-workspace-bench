{
  "id": "stark_l2_build_compliance_surveillance_dashboard",
  "title": "Compliance Surveillance Review",
  "level": "L2",
  "capability": "dashboard-construction",
  "workflow": "compliance-surveillance",
  "domain": "finance",
  "subdomain": "compliance",
  "difficulty": "medium",
  "split": "dev",
  "tags": [
    "stark",
    "compliance",
    "dashboard-construction",
    "multi-widget"
  ],
  "source": "stark-enterprise-v0",
  "prompt": "Create a Compliance Surveillance Review dashboard with Alerts and Restricted List tabs, using surveillance alerts and restricted/watch-list widgets.",
  "fixtures": {
    "backends": [
      {
        "name": "stark-enterprise"
      }
    ]
  },
  "initial_state": {},
  "allowed_tools": [
    "manage_dashboard",
    "manage_navigation_bar",
    "navigate_workspace",
    "list_available_widgets",
    "get_widget_schema",
    "create_widget",
    "add_generative_widget"
  ],
  "success": {
    "required_dashboard_name_contains": "Compliance Surveillance Review",
    "required_tabs": [
      "alerts",
      "restricted-list"
    ],
    "required_widgets": [
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "compliance_surveillance_hub_alerts_surveillance_alerts",
        "data_args": {
          "status": "Open",
          "period": "YTD"
        },
        "tab_id": "alerts"
      },
      {
        "origin": "Bench Stark Enterprise",
        "widget_id": "compliance_surveillance_hub_restricted_list_restricted_and_watch_list",
        "data_args": {
          "status": "Open",
          "period": "YTD"
        },
        "tab_id": "restricted-list"
      }
    ],
    "required_generated_widgets": [],
    "layout": {
      "within_grid": true
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "manage_dashboard",
      "args": {
        "operation": "create",
        "name": "Compliance Surveillance Review",
        "activate": true
      }
    },
    {
      "tool": "manage_navigation_bar",
      "args": {
        "operation": "create",
        "tabs": [
          {
            "name": "Alerts"
          },
          {
            "name": "Restricted List"
          }
        ]
      }
    },
    {
      "tool": "list_available_widgets",
      "args": {
        "origin": "Bench Stark Enterprise"
      }
    },
    {
      "tool": "navigate_workspace",
      "args": {
        "operation": "tab",
        "tab_id": "alerts"
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Bench Stark Enterprise",
        "widget_id": "compliance_surveillance_hub_alerts_surveillance_alerts"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Bench Stark Enterprise",
        "widget_id": "compliance_surveillance_hub_alerts_surveillance_alerts",
        "data_args": {
          "status": "Open",
          "period": "YTD"
        }
      }
    },
    {
      "tool": "navigate_workspace",
      "args": {
        "operation": "tab",
        "tab_id": "restricted-list"
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Bench Stark Enterprise",
        "widget_id": "compliance_surveillance_hub_restricted_list_restricted_and_watch_list"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Bench Stark Enterprise",
        "widget_id": "compliance_surveillance_hub_restricted_list_restricted_and_watch_list",
        "data_args": {
          "status": "Open",
          "period": "YTD"
        }
      }
    }
  ],
  "limits": {
    "max_turns": 18
  }
}
