{
  "id": "stark_l1_read_risk_chart_data",
  "title": "Read Underlying Risk Chart Data",
  "level": "L1",
  "capability": "data-reading",
  "workflow": "risk-review",
  "domain": "finance",
  "subdomain": "risk",
  "difficulty": "easy",
  "split": "dev",
  "tags": [
    "stark",
    "risk",
    "data-reading",
    "chart"
  ],
  "source": "stark-enterprise-v0",
  "prompt": "Pull the underlying data for the VaR Trend widget and add a short note that cites the widget id and that it is risk data.",
  "fixtures": {
    "backends": [
      {
        "name": "stark-enterprise"
      }
    ]
  },
  "initial_state": {
    "dashboard": {
      "name": "Risk Data Review",
      "activate": true,
      "tabs": [
        {
          "id": "dashboard",
          "name": "Dashboard"
        }
      ],
      "widgets": [
        {
          "origin": "Bench Stark Enterprise",
          "widget_id": "risk_exposure_monitor_dashboard_var_trend",
          "data_args": {
            "fund": "Flagship Long/Short",
            "period": "YTD",
            "raw": true
          },
          "tab_id": "dashboard",
          "layout": {
            "x": 0,
            "y": 2,
            "w": 40,
            "h": 12
          }
        }
      ]
    }
  },
  "allowed_tools": [
    "get_workspace_snapshot",
    "get_widget_data",
    "add_generative_widget"
  ],
  "success": {
    "required_tool_calls": [
      {
        "tool": "get_widget_data",
        "args_contains": {
          "origin": "Bench Stark Enterprise",
          "widget_id": "risk_exposure_monitor_dashboard_var_trend"
        }
      }
    ],
    "required_tool_results": [
      {
        "tool": "get_widget_data",
        "data_contains": [
          "risk_exposure_monitor_dashboard_var_trend",
          "Risk"
        ]
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "risk_exposure_monitor_dashboard_var_trend",
          "risk data"
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 0
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_snapshot",
      "args": {}
    },
    {
      "tool": "get_widget_data",
      "args": {
        "origin": "Bench Stark Enterprise",
        "widget_id": "risk_exposure_monitor_dashboard_var_trend",
        "widget_uuid": "widget_001",
        "data_args": {
          "fund": "Flagship Long/Short",
          "period": "YTD",
          "raw": true
        }
      }
    },
    {
      "tool": "add_generative_widget",
      "args": {
        "widget_type": "note",
        "name": "Risk Data Note",
        "data": "The risk_exposure_monitor_dashboard_var_trend widget returned deterministic risk data for the Flagship Long/Short YTD review."
      }
    }
  ],
  "limits": {
    "max_turns": 6
  }
}
