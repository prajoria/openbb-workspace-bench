{
  "id": "l2_portfolio_macro_risk_dashboard",
  "title": "Build a Portfolio and Macro Risk Dashboard",
  "level": "L2",
  "category": "dashboard-construction",
  "difficulty": "medium",
  "tags": [
    "portfolio",
    "macro",
    "cross-backend",
    "risk",
    "multi-widget"
  ],
  "source": "workspace-bench",
  "prompt": "Create a dashboard combining portfolio sector exposure, risk metrics, and the 10Y Treasury series. Add a note about concentration and rates risk using the exact largest sector exposure value from the data.",
  "fixtures": {
    "backends": [
      {
        "name": "portfolio"
      },
      {
        "name": "macro"
      }
    ]
  },
  "initial_state": {},
  "allowed_tools": [
    "manage_dashboard",
    "list_available_widgets",
    "get_widget_schema",
    "get_widget_data",
    "create_widget",
    "add_generative_widget"
  ],
  "success": {
    "required_dashboard_name_contains": "Portfolio Macro Risk",
    "required_widgets": [
      {
        "origin": "Bench Portfolio",
        "widget_id": "sector_exposure",
        "data_args": {}
      },
      {
        "origin": "Bench Portfolio",
        "widget_id": "risk_metrics",
        "data_args": {}
      },
      {
        "origin": "Bench Macro",
        "widget_id": "macro_timeseries",
        "data_args": {
          "series": "DGS10"
        }
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "Technology",
          "0.86",
          "10Y"
        ]
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "manage_dashboard",
      "args": {
        "operation": "create",
        "name": "Portfolio Macro Risk Dashboard",
        "activate": true
      }
    },
    {
      "tool": "list_available_widgets",
      "args": {
        "origin": "Bench Portfolio"
      }
    },
    {
      "tool": "list_available_widgets",
      "args": {
        "origin": "Bench Macro"
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Bench Portfolio",
        "widget_id": "sector_exposure"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Bench Portfolio",
        "widget_id": "sector_exposure",
        "data_args": {}
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Bench Portfolio",
        "widget_id": "risk_metrics"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Bench Portfolio",
        "widget_id": "risk_metrics",
        "data_args": {}
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Bench Macro",
        "widget_id": "macro_timeseries"
      }
    },
    {
      "tool": "get_widget_data",
      "args": {
        "origin": "Bench Portfolio",
        "widget_id": "sector_exposure",
        "data_args": {}
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Bench Macro",
        "widget_id": "macro_timeseries",
        "data_args": {
          "series": "DGS10"
        }
      }
    },
    {
      "tool": "add_generative_widget",
      "args": {
        "widget_type": "note",
        "name": "Risk Note",
        "data": "Technology is 0.86 of sector exposure, so portfolio concentration should be monitored alongside the 10Y Treasury rate backdrop."
      }
    }
  ],
  "limits": {
    "max_turns": 14
  }
}
