{
  "id": "l3_app_template_summary",
  "title": "Summarize an App Template",
  "level": "L3",
  "capability": "app-instantiation",
  "workflow": "equity-tearsheet",
  "domain": "finance",
  "subdomain": "equity-research",
  "difficulty": "medium",
  "tags": [
    "apps",
    "equities",
    "generated-note"
  ],
  "source": "workspace-bench",
  "prompt": "Read the Equity Earnings Review app template and add a note summarizing its tabs, widgets, and suggested prompts.",
  "fixtures": {
    "backends": [
      {
        "name": "equities"
      }
    ]
  },
  "initial_state": {},
  "allowed_tools": [
    "manage_backends",
    "manage_apps",
    "add_generative_widget"
  ],
  "success": {
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "Equity Earnings Review",
          "overview",
          "estimates",
          "price_performance",
          "prompts"
        ]
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "manage_backends",
      "args": {
        "operation": "list"
      }
    },
    {
      "tool": "manage_apps",
      "args": {
        "operation": "read",
        "backend_id": "backend_001",
        "template_id": "equity-earnings-review"
      }
    },
    {
      "tool": "add_generative_widget",
      "args": {
        "widget_type": "note",
        "name": "App Template Summary",
        "data": "Equity Earnings Review has overview and estimates tabs. It includes price_performance, latest_news, estimate_history, and fundamental_metrics widgets, plus suggested prompts for earnings analysis."
      }
    }
  ],
  "limits": {
    "max_turns": 6
  }
}
