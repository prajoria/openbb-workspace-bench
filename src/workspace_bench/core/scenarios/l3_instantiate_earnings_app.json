{
  "id": "l3_instantiate_earnings_app",
  "title": "Instantiate the Equity Earnings App",
  "level": "L3",
  "capability": "app-instantiation",
  "workflow": "earnings-prep",
  "domain": "finance",
  "subdomain": "equity-research",
  "difficulty": "medium",
  "tags": [
    "apps",
    "equities",
    "tabs"
  ],
  "source": "workspace-bench",
  "prompt": "Find the Equity Earnings Review app template in the equities backend and instantiate it as a new dashboard named AAPL App Review.",
  "fixtures": {
    "backends": [
      {
        "name": "equities"
      }
    ]
  },
  "initial_state": {},
  "allowed_tools": [
    "manage_backends",
    "manage_apps",
    "manage_dashboard",
    "get_workspace_snapshot"
  ],
  "success": {
    "required_dashboard_name_contains": "AAPL App Review",
    "required_tabs": [
      "overview",
      "estimates"
    ],
    "required_widgets": [
      {
        "origin": "Bench Equities",
        "widget_id": "price_performance",
        "data_args": {
          "symbol": "AAPL"
        },
        "tab_id": "overview"
      },
      {
        "origin": "Bench Equities",
        "widget_id": "latest_news",
        "data_args": {
          "symbol": "AAPL",
          "limit": 5
        },
        "tab_id": "overview"
      },
      {
        "origin": "Bench Equities",
        "widget_id": "estimate_history",
        "data_args": {
          "symbol": "AAPL"
        },
        "tab_id": "estimates"
      },
      {
        "origin": "Bench Equities",
        "widget_id": "fundamental_metrics",
        "data_args": {
          "symbol": "AAPL"
        },
        "tab_id": "estimates"
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "forbid_invented_widget_ids": true
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "manage_backends",
      "args": {
        "operation": "list"
      }
    },
    {
      "tool": "manage_apps",
      "args": {
        "operation": "list",
        "backend_id": "backend_001"
      }
    },
    {
      "tool": "manage_apps",
      "args": {
        "operation": "read",
        "backend_id": "backend_001",
        "template_id": "equity-earnings-review"
      }
    },
    {
      "tool": "manage_apps",
      "args": {
        "operation": "instantiate",
        "backend_id": "backend_001",
        "template_id": "equity-earnings-review",
        "dashboard_name": "AAPL App Review",
        "activate": true
      }
    }
  ],
  "limits": {
    "max_turns": 8
  }
}
