{
  "id": "l4_add_missing_estimates_tab",
  "title": "Repair an Earnings Dashboard Missing Its Estimates Tab",
  "level": "L4",
  "category": "repair",
  "difficulty": "hard",
  "tags": [
    "repair",
    "tabs",
    "equities",
    "multi-widget"
  ],
  "source": "workspace-bench",
  "prompt": "This AAPL earnings dashboard has Overview content but is missing the Estimates tab. Add the Estimates tab with estimate history and fundamental metrics widgets for AAPL.",
  "fixtures": {
    "backends": [
      {
        "name": "equities"
      }
    ]
  },
  "initial_state": {
    "dashboard": {
      "name": "Incomplete AAPL Earnings",
      "activate": true,
      "tabs": [
        {
          "id": "overview",
          "name": "Overview"
        }
      ],
      "widgets": [
        {
          "origin": "Bench Equities",
          "widget_id": "price_performance",
          "data_args": {
            "symbol": "AAPL"
          },
          "tab_id": "overview",
          "layout": {
            "x": 0,
            "y": 2,
            "w": 20,
            "h": 12
          }
        },
        {
          "origin": "Bench Equities",
          "widget_id": "latest_news",
          "data_args": {
            "symbol": "AAPL",
            "limit": 5
          },
          "tab_id": "overview",
          "layout": {
            "x": 20,
            "y": 2,
            "w": 20,
            "h": 10
          }
        }
      ]
    }
  },
  "allowed_tools": [
    "get_workspace_snapshot",
    "manage_navigation_bar",
    "navigate_workspace",
    "list_available_widgets",
    "get_widget_schema",
    "create_widget"
  ],
  "success": {
    "required_tabs": [
      "overview",
      "estimates"
    ],
    "required_widgets": [
      {
        "origin": "Bench Equities",
        "widget_id": "price_performance",
        "data_args": {
          "symbol": "AAPL"
        },
        "tab_id": "overview"
      },
      {
        "origin": "Bench Equities",
        "widget_id": "estimate_history",
        "data_args": {
          "symbol": "AAPL"
        },
        "tab_id": "estimates"
      },
      {
        "origin": "Bench Equities",
        "widget_id": "fundamental_metrics",
        "data_args": {
          "symbol": "AAPL"
        },
        "tab_id": "estimates"
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true,
      "max_repeated_snapshots": 1
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_snapshot",
      "args": {}
    },
    {
      "tool": "manage_navigation_bar",
      "args": {
        "operation": "add_tabs",
        "tabs": [
          {
            "name": "Estimates"
          }
        ]
      }
    },
    {
      "tool": "navigate_workspace",
      "args": {
        "operation": "tab",
        "tab_id": "estimates"
      }
    },
    {
      "tool": "list_available_widgets",
      "args": {
        "origin": "Bench Equities"
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Bench Equities",
        "widget_id": "estimate_history"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Bench Equities",
        "widget_id": "estimate_history",
        "data_args": {
          "symbol": "AAPL"
        }
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Bench Equities",
        "widget_id": "fundamental_metrics"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Bench Equities",
        "widget_id": "fundamental_metrics",
        "data_args": {
          "symbol": "AAPL"
        }
      }
    }
  ],
  "limits": {
    "max_turns": 12
  }
}
