          },
          "tab_id": "overview",
          "layout": {
            "x": 0,
            "y": 2,
            "w": 20,
            "h": 12
          }
        }
      ]
    }
  },
  "allowed_tools": [
    "get_workspace_snapshot",
    "read_widget",
    "update_widget",
    "add_generative_widget",
    "get_widget_data"
