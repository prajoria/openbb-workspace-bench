      "tool": "get_workspace_snapshot",
      "args": {}
    },
    {
      "tool": "read_widget",
      "args": {
        "widget_id": "price_performance"
      }
    },
    {
      "tool": "update_widget",
      "args": {
        "widget_id": "price_performance",
        "data_args": {
          "symbol": "AAPL"
        }
      }
