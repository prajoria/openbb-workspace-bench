      {
        "name": "equities"
      }
    ]
  },
  "initial_state": {
    "dashboard": {
      "name": "AAPL Repair Task",
      "activate": true,
      "tabs": [
        {
          "id": "overview",
          "name": "Overview"
        }
      ],
      "widgets": [
        {
