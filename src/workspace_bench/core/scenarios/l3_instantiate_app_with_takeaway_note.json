{
  "id": "l3_instantiate_app_with_takeaway_note",
  "title": "Instantiate an App and Add a Takeaway Note",
  "level": "L3",
  "capability": "app-instantiation",
  "workflow": "equity-tearsheet",
  "domain": "finance",
  "subdomain": "equity-research",
  "difficulty": "medium",
  "tags": [
    "apps",
    "equities",
    "generated-note",
    "tabs"
  ],
  "source": "workspace-bench",
  "prompt": "Instantiate the Equity Earnings Review app as AAPL Earnings App Plus and add a note on the Overview tab explaining what the app is for.",
  "fixtures": {
    "backends": [
      {
        "name": "equities"
      }
    ]
  },
  "initial_state": {},
  "allowed_tools": [
    "manage_backends",
    "manage_apps",
    "navigate_workspace",
    "add_generative_widget"
  ],
  "success": {
    "required_dashboard_name_contains": "AAPL Earnings App Plus",
    "required_tabs": [
      "overview",
      "estimates"
    ],
    "required_widgets": [
      {
        "origin": "Bench Equities",
        "widget_id": "price_performance",
        "data_args": {
          "symbol": "AAPL"
        },
        "tab_id": "overview"
      },
      {
        "origin": "Bench Equities",
        "widget_id": "estimate_history",
        "data_args": {
          "symbol": "AAPL"
        },
        "tab_id": "estimates"
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "earnings",
          "AAPL",
          "Overview"
        ],
        "tab_id": "overview"
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "manage_backends",
      "args": {
        "operation": "list"
      }
    },
    {
      "tool": "manage_apps",
      "args": {
        "operation": "instantiate",
        "backend_id": "backend_001",
        "template_id": "equity-earnings-review",
        "dashboard_name": "AAPL Earnings App Plus",
        "activate": true
      }
    },
    {
      "tool": "navigate_workspace",
      "args": {
        "operation": "tab",
        "tab_id": "overview"
      }
    },
    {
      "tool": "add_generative_widget",
      "args": {
        "widget_type": "note",
        "name": "App Purpose",
        "data": "This Overview tab is for AAPL earnings preparation, combining price action, news, estimates, and fundamentals."
      }
    }
  ],
  "limits": {
    "max_turns": 8
  }
}
