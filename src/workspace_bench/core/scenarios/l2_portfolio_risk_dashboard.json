{
  "id": "l2_portfolio_risk_dashboard",
  "title": "Build a Portfolio Risk Dashboard",
  "level": "L2",
  "capability": "dashboard-construction",
  "workflow": "portfolio-risk-review",
  "domain": "finance",
  "subdomain": "portfolio-management",
  "difficulty": "medium",
  "tags": [
    "portfolio",
    "risk",
    "generated-note",
    "multi-widget"
  ],
  "source": "workspace-bench",
  "prompt": "Create a portfolio risk dashboard with holdings, sector exposure, and risk metrics. Add a note identifying the largest concentration risk.",
  "fixtures": {
    "backends": [
      {
        "name": "portfolio"
      }
    ]
  },
  "initial_state": {},
  "allowed_tools": [
    "manage_dashboard",
    "list_available_widgets",
    "get_widget_schema",
    "get_widget_data",
    "create_widget",
    "add_generative_widget"
  ],
  "success": {
    "required_dashboard_name_contains": "Portfolio Risk",
    "required_widgets": [
      {
        "origin": "Bench Portfolio",
        "widget_id": "holdings_table",
        "data_args": {}
      },
      {
        "origin": "Bench Portfolio",
        "widget_id": "sector_exposure",
        "data_args": {}
      },
      {
        "origin": "Bench Portfolio",
        "widget_id": "risk_metrics",
        "data_args": {}
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "Technology",
          "0.86"
        ]
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "manage_dashboard",
      "args": {
        "operation": "create",
        "name": "Portfolio Risk Dashboard",
        "activate": true
      }
    },
    {
      "tool": "list_available_widgets",
      "args": {
        "origin": "Bench Portfolio"
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Bench Portfolio",
        "widget_id": "holdings_table"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Bench Portfolio",
        "widget_id": "holdings_table",
        "data_args": {}
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Bench Portfolio",
        "widget_id": "sector_exposure"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Bench Portfolio",
        "widget_id": "sector_exposure",
        "data_args": {}
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Bench Portfolio",
        "widget_id": "risk_metrics"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Bench Portfolio",
        "widget_id": "risk_metrics",
        "data_args": {}
      }
    },
    {
      "tool": "get_widget_data",
      "args": {
        "origin": "Bench Portfolio",
        "widget_id": "sector_exposure",
        "data_args": {}
      }
    },
    {
      "tool": "add_generative_widget",
      "args": {
        "widget_type": "note",
        "name": "Risk Takeaway",
        "data": "Technology is the largest concentration risk at 0.86 portfolio weight, led by mega-cap software and semiconductor exposure."
      }
    }
  ],
  "limits": {
    "max_turns": 14
  }
}
