  "prompt": "Connect a new custom backend named \"Vol Desk Data\" at http://localhost:7801. Its widgets.json serves exactly one content widget \u2014 `vol_commentary`: name \"Vol Commentary\", description \"Morning volatility commentary.\", endpoint /vol-commentary, type markdown, sized w=12 h=8 on the grid, staleTime 900000, params required: desk \u2014 a text input (type text), labeled \"Desk\", static options [\"Index\"=\"index\", \"Single Stock\"=\"single\"], default \"index\". Register it with manage_backends.",
  "fixtures": {},
  "initial_state": {},
  "allowed_tools": [
    "get_workspace_snapshot",
    "manage_backends"
  ],
  "success": {
    "required_widget_defs": [
      {
        "backend_name": "Vol Desk Data",
        "widget_id": "vol_commentary",
        "expect": {
          "type": "markdown",
          "endpoint": "/vol-commentary",
          "gridData.w": 12,
          "gridData.h": 8,
          "staleTime": 900000
        },
        "params_include": [
          {
            "paramName": "desk",
            "type": "text"
          }
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 1,
      "max_repeated_snapshots": 2
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "manage_backends",
      "args": {
        "operation": "add",
        "name": "Vol Desk Data",
        "url": "http://localhost:7801",
        "widgets_json": {
          "vol_commentary": {
            "name": "Vol Commentary",
            "description": "Morning volatility commentary.",
            "endpoint": "/vol-commentary",
            "type": "markdown",
            "gridData": {
              "w": 12,
              "h": 8
            },
            "params": [
              {
                "paramName": "desk",
                "type": "text",
                "label": "Desk",
                "value": "index",
                "options": [
                  {
                    "label": "Index",
                    "value": "index"
                  },
                  {
                    "label": "Single Stock",
                    "value": "single"
                  }
                ]
              }
            ],
            "staleTime": 900000
          }
        }
      }
    }
  ],
