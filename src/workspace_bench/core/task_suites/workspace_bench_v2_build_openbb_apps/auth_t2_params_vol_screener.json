  "success": {
    "required_widget_defs": [
      {
        "backend_name": "Vol Desk Data",
        "widget_id": "vol_screener",
        "expect": {
          "type": "table",
          "endpoint": "/vol-screener",
          "gridData.w": 24,
          "gridData.h": 10,
          "category": "Volatility",
          "staleTime": 600000
