  "prompt": "Add apps.json to the connected backend \"Earnings Prep Data\" (already serving `earnings_chart`, `earnings_note`): app \"Chart Note Board\", description \"Chart and preview note synced by symbol.\", tab `preview` named \"Preview\" places: `earnings_chart` at x=0 y=0 w=20 h=9; `earnings_note` at x=20 y=0 w=12 h=9, group \"Preview Symbol Sync\" (type param) syncing param symbol across [\"earnings_chart\", \"earnings_note\"]. Use operation refresh with apps_json.",
  "fixtures": {},
  "initial_state": {
    "custom_backends": [
      {
        "name": "Earnings Prep Data",
        "url": "http://localhost:7805",
        "backend_id": "backend_001",
        "widgets_json": {
          "earnings_chart": {
            "name": "EPS History",
            "description": "Plotly EPS beat/miss history.",
            "endpoint": "/eps-history",
            "type": "chart",
            "gridData": {
              "w": 20,
              "h": 9
            },
            "params": [
              {
                "paramName": "symbol",
                "type": "endpoint",
                "label": "Symbol",
                "value": "AAPL",
                "optionsEndpoint": "/symbols"
              }
            ],
            "raw": true
          },
          "earnings_note": {
            "name": "Earnings Preview",
            "description": "Preview note for the earnings call.",
            "endpoint": "/earnings-preview",
            "type": "markdown",
            "gridData": {
              "w": 12,
              "h": 8
            },
            "params": [
              {
                "paramName": "symbol",
                "type": "endpoint",
                "label": "Symbol",
                "value": "AAPL",
                "optionsEndpoint": "/symbols"
              }
            ]
          }
        }
      }
    ]
  },
  "allowed_tools": [
    "get_workspace_snapshot",
    "manage_backends"
  ],
  "success": {
    "required_app_defs": [
      {
        "backend_name": "Earnings Prep Data",
        "layout_refs_valid": true,
        "no_overlaps": true,
        "name_contains": "Chart Note Board",
        "tabs_include": [
          "preview"
        ],
        "tab_count": 1,
        "widgets_on_tab": [
          {
            "tab_id": "preview",
            "widget_id": "earnings_chart"
          },
          {
            "tab_id": "preview",
            "widget_id": "earnings_note"
          }
        ],
        "groups_include": [
          {
            "name": "Preview Symbol Sync",
            "type": "param",
            "paramName": "symbol",
            "widgetIds_include": [
              "earnings_chart",
              "earnings_note"
            ]
          }
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 1,
      "max_repeated_snapshots": 2
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_snapshot",
      "args": {}
    },
    {
      "tool": "manage_backends",
      "args": {
        "operation": "refresh",
        "backend_id": "backend_001",
        "apps_json": [
          {
            "name": "Chart Note Board",
            "description": "Chart and preview note synced by symbol.",
            "tabs": {
              "preview": {
                "id": "preview",
                "name": "Preview",
                "layout": [
                  {
                    "i": "earnings_chart",
                    "x": 0,
                    "y": 0,
                    "w": 20,
                    "h": 9
                  },
                  {
                    "i": "earnings_note",
                    "x": 20,
                    "y": 0,
                    "w": 12,
                    "h": 9
                  }
                ]
              }
            },
            "groups": [
              {
                "name": "Preview Symbol Sync",
                "type": "param",
                "paramName": "symbol",
                "widgetIds": [
                  "earnings_chart",
                  "earnings_note"
                ]
              }
            ]
          }
        ]
      }
    }
  ],
