  "success": {
    "required_widget_defs": [
      {
        "backend_name": "Vol Desk Data",
        "widget_id": "vix_history",
        "expect": {
          "type": "table",
          "endpoint": "/vix-history",
          "gridData.w": 20,
          "gridData.h": 9
        },
        "params_include": [
