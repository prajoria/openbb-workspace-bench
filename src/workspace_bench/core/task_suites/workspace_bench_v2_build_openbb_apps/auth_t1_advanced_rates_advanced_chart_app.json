    "get_workspace_snapshot",
    "manage_backends"
  ],
  "success": {
    "required_widget_defs": [
      {
        "backend_name": "Rates Watch Data",
        "widget_id": "rates_advanced_chart",
        "expect": {
          "type": "advanced_charting",
          "endpoint": "/rates-udf",
          "gridData.w": 20,
          "gridData.h": 18
        }
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Rates Watch Data",
        "layout_refs_valid": true,
        "no_overlaps": true,
        "name_contains": "Rates Advanced",
        "tabs_include": [
          "rates"
        ],
        "tab_count": 1,
        "widgets_on_tab": [
          {
            "tab_id": "rates",
            "widget_id": "rates_advanced_chart"
          }
        ]
      }
    ],
