    "grouping"
  ],
  "prompt": "Add apps.json to the connected backend \"Earnings Prep Data\" (already serving `estimate_revisions`, `earnings_note`): app \"Revision Note Board\", description \"Revisions and preview note synced by symbol.\", tab `notes` named \"Notes\" places: `estimate_revisions` at x=0 y=0 w=20 h=9; `earnings_note` at x=20 y=0 w=12 h=9, group \"Revision Symbol Sync\" (type param) syncing param symbol across [\"estimate_revisions\", \"earnings_note\"]. Use operation refresh with apps_json.",
  "fixtures": {},
  "initial_state": {
    "custom_backends": [
      {
        "name": "Earnings Prep Data",
        "url": "http://localhost:7805",
        "backend_id": "backend_001",
        "widgets_json": {
          "estimate_revisions": {
            "name": "Estimate Revisions",
            "description": "Street estimate revisions by quarter.",
            "endpoint": "/estimate-revisions",
            "type": "table",
            "gridData": {
              "w": 20,
              "h": 9
            },
            "params": [
              {
                "paramName": "symbol",
                "type": "endpoint",
                "label": "Symbol",
                "value": "AAPL",
                "optionsEndpoint": "/symbols"
              }
            ],
            "data": {
              "table": {
                "columnsDefs": [
                  {
                    "field": "quarter",
                    "headerName": "Quarter",
                    "cellDataType": "text"
                  },
                  {
                    "field": "eps_estimate",
                    "headerName": "EPS Est",
                    "cellDataType": "number"
                  },
                  {
                    "field": "revenue_estimate_b",
                    "headerName": "Revenue Est ($B)",
                    "cellDataType": "number"
                  }
                ]
              }
            }
          },
          "earnings_note": {
            "name": "Earnings Preview",
            "description": "Preview note for the earnings call.",
            "endpoint": "/earnings-preview",
            "type": "markdown",
            "gridData": {
              "w": 12,
              "h": 8
            },
            "params": [
              {
                "paramName": "symbol",
                "type": "endpoint",
                "label": "Symbol",
                "value": "AAPL",
                "optionsEndpoint": "/symbols"
              }
            ]
          }
        }
      }
    ]
  },
  "allowed_tools": [
    "get_workspace_snapshot",
    "manage_backends"
  ],
  "success": {
    "required_app_defs": [
      {
        "backend_name": "Earnings Prep Data",
        "layout_refs_valid": true,
        "no_overlaps": true,
        "name_contains": "Revision Note Board",
        "tabs_include": [
          "notes"
        ],
        "tab_count": 1,
        "widgets_on_tab": [
          {
            "tab_id": "notes",
            "widget_id": "estimate_revisions"
          },
          {
            "tab_id": "notes",
            "widget_id": "earnings_note"
          }
        ],
        "groups_include": [
          {
            "name": "Revision Symbol Sync",
            "type": "param",
            "paramName": "symbol",
            "widgetIds_include": [
              "estimate_revisions",
              "earnings_note"
            ]
          }
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 1,
      "max_repeated_snapshots": 2
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_snapshot",
      "args": {}
    },
    {
      "tool": "manage_backends",
      "args": {
        "operation": "refresh",
        "backend_id": "backend_001",
        "apps_json": [
          {
            "name": "Revision Note Board",
            "description": "Revisions and preview note synced by symbol.",
            "tabs": {
              "notes": {
                "id": "notes",
                "name": "Notes",
                "layout": [
                  {
                    "i": "estimate_revisions",
                    "x": 0,
                    "y": 0,
                    "w": 20,
                    "h": 9
                  },
                  {
                    "i": "earnings_note",
                    "x": 20,
                    "y": 0,
                    "w": 12,
                    "h": 9
                  }
                ]
              }
            },
            "groups": [
              {
                "name": "Revision Symbol Sync",
                "type": "param",
                "paramName": "symbol",
                "widgetIds": [
                  "estimate_revisions",
                  "earnings_note"
                ]
              }
            ]
          }
        ]
      }
    }
  ],
  "domain": "finance",
  "source": "workspace-bench-build-apps-gen",
