            },
            "category": "Surveillance",
            "staleTime": 1800000
          }
        },
        "apps_json": [
          {
            "name": "Surveillance Settings Room",
            "description": "Alerts, notes, and policy settings.",
            "tabs": {
              "alerts": {
                "id": "alerts",
