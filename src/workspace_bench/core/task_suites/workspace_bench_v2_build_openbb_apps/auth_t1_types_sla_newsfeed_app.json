  "prompt": "Check the workspace, then connect \"Vendor SLA Data\" at http://localhost:7804. Its widgets.json serves one widget \u2014 `sla_newsfeed`: name \"Vendor Notices\", description \"Vendor incident notices feed.\", endpoint /vendor-notices, type newsfeed, sized w=12 h=10 on the grid. Its apps.json ships an app named \"Vendor Notices\" (description \"Vendor incident notices.\") with a single tab `notices` named \"Notices\" that places `sla_newsfeed` at x=0 y=0 w=12 h=10. Publish both in the same manage_backends add.",
  "fixtures": {},
  "initial_state": {},
  "allowed_tools": [
    "get_workspace_snapshot",
    "manage_backends"
  ],
  "success": {
    "required_widget_defs": [
      {
        "backend_name": "Vendor SLA Data",
        "widget_id": "sla_newsfeed",
        "expect": {
          "type": "newsfeed",
          "endpoint": "/vendor-notices",
          "gridData.w": 12,
          "gridData.h": 10
        }
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Vendor SLA Data",
        "layout_refs_valid": true,
        "no_overlaps": true,
        "name_contains": "Vendor Notices",
        "tabs_include": [
          "notices"
        ],
        "tab_count": 1,
        "widgets_on_tab": [
          {
            "tab_id": "notices",
            "widget_id": "sla_newsfeed"
          }
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 1,
      "max_repeated_snapshots": 2
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_snapshot",
      "args": {}
    },
    {
      "tool": "manage_backends",
      "args": {
        "operation": "add",
        "name": "Vendor SLA Data",
        "url": "http://localhost:7804",
        "widgets_json": {
          "sla_newsfeed": {
