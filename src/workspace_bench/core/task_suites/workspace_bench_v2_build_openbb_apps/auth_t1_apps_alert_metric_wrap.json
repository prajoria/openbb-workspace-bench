  "prompt": "Build widgets.json (`alert_metric`: name \"Open Alerts\", description \"Open alert count.\", endpoint /alert-count, type metric, sized w=5 h=4 on the grid) and apps.json (an app named \"Alert Board\" (description \"Alert posture.\") with one tab `alerts` named \"Alerts\" placing `alert_metric` at x=0 y=0 w=12 h=6) for \"Surveillance Data\" at http://localhost:7807, then add the backend.",
  "fixtures": {},
  "initial_state": {},
  "allowed_tools": [
    "get_workspace_snapshot",
    "manage_backends"
  ],
  "success": {
    "required_widget_defs": [
      {
        "backend_name": "Surveillance Data",
        "widget_id": "alert_metric",
        "expect": {
          "type": "metric",
          "endpoint": "/alert-count"
        }
      }
    ],
    "required_app_defs": [
      {
        "backend_name": "Surveillance Data",
        "layout_refs_valid": true,
        "no_overlaps": true,
        "name_contains": "Alert Board",
        "tabs_include": [
          "alerts"
        ],
        "tab_count": 1,
        "widgets_on_tab": [
          {
            "tab_id": "alerts",
            "widget_id": "alert_metric"
          }
        ]
      }
    ],
    "trace_checks": {
      "max_invalid_tool_calls": 1,
      "max_repeated_snapshots": 2
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "get_workspace_snapshot",
      "args": {}
    },
    {
      "tool": "manage_backends",
      "args": {
        "operation": "add",
        "name": "Surveillance Data",
        "url": "http://localhost:7807",
        "widgets_json": {
          "alert_metric": {
            "name": "Open Alerts",
            "description": "Open alert count.",
            "endpoint": "/alert-count",
            "type": "metric",
            "gridData": {
              "w": 5,
              "h": 4
            }
          }
        },
        "apps_json": [
          {
            "name": "Alert Board",
            "description": "Alert posture.",
            "tabs": {
              "alerts": {
                "id": "alerts",
                "name": "Alerts",
                "layout": [
                  {
                    "i": "alert_metric",
                    "x": 0,
                    "y": 0,
                    "w": 12,
                    "h": 6
                  }
                ]
              }
            },
            "groups": []
          }
        ]
      }
    }
