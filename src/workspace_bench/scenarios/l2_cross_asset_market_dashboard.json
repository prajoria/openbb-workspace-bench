{
  "id": "l2_cross_asset_market_dashboard",
  "title": "Build a Cross-Asset Market Dashboard",
  "level": "L2",
  "category": "dashboard-construction",
  "difficulty": "medium",
  "tags": [
    "equities",
    "macro",
    "cross-backend",
    "multi-widget",
    "generated-note"
  ],
  "source": "workspace-bench",
  "prompt": "Create a cross-asset dashboard with AAPL price performance, the 10Y Treasury time series, and the yield curve. Add a note linking equity performance to the rates backdrop.",
  "fixtures": {
    "backends": [
      {
        "name": "equities"
      },
      {
        "name": "macro"
      }
    ]
  },
  "initial_state": {},
  "allowed_tools": [
    "manage_dashboard",
    "list_available_widgets",
    "get_widget_schema",
    "get_params_options",
    "create_widget",
    "add_generative_widget"
  ],
  "success": {
    "required_dashboard_name_contains": "Cross-Asset",
    "required_widgets": [
      {
        "origin": "Bench Equities",
        "widget_id": "price_performance",
        "data_args": {
          "symbol": "AAPL"
        }
      },
      {
        "origin": "Bench Macro",
        "widget_id": "macro_timeseries",
        "data_args": {
          "series": "DGS10"
        }
      },
      {
        "origin": "Bench Macro",
        "widget_id": "yield_curve",
        "data_args": {}
      }
    ],
    "required_generated_widgets": [
      {
        "widget_type": "note",
        "data_contains": [
          "AAPL",
          "10Y",
          "rates"
        ]
      }
    ],
    "layout": {
      "within_grid": true,
      "no_overlaps": true,
      "grid_width": 40
    },
    "trace_checks": {
      "max_invalid_tool_calls": 0,
      "must_call_schema_before_create": true,
      "forbid_invented_widget_ids": true
    }
  },
  "oracle_tool_calls": [
    {
      "tool": "manage_dashboard",
      "args": {
        "operation": "create",
        "name": "Cross-Asset Market Dashboard",
        "activate": true
      }
    },
    {
      "tool": "list_available_widgets",
      "args": {
        "origin": "Bench Equities"
      }
    },
    {
      "tool": "list_available_widgets",
      "args": {
        "origin": "Bench Macro"
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Bench Equities",
        "widget_id": "price_performance"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Bench Equities",
        "widget_id": "price_performance",
        "data_args": {
          "symbol": "AAPL"
        }
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Bench Macro",
        "widget_id": "macro_timeseries"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Bench Macro",
        "widget_id": "macro_timeseries",
        "data_args": {
          "series": "DGS10"
        }
      }
    },
    {
      "tool": "get_widget_schema",
      "args": {
        "origin": "Bench Macro",
        "widget_id": "yield_curve"
      }
    },
    {
      "tool": "create_widget",
      "args": {
        "origin": "Bench Macro",
        "widget_id": "yield_curve",
        "data_args": {}
      }
    },
    {
      "tool": "add_generative_widget",
      "args": {
        "widget_type": "note",
        "name": "Cross-Asset Note",
        "data": "AAPL price performance should be read alongside the 10Y rates backdrop and the upward-sloping yield curve."
      }
    }
  ],
  "limits": {
    "max_turns": 14
  }
}
